    IF idx==6 THEN d:="Regresa al tablero de modulos."; e:="Presione ENTER para volver"; END;
  END;
  IF titulo=="Expresion o tramos" THEN
    IF idx==1 THEN d:="Evalua una expresion continua."; e:="X es t; Ts fija el paso"; END;
    IF idx==2 THEN d:="Carga hasta 8 intervalos continuos."; e:="Cada [a,b) incluye a y excluye b"; END;
    IF idx==3 THEN d:="Carga tramos con indices enteros."; e:="[0,3) contiene n=0,1,2"; END;
