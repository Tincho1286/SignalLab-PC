  IF INSTRING(titulo,"Teoria por programa")>0 THEN
    IF idx==1 THEN d:="Senales, LTI, Laplace y Z."; e:="Incluye propiedades y simulacion"; END;
    IF idx==2 THEN d:="Series y transformadas de Fourier."; e:="Incluye Parseval y convolucion"; END;
    IF idx==3 THEN d:="Muestreo, reconstruccion y control."; e:="Incluye Bode y lugar de raices"; END;
