#pragma mode( separator(.,;) integer(h32) )
// SignalLab 5.0 - Motor numerico protegido y centros de resultados
// Sistemas y Senales I + Sistemas y Senales II (UNRC)
// Fuente ASCII para maxima compatibilidad.

EXPORT SSDATA;
EXPORT SSDATA_N0;
EXPORT SSDATA_DX;
EXPORT SSDATA_NAME;
EXPORT SSEVAL_EVENTS;
EXPORT SSDATA_EVENTS;
EXPORT SSHISTORY;
EXPORT SSREAD_META;

SSHistoryAdd(item)
BEGIN
  LOCAL k;
  LOCAL total:=0;
  LOCAL serial;
  LOCAL conservar;
  LOCAL siguiente;
  LOCAL valor;
  LOCAL limite;
  LOCAL profundidad;
  LOCAL medida;
  LOCAL otro;
  // Diagnostico pequeno: reemplazar solo su propia entrada; nunca desalojar
  // resultados del usuario si los ocho lugares ya estan ocupados.
  IF TYPE(item)==6 THEN IF SIZE(item)==4 THEN IF item(1)=="DIAG" THEN
    IFERR
      IF TYPE(SSHISTORY)<>6 THEN SSHISTORY:={}; END;
      siguiente:={5,"Diagnostico: ultima operacion",item(2),item(3),item(4)};
      total:=SSHistoryAdd({"SIZE",siguiente,512,0}); IF total<0 THEN RETURN 0; END;
      conservar:=0;
      FOR k FROM 1 TO SIZE(SSHISTORY) DO
        valor:=SSHISTORY(k);
        IF valor(1)==5 THEN conservar:=k;
        ELSE
          medida:=SSHistoryAdd({"SIZE",valor,32000-total,0}); IF medida<0 THEN RETURN 0; END;
          total:=total+medida;
        END;
      END;
      IF conservar>0 THEN SSHISTORY(conservar):=siguiente; RETURN 1; END;
      IF SIZE(SSHISTORY)<8 THEN SSHISTORY:=CONCAT(SSHISTORY,{siguiente}); RETURN 1; END;
    THEN RETURN 0; END;
    RETURN 0;
  END; END; END;
  // Comparacion exacta sin STRING: no depende del formato decimal de Home.
  IF TYPE(item)==6 THEN IF SIZE(item)==3 THEN IF item(1)=="EQUAL" THEN
    valor:=item(2); otro:=item(3);
    IF TYPE(valor)<>TYPE(otro) THEN RETURN 0; END;
    IF TYPE(valor)<>6 THEN RETURN valor==otro; END;
    IF SIZE(valor)<>SIZE(otro) THEN RETURN 0; END;
    FOR k FROM 1 TO SIZE(valor) DO
      IF SSHistoryAdd({"EQUAL",valor(k),otro(k)})==0 THEN RETURN 0; END;
    END;
    RETURN 1;
  END; END; END;
  IF TYPE(item)==6 THEN IF SIZE(item)==2 THEN IF item(1)=="MATCH" THEN
    IF TYPE(SSHISTORY)<>6 THEN RETURN 0; END;
    FOR k FROM 1 TO SIZE(SSHISTORY) DO
      IF SSHistoryAdd({"EQUAL",item(2),SSHISTORY(k)}) THEN RETURN 1; END;
    END;
    RETURN 0;
  END; END; END;
  // Consulta interna acotada: contar hojas sin serializar el arbol completo.
  // Listas usan margen para separadores; no es una medicion de RAM libre.
  IF TYPE(item)==6 THEN IF SIZE(item)==4 THEN IF item(1)=="SIZE" THEN
    valor:=item(2); limite:=item(3); profundidad:=item(4);
    IF limite<0 OR profundidad>16 THEN RETURN -1; END;
    IF TYPE(valor)==6 THEN
      IF SIZE(valor)>4096 THEN RETURN -1; END;
      total:=2;
      FOR k FROM 1 TO SIZE(valor) DO
        medida:=SSHistoryAdd({"SIZE",valor(k),limite-total-2,profundidad+1});
        IF medida<0 THEN RETURN -1; END;
        total:=total+medida+2;
        IF total>limite THEN RETURN -1; END;
      END;
    ELSE
      IF TYPE(valor)==2 THEN IF DIM(valor)>limite THEN RETURN -1; END;
      ELSE IF TYPE(valor)<>0 AND TYPE(valor)<>1 AND TYPE(valor)<>3 THEN RETURN -1; END; END;
      total:=DIM(STRING(valor));
    END;
    IF total>limite THEN RETURN -1; END;
    RETURN total;
  END; END; END;
  IFERR
  IF TYPE(SSHISTORY)<>6 THEN SSHISTORY:={}; END;
  // Limite de memoria: 8 entradas y 32000 caracteres serializados.
  total:=SSHistoryAdd({"SIZE",item,16000,0});
  IF total<0 THEN RETURN 0; END;
  IF SIZE(SSHISTORY)>0 THEN
    medida:=SSHistoryAdd({"SIZE",SSHISTORY(1),16000,0});
    IF medida>=0 THEN IF SSHistoryAdd({"EQUAL",SSHISTORY(1),item}) THEN RETURN 1; END; END;
  END;
  serial:="";
  // Recortar ANTES de anteponer: no construir un historial sobredimensionado.
  conservar:=0;
  FOR k FROM 1 TO MIN(7,SIZE(SSHISTORY)) DO
    medida:=SSHistoryAdd({"SIZE",SSHISTORY(k),32000-total,0});
    IF medida<0 THEN BREAK; END;
    total:=total+medida;
    IF total>32000 THEN BREAK; END;
    conservar:=k;
  END;
  // Preparar el nuevo historial completo antes de reemplazar el anterior.
  IF conservar==0 THEN siguiente:={};
  ELSE siguiente:=MAKELIST(SSHISTORY(k),k,1,conservar,1); END;
  siguiente:=CONCAT({item},siguiente);
  SSHISTORY:=siguiente;
  THEN RETURN 0; END;
  RETURN 1;
END;

SSDataSummary(x,x0,dx,nombre)
BEGIN
  RETURN nombre+"\nN="+STRING(SIZE(x))+"\nOrigen="+STRING(x0)+"\nPaso="+STRING(dx)+"\nUltimo punto="+STRING(x0+(SIZE(x)-1)*dx)+"\nLos valores se conservan sin redondear. La vista limpia muestra componentes <=1E-10 como cero: tecla 5 muestra originales. Es una tolerancia visual absoluta, no prueba de cero algebraico. Puede ocultar senales pequenas reales; consulte Original para esas senales. Exportar conserva los datos recibidos. El eje usa las unidades de origen.";
END;

SSUseBuffer()
BEGIN
  LOCAL op;
  IF SIZE(SSDATA)>4096 THEN SSInfoView("Banco SignalLab","Registro demasiado extenso","Use hasta 4096 muestras por operacion. El banco se conserva; no se recortan datos automaticamente.",SSAccent(5)); RETURN {}; END;
  SSInfoView("Reutilizar senal","Compruebe el eje de origen",SSDataSummary(SSDATA,SSDATA_N0,SSDATA_DX,SSDATA_NAME),SSAccent(5));
  op:=SSMenu("Interpretar datos",{"Conservar origen y paso","Solo valores; indice desde cero","Cancelar"},1);
  IF op==0 OR op==3 THEN RETURN {}; END;
  IF op==1 THEN
    SSREAD_META:={1,SSDATA_N0,SSDATA_DX,SSDATA_NAME};
    IF TYPE(SSDATA_EVENTS)==6 THEN SSEVAL_EVENTS:=SSDATA_EVENTS; END;
  ELSE SSREAD_META:={0,0,1,SSDATA_NAME}; SSEVAL_EVENTS:={}; END;
  RETURN SSDATA;
END;

SSReadOrigin(valor)
BEGIN
  IF TYPE(SSREAD_META)==6 AND SIZE(SSREAD_META)==4 THEN
    IF SSREAD_META(1)==1 THEN RETURN SSREAD_META(2); END;
  END;
  RETURN valor;
END;

SSReadStep(valor)
BEGIN
  IF TYPE(SSREAD_META)==6 AND SIZE(SSREAD_META)==4 THEN
    IF SSREAD_META(1)==1 THEN RETURN SSREAD_META(3); END;
  END;
  RETURN valor;
END;

SSRecentExpression(titulo,valor)
BEGIN
  LOCAL k;
  LOCAL item;
  LOCAL pos;
  IF TYPE(SSHISTORY)<>6 THEN RETURN valor; END;
  FOR k FROM 1 TO SIZE(SSHISTORY) DO
    item:=SSHISTORY(k);
    IF item(1)==1 AND item(2)==titulo THEN
      pos:=INSTRING(item(5),"=");
      IF pos>0 THEN RETURN MID(item(5),pos+1); END;
    END;
  END;
  RETURN valor;
END;

EXPORT SysSenales()
BEGIN
  START();
END;

// ---------- Utilidades generales ----------

SSValidList(x)
BEGIN
  IF TYPE(x)==6 AND SIZE(x)>0 THEN RETURN 1; END;
  SSInfoView("SignalLab","Aviso","Ingrese una lista no vacia. Ejemplo: {1,2,3}",SSAccent(1));
  RETURN 0;
END;

SSBufferValid()
BEGIN
  RETURN TYPE(SSDATA)==6 AND SIZE(SSDATA)>0;
END;

SSExportData(x,x0,dx,nombre)
BEGIN
  LOCAL k;
  LOCAL op;
  LOCAL eje;
  LOCAL tabla;
  IF TYPE(x)<>6 OR SIZE(x)==0 THEN SSInfoView("SignalLab","Aviso","No hay datos para exportar.",SSAccent(1)); RETURN 0; END;
  IF SIZE(x)>4096 THEN SSInfoView("Exportar","Lista demasiado extensa","Limite por exportacion: 4096 muestras. No se cambiaron los destinos.",SSAccent(5)); RETURN 0; END;
  op:=SSMenu("Destino de exportacion",{"Banco SignalLab (menos memoria)","Listas Home L0 y L1","Tabla Home M0","Banco + L0 + L1 + M0","Guardar en historial","Cancelar"},1);
  IF op==0 OR op==6 THEN RETURN 0; END;
  // Preparar las estructuras ANTES de tocar destinos. No copiar todo por defecto.
  IFERR
    IF op==2 OR op==4 THEN eje:=MAKELIST(x0+(k-1)*dx,k,1,SIZE(x),1); END;
    IF op==3 OR op==4 THEN
      tabla:=MAKEMAT(0,SIZE(x),2);
      FOR k FROM 1 TO SIZE(x) DO tabla(k,1):=x0+(k-1)*dx; tabla(k,2):=x(k); END;
    END;
  THEN SSInfoView("Exportar","No se pudo preparar el destino","Los destinos se conservan. Pruebe solo Banco SignalLab o reduzca las muestras.",SSAccent(5)); RETURN 0; END;
  IFERR
  IF op==5 THEN
    IF SSHistoryAdd({2,nombre,x,x0,dx,SSEVAL_EVENTS})==0 THEN SSInfoView("Historial","Entrada demasiado grande","No se guardo: limite de 16000 caracteres por entrada. Use el banco o listas Home.",SSAccent(5)); RETURN 0; END;
  ELSE
    IF op==1 OR op==4 THEN SSDATA:=x; SSDATA_N0:=x0; SSDATA_DX:=dx; SSDATA_NAME:=nombre; SSDATA_EVENTS:=SSEVAL_EVENTS; END;
    IF op==2 OR op==4 THEN L0:=x; L1:=eje; END;
    IF op==3 OR op==4 THEN M0:=tabla; END;
  END;
  THEN SSInfoView("Exportacion incompleta","No se confirma la escritura","Revise los destinos: alguno puede haberse actualizado antes del error. Los datos siguen en el resultado. Pruebe exportar a un solo destino.",SSAccent(5)); RETURN 0; END;
  eje:={}; tabla:={};
  SSInfoView("Exportacion completada",nombre,"N="+STRING(SIZE(x))+"\nOrigen="+STRING(x0)+"; paso="+STRING(dx)+".\nSolo se modifico el destino elegido. Datos originales, sin limpieza visual. L0 contiene valores; L1 el eje; M0 las dos columnas cuando se seleccionan.",SSAccent(5));
  RETURN 1;
END;

SSReadList(titulo,etiqueta,ayuda,valor)
BEGIN
  LOCAL txt:=STRING(valor);
  LOCAL out;
  LOCAL fuente:=1;
  SSEVAL_EVENTS:={};
  SSREAD_META:={0,0,1,"Lista manual"};
  IF SSBufferValid() THEN
    fuente:=SSMenu("Fuente de datos",{"Ingresar una lista","Usar banco SignalLab","Usar lista L0 de Home"},fuente);
    IF fuente==0 THEN RETURN {}; END;
    IF fuente==2 THEN RETURN SSUseBuffer(); END;
    IF fuente==3 THEN
      IF TYPE(L0)==6 AND SIZE(L0)>0 THEN RETURN SSUseHomeList(); END;
      SSInfoView("SignalLab","Aviso","La lista L0 esta vacia.\nExporte primero un resultado o cargue L0 desde Home.",SSAccent(1)); RETURN {};
    END;
  ELSE
    fuente:=SSMenu("Fuente de datos",{"Ingresar una lista","Usar lista L0 de Home"},fuente);
    IF fuente==0 THEN RETURN {}; END;
    IF fuente==2 THEN
      IF TYPE(L0)==6 AND SIZE(L0)>0 THEN RETURN SSUseHomeList(); END;
      SSInfoView("SignalLab","Aviso","La lista L0 esta vacia.\nExporte primero un resultado o cargue L0 desde Home.",SSAccent(1)); RETURN {};
    END;
  END;
  IF INPUT(txt,titulo,etiqueta,ayuda,txt,txt)==0 THEN RETURN {}; END;
  IF DIM(txt)>65536 THEN SSInfoView(titulo,"Lista demasiado extensa","Use hasta 65536 caracteres de entrada y 4096 muestras. No se evaluo la expresion.",SSAccent(1)); RETURN {}; END;
  IFERR out:=EXPR(txt); THEN
    SSInfoView(titulo,"Lista no interpretada","Entrada: "+txt+"\nUse llaves y comas: {1,2,3}. Para una expresion utilice el generador de senales. No se modifico el banco guardado.",SSAccent(7));
    RETURN {};
  END;
  IF TYPE(out)==6 AND SIZE(out)>0 THEN
    IF SIZE(out)<=4096 THEN RETURN out; END;
    SSInfoView(titulo,"Demasiadas muestras","Use hasta 4096 valores. El banco no se modifico y no se trunco la entrada.",SSAccent(1)); RETURN {};
  END;
  SSInfoView("SignalLab","Aviso","Ingrese una lista no vacia. Ejemplo: {1,2,3}",SSAccent(1));
  RETURN {};
END;

SSUseHomeList()
BEGIN
  LOCAL k;
  LOCAL paso;
  LOCAL ok:=1;
  LOCAL op;
  IF SIZE(L0)>4096 THEN SSInfoView("Lista Home L0","Registro demasiado extenso","Use hasta 4096 muestras. L0 se conserva sin modificar.",SSAccent(5)); RETURN {}; END;
  // No se presupone que L1 siga correspondiendo a L0.
  IF TYPE(L1)==6 AND SIZE(L1)==SIZE(L0) AND SIZE(L0)>1 THEN
    IFERR
      paso:=L1(2)-L1(1);
      IF IM(paso)<>0 OR paso<=0 THEN ok:=0; END;
      FOR k FROM 1 TO SIZE(L1) DO
        IF ABS(L1(k)-(L1(1)+(k-1)*paso))>1E-8*MAX(1,ABS(L1(k))) THEN ok:=0; END;
      END;
    THEN ok:=0; END;
    IF ok==1 THEN
      op:=SSMenu("Lista L0 de Home",{"Usar valores e indice desde cero","Asociar eje uniforme de L1","Cancelar"},1);
      IF op==0 OR op==3 THEN RETURN {}; END;
      IF op==2 THEN SSREAD_META:={1,L1(1),paso,"L0 con eje L1"}; END;
    END;
  END;
  RETURN L0;
END;

SSReadListDirect(titulo,etiqueta,ayuda,valor)
BEGIN
  LOCAL txt:=STRING(valor);
  LOCAL out;
  SSEVAL_EVENTS:={};
  IF INPUT(txt,titulo,etiqueta,ayuda,txt)==0 THEN RETURN {}; END;
  IF DIM(txt)>65536 THEN SSInfoView(titulo,"Entrada demasiado extensa","Use hasta 65536 caracteres y 4096 muestras. No se evaluo la lista.",SSAccent(1)); RETURN {}; END;
  IFERR out:=EXPR(txt); THEN out:={}; END;
  IF TYPE(out)==6 AND SIZE(out)>0 THEN
    IF SIZE(out)<=4096 THEN RETURN out; END;
    SSInfoView(titulo,"Lista demasiado extensa","Use hasta 4096 muestras. No se trunco la entrada.",SSAccent(1)); RETURN {};
  END;
  SSInfoView("SignalLab","Aviso","Ingrese una lista no vacia. Ejemplo: {1,2,3}",SSAccent(1));
  RETURN {};
END;

SSReadTransfer(titulo,b0,a0)
BEGIN
  LOCAL b;
  LOCAL a;
  LOCAL entradas:={b0,a0};
  LOCAL paso;
  LOCAL k;
  LOCAL txt;
  LOCAL etiqueta;
  LOCAL pol;
  LOCAL pos;
  LOCAL fin;
  LOCAL token;
  LOCAL grado;
  LOCAL coef;
  LOCAL re;
  LOCAL im;
  LOCAL datos;
  LOCAL bien;
  LOCAL axis:="sltransferaxis";
  LOCAL letras:="ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_";
  IF titulo=="Bode de H(s)" OR titulo=="Respuesta lineal H(jw)" THEN
    FOR paso FROM 1 TO 2 DO
      etiqueta:="Numerador="; IF paso==2 THEN etiqueta:="Denominador="; END;
      txt:=STRING(entradas(paso));
      IF INPUT(txt,titulo,etiqueta,"Lista {1,0,0} o polinomio X^2; X o s",txt)==0 THEN RETURN {}; END;
      bien:=1; datos:={};
      IFERR
        IF INSTRING(txt,"{")>0 THEN datos:=EXPR(txt);
        ELSE
          IF SSCASString("eval("+axis+")")<>axis THEN bien:=0;
          ELSE
            pol:=""; pos:=1;
            WHILE pos<=DIM(txt) DO
              token:=MID(txt,pos,1);
              IF INSTRING("ABCDEFGHIJKLMNOPQRSTUVWXYZ_",UPPER(token))>0 THEN
                fin:=pos+1; WHILE fin<=DIM(txt) AND INSTRING(letras,UPPER(MID(txt,fin,1)))>0 DO fin:=fin+1; END;
                token:=MID(txt,pos,fin-pos); pos:=fin;
                IF UPPER(token)=="X" OR UPPER(token)=="S" THEN token:=axis;
                ELSE
                  IF INSTRING("|SQRT|SIN|COS|EXP|LN|ABS|PI|","|"+UPPER(token)+"|")>0 THEN token:=LOWER(token); END;
                  IF UPPER(token)==UPPER(axis) THEN bien:=0; END;
                END;
              ELSE pos:=pos+1; END;
              pol:=pol+token;
            END;
            IF STRING(CAS.simplify(pol))=="0" THEN grado:=0;
            ELSE grado:=CAS.degree(pol,axis)+0.0; END;
            IF TYPE(grado)<>0 THEN bien:=0;
            ELSE IF grado<0 OR grado>32 OR grado<>FLOOR(grado) THEN bien:=0; END; END;
            IF bien THEN
              FOR k FROM grado DOWNTO 0 DO
                coef:=CAS.coeff(pol,axis,k);
                re:=CAS.evalf(CAS.re(coef))+0.0; im:=CAS.evalf(CAS.im(coef))+0.0;
                IF TYPE(re)<>0 OR TYPE(im)<>0 THEN bien:=0;
                ELSE datos:=CONCAT(datos,{re+(0,1)*im}); END;
              END;
            END;
          END;
        END;
      THEN bien:=0; END;
      IF TYPE(datos)<>6 THEN bien:=0;
      ELSE IF SIZE(datos)==0 OR SIZE(datos)>257 THEN bien:=0; END; END;
      IF bien==0 THEN SSInfoView(titulo,"Entrada no interpretada","Use coeficientes numericos {1,0,0} o un polinomio como X^2+2*X+1 (grado <=32). No use parametros sin valor. sltransferaxis debe estar libre; no se borro ninguna variable.",SSAccent(7)); RETURN {}; END;
      entradas(paso):=datos;
    END;
    b:=entradas(1); a:=entradas(2);
  ELSE
  txt:="Coeficientes en orden descendente";
  IF titulo=="Polos/ceros digital" THEN txt:="{b0,b1,...}: z^0,z^-1,...; ej {1,0}"; END;
  b:=SSReadListDirect(titulo,"Numerador b=",txt,b0);
  IF SIZE(b)==0 THEN RETURN {}; END;
  txt:="ENTER continua desde el numerador";
  IF titulo=="Polos/ceros digital" THEN txt:="{a0,a1,...}: z^0,z^-1,...; a0<>0"; END;
  a:=SSReadListDirect(titulo,"Denominador a=",txt,a0);
  IF SIZE(a)==0 THEN RETURN {}; END;
  END;
  FOR paso FROM 1 TO 2 DO
    datos:=b; IF paso==2 THEN datos:=a; END;
    FOR k FROM 1 TO SIZE(datos) DO
      IF TYPE(datos(k))<>0 AND TYPE(datos(k))<>1 AND TYPE(datos(k))<>3 THEN SSInfoView(titulo,"Coeficiente invalido","Todos los coeficientes deben ser numeros reales o complejos finitos.",SSAccent(7)); RETURN {}; END;
      IF SSIsDrawable(datos(k))==0 THEN SSInfoView(titulo,"Coeficiente fuera de rango","No se admiten simbolos pendientes, N/D o infinitos.",SSAccent(7)); RETURN {}; END;
    END;
  END;
  IF a(1)==0 THEN SSInfoView(titulo,"Denominador invalido","El primer coeficiente del denominador no puede ser cero. Quite ceros iniciales; el denominador completo nunca puede ser cero.",SSAccent(7)); RETURN {}; END;
  RETURN {b,a};
END;

SSAt(x,n0,n)
BEGIN
  IF n<n0 OR n>n0+SIZE(x)-1 THEN RETURN 0; END;
  RETURN x(n-n0+1);
END;

SSReverse(x)
BEGIN
  LOCAL n;
  LOCAL len:=SIZE(x);
  LOCAL y:=MAKELIST(0,n,1,SIZE(x),1);
  FOR n FROM 1 TO len DO y(n):=x(len-n+1); END;
  RETURN y;
END;

SSConv(x,h)
BEGIN
  LOCAL nx:=SIZE(x);
  LOCAL nh:=SIZE(h);
  LOCAL n;
  LOCAL k;
  LOCAL j;
  LOCAL s;
  LOCAL bueno;
  LOCAL y;
  IF nx<1 OR nh<1 OR nx+nh-1>4096 THEN SSInfoView("Convolucion","Tamano no admitido","La salida debe tener entre 1 y 4096 muestras. Reduzca las entradas.",SSAccent(2)); RETURN {}; END;
  y:=MAKELIST(0,n,1,nx+nh-1,1);
  SSEVAL_EVENTS:={};
  FOR n FROM 1 TO nx+nh-1 DO
    s:=0; bueno:=1;
    FOR k FROM 1 TO nx DO
      j:=n-k+1;
      IF j>=1 AND j<=nh THEN
        IF SSIsDrawable(x(k)) AND SSIsDrawable(h(j)) THEN
          IFERR s:=s+x(k)*h(j); THEN bueno:=0; END;
        ELSE bueno:=0; END;
      END;
    END;
    IF bueno AND SSIsDrawable(s) THEN y(n):=s; ELSE y(n):=SSUndef(); END;
  END;
  RETURN y;
END;

SSCorr(x,h)
BEGIN
  LOCAL n;
  LOCAL len:=SIZE(h);
  LOCAL hr:=MAKELIST(0,n,1,SIZE(h),1);
  FOR n FROM 1 TO len DO hr(n):=CONJ(h(len-n+1)); END;
  RETURN SSConv(x,hr);
END;

SSAdd(x,nx,h,nh)
BEGIN
  LOCAL n;
  LOCAL n0:=MIN(nx,nh);
  LOCAL n1:=MAX(nx+SIZE(x)-1,nh+SIZE(h)-1);
  LOCAL y;
  IF n1-n0+1>4096 OR n1<n0 THEN SSInfoView("Suma de secuencias","Salida demasiado extensa","Incluyendo los ceros entre origenes, la salida supera 4096 muestras. Acerque los intervalos antes de sumar.",SSAccent(1)); RETURN {}; END;
  y:=MAKELIST(0,n,n0,n1,1);
  FOR n FROM n0 TO n1 DO
    IF SSIsDrawable(SSAt(x,nx,n)) AND SSIsDrawable(SSAt(h,nh,n)) THEN y(n-n0+1):=SSAt(x,nx,n)+SSAt(h,nh,n); ELSE y(n-n0+1):=SSUndef(); END;
  END;
  RETURN {y,n0};
END;

SSEvenOdd(x,nx)
BEGIN
  LOCAL n;
  LOCAL xn;
  LOCAL xmn;
  LOCAL n0:=MIN(nx,-(nx+SIZE(x)-1));
  LOCAL n1:=MAX(nx+SIZE(x)-1,-nx);
  LOCAL par;
  LOCAL impar;
  IF n1-n0+1>4096 THEN SSInfoView("Partes par e impar","Intervalo demasiado extenso","La reflexion requiere mas de 4096 muestras por salida. Reduzca el intervalo o acerque su origen a cero.",SSAccent(1)); RETURN {}; END;
  par:=MAKELIST(0,n,n0,n1,1);
  impar:=MAKELIST(0,n,n0,n1,1);
  FOR n FROM n0 TO n1 DO
    xn:=SSAt(x,nx,n); xmn:=SSAt(x,nx,-n);
    IF SSIsDrawable(xn) AND SSIsDrawable(xmn) THEN
      par(n-n0+1):=(xn+xmn)/2; impar(n-n0+1):=(xn-xmn)/2;
    ELSE par(n-n0+1):=SSUndef(); impar(n-n0+1):=SSUndef(); END;
  END;
  RETURN {par,impar,n0};
END;

SSEnergy(x)
BEGIN
  LOCAL n;
  LOCAL e:=0;
  FOR n FROM 1 TO SIZE(x) DO
    IF x(n)==SSUndef() THEN RETURN SSUndef(); END;
    IF SSIsSpecial(x(n))==0 AND SSIsDrawable(x(n))==0 THEN RETURN SSUndef(); END;
  END;
  FOR n FROM 1 TO SIZE(x) DO
    IF SSIsSpecial(x(n)) THEN RETURN SSPosInf(); END;
    IFERR e:=e+ABS(x(n))^2; THEN RETURN SSUndef(); END;
  END;
  RETURN e;
END;

SSMean(x)
BEGIN
  LOCAL n;
  LOCAL s:=0;
  IF SIZE(x)==0 THEN RETURN SSUndef(); END;
  FOR n FROM 1 TO SIZE(x) DO IF SSIsDrawable(x(n))==0 THEN RETURN SSUndef(); END; s:=s+x(n); END;
  RETURN s/SIZE(x);
END;

SSRMS(x)
BEGIN
  LOCAL e:=SSEnergy(x);
  IF SIZE(x)==0 OR e==SSUndef() THEN RETURN SSUndef(); END;
  IF e==SSPosInf() THEN RETURN SSPosInf(); END;
  RETURN SQRT(e/SIZE(x));
END;

SSPeriod(x)
BEGIN
  LOCAL p;
  LOCAL n;
  LOCAL len:=SIZE(x);
  LOCAL ok;
  FOR n FROM 1 TO len DO IF SSIsDrawable(x(n))==0 THEN RETURN 0; END; END;
  // Un periodo debe aparecer al menos dos veces en la ventana.
  FOR p FROM 1 TO FLOOR(len/2) DO
    ok:=1;
    FOR n FROM 1 TO len-p DO
      IF ABS(x(n+p)-x(n))>1E-10 THEN ok:=0; BREAK; END;
    END;
    IF ok==1 THEN RETURN p; END;
  END;
  RETURN 0;
END;

SSDFT(x)
BEGIN
  LOCAL len:=SIZE(x);
  LOCAL k;
  LOCAL n;
  LOCAL s;
  LOCAL p:=3.141592653589793;
  LOCAL spec;
  LOCAL m:=1;
  LOCAL j;
  LOCAL half;
  LOCAL base;
  LOCAL factor;
  LOCAL odd;
  LOCAL even;
  LOCAL progress:=0;
  IF SIZE(x)==2 THEN IF TYPE(x(1))==6 AND x(2)=="PROGRESS" THEN x:=x(1); len:=SIZE(x); progress:=1; END; END;
  SSEVAL_EVENTS:={};
  IF len<1 OR len>4096 THEN SSInfoView("DFT","Longitud no admitida","Use entre 1 y 4096 muestras. No se modifica ni rellena la entrada automaticamente.",SSAccent(4)); RETURN {}; END;
  FOR n FROM 1 TO len DO IF SSIsDrawable(x(n))==0 THEN RETURN MAKELIST(SSUndef(),k,1,len,1); END; END;
  IF progress THEN IF SSHeader("DFT / FFT",{0,len},"PROGRESS")==0 THEN RETURN {}; END; END;
  WHILE m<len DO m:=2*m; END;
  IF m==len THEN
    // FFT radix-2 in situ; otras longitudes conservan su DFT exacta de N puntos.
    spec:=x; j:=0;
    FOR n FROM 0 TO len-1 DO
      IF n<j THEN s:=spec(n+1); spec(n+1):=spec(j+1); spec(j+1):=s; END;
      m:=len/2;
      WHILE m>=1 AND j>=m DO j:=j-m; m:=m/2; END;
      j:=j+m;
    END;
    m:=2;
    IFERR
      WHILE m<=len DO
        IF progress THEN IF SSHeader("FFT",{LOG(m)/LOG(2)-1,MAX(1,LOG(len)/LOG(2))},"PROGRESS")==0 THEN RETURN {}; END; END;
        half:=m/2;
        FOR k FROM 0 TO half-1 DO
          factor:=EXP((0,-1)*2*p*k/m);
          FOR base FROM 0 TO len-1 STEP m DO
            even:=spec(base+k+1); odd:=factor*spec(base+k+half+1);
            spec(base+k+1):=even+odd; spec(base+k+half+1):=even-odd;
          END;
        END;
        m:=2*m;
      END;
    THEN RETURN MAKELIST(SSUndef(),k,1,len,1); END;
    FOR k FROM 1 TO len DO IF SSIsDrawable(spec(k))==0 THEN spec(k):=SSUndef(); END; END;
    IF progress THEN IF SSHeader("FFT",{len,len},"PROGRESS")==0 THEN RETURN {}; END; END;
    RETURN spec;
  END;
  spec:=MAKELIST(0,k,1,len,1);
  FOR k FROM 0 TO len-1 DO
    IF progress AND k MOD 4==0 THEN IF SSHeader("DFT",{k,len},"PROGRESS")==0 THEN RETURN {}; END; END;
    s:=0;
    FOR n FROM 0 TO len-1 DO
      IFERR s:=s+x(n+1)*EXP((0,-1)*2*p*k*n/len); THEN RETURN MAKELIST(SSUndef(),k,1,len,1); END;
    END;
    IF SSIsDrawable(s) THEN spec(k+1):=s; ELSE spec(k+1):=SSUndef(); END;
  END;
  RETURN spec;
END;

SSShiftSpectrum(x)
BEGIN
  LOCAL N:=SIZE(x);
  LOCAL k;
  LOCAL src;
  LOCAL sh:=N-FLOOR(N/2);
  LOCAL y:=MAKELIST(0,k,1,N,1);
  FOR k FROM 0 TO N-1 DO
    src:=(k+sh) MOD N;
    y(k+1):=x(src+1);
  END;
  RETURN y;
END;

SSDFTAxis0(N)
BEGIN
  RETURN -2*3.141592653589793*FLOOR(N/2)/N;
END;

SSIDFT(spec)
BEGIN
  LOCAL len:=SIZE(spec);
  LOCAL n;
  LOCAL x;
  LOCAL progress:=0;
  IF SIZE(spec)==2 THEN IF TYPE(spec(1))==6 AND spec(2)=="PROGRESS" THEN spec:=spec(1); len:=SIZE(spec); progress:=1; END; END;
  IF len<1 OR len>4096 THEN RETURN {}; END;
  x:=spec;
  FOR n FROM 1 TO len DO
    IF SSIsDrawable(spec(n))==0 THEN RETURN MAKELIST(SSUndef(),n,1,len,1); END;
    x(n):=CONJ(spec(n));
  END;
  IF progress THEN x:=SSDFT({x,"PROGRESS"}); ELSE x:=SSDFT(x); END;
  FOR n FROM 1 TO SIZE(x) DO IF SSIsDrawable(x(n)) THEN x(n):=CONJ(x(n))/len; END; END;
  RETURN x;
END;

SSCleanComplex(x)
BEGIN
  LOCAL n;
  LOCAL re;
  LOCAL im;
  LOCAL tolerance:=1E-10;
  LOCAL visual:=0;
  LOCAL y;
  // El envoltorio {lista,tolerancia} limpia una COPIA visual, nunca el banco.
  IF SIZE(x)==2 THEN
    IF TYPE(x(1))==6 THEN tolerance:=x(2); x:=x(1); visual:=1; END;
  END;
  // Sin descriptor visual, devolver originales. No alterar calculos/exportacion.
  IF visual==0 THEN RETURN x; END;
  y:=x;
  FOR n FROM 1 TO SIZE(x) DO
    IF SSIsDrawable(x(n)) THEN
    re:=RE(x(n)); im:=IM(x(n));
    IF ABS(re)<tolerance OR (visual==1 AND ABS(re)==tolerance) THEN re:=0; END;
    IF ABS(im)<tolerance OR (visual==1 AND ABS(im)==tolerance) THEN im:=0; END;
    IF im==0 THEN y(n):=re; ELSE y(n):=(re,im); END;
    END;
  END;
  RETURN y;
END;

SSMag(x)
BEGIN
  LOCAL n;
  LOCAL y:=MAKELIST(0,n,1,SIZE(x),1);
  FOR n FROM 1 TO SIZE(x) DO
    IF SSIsDrawable(x(n)) THEN y(n):=ABS(x(n));
    ELSE IF x(n)==SSUndef() OR SSIsSpecial(x(n))==0 THEN y(n):=SSUndef(); ELSE y(n):=SSPosInf(); END; END;
  END;
  RETURN y;
END;

SSPhase(x)
BEGIN
  LOCAL salidaModo:="PRINCIPAL";
  LOCAL dw:=1;
  LOCAL anterior;
  LOCAL ajuste:=0;
  LOCAL delta;
  LOCAL unido:=0;
  LOCAL derivada;
  LOCAL izq;
  LOCAL der;
  IF SIZE(x)==3 THEN IF TYPE(x(1))==6 THEN
    salidaModo:=x(2); dw:=x(3); x:=x(1);
  END; END;
  LOCAL n;
  LOCAL y:=MAKELIST(0,n,1,SIZE(x),1);
  LOCAL escala:=0;
  LOCAL re;
  LOCAL im;
  LOCAL z;
  FOR n FROM 1 TO SIZE(x) DO IF SSIsDrawable(x(n)) THEN escala:=MAX(escala,ABS(x(n))); END; END;
  FOR n FROM 1 TO SIZE(x) DO
    y(n):=SSUndef();
    IF SSIsDrawable(x(n)) THEN
      re:=RE(x(n)); im:=IM(x(n));
      IF ABS(re)<=1E-12*escala THEN re:=0; END;
      IF ABS(im)<=1E-12*escala THEN im:=0; END;
      z:=re+(0,1)*im;
      IF ABS(z)>0 THEN IFERR y(n):=IM(LN(z/ABS(z))); THEN y(n):=SSUndef(); END; END;
    END;
  END;
  IF salidaModo=="UNWRAP" OR salidaModo=="DELAY" THEN
    FOR n FROM 1 TO SIZE(y) DO
      IF SSIsDrawable(y(n)) THEN
        IF unido THEN
          delta:=y(n)-anterior;
          IF delta>3.141592653589793 THEN ajuste:=ajuste-2*3.141592653589793; END;
          IF delta< -3.141592653589793 THEN ajuste:=ajuste+2*3.141592653589793; END;
        ELSE ajuste:=0; END;
        anterior:=y(n); y(n):=y(n)+ajuste; unido:=1;
      ELSE unido:=0; END;
    END;
  END;
  IF salidaModo=="DELAY" THEN
    derivada:=MAKELIST(SSUndef(),n,1,SIZE(y),1);
    IF SSIsDrawable(dw)==0 THEN RETURN derivada; END;
    IF IM(dw)<>0 OR dw<=0 THEN RETURN derivada; END;
    FOR n FROM 1 TO SIZE(y) DO
      IF SSIsDrawable(y(n)) THEN
        izq:=n; der:=n;
        IF n>1 THEN IF SSIsDrawable(y(n-1)) THEN izq:=n-1; END; END;
        IF n<SIZE(y) THEN IF SSIsDrawable(y(n+1)) THEN der:=n+1; END; END;
        IF der>izq THEN derivada(n):=-(y(der)-y(izq))/((der-izq)*dw); END;
      END;
    END;
    RETURN derivada;
  END;
  RETURN y;
END;

SSPad(x,N)
BEGIN
  LOCAL idx;
  LOCAL y;
  LOCAL take:=MIN(SIZE(x),N);
  IF N<1 OR N>4096 OR N<>FLOOR(N) THEN RETURN {}; END;
  y:=MAKELIST(0,idx,1,N,1);
  FOR idx FROM 1 TO take DO y(idx):=x(idx); END;
  RETURN y;
END;

SSCircular(x,h)
BEGIN
  LOCAL len:=MAX(SIZE(x),SIZE(h));
  LOCAL xp;
  LOCAL hp;
  LOCAL out;
  LOCAL k;
  LOCAL j;
  LOCAL pos;
  LOCAL progress:=0;
  IF SIZE(x)==2 THEN IF TYPE(x(1))==6 AND x(2)=="PROGRESS" THEN x:=x(1); len:=MAX(SIZE(x),SIZE(h)); progress:=1; END; END;
  IF len<1 OR len>4096 THEN RETURN {}; END;
  FOR k FROM 1 TO SIZE(x) DO IF SSIsDrawable(x(k))==0 THEN RETURN MAKELIST(SSUndef(),j,1,len,1); END; END;
  FOR k FROM 1 TO SIZE(h) DO IF SSIsDrawable(h(k))==0 THEN RETURN MAKELIST(SSUndef(),j,1,len,1); END; END;
  xp:=SSPad(x,len); hp:=SSPad(h,len);
  out:=MAKELIST(0,k,1,len,1);
  IF progress THEN IF SSHeader("Convolucion circular",{0,len},"PROGRESS")==0 THEN RETURN {}; END; END;
  FOR k FROM 0 TO len-1 DO
    IF progress AND k MOD 4==0 THEN IF SSHeader("Convolucion circular",{k,len},"PROGRESS")==0 THEN RETURN {}; END; END;
    FOR j FROM 0 TO len-1 DO
      pos:=(k-j) MOD len; IF pos<0 THEN pos:=pos+len; END;
      out(k+1):=out(k+1)+xp(pos+1)*hp(j+1);
    END;
  END;
  RETURN out;
END;

SSDiffEq(b,a,x)
BEGIN
  LOCAL n;
  LOCAL k;
  LOCAL len:=SIZE(x);
  LOCAL y;
  LOCAL s;
  LOCAL bueno;
  IF len<1 OR len>4096 OR SIZE(a)<1 OR SIZE(b)<1 THEN RETURN {}; END;
  IF a(1)==0 THEN RETURN MAKELIST(SSUndef(),n,1,len,1); END;
  FOR k FROM 1 TO SIZE(a) DO IF SSIsDrawable(a(k))==0 THEN RETURN MAKELIST(SSUndef(),n,1,len,1); END; END;
  FOR k FROM 1 TO SIZE(b) DO IF SSIsDrawable(b(k))==0 THEN RETURN MAKELIST(SSUndef(),n,1,len,1); END; END;
  y:=MAKELIST(SSUndef(),n,1,len,1);
  FOR n FROM 1 TO len DO
    s:=0; bueno:=1;
    IFERR
    FOR k FROM 1 TO SIZE(b) DO
      IF n-k+1>=1 AND b(k)<>0 THEN IF SSIsDrawable(x(n-k+1)) THEN s:=s+b(k)*x(n-k+1); ELSE bueno:=0; END; END;
    END;
    FOR k FROM 2 TO SIZE(a) DO
      IF n-k+1>=1 AND a(k)<>0 THEN IF SSIsDrawable(y(n-k+1)) THEN s:=s-a(k)*y(n-k+1); ELSE bueno:=0; END; END;
    END;
    IF bueno THEN s:=s/a(1); IF SSIsDrawable(s) THEN y(n):=s; END; END;
    THEN y(n):=SSUndef(); END;
  END;
  RETURN y;
END;

SSImpulse(N)
BEGIN
  LOCAL idx;
  LOCAL x;
  IF N<1 OR N>4096 OR N<>FLOOR(N) THEN RETURN {}; END;
  x:=MAKELIST(0,idx,1,N,1); x(1):=1; RETURN x;
END;

SSStep(N)
BEGIN
  LOCAL idx;
  IF N<1 OR N>4096 OR N<>FLOOR(N) THEN RETURN {}; END;
  RETURN MAKELIST(1,idx,1,N,1);
END;

SSDecimate(x,M,fase)
BEGIN
  LOCAL idx;
  LOCAL k:=0;
  LOCAL len;
  LOCAL y:={};
  len:=FLOOR((SIZE(x)-fase-1)/M)+1;
  IF len<1 THEN RETURN {}; END;
  y:=MAKELIST(0,idx,1,len,1);
  FOR idx FROM fase+1 TO SIZE(x) STEP M DO k:=k+1; y(k):=x(idx); END;
  RETURN y;
END;

SSExpand(x,L)
BEGIN
  LOCAL n;
  LOCAL y;
  IF L<1 OR L<>FLOOR(L) OR SIZE(x)<1 OR (SIZE(x)-1)*L+1>4096 THEN RETURN {}; END;
  y:=MAKELIST(0,n,1,(SIZE(x)-1)*L+1,1);
  FOR n FROM 1 TO SIZE(x) DO y((n-1)*L+1):=x(n); END;
  RETURN y;
END;

SSLinearInterp(x,L)
BEGIN
  LOCAL idx;
  LOCAL r;
  LOCAL k;
  LOCAL len:=(SIZE(x)-1)*L+1;
  LOCAL y;
  IF L<1 OR L<>FLOOR(L) OR len<1 OR len>4096 THEN RETURN {}; END;
  y:=MAKELIST(0,idx,1,len,1);
  FOR idx FROM 1 TO SIZE(x)-1 DO
    FOR r FROM 0 TO L-1 DO
      k:=(idx-1)*L+r+1;
      y(k):=x(idx)+(x(idx+1)-x(idx))*r/L;
    END;
  END;
  y(len):=x(SIZE(x));
  RETURN y;
END;

SSZeroOrderHold(x,L)
BEGIN
  LOCAL idx;
  LOCAL y;
  IF L<1 OR L<>FLOOR(L) OR SIZE(x)<1 OR (SIZE(x)-1)*L+1>4096 THEN RETURN {}; END;
  y:=MAKELIST(0,idx,1,(SIZE(x)-1)*L+1,1);
  FOR idx FROM 1 TO SIZE(y) DO
    y(idx):=x(MIN(SIZE(x),FLOOR((idx-1)/L)+1));
  END;
  RETURN y;
END;

SSSincInterp(x,L)
BEGIN
  LOCAL idx;
  LOCAL n;
  LOCAL u;
  LOCAL s;
  LOCAL len:=(SIZE(x)-1)*L+1;
  LOCAL y;
  LOCAL progress:=0;
  IF SIZE(x)==2 THEN IF TYPE(x(1))==6 AND x(2)=="PROGRESS" THEN x:=x(1); len:=(SIZE(x)-1)*L+1; progress:=1; END; END;
  IF L<1 OR L<>FLOOR(L) OR len<1 OR len>4096 THEN RETURN {}; END;
  FOR n FROM 1 TO SIZE(x) DO IF SSIsDrawable(x(n))==0 THEN RETURN MAKELIST(SSUndef(),idx,1,len,1); END; END;
  IF progress THEN IF SSHeader("Interpolacion SINC",{0,len},"PROGRESS")==0 THEN RETURN {}; END; END;
  y:=MAKELIST(0,idx,1,len,1);
  FOR idx FROM 0 TO len-1 DO
    IF progress AND idx MOD 4==0 THEN IF SSHeader("Interpolacion SINC",{idx,len},"PROGRESS")==0 THEN RETURN {}; END; END;
    u:=idx/L; s:=0;
    FOR n FROM 0 TO SIZE(x)-1 DO
      s:=s+x(n+1)*SSSinc(u-n);
    END;
    y(idx+1):=s;
  END;
  RETURN y;
END;

SSDiracApprox(f,sigma)
BEGIN
  LOCAL src:=f;
  LOCAL upper:=UPPER(f);
  LOCAL out:="";
  LOCAL pos:=1;
  LOCAL rel;
  LOCAL ini;
  LOCAL j;
  LOCAL depth;
  LOCAL ch;
  LOCAL arg;
  LOCAL fin;
  LOCAL token;
  LOCAL mirar;
  LOCAL scalarArg;
  LOCAL argPos;
  LOCAL argChar;
  LOCAL argPrev;
  LOCAL argContext;
  LOCAL argStack;
  LOCAL argDepth;
  LOCAL argQuote;
  LOCAL letras:="ABCDEFGHIJKLMNOPQRSTUVWXYZ_";
  LOCAL sig:=STRING(MAX(ABS(sigma),1E-6),1,12,{3,".E-",0});
  // sigma negativo es un modo explicito discreto; nunca inferirlo de dt=1.
  // Heaviside real usa siempre 0/1 local: no delegar cada muestra al CAS.
  // Convencion HP: H(0)=1. Solo cambia la copia numerica de la expresion.
  IF sigma<0 OR INSTRING(upper,"HEAVISIDE")>0 THEN
    WHILE pos<=DIM(src) DO
      ch:=MID(src,pos,1);
      IF INSTRING(letras,UPPER(ch))>0 THEN
        fin:=pos+1;
        WHILE fin<=DIM(src) AND INSTRING(letras+"0123456789",UPPER(MID(src,fin,1)))>0 DO fin:=fin+1; END;
        token:=MID(src,pos,fin-pos); mirar:=fin;
        WHILE mirar<=DIM(src) AND MID(src,mirar,1)==" " DO mirar:=mirar+1; END;
        IF ((sigma<0 AND UPPER(token)=="DIRAC") OR UPPER(token)=="HEAVISIDE") AND MID(src,mirar,1)=="(" THEN
          j:=mirar+1; depth:=1;
          WHILE j<=DIM(src) AND depth>0 DO
            ch:=MID(src,j,1);
            IF ch=="(" THEN depth:=depth+1; END;
            IF ch==")" THEN depth:=depth-1; END;
            j:=j+1;
          END;
          IF depth<>0 THEN SSInfoView("Evaluar expresion","Parentesis incompleto","Revise Dirac(...) o Heaviside(...).",SSAccent(1)); RETURN ""; END;
          arg:=MID(src,mirar+1,j-mirar-2);
          IF UPPER(token)=="HEAVISIDE" THEN
            // Heaviside recibe UN real. X-2,5 no debe pasar a (X-2,5)
            // como par complejo al envolver el argumento en la comparacion.
            // Coma entre digitos: decimal en el argumento escalar/grupos.
            // Las comas de llamadas anidadas, listas y textos se conservan.
            scalarArg:=""; argPos:=1; argDepth:=0; argStack:={}; argQuote:="";
            WHILE argPos<=DIM(arg) DO
              argChar:=MID(arg,argPos,1);
              IF argQuote<>"" THEN
                IF argChar==argQuote THEN argQuote:=""; END;
              ELSE
                IF argChar=="\"" OR argChar=="'" THEN argQuote:=argChar;
                ELSE
                  IF argChar=="(" OR argChar=="[" OR argChar=="{" THEN
                    argContext:=2;
                    IF argChar=="(" THEN
                      argContext:=0; argPrev:=argPos-1;
                      WHILE argPrev>0 AND MID(arg,argPrev,1)==" " DO argPrev:=argPrev-1; END;
                      IF argPrev>0 THEN
                        IF INSTRING(letras+"0123456789)]",UPPER(MID(arg,argPrev,1)))>0 THEN argContext:=1; END;
                      END;
                    END;
                    argDepth:=argDepth+1;
                    IF argDepth>SIZE(argStack) THEN argStack:=CONCAT(argStack,{argContext});
                    ELSE argStack(argDepth):=argContext; END;
                  END;
                  IF argChar=="," THEN
                    argContext:=0; IF argDepth>0 THEN argContext:=argStack(argDepth); END;
                    IF argContext==0 THEN
                      argPrev:=0;
                      IF argPos>1 AND argPos<DIM(arg) THEN
                        IF INSTRING("0123456789",MID(arg,argPos-1,1))>0 AND INSTRING("0123456789",MID(arg,argPos+1,1))>0 THEN argPrev:=1; END;
                      END;
                      IF argPrev==0 THEN SSInfoView("Heaviside","Argumento real ambiguo","Use un solo argumento real. Para decimales: 2.5, 2,5 sin espacios o 5/2. No use una coma para separar dos argumentos.",SSAccent(1)); RETURN ""; END;
                      argChar:=".";
                    END;
                  END;
                  IF argChar==")" OR argChar=="]" OR argChar=="}" THEN argDepth:=MAX(0,argDepth-1); END;
                END;
              END;
              scalarArg:=scalarArg+argChar; argPos:=argPos+1;
            END;
            arg:=scalarArg;
          END;
          arg:=SSDiracApprox(arg,sigma);
          IF arg=="" THEN RETURN ""; END;
          // -2: copia CAS discreta, con valores 0/1 explicitos en cada rama.
          IF sigma==-2 THEN
            IF UPPER(token)=="DIRAC" THEN out:=out+"piecewise(("+arg+")==0,1,0)";
            ELSE out:=out+"piecewise(("+arg+")>=0,1,0)"; END;
          ELSE
            IF UPPER(token)=="DIRAC" THEN out:=out+"(("+arg+")==0)";
            ELSE out:=out+"(("+arg+")>=0)"; END;
          END;
          pos:=j;
        ELSE out:=out+token; pos:=fin; END;
      ELSE out:=out+ch; pos:=pos+1; END;
    END;
    IF sigma<0 THEN RETURN out; END;
    // Continuo: conservar la aproximacion gaussiana de Dirac, no usar delta[n].
    src:=out; upper:=UPPER(src); pos:=1; out:="";
  END;
  WHILE pos<=DIM(src) DO
    rel:=INSTRING(MID(upper,pos),"DIRAC(");
    IF rel==0 THEN out:=out+MID(src,pos); RETURN out; END;
    ini:=pos+rel-1;
    IF ini>pos THEN out:=out+MID(src,pos,ini-pos); END;
    j:=ini+6; depth:=1;
    WHILE j<=DIM(src) AND depth>0 DO
      ch:=MID(src,j,1);
      IF ch=="(" THEN depth:=depth+1; END;
      IF ch==")" THEN depth:=depth-1; END;
      j:=j+1;
    END;
    IF depth<>0 THEN SSInfoView("SignalLab","Aviso","Falta cerrar un parentesis en Dirac(...).",SSAccent(1)); RETURN ""; END;
    arg:=MID(src,ini+6,(j-1)-(ini+6));
    out:=out+"(EXP(-(("+arg+")/("+sig+"))^2)/(("+sig+")*SQRT(3.141592653589793)))";
    pos:=j;
  END;
  RETURN out;
END;

SSPosInf()
BEGIN
  RETURN 8E99;
END;

SSNegInf()
BEGIN
  RETURN -8E99;
END;

SSBothInf()
BEGIN
  RETURN 9E99;
END;

SSUndef()
BEGIN
  RETURN 7.5E99;
END;

SSIsSpecial(v)
BEGIN
  IFERR
    IF v==SSUndef() OR v==SSPosInf() OR v==SSNegInf() OR v==SSBothInf() THEN RETURN 1; END;
  THEN
    RETURN 0;
  END;
  RETURN 0;
END;

SSIsDrawable(v)
BEGIN
  IF TYPE(v)<>0 AND TYPE(v)<>1 AND TYPE(v)<>3 THEN RETURN 0; END;
  IF SSIsSpecial(v) THEN RETURN 0; END;
  IFERR
    IF ABS(RE(v))<1E50 AND ABS(IM(v))<1E50 THEN RETURN 1; END;
  THEN
    RETURN 0;
  END;
  RETURN 0;
END;

SSLimitRead(txt)
BEGIN
  LOCAL u:=UPPER(txt);
  LOCAL v;
  IF txt=="" THEN RETURN {0,0}; END;
  IF INSTRING(u,"-INFINITY")>0 OR INSTRING(u,"-INF")>0 THEN RETURN {-1,0}; END;
  IF INSTRING(u,"INFINITY")>0 OR INSTRING(u,"+INF")>0 THEN RETURN {1,0}; END;
  IFERR v:=EXPR(txt)+0.0; THEN RETURN {0,0}; END;
  IFERR
    IF ABS(IM(v))<1E-9 AND ABS(RE(v))<1E50 THEN RETURN {2,RE(v)}; END;
  THEN
    RETURN {0,0};
  END;
  RETURN {0,0};
END;

SSLimitLabel(code,val)
BEGIN
  IF code==1 THEN RETURN "+INF"; END;
  IF code==(-1) THEN RETURN "-INF"; END;
  IF code==2 THEN RETURN SSFmt(val,8); END;
  RETURN "no representable";
END;

SSEventText(row)
BEGIN
  LOCAL k;
  LOCAL e;
  IF TYPE(SSEVAL_EVENTS)<>6 THEN RETURN ""; END;
  FOR k FROM 1 TO SIZE(SSEVAL_EVENTS) DO
    e:=SSEVAL_EVENTS(k);
    IF e(1)==row THEN
      IF e(7)==1 THEN
        RETURN "Punto no definido; se muestra el limite finito.\nLimite izq="+SSLimitLabel(e(3),e(4))+"\nLimite der="+SSLimitLabel(e(5),e(6));
      END;
      RETURN "Discontinuidad detectada.\nLimite izq="+SSLimitLabel(e(3),e(4))+"\nLimite der="+SSLimitLabel(e(5),e(6));
    END;
  END;
  RETURN "";
END;

SSEventType(row)
BEGIN
  LOCAL k;
  LOCAL e;
  IF TYPE(SSEVAL_EVENTS)<>6 THEN RETURN 0; END;
  FOR k FROM 1 TO SIZE(SSEVAL_EVENTS) DO
    e:=SSEVAL_EVENTS(k); IF e(1)==row THEN RETURN e(7); END;
  END;
  RETURN 0;
END;

SSEvalExpr(f,t0,dt,N)
BEGIN
  LOCAL idx;
  LOCAL ff;
  LOCAL discreta:=0;
  LOCAL normal:="";
  LOCAL pos:=1;
  LOCAL fin;
  LOCAL ch;
  LOCAL token;
  LOCAL key;
  LOCAL letras:="ABCDEFGHIJKLMNOPQRSTUVWXYZ_";
  LOCAL nombres:="|SIN|COS|TAN|ASIN|ACOS|ATAN|SINH|COSH|TANH|EXP|LN|SQRT|ABS|RE|IM|SIGN|FLOOR|CEILING|";
  LOCAL puntoTxt;
  LOCAL evaluada;
  LOCAL realTxt;
  LOCAL imagTxt;
  LOCAL realVal;
  LOCAL imagVal;
  LOCAL val;
  LOCAL punto;
  LOCAL ltxt;
  LOCAL rtxt;
  LOCAL lr;
  LOCAL rr;
  LOCAL lv:=0;
  LOCAL rv:=0;
  LOCAL eps;
  LOCAL nearL;
  LOCAL nearR;
  LOCAL nearOK;
  LOCAL forcedAsym;
  LOCAL eventType;
  LOCAL ok;
  LOCAL y;
  LOCAL homeff;
  LOCAL homeArg;
  LOCAL angleScale;
  LOCAL abertura;
  LOCAL cierre;
  LOCAL nivel;
  IF N<1 OR N>4096 OR N<>FLOOR(N) THEN SSInfoView("Evaluar expresion","Cantidad no valida","Use de 1 a 4096 puntos. No se creo ninguna lista.",SSAccent(1)); RETURN {}; END;
  y:=MAKELIST(0,idx,1,N,1);
  // {expresion,"DISCRETE"} distingue secuencias de muestreo continuo con Ts=1.
  IF TYPE(f)==6 THEN
    IF SIZE(f)<>2 THEN RETURN {}; END;
    discreta:=f(2)=="DISCRETE"; f:=f(1);
  END;
  IF discreta THEN ff:=SSDiracApprox(f,-1); ELSE ff:=SSDiracApprox(f,ABS(dt)); END;
  IF ff=="" THEN RETURN {}; END;
  // Normalizar identificadores completos, nunca reemplazar dentro de nombres.
  // pi y PI son alias de la constante; no dependen de una variable CAS.
  WHILE pos<=DIM(ff) DO
    ch:=MID(ff,pos,1);
    IF ch=="\"" OR ch=="'" THEN
      normal:=normal+ch; pos:=pos+1;
      WHILE pos<=DIM(ff) AND MID(ff,pos,1)<>ch DO
        normal:=normal+MID(ff,pos,1); pos:=pos+1;
      END;
      IF pos<=DIM(ff) THEN normal:=normal+ch; pos:=pos+1; END;
    ELSE
      IF INSTRING(letras,UPPER(ch))>0 THEN
        fin:=pos+1;
        WHILE fin<=DIM(ff) AND INSTRING(letras+"0123456789",UPPER(MID(ff,fin,1)))>0 DO fin:=fin+1; END;
        token:=MID(ff,pos,fin-pos); key:=UPPER(token);
        IF key=="PI" THEN
          IF DIM(normal)>0 THEN
            ch:=RIGHT(normal,1);
            IF INSTRING("0123456789)",ch)>0 THEN normal:=normal+"*"; END;
          END;
          token:="(π)";
        ELSE
          IF key=="X" THEN token:="X"; END;
          IF INSTRING(nombres,"|"+key+"|")>0 THEN
            idx:=fin; WHILE idx<=DIM(ff) AND MID(ff,idx,1)==" " DO idx:=idx+1; END;
            IF idx<=DIM(ff) THEN IF MID(ff,idx,1)=="(" THEN token:=key; END; END;
          END;
        END;
        normal:=normal+token; pos:=fin;
      ELSE
        IF ch=="π" THEN
          IF DIM(normal)>0 THEN
            token:=RIGHT(normal,1);
            IF INSTRING("0123456789)",token)>0 THEN normal:=normal+"*"; END;
          END;
          normal:=normal+"(π)";
        ELSE normal:=normal+ch; END;
        pos:=pos+1;
      END;
    END;
  END;
  ff:=normal;
  // Trigonometria directa via Euler: radianes para argumentos reales/complejos.
  // No cambiar Home/CAS. Las inversas requieren radianes por sus ramas complejas.
  angleScale:=ACOS(0)/(3.141592653589793/2); homeff:=ff;
  IF ABS(angleScale-1)>1E-10 THEN
    IF INSTRING(ff,"ASIN(")>0 OR INSTRING(ff,"ACOS(")>0 OR INSTRING(ff,"ATAN(")>0 THEN
      SSInfoView("Trigonometria inversa","Se requiere modo radianes","ASIN, ACOS y ATAN pueden devolver ramas complejas. Seleccione radianes para estas expresiones y vuelva a calcular. No se cambiaron sus ajustes. SIN, COS y TAN no requieren este cambio.",SSAccent(1)); RETURN {};
    END;
  END;
    // De derecha a izquierda: primero llamadas interiores. Identificadores completos.
    FOR pos FROM DIM(homeff) DOWNTO 1 DO
      token:=MID(homeff,pos,3);
      IF token=="SIN" OR token=="COS" OR token=="TAN" THEN
        ok:=1;
        IF pos>1 THEN IF INSTRING(letras+"0123456789",UPPER(MID(homeff,pos-1,1)))>0 THEN ok:=0; END; END;
        abertura:=pos+DIM(token); WHILE abertura<=DIM(homeff) AND MID(homeff,abertura,1)==" " DO abertura:=abertura+1; END;
        IF ok AND MID(homeff,abertura,1)=="(" THEN
          cierre:=abertura+1; nivel:=1;
          WHILE cierre<=DIM(homeff) AND nivel>0 DO
            ch:=MID(homeff,cierre,1); IF ch=="(" THEN nivel:=nivel+1; END; IF ch==")" THEN nivel:=nivel-1; END;
            cierre:=cierre+1;
          END;
          IF nivel==0 THEN
            homeArg:=MID(homeff,abertura+1,cierre-abertura-2);
            IF token=="SIN" THEN homeArg:="((EXP((0,1)*("+homeArg+"))-EXP((0,-1)*("+homeArg+")))/(0,2))"; END;
            IF token=="COS" THEN homeArg:="((EXP((0,1)*("+homeArg+"))+EXP((0,-1)*("+homeArg+")))/2)"; END;
            IF token=="TAN" THEN homeArg:="((EXP((0,2)*("+homeArg+"))-1)/((0,1)*(EXP((0,2)*("+homeArg+"))+1)))"; END;
            homeff:=LEFT(homeff,pos-1)+homeArg+MID(homeff,cierre);
            IF DIM(homeff)>32768 THEN SSInfoView("Expresion anidada","Limite de evaluacion","La expansion numerica supera 32768 caracteres. Simplifique la expresion; no se sustituyo por un resultado falso.",SSAccent(1)); RETURN {}; END;
          END;
        END;
      END;
    END;
  SSEVAL_EVENTS:={};
  FOR idx FROM 0 TO N-1 DO
    punto:=t0+idx*dt; ok:=1; nearOK:=0; forcedAsym:=0;
    puntoTxt:=STRING(punto,1,12,{3,".E-",0});
    evaluada:=SSReplaceX(ff,"("+puntoTxt+")");
    IFERR
      val:=EXPR(SSReplaceX(homeff,"("+puntoTxt+")"))+0.0;
      IF TYPE(val)<>0 AND TYPE(val)<>3 THEN ok:=0; END;
    THEN
      ok:=0;
    END;
    // Antes de declarar una discontinuidad, intentar evaluacion numerica CAS.
    // Re/Im separados evitan interpretar un complejo serializado segun la region.
    IF ok==0 THEN
      realTxt:=SSCASString("evalf(RE("+evaluada+"))");
      imagTxt:=SSCASString("evalf(IM("+evaluada+"))");
      IF realTxt<>"" AND imagTxt<>"" THEN
        IFERR
          realVal:=EXPR(realTxt)+0.0; imagVal:=EXPR(imagTxt)+0.0;
          IF TYPE(realVal)==0 AND TYPE(imagVal)==0 THEN
            IF SSIsDrawable(realVal) AND SSIsDrawable(imagVal) THEN val:=realVal+(0,1)*imagVal; ok:=1; END;
          END;
        THEN ok:=0; END;
      END;
    END;
    // Algunas funciones, como TAN(pi/2), devuelven un numero enorme
    // en aritmetica finita. Solo en ese caso se inspeccionan ambos lados.
    IF ok==1 THEN
      IFERR
        IF ABS(RE(val))>1E12 AND ABS(IM(val))<1E-9 THEN
          eps:=MAX(1E-7,ABS(dt)*1E-5);
          IFERR
            nearL:=EXPR(SSReplaceX(homeff,"("+STRING(punto-eps,1,12,{3,".E-",0})+")"))+0.0;
            nearR:=EXPR(SSReplaceX(homeff,"("+STRING(punto+eps,1,12,{3,".E-",0})+")"))+0.0;
            nearOK:=1;
            IF TYPE(nearL)<>0 AND TYPE(nearL)<>3 THEN nearOK:=0; END;
            IF TYPE(nearR)<>0 AND TYPE(nearR)<>3 THEN nearOK:=0; END;
          THEN
            nearOK:=0;
          END;
          IF nearOK==1 AND ABS(RE(nearL))>1E6 AND ABS(RE(nearR))>1E6 AND SIGN(RE(nearL))<>SIGN(RE(nearR)) THEN ok:=0; forcedAsym:=1; END;
        END;
      THEN
        ok:=0;
      END;
    END;
    IF ok==0 THEN
      ltxt:=SSCASString("limit("+ff+",X,"+puntoTxt+",-1)");
      rtxt:=SSCASString("limit("+ff+",X,"+puntoTxt+",1)");
      lr:=SSLimitRead(ltxt); rr:=SSLimitRead(rtxt);
      IF forcedAsym==1 THEN lr:={SIGN(RE(nearL)),0}; rr:={SIGN(RE(nearR)),0}; END;
      IF forcedAsym==0 AND (lr(1)==0 OR rr(1)==0) THEN
        eps:=MAX(1E-7,ABS(dt)*1E-5); nearOK:=0;
        IFERR
          nearL:=EXPR(SSReplaceX(homeff,"("+STRING(punto-eps,1,12,{3,".E-",0})+")"))+0.0;
          nearR:=EXPR(SSReplaceX(homeff,"("+STRING(punto+eps,1,12,{3,".E-",0})+")"))+0.0; nearOK:=1;
          IF TYPE(nearL)<>0 AND TYPE(nearL)<>3 THEN nearOK:=0; END;
          IF TYPE(nearR)<>0 AND TYPE(nearR)<>3 THEN nearOK:=0; END;
        THEN nearOK:=0; END;
        IF nearOK==1 THEN
          IF lr(1)==0 AND ABS(RE(nearL))>1E4 THEN lr:={SIGN(RE(nearL)),0}; END;
          IF rr(1)==0 AND ABS(RE(nearR))>1E4 THEN rr:={SIGN(RE(nearR)),0}; END;
        END;
      END;
      lv:=lr(2); rv:=rr(2); eventType:=2;
      IF lr(1)==2 AND rr(1)==2 AND ABS(lv-rv)<=1E-7*(1+ABS(lv)+ABS(rv)) THEN
        val:=(lv+rv)/2; eventType:=1;
      ELSE
        IF lr(1)==1 AND rr(1)==1 THEN val:=SSPosInf(); END;
        IF lr(1)==(-1) AND rr(1)==(-1) THEN val:=SSNegInf(); END;
        IF lr(1)*rr(1)==(-1) THEN val:=SSBothInf(); END;
        IF lr(1)==0 OR rr(1)==0 OR lr(1)==2 OR rr(1)==2 THEN val:=SSUndef(); END;
      END;
      SSEVAL_EVENTS:=CONCAT(SSEVAL_EVENTS,{{idx+1,punto,lr(1),lv,rr(1),rv,eventType}});
    END;
    y(idx+1):=val;
  END;
  RETURN y;
END;

SSCTFT(x,t0,dt,w0,dw,Nw)
BEGIN
  LOCAL k;
  LOCAL n;
  LOCAL w;
  LOCAL t;
  LOCAL sum;
  LOCAL spec;
  LOCAL progress:=0;
  IF SIZE(x)==2 THEN IF TYPE(x(1))==6 AND x(2)=="PROGRESS" THEN x:=x(1); progress:=1; END; END;
  IF Nw<1 OR Nw>4096 OR SIZE(x)>4096 THEN RETURN {}; END;
  FOR n FROM 1 TO SIZE(x) DO IF SSIsDrawable(x(n))==0 THEN RETURN MAKELIST(SSUndef(),k,1,Nw,1); END; END;
  IF progress THEN IF SSHeader("Fourier numerica",{0,Nw},"PROGRESS")==0 THEN RETURN {}; END; END;
  spec:=MAKELIST(0,k,1,Nw,1);
  SSEVAL_EVENTS:={};
  FOR k FROM 0 TO Nw-1 DO
    IF progress AND k MOD 4==0 THEN IF SSHeader("Fourier numerica",{k,Nw},"PROGRESS")==0 THEN RETURN {}; END; END;
    w:=w0+k*dw; sum:=0;
    FOR n FROM 0 TO SIZE(x)-1 DO
      t:=t0+n*dt;
      sum:=sum+x(n+1)*EXP((0,-1)*w*t);
    END;
    IFERR sum:=sum*dt; IF SSIsDrawable(sum) THEN spec(k+1):=sum; ELSE spec(k+1):=SSUndef(); END; THEN spec(k+1):=SSUndef(); END;
  END;
  RETURN spec;
END;

SSICTFT(spec,w0,dw,t0,dt,Nt)
BEGIN
  LOCAL n;
  LOCAL k;
  LOCAL t;
  LOCAL w;
  LOCAL sum;
  LOCAL peso;
  LOCAL out;
  LOCAL progress:=0;
  IF SIZE(spec)==2 THEN IF TYPE(spec(1))==6 AND spec(2)=="PROGRESS" THEN spec:=spec(1); progress:=1; END; END;
  IF Nt<1 OR Nt>4096 OR SIZE(spec)>4096 THEN RETURN {}; END;
  FOR k FROM 1 TO SIZE(spec) DO IF SSIsDrawable(spec(k))==0 THEN RETURN MAKELIST(SSUndef(),n,1,Nt,1); END; END;
  IF progress THEN IF SSHeader("Fourier inversa",{0,Nt},"PROGRESS")==0 THEN RETURN {}; END; END;
  out:=MAKELIST(0,n,1,Nt,1);
  FOR n FROM 0 TO Nt-1 DO
    IF progress AND n MOD 4==0 THEN IF SSHeader("Fourier inversa",{n,Nt},"PROGRESS")==0 THEN RETURN {}; END; END;
    t:=t0+n*dt; sum:=0;
    FOR k FROM 0 TO SIZE(spec)-1 DO
      w:=w0+k*dw;
      // Trapecios sobre la ventana cerrada: no duplicar area en los extremos.
      peso:=1;
      IF k==0 OR k==SIZE(spec)-1 THEN peso:=0.5; END;
      IF SIZE(spec)==1 THEN peso:=0; END;
      sum:=sum+peso*spec(k+1)*EXP((0,1)*w*t);
    END;
    IFERR sum:=sum*dw/(2*3.141592653589793); IF SSIsDrawable(sum) THEN out(n+1):=sum; ELSE out(n+1):=SSUndef(); END; THEN out(n+1):=SSUndef(); END;
  END;
  RETURN out;
END;

SSQuantize(x,bits,xmin,xmax,modo)
BEGIN
  LOCAL n;
  LOCAL L:=2^bits;
  LOCAL q:=(xmax-xmin)/(2^bits-1);
  LOCAL v;
  LOCAL y;
  LOCAL kzero:=0;
  IF modo>2 THEN
    kzero:=MAX(0,MIN(L-1,FLOOR(-xmin/q+0.5)));
    xmin:=-kzero*q; xmax:=(L-1-kzero)*q;
  END;
  y:=MAKELIST(0,n,1,SIZE(x),1);
  FOR n FROM 1 TO SIZE(x) DO
    v:=MAX(xmin,MIN(xmax,x(n)));
    IF modo>2 THEN v:=v/q+kzero; ELSE v:=(v-xmin)/q; END;
    IF modo==1 OR modo==3 THEN v:=ROUND(v,0); ELSE v:=FLOOR(v); END;
    v:=MAX(0,MIN(L-1,v));
    IF modo>2 THEN y(n):=(v-kzero)*q; ELSE y(n):=xmin+v*q; END;
  END;
  RETURN {y,q,L};
END;

SSCosR(x)
BEGIN
  RETURN RE(EXP((0,1)*x));
END;

SSSinR(x)
BEGIN
  RETURN IM(EXP((0,1)*x));
END;

SSSinc(x)
BEGIN
  LOCAL p:=3.141592653589793;
  IF ABS(x)<1E-12 THEN RETURN 1; END;
  IF x==FLOOR(x) THEN RETURN 0; END;
  RETURN SSSinR(p*x)/(p*x);
END;

SSI0(x)
BEGIN
  LOCAL k;
  LOCAL t:=1;
  LOCAL s:=1;
  FOR k FROM 1 TO 64 DO t:=t*(x*x/4)/(k*k); s:=s+t; IF ABS(t)<=1E-15*ABS(s) THEN BREAK; END; END;
  RETURN s;
END;

SSWindow(N,tipo,beta)
BEGIN
  LOCAL idx;
  LOCAL r;
  LOCAL p:=3.141592653589793;
  LOCAL w:=MAKELIST(1,idx,1,N,1);
  IF N==1 THEN RETURN {1}; END;
  FOR idx FROM 0 TO N-1 DO
    r:=idx/(N-1);
    IF tipo==1 THEN w(idx+1):=1; END;
    IF tipo==2 THEN w(idx+1):=0.5-0.5*SSCosR(2*p*r); END;
    IF tipo==3 THEN w(idx+1):=0.54-0.46*SSCosR(2*p*r); END;
    IF tipo==4 THEN w(idx+1):=0.42-0.5*SSCosR(2*p*r)+0.08*SSCosR(4*p*r); END;
    IF tipo==5 THEN w(idx+1):=SSI0(beta*SQRT(MAX(0,1-(2*r-1)^2)))/SSI0(beta); END;
  END;
  RETURN w;
END;

SSFIR(tipo,N,f1,f2,ventana,beta)
BEGIN
  LOCAL idx;
  LOCAL m;
  LOCAL c:=(N-1)/2;
  LOCAL d;
  LOCAL h;
  LOCAL w;
  IF N<3 OR N>101 OR N<>FLOOR(N) THEN RETURN {}; END;
  IF (tipo==2 OR tipo==4) AND N MOD 2==0 THEN RETURN {}; END;
  w:=SSWindow(N,ventana,beta);
  h:=MAKELIST(0,idx,1,N,1);
  FOR idx FROM 0 TO N-1 DO
    m:=idx-c; d:=0;
    IF tipo==1 THEN d:=2*f1*SSSinc(2*f1*m); END;
    IF tipo==2 THEN
      IF ABS(m)<1E-12 THEN d:=1-2*f1; ELSE d:=-2*f1*SSSinc(2*f1*m); END;
    END;
    IF tipo==3 THEN d:=2*f2*SSSinc(2*f2*m)-2*f1*SSSinc(2*f1*m); END;
    IF tipo==4 THEN
      IF ABS(m)<1E-12 THEN d:=1-2*(f2-f1);
      ELSE d:=2*f1*SSSinc(2*f1*m)-2*f2*SSSinc(2*f2*m); END;
    END;
    h(idx+1):=d*w(idx+1);
  END;
  RETURN h;
END;

SSBiquad(tipo,f0,Q)
BEGIN
  LOCAL w:=2*3.141592653589793*f0;
  LOCAL c;
  LOCAL s;
  LOCAL al;
  LOCAL b;
  LOCAL a;
  c:=SSCosR(w); s:=SSSinR(w); al:=s/(2*Q);
  a:={1+al,-2*c,1-al}; b:={0,0,0};
  IF tipo==1 THEN b:={(1-c)/2,1-c,(1-c)/2}; END;
  IF tipo==2 THEN b:={(1+c)/2,-(1+c),(1+c)/2}; END;
  IF tipo==3 THEN b:={s/2,0,-s/2}; END;
  IF tipo==4 THEN b:={1,-2*c,1}; END;
  RETURN {{b(1)/a(1),b(2)/a(1),b(3)/a(1)},{1,a(2)/a(1),a(3)/a(1)}};
END;

SSFResponse(b,a,N)
BEGIN
  LOCAL k;
  LOCAL idx;
  LOCAL w;
  LOCAL z;
  LOCAL num;
  LOCAL den;
  LOCAL pirad:=3.141592653589793;
  LOCAL w0:=-pirad;
  LOCAL dw;
  LOCAL dominio:=2;
  LOCAL meta;
  LOCAL texto;
  LOCAL realtxt;
  LOCAL imagtxt;
  LOCAL rv;
  LOCAL iv;
  LOCAL H;
  LOCAL bb;
  LOCAL aa;
  LOCAL orden;
  LOCAL valido:=1;
  IF TYPE(N)==6 THEN meta:=N; N:=meta(1); w0:=meta(2); dw:=meta(3); dominio:=meta(4);
  ELSE dw:=2*pirad/(N-1); END;
  H:=MAKELIST(SSUndef(),k,1,N,1);
  IF dominio<=3 THEN
    IF TYPE(b)<>6 OR TYPE(a)<>6 THEN RETURN H; END;
    IF SIZE(b)==0 OR SIZE(a)==0 THEN RETURN H; END;
    FOR idx FROM 1 TO SIZE(b) DO IF SSIsDrawable(b(idx))==0 THEN valido:=0; END; END;
    den:=0;
    FOR idx FROM 1 TO SIZE(a) DO
      IF SSIsDrawable(a(idx))==0 THEN valido:=0; END;
      IF a(idx)<>0 THEN den:=1; END;
    END;
    IF valido==0 OR den==0 THEN RETURN H; END;
  END;
  FOR k FROM 0 TO N-1 DO
    w:=w0+dw*k;
    IF dominio==4 THEN IF k==32*FLOOR(k/32) THEN SSHeader("Respuesta simbolica","Evaluando "+STRING(k+1)+" de "+STRING(N),SSAccent(3)); END; END;
    IFERR
      IF dominio==3 THEN w:=10^w; END;
      IF dominio==4 OR dominio==5 THEN
        IF dominio==4 THEN z:=a*EXP((0,1)*w); ELSE z:=a(2)*EXP((0,1)*w); END;
        IF w==0 THEN IF dominio==4 THEN z:=a; ELSE z:=a(2); END; END;
        IF ABS(w)==pirad THEN IF dominio==4 THEN z:=-a; ELSE z:=-a(2); END; END;
        IF dominio==5 THEN
          num:=0;
          FOR idx FROM 1 TO SIZE(b) DO IF b(idx)<>0 THEN num:=num+b(idx)*z^(-(a(1)+idx-1)); END; END;
          H(k+1):=num;
        ELSE
          texto:="subst(("+b+"),z=("+STRING(RE(z),1,12,{3,".E-",0})+"+("+STRING(IM(z),1,12,{3,".E-",0})+")*i))";
          realtxt:=SSCASString("evalf(RE("+texto+"))"); imagtxt:=SSCASString("evalf(IM("+texto+"))");
          rv:=EXPR(realtxt)+0.0; iv:=EXPR(imagtxt)+0.0;
          IF TYPE(rv)==0 AND TYPE(iv)==0 THEN IF SSIsDrawable(rv) AND SSIsDrawable(iv) THEN H(k+1):=rv+(0,1)*iv; END; END;
        END;
      ELSE
        IF dominio==2 THEN
          z:=EXP((0,-1)*w); num:=0; den:=0;
          FOR idx FROM SIZE(b) DOWNTO 1 DO num:=num*z+b(idx); END;
          FOR idx FROM SIZE(a) DOWNTO 1 DO den:=den*z+a(idx); END;
        ELSE
          z:=(0,1)*w; num:=SSPolyEval(b,z); den:=SSPolyEval(a,z);
        END;
        // Solo 0/0 exacto: limite por derivadas hasta agotar el grado.
        // No cancelar polos cercanos mediante una tolerancia arbitraria.
        IF den==0 AND num==0 THEN
          bb:=b; aa:=a;
          FOR orden FROM 1 TO MAX(SIZE(b),SIZE(a))-1 DO
            IF dominio==2 THEN
              IF SIZE(bb)>1 THEN bb:=MAKELIST(idx*bb(idx+1),idx,1,SIZE(bb)-1,1); ELSE bb:={0}; END;
              IF SIZE(aa)>1 THEN aa:=MAKELIST(idx*aa(idx+1),idx,1,SIZE(aa)-1,1); ELSE aa:={0}; END;
              num:=0; den:=0;
              FOR idx FROM SIZE(bb) DOWNTO 1 DO num:=num*z+bb(idx); END;
              FOR idx FROM SIZE(aa) DOWNTO 1 DO den:=den*z+aa(idx); END;
            ELSE
              IF SIZE(bb)>1 THEN bb:=MAKELIST((SIZE(bb)-idx)*bb(idx),idx,1,SIZE(bb)-1,1); ELSE bb:={0}; END;
              IF SIZE(aa)>1 THEN aa:=MAKELIST((SIZE(aa)-idx)*aa(idx),idx,1,SIZE(aa)-1,1); ELSE aa:={0}; END;
              num:=SSPolyEval(bb,z); den:=SSPolyEval(aa,z);
            END;
            IF den<>0 OR num<>0 THEN BREAK; END;
          END;
        END;
        IF den<>0 THEN H(k+1):=num/den; END;
      END;
      IF SSIsDrawable(H(k+1))==0 THEN H(k+1):=SSUndef(); END;
    THEN H(k+1):=SSUndef(); END;
  END;
  RETURN H;
END;

SSAnalogResponse(b,a,w0,dw,N)
BEGIN
  RETURN SSFResponse(b,a,{N,w0,dw,1});
END;

SSPolyText(c,var)
BEGIN
  LOCAL k;
  LOCAL p;
  LOCAL out:="";
  LOCAL term;
  LOCAL realText;
  LOCAL imagText;
  FOR k FROM 1 TO SIZE(c) DO
    p:=SIZE(c)-k;
    IF SSIsDrawable(c(k))==0 THEN RETURN "undef"; END;
    IF c(k)<>0 THEN
      // Texto para CAS, no formato regional de tablas. (8,5) seria complejo.
      realText:=STRING(RE(c(k)),1,12,{3,".E-",0});
      term:="("+realText+")";
      IF IM(c(k))<>0 THEN
        imagText:=STRING(IM(c(k)),1,12,{3,".E-",0});
        term:="("+realText+"+("+imagText+")*i)";
      END;
      IF p==1 THEN term:=term+"*"+var; END;
      IF p>1 THEN term:=term+"*"+var+"^"+STRING(p); END;
      IF out<>"" THEN out:=out+" + "; END;
      out:=out+term;
    END;
  END;
  IF out=="" THEN out:="0"; END;
  RETURN out;
END;

SSDigitalPolyText(c)
BEGIN
  LOCAL k;
  LOCAL p;
  LOCAL out:="";
  LOCAL term;
  LOCAL realText;
  LOCAL imagText;
  FOR k FROM 1 TO SIZE(c) DO
    p:=k-1;
    IF SSIsDrawable(c(k))==0 THEN RETURN "undef"; END;
    IF c(k)<>0 THEN
      realText:=STRING(RE(c(k)),1,12,{3,".E-",0});
      term:="("+realText+")";
      IF IM(c(k))<>0 THEN
        imagText:=STRING(IM(c(k)),1,12,{3,".E-",0});
        term:="("+realText+"+("+imagText+")*i)";
      END;
      IF p==1 THEN term:=term+"*z^(-1)"; END;
      IF p>1 THEN term:=term+"*z^(-"+STRING(p)+")"; END;
      IF out<>"" THEN out:=out+" + "; END;
      out:=out+term;
    END;
  END;
  IF out=="" THEN out:="0"; END;
  RETURN out;
END;

SSTransferText(b,a,dominio)
BEGIN
  IF dominio==1 THEN RETURN "H(s)=("+SSPolyText(b,"s")+")/("+SSPolyText(a,"s")+")"; END;
  RETURN "H(z)=("+SSDigitalPolyText(b)+")/("+SSDigitalPolyText(a)+")";
END;

SSFilterType(tipo)
BEGIN
  IF tipo==1 THEN RETURN "Pasa bajos"; END;
  IF tipo==2 THEN RETURN "Pasa altos"; END;
  IF tipo==3 THEN RETURN "Pasa banda"; END;
  RETURN "Rechaza banda / notch";
END;

SSPolyAdd(a,b,ka,kb)
BEGIN
  LOCAL N:=MAX(SIZE(a),SIZE(b));
  LOCAL i;
  LOCAL aa:=SSPad(a,N);
  LOCAL bb:=SSPad(b,N);
  LOCAL c;
  // Alineacion de coeficientes en potencias descendentes.
  IF SIZE(a)<N THEN aa:=CONCAT(MAKELIST(0,i,1,N-SIZE(a),1),a); END;
  IF SIZE(b)<N THEN bb:=CONCAT(MAKELIST(0,i,1,N-SIZE(b),1),b); END;
  c:=MAKELIST(0,i,1,N,1);
  FOR i FROM 1 TO N DO c(i):=ka*aa(i)+kb*bb(i); END;
  RETURN c;
END;

SSPolyRoots(c)
BEGIN
  LOCAL v:=c;
  LOCAL r:={};
  LOCAL k;
  LOCAL escala:=0;
  LOCAL valor;
  LOCAL norma;
  IF SIZE(v)<=1 THEN RETURN {}; END;
  WHILE SIZE(v)>1 AND v(1)==0 DO v:=MAKELIST(v(k),k,2,SIZE(v),1); END;
  IF SIZE(v)<=1 THEN RETURN {}; END;
  IF SIZE(v)>33 THEN RETURN {}; END;
  FOR k FROM 1 TO SIZE(v) DO
    IF SSIsDrawable(v(k))==0 THEN RETURN {}; END;
    escala:=MAX(escala,ABS(v(k)));
  END;
  IF escala==0 THEN RETURN {}; END;
  v:=v/escala;
  IFERR r:=POLYROOT(list2mat(v,SIZE(v))); THEN r:={}; END;
  IF SIZE(r)<>SIZE(v)-1 THEN RETURN {}; END;
  FOR k FROM 1 TO SIZE(r) DO
    IF SSIsDrawable(r(k))==0 THEN RETURN {}; END;
    IFERR
      valor:=ABS(SSPolyEval(v,r(k))); norma:=SSPolyEval(SSMag(v),ABS(r(k)));
      IF valor>1E-7*MAX(1E-100,norma) THEN RETURN {}; END;
    THEN RETURN {}; END;
  END;
  RETURN r;
END;

SSStable(a,dominio)
BEGIN
  LOCAL v:=a;
  LOCAL r;
  LOCAL k;
  LOCAL cerca:=0;
  IF SIZE(v)==0 THEN RETURN -1; END;
  WHILE SIZE(v)>1 AND v(1)==0 DO v:=MAKELIST(v(k),k,2,SIZE(v),1); END;
  IF SIZE(v)==1 THEN IF SSIsDrawable(v(1)) AND v(1)<>0 THEN RETURN 1; ELSE RETURN -1; END; END;
  r:=SSPolyRoots(v);
  IF SIZE(r)<>SIZE(v)-1 THEN RETURN -1; END;
  FOR k FROM 1 TO SIZE(r) DO
    IF dominio==1 THEN
      IF RE(r(k))>1E-9*MAX(1,ABS(r(k))) THEN RETURN 0; END;
      IF ABS(RE(r(k)))<=1E-9*MAX(1,ABS(r(k))) THEN cerca:=1; END;
    ELSE
      IF ABS(r(k))>1+1E-9 THEN RETURN 0; END;
      IF ABS(ABS(r(k))-1)<=1E-9 THEN cerca:=1; END;
    END;
  END;
  IF cerca THEN RETURN -1; END;
  RETURN 1;
END;

SSShow(x,n0,titulo)
BEGIN
  LOCAL op:=1;
  LOCAL paso:=1;
  LOCAL formula:="";
  LOCAL meta;
  IF TYPE(titulo)==6 THEN meta:=titulo; titulo:=meta(1); paso:=meta(2); IF SIZE(meta)>=3 THEN formula:=meta(3); END; END;
  IF SIZE(x)==0 THEN SSInfoView(titulo,"Sin resultado","No se construyo una salida. Revise los limites y los datos de entrada.",SSAccent(1)); RETURN 0; END;
  REPEAT
    op:=SSMenu({titulo,{3,titulo,{{"Salida",x,n0,paso},{"Formula",formula}},"Datos originales y eje. Formula vacia: salida definida por sus muestras."},6},{"Tabla de valores","Grafico de la senal","Formula / representacion","Datos y eje del resultado","Exportar resultado","Volver"},op);
    IF op==0 OR op==6 THEN RETURN 1; END;
    IF op==1 THEN SSDataView(x,n0,paso,titulo,"eje","valor",SSAccent(1)); END;
    IF op==2 THEN SSPlotDiscrete(x,n0,paso,titulo,"eje original"); END;
    IF op==3 THEN
      IF formula<>"" THEN SSFormulaView(titulo,"Modelo aplicado",formula,SSAccent(1));
      ELSE
        IF SIZE(x)<=128 AND paso==1 THEN SSFormulaView(titulo,"Secuencia finita",SSSeqMath(x,n0,"y"),SSAccent(1));
        ELSE SSInfoView(titulo,"Representacion por muestras","y[eje inicial + k*paso] = tabla(k+1), k=0...N-1.\n\n"+SSDataSummary(x,n0,paso,titulo),SSAccent(1)); END;
      END;
    END;
    IF op==4 THEN SSInfoView(titulo,"Valores originales conservados",SSDataSummary(x,n0,paso,titulo),SSAccent(1)); END;
    IF op==5 THEN SSExportData(x,n0,paso,titulo); END;
  UNTIL 0;
END;

SSAccent(idx)
BEGIN
  IF idx==1 THEN RETURN RGB(28,132,255); END;
  IF idx==2 THEN RETURN RGB(0,184,148); END;
  IF idx==3 THEN RETURN RGB(139,92,246); END;
  IF idx==4 THEN RETURN RGB(236,72,153); END;
  IF idx==5 THEN RETURN RGB(245,158,11); END;
  IF idx==6 THEN RETURN RGB(20,184,166); END;
  IF idx==7 THEN RETURN RGB(239,68,68); END;
  RETURN RGB(100,116,139);
END;

SSHeader(titulo,subtitulo,color)
BEGIN
  LOCAL key;
  LOCAL contacts;
  LOCAL point;
  LOCAL j;
  LOCAL cancelar:=0;
  LOCAL porcentaje;
  // Modo cooperativo optativo: {terminados,total}, sin espera entre bloques.
  IF TYPE(color)==2 THEN IF color=="PROGRESS" THEN
    porcentaje:=MAX(0,MIN(100,FLOOR(100*subtitulo(1)/MAX(1,subtitulo(2)))));
    IF subtitulo(1)==0 THEN
      j:=SSHistoryAdd({"DIAG",titulo,subtitulo,"Calculo iniciado; el estado no prueba un fallo si hubo reinicio."});
      SSHeader(titulo,"Calculo numerico; entrada conservada",SSAccent(4));
      TEXTOUT_P("ESC o Cancelar vuelve sin salida parcial",16,158,1,RGB(51,65,85),290);
      RECT_P(216,216,319,239,RGB(15,23,42),RGB(15,23,42));
      TEXTOUT_P("Cancelar",240,222,1,RGB(255,255,255));
    END;
    RECT_P(16,82,303,132,RGB(245,247,251),RGB(245,247,251));
    TEXTOUT_P(STRING(porcentaje)+" %",130,86,2,RGB(30,41,59));
    RECT_P(20,112,299,124,RGB(203,213,225),RGB(255,255,255));
    IF porcentaje>0 THEN RECT_P(21,113,21+FLOOR(277*porcentaje/100),123,SSAccent(4),SSAccent(4)); END;
    key:=GETKEY; IF key==4 OR ISKEYDOWN(4) THEN cancelar:=1; END;
    contacts:={{},{}}; IFERR contacts:=MOUSE; THEN contacts:={{},{}}; END;
    IF TYPE(contacts)==6 THEN IF SIZE(contacts)>=2 THEN
      point:=contacts(1);
      IF SIZE(point)>=5 AND SIZE(contacts(2))==0 THEN
        FOR j FROM 1 TO 5 DO IF TYPE(point(j))==1 THEN point(j):=B→R(point(j)); END; END;
        IF point(5)==0 OR point(5)==1 OR point(5)==2 OR point(5)==5 THEN
          IF point(1)>=216 AND point(1)<=319 AND point(2)>=216 AND point(2)<=239 AND point(3)>=216 AND point(3)<=319 AND point(4)>=216 AND point(4)<=239 THEN cancelar:=1; END;
        END;
      END;
    END; END;
    IF cancelar THEN
      j:=SSHistoryAdd({"DIAG",titulo,subtitulo,"Cancelado por el usuario; no se entrega salida parcial."});
      WHILE ISKEYDOWN(4) DO key:=GETKEY; END;
      REPEAT
        contacts:={{},{}}; IFERR contacts:=MOUSE; THEN contacts:={{},{}}; END;
        key:=GETKEY;
      UNTIL SIZE(contacts(1))==0 AND SIZE(contacts(2))==0;
      RETURN 0;
    END;
    RETURN 1;
  END; END;
  RECT_P(0,0,319,239,RGB(245,247,251),RGB(245,247,251));
  RECT_P(0,0,319,39,RGB(15,23,42),RGB(15,23,42));
  RECT_P(0,0,4,39,color,color);
  RECT_P(0,40,319,41,color,color);
  IF DIM(titulo)>43 THEN titulo:=LEFT(titulo,40)+"..."; END;
  IF DIM(titulo)>28 THEN TEXTOUT_P(titulo,10,5,1,RGB(255,255,255)); ELSE TEXTOUT_P(titulo,10,4,2,RGB(255,255,255)); END;
  IF DIM(subtitulo)>49 THEN subtitulo:=LEFT(subtitulo,46)+"..."; END;
  TEXTOUT_P(subtitulo,11,25,1,RGB(225,235,248));
END;

SSFooter(izq,der)
BEGIN
  LOCAL j;
  LOCAL n;
  LOCAL a;
  LOCAL b;
  RECT_P(0,216,319,239,RGB(15,23,42),RGB(15,23,42));
  IF TYPE(izq)==6 THEN
    n:=SIZE(izq);
    FOR j FROM 1 TO n DO
      a:=CEILING(320*(j-1)/n); b:=CEILING(320*j/n)-1;
      RECT_P(a+1,218,b-1,237,RGB(100,116,139),RGB(30,41,59));
      TEXTOUT_P(izq(j),a+3,223,1,RGB(255,255,255),b-a-4);
    END;
    RETURN 1;
  END;
  TEXTOUT_P(izq,9,222,1,RGB(226,232,240));
  TEXTOUT_P(der,235,222,1,RGB(125,211,252));
END;

SSPause()
BEGIN
  LOCAL key:=-1;
  LOCAL pending:=-1;
  LOCAL held;
  LOCAL contacts;
  LOCAL point;
  LOCAL j;
  LOCAL active:=0;
  LOCAL blocked:=0;
  LOCAL sx:=0;
  LOCAL sy:=0;
  LOCAL ex:=0;
  LOCAL ey:=0;
  LOCAL moved:=0;
  LOCAL kind;
  // No usar WAIT positivo: ESC debe ser un evento, no interrumpir la app.
  // Los eventos propios ya se entregan soltados. Solo consumir el ENTER/ESC
  // heredado de un INPUT nativo; no recorrer las 51 teclas antes de cada toque.
  WHILE ISKEYDOWN(30) OR ISKEYDOWN(4) DO pending:=GETKEY; END;
  REPEAT pending:=GETKEY; UNTIL pending==-1;
  REPEAT
    key:=GETKEY;
    IF key==-1 THEN
      contacts:={{},{}};
      IFERR contacts:=MOUSE; THEN contacts:={{},{}}; END;
      IF TYPE(contacts)==6 THEN
      IF SIZE(contacts)>=2 THEN
        point:=contacts(1);
        IF SIZE(contacts(2))>0 THEN blocked:=1; active:=0; END;
        IF SIZE(point)==0 AND SIZE(contacts(2))==0 THEN
          IF active==1 AND blocked==0 THEN RETURN {sx,sy,ex,ey,moved}; END;
          active:=0; blocked:=0;
        ELSE
          IF SIZE(point)>=5 THEN
            FOR j FROM 1 TO 5 DO
              IF TYPE(point(j))==1 THEN point(j):=B→R(point(j)); END;
            END;
            kind:=point(5);
            IF kind==3 OR kind==4 THEN blocked:=1; active:=0; END;
            IF point(1)<0 OR point(1)>319 OR point(2)<0 OR point(2)>239 THEN blocked:=1; active:=0; END;
            // MOUSE es una instantanea, no una cola de eventos: un gesto rapido
            // puede llegar ya arrastrado/completado, sin observar nunca tipo 0.
            IF blocked==0 THEN
              IF (kind==0 OR kind==1 OR kind==2 OR kind==5) AND active==0 THEN
                sx:=point(3); sy:=point(4); ex:=point(1); ey:=point(2); moved:=0;
                IF sx>=0 AND sx<=319 AND sy>=0 AND sy<=239 THEN active:=1;
                ELSE blocked:=1; END;
              END;
              IF active==1 THEN
                ex:=point(1); ey:=point(2);
                IF ABS(ex-sx)>8 OR ABS(ey-sy)>8 THEN moved:=1; END;
                // Consumir hasta quedar sin contactos: una accion por toque.
              END;
            END;
          END;
        END;
      END;
      END;
    END;
  UNTIL key<>-1;
  // Una pulsacion no debe propagarse al menu anterior al cerrar el visor.
  WHILE ISKEYDOWN(key) DO pending:=GETKEY; END;
  REPEAT pending:=GETKEY; UNTIL pending==-1;
  // Una tecla usada con un dedo apoyado consume tambien ese contacto.
  REPEAT
    held:=0; contacts:={{},{}};
    IFERR contacts:=MOUSE; THEN contacts:={{},{}}; END;
    IF TYPE(contacts)==6 THEN
      FOR j FROM 1 TO MIN(2,SIZE(contacts)) DO
        point:=contacts(j);
        IF SIZE(point)>=5 THEN
          kind:=point(5); IF TYPE(kind)==1 THEN kind:=B→R(kind); END;
          held:=1;
        END;
      END;
    END;
    pending:=GETKEY;
  UNTIL held==0;
  RETURN key;
END;

SSFmt(v,d)
BEGIN
  LOCAL re:=RE(v);
  LOCAL im:=IM(v);
  LOCAL txt;
  LOCAL parts:={"",""};
  LOCAL values:={re,im};
  LOCAL j;
  LOCAL value;
  LOCAL exponent;
  LOCAL mantissa;
  LOCAL tolerance:=0;
  IF TYPE(d)==6 THEN tolerance:=d(2); d:=d(1); END;
  IF re>8.5E99 THEN RETURN "+/-INF"; END;
  IF re>7.75E99 THEN RETURN "+INF"; END;
  IF re<(-7.75E99) THEN RETURN "-INF"; END;
  IF ABS(re)>=7E99 THEN RETURN "N/D"; END;
  IF ABS(re)<=tolerance THEN re:=0; END;
  IF ABS(im)<=tolerance THEN im:=0; END;
  values:={re,im};
  // El umbral solo se usa cuando el llamador pide presentacion limpia.
  FOR j FROM 1 TO 2 DO
    value:=values(j);
    IF value<>0 AND (ABS(value)<10^(-d) OR ABS(value)>=1E6) THEN
      exponent:=FLOOR(LOG(ABS(value)));
      mantissa:=ROUND(value/10^exponent,MIN(5,MAX(1,d)));
      IF ABS(mantissa)>=10 THEN mantissa:=mantissa/10; exponent:=exponent+1; END;
      parts(j):=STRING(mantissa)+"E"+STRING(exponent);
    ELSE parts(j):=STRING(ROUND(value,d)); END;
  END;
  IF im==0 THEN RETURN parts(1); END;
  txt:=parts(1); IF im>0 THEN txt:=txt+"+"; END;
  RETURN txt+parts(2)+"i";
END;

SSReplaceX(src,repl)
BEGIN
  LOCAL out:="";
  LOCAL pos;
  LOCAL ch;
  LOCAL prev;
  LOCAL next;
  LOCAL chars:="ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_";
  LOCAL standalone;
  FOR pos FROM 1 TO DIM(src) DO
    ch:=MID(src,pos,1); standalone:=0;
    IF UPPER(ch)=="X" THEN
      IF pos==1 THEN prev:=""; ELSE prev:=MID(src,pos-1,1); END;
      IF pos==DIM(src) THEN next:=""; ELSE next:=MID(src,pos+1,1); END;
      IF (prev=="" OR INSTRING(chars,UPPER(prev))==0) AND (next=="" OR INSTRING(chars,UPPER(next))==0) THEN standalone:=1; END;
    END;
    IF standalone THEN out:=out+repl; ELSE out:=out+ch; END;
  END;
  RETURN out;
END;

SSOnlySigns(src)
BEGIN
  LOCAL k;
  LOCAL ch;
  FOR k FROM 1 TO DIM(src) DO
    ch:=MID(src,k,1);
    IF ch<>" " AND ch<>"+" AND ch<>"-" THEN RETURN 0; END;
  END;
  RETURN 1;
END;

SSDiracShift(signal,impulse)
BEGIN
  LOCAL src:=impulse;
  LOCAL upper:=UPPER(impulse);
  LOCAL pos:=1;
  LOCAL rel;
  LOCAL ini;
  LOCAL j;
  LOCAL k;
  LOCAL depth;
  LOCAL ch;
  LOCAL arg;
  LOCAL remain:="";
  LOCAL out:="";
  LOCAL axis:="sldiracaxis";
  LOCAL pol;
  LOCAL grado;
  LOCAL ac;
  LOCAL bc;
  LOCAL b;
  LOCAL a;
  LOCAL root;
  LOCAL coef;
  LOCAL sign;
  LOCAL shift;
  LOCAL term;
  LOCAL count:=0;
  WHILE pos<=DIM(src) DO
    rel:=INSTRING(MID(upper,pos),"DIRAC(");
    IF rel==0 THEN remain:=remain+MID(src,pos); BREAK; END;
    ini:=pos+rel-1;
    IF ini>pos THEN remain:=remain+MID(src,pos,ini-pos); END;
    sign:=1; k:=DIM(remain);
    WHILE k>=1 DO
      ch:=MID(remain,k,1);
      IF ch==" " THEN
        k:=k-1;
      ELSE
        IF ch=="-" THEN sign:=-1; END;
        k:=0;
      END;
    END;
    j:=ini+6; depth:=1;
    WHILE depth>0 DO
      IF j>DIM(src) THEN RETURN ""; END;
      ch:=MID(src,j,1);
      IF ch=="(" THEN depth:=depth+1; END;
      IF ch==")" THEN depth:=depth-1; END;
      j:=j+1;
    END;
    IF depth<>0 THEN RETURN ""; END;
    arg:=MID(src,ini+6,(j-1)-(ini+6));
    // Probar afinidad simbolica; dos evaluaciones no descartan X^2-1.
    IFERR
      IF INSTRING(UPPER(arg),UPPER(axis))>0 THEN RETURN ""; END;
      IF SSCASString("eval("+axis+")")<>axis THEN RETURN ""; END;
      pol:=SSReplaceX(arg,axis);
      grado:=CAS.degree(pol,axis)+0.0;
      IF TYPE(grado)<>0 THEN RETURN ""; END;
      IF grado<>1 THEN RETURN ""; END;
      ac:=CAS.coeff(pol,axis,1); bc:=CAS.coeff(pol,axis,0);
      IF SSCASString("simplify(("+pol+")-coeff(("+pol+"),"+axis+",1)*"+axis+"-coeff(("+pol+"),"+axis+",0))")<>"0" THEN RETURN ""; END;
      a:=CAS.evalf(ac)+0.0; b:=CAS.evalf(bc)+0.0;
      IF TYPE(a)<>0 OR TYPE(b)<>0 THEN RETURN ""; END;
      IF SSIsDrawable(a)==0 OR SSIsDrawable(b)==0 THEN RETURN ""; END;
    THEN
      RETURN "";
    END;
    IF a==0 THEN RETURN ""; END;
    root:=-b/a; coef:=sign/ABS(a);
    IF SSIsDrawable(root)==0 OR SSIsDrawable(coef)==0 THEN RETURN ""; END;
    IF root==0 THEN shift:="(t)"; END;
    IF root>0 THEN shift:="(t-("+STRING(root,1,12,{3,".E-",0})+"))"; END;
    IF root<0 THEN shift:="(t+("+STRING(-root,1,12,{3,".E-",0})+"))"; END;
    term:=SSReplaceX(signal,shift);
    IF coef<>1 THEN term:="("+STRING(coef,1,12,{3,".E-",0})+")*("+term+")"; END;
    IF DIM(out)+DIM(term)+3>5000 THEN RETURN ""; END;
    IF count>0 THEN out:=out+" + "; END;
    out:=out+term; count:=count+1; pos:=j;
  END;
  IF count==0 OR SSOnlySigns(remain)==0 THEN RETURN ""; END;
  RETURN out;
END;

SSSeqMath(y,n0,nombre)
BEGIN
  LOCAL k;
  LOCAL idx;
  LOCAL atom;
  LOCAL term;
  LOCAL out:="";
  LOCAL terms:=0;
  LOCAL resumen:=0;
  IF TYPE(n0)<>0 THEN RETURN "Indice inicial no numerico; consulte la tabla."; END;
  IF SSIsDrawable(n0)==0 THEN RETURN "Indice inicial no finito; consulte la tabla."; END;
  IF n0<>FLOOR(n0) THEN RETURN "El eje no es entero; consulte la tabla."; END;
  FOR k FROM 1 TO SIZE(y) DO
    IF SSIsDrawable(y(k))==0 THEN RETURN "Secuencia con N/D: no se sustituye por cero. Consulte la tabla."; END;
  END;
  FOR k FROM 1 TO SIZE(y) DO
    IF y(k)<>0 THEN
      idx:=n0+k-1;
      IF idx==0 THEN atom:="delta[n]"; END;
      IF idx>0 THEN atom:="delta[n-"+STRING(idx)+"]"; END;
      IF idx<0 THEN atom:="delta[n+"+STRING(-idx)+"]"; END;
      term:="("+STRING(RE(y(k)),1,12,{3,".E-",0});
      IF IM(y(k))<>0 THEN term:=term+"+("+STRING(IM(y(k)),1,12,{3,".E-",0})+")*i"; END;
      term:=term+")*"+atom;
      IF DIM(out)+DIM(term)+3>390 THEN resumen:=1; BREAK; END;
      IF terms>0 THEN out:=out+" + "; END;
      out:=out+term; terms:=terms+1;
    END;
  END;
  IF resumen THEN RETURN nombre+"[n] (resumen): "+out+" ...; secuencia completa en tabla."; END;
  IF terms==0 THEN out:="0"; END;
  RETURN nombre+"[n]="+out;
END;

SSListMath(y,n0,nombre)
BEGIN
  LOCAL k;
  LOCAL take:=MIN(SIZE(y),12);
  LOCAL out:=nombre+"["+STRING(n0)+"..."+STRING(n0+SIZE(y)-1)+"]={";
  FOR k FROM 1 TO take DO
    IF k>1 THEN out:=out+","; END;
    out:=out+SSFmt(y(k),6);
  END;
  IF take<SIZE(y) THEN out:=out+",..."; END;
  RETURN out+"}";
END;

SSFormulaView(titulo,formula1,formula2,seccion,detalle1,detalle2,nota,color)
BEGIN
  LOCAL touch;
  LOCAL button;
  LOCAL touchKeys;
  LOCAL key:=-1;
  SSHeader(titulo,"Convolucion continua | expresion simbolica",color);

  // Tarjeta del resultado: cada renglon usa una posicion estable.
  RECT_P(10,48,309,113,RGB(203,213,225),RGB(255,255,255));
  RECT_P(10,48,15,113,color,color);
  TEXTOUT_P("RESULTADO y(t)",24,54,1,color);
  IF formula2=="" THEN
    TEXTOUT_P(formula1,24,79,1,RGB(15,23,42));
  ELSE
    TEXTOUT_P(formula1,24,72,1,RGB(15,23,42));
    TEXTOUT_P(formula2,68,94,1,RGB(15,23,42));
  END;

  // Tarjeta explicativa separada para evitar mezclar formula y propiedad.
  RECT_P(10,123,309,207,RGB(203,213,225),RGB(248,250,252));
  TEXTOUT_P(seccion,20,130,1,color);
  TEXTOUT_P(detalle1,20,153,1,RGB(30,41,59));
  IF detalle2<>"" THEN TEXTOUT_P(detalle2,20,174,1,RGB(30,41,59)); END;
  TEXTOUT_P(nota,20,194,1,RGB(100,116,139));

  REPEAT
    SSFooter({"Volver"},"");
    key:=SSPause();
    IF TYPE(key)==6 THEN
      touch:=key; key:=-1;
      IF touch(5)==0 AND touch(2)>=216 AND touch(4)>=216 THEN
        button:=1+FLOOR(touch(3)*1/320);
        IF button==1+FLOOR(touch(1)*1/320) THEN
          touchKeys:={4}; key:=touchKeys(button);
        END;
      END;
    END;
  UNTIL key==4 OR key==30;
  RETURN 1;
END;

SSWrapText(src,maxchars)
BEGIN
  LOCAL out:={};
  LOCAL pos:=1;
  LOCAL take;
  LOCAL cut;
  LOCAL j;
  LOCAL salto;
  LOCAL ch;
  LOCAL pasada;
  LOCAL filas;
  IF DIM(src)==0 THEN RETURN {""}; END;
  // Dos pasadas sin CONCAT creciente: contar y reservar exactamente las filas.
  FOR pasada FROM 1 TO 2 DO
  pos:=1; filas:=0;
  WHILE pos<=DIM(src) DO
    take:=MIN(maxchars,DIM(src)-pos+1);
    cut:=take;
    salto:=0;
    // Cada salto explicito inicia una fila; dos saltos dejan espacio entre bloques.
    FOR j FROM 1 TO take DO
      ch:=MID(src,pos+j-1,1);
      IF ch==CHAR(10) OR ch==CHAR(13) THEN cut:=j-1; salto:=1; BREAK; END;
    END;
    IF salto==0 AND pos+take-1<DIM(src) THEN
      FOR j FROM take DOWNTO 1 DO
        IF MID(src,pos+j-1,1)==" " THEN cut:=j-1; BREAK; END;
      END;
      IF cut<1 THEN cut:=take; END;
    END;
    filas:=filas+1;
    IF pasada==2 THEN
      IF cut==0 THEN out(filas):=""; ELSE out(filas):=MID(src,pos,cut); END;
    END;
    pos:=pos+cut;
    IF salto==1 THEN
      ch:=MID(src,pos,1); pos:=pos+1;
      IF ch==CHAR(13) AND pos<=DIM(src) THEN IF MID(src,pos,1)==CHAR(10) THEN pos:=pos+1; END; END;
    ELSE
      WHILE pos<=DIM(src) AND MID(src,pos,1)==" " DO pos:=pos+1; END;
      // Si el renglon ocupa el ancho exacto, consumir su terminador una sola vez.
      IF pos<=DIM(src) THEN
        ch:=MID(src,pos,1);
        IF ch==CHAR(10) OR ch==CHAR(13) THEN
          pos:=pos+1;
          IF ch==CHAR(13) AND pos<=DIM(src) THEN IF MID(src,pos,1)==CHAR(10) THEN pos:=pos+1; END; END;
        END;
      END;
    END;
  END;
  IF pasada==1 THEN out:=MAKELIST("",j,1,filas,1); END;
  END;
  RETURN out;
END;

SSInfoView(titulo,subtitulo,txt,color)
BEGIN
  LOCAL touch;
  LOCAL button;
  LOCAL touchKeys;
  LOCAL lines:=SSWrapText(txt,34);
  LOCAL first:=1;
  LOCAL k;
  LOCAL key:=-1;
  REPEAT
    SSHeader(titulo,subtitulo,color);
    RECT_P(8,47,311,210,RGB(203,213,225),RGB(255,255,255));
    FOR k FROM 0 TO 6 DO
      IF first+k<=SIZE(lines) THEN TEXTOUT_P(lines(first+k),15,53+21*k,2,RGB(30,41,59),276); END;
    END;
    IF first>1 THEN TEXTOUT_P("^",298,50,1,color); END;
    TEXTOUT_P(STRING(first)+"-"+STRING(MIN(first+6,SIZE(lines)))+" / "+STRING(SIZE(lines)),15,199,1,RGB(100,116,139));
    IF first+6<SIZE(lines) THEN TEXTOUT_P("v",298,194,1,color); END;
    SSFooter({"Subir","Bajar","Volver"},"");
    key:=SSPause();
    IF TYPE(key)==6 THEN
      touch:=key; key:=-1;
      IF touch(5)==0 AND touch(2)>=216 AND touch(4)>=216 THEN
        button:=1+FLOOR(touch(3)*3/320);
        IF button==1+FLOOR(touch(1)*3/320) THEN
          touchKeys:={2,12,4}; key:=touchKeys(button);
        END;
      END;
      IF touch(5)==1 AND touch(2)>=47 AND touch(2)<=210 AND touch(4)<216 THEN
        first:=MAX(1,MIN(MAX(1,SIZE(lines)-6),first+ROUND((touch(2)-touch(4))/21,0)));
      END;
    END;
    IF key==2 THEN first:=MAX(1,first-1); END;
    IF key==12 THEN first:=MIN(MAX(1,SIZE(lines)-6),first+1); END;
  UNTIL key==4 OR key==30;
  RETURN 1;
END;

SSFormulaView(titulo,etiqueta,txt,color)
BEGIN
  LOCAL touch;
  LOCAL button;
  LOCAL touchKeys;
  LOCAL formula;
  LOCAL key:=-1;
  LOCAL px:=0;
  LOCAL py:=0;
  LOCAL font:=3;
  LOCAL ok:=1;
  // Registros largos: evitar cargar miles de terminos en el visor 2D.
  IF DIM(txt)>6000 THEN SSInfoView(titulo,etiqueta+" | formula larga: texto",txt,color); RETURN 1; END;
  // quote conserva la formula: presentar no implica recalcular.
  IFERR formula:=CAS(EVAL("quote("+txt+")")); THEN ok:=0; END;
  IF ok==1 THEN IF TYPE(formula)==2 THEN ok:=0; END; END;
  IF ok==0 THEN
    SSInfoView(titulo,etiqueta+" | vista lineal",txt,color); RETURN 1;
  END;
  REPEAT
    RECT_P(0,0,319,239,RGB(255,255,255),RGB(255,255,255));
    IFERR
      // Dibujar sobre la pantalla nativa, sin copiar/restaurar un GROB local.
      // x<=0 evita depender del posicionamiento positivo del visor 2D.
      TEXTOUT_P(formula,G0,-px,50-py,{"2D",{0},font,RGB(15,23,42)});
    THEN ok:=0; END;
    IF ok==0 THEN
      SSInfoView(titulo,"Textbook no disponible | texto",txt,color); RETURN 1;
    END;
    // Reponer las bandas despues de la formula: el desplazamiento no las tapa.
    RECT_P(0,0,319,45,RGB(245,247,251),RGB(245,247,251));
    RECT_P(0,0,319,39,color,color);
    RECT_P(0,40,319,41,RGB(15,23,42),RGB(15,23,42));
    TEXTOUT_P(titulo,10,4,2,RGB(255,255,255));
    TEXTOUT_P(etiqueta+" | Textbook",11,24,1,RGB(225,235,248));
    RECT_P(0,208,319,239,RGB(245,247,251),RGB(245,247,251));
    LINE_P(0,46,319,46,RGB(203,213,225));
    LINE_P(0,207,319,207,RGB(203,213,225));
    SSFooter({"+","-","Texto","Inicio","Volver"},"");
    key:=SSPause();
    IF TYPE(key)==6 THEN
      touch:=key; key:=-1;
      IF touch(5)==0 AND touch(2)>=216 AND touch(4)>=216 THEN
        button:=1+FLOOR(touch(3)*5/320);
        IF button==1+FLOOR(touch(1)*5/320) THEN
          touchKeys:={50,45,48,47,4}; key:=touchKeys(button);
        END;
      END;
      IF touch(5)==1 AND touch(2)>=47 AND touch(2)<=207 AND touch(4)<216 THEN
        px:=MAX(0,MIN(4096,px+touch(1)-touch(3)));
        py:=MAX(0,MIN(2048,py+touch(2)-touch(4)));
      END;
    END;
    IF key==7 THEN px:=MAX(0,px-40); END;
    IF key==8 THEN px:=MIN(4096,px+40); END;
    IF key==2 THEN py:=MAX(0,py-24); END;
    IF key==12 THEN py:=MIN(2048,py+24); END;
    IF key==50 THEN font:=MIN(7,font+1); px:=0; py:=0; END;
    IF key==45 THEN font:=MAX(1,font-1); px:=0; py:=0; END;
    IF key==47 THEN px:=0; py:=0; font:=3; END;
    IF key==48 THEN SSInfoView(titulo,"Expresion lineal completa",txt,color); END;
  UNTIL key==4 OR key==30;
  // Ambas teclas cierran unicamente este visor. No hay limpieza grafica al salir.
  RETURN 1;
END;

SSHistoryMenu()
BEGIN
  LOCAL items;
  LOCAL k;
  LOCAL op:=1;
  LOCAL sub;
  LOCAL item;
  LOCAL filas;
  LOCAL fila;
  LOCAL nombres;
  LOCAL vista;
  LOCAL detalle;
  LOCAL texto;
  LOCAL r;
  LOCAL savedEvents:=SSEVAL_EVENTS;
  LOCAL savedMeta:=SSREAD_META;
  LOCAL reabrir;
  LOCAL compatible;
  LOCAL parametros;
  LOCAL salidaGuardada;
  LOCAL entradaGuardada;
  IF TYPE(SSHISTORY)<>6 THEN SSHISTORY:={}; END;
  IF SIZE(SSHISTORY)==0 THEN
    SSInfoView("Recientes","Sin resultados guardados","Aqui se guardan hasta 8 resultados, senales y disenos. ESC en un centro de resultados ofrece guardar antes de salir. Limites: 16000 caracteres por registro y 32000 en total; se reemplazan los mas antiguos. No es una copia de seguridad ilimitada.",SSAccent(5)); RETURN 0;
  END;
  REPEAT
    items:={};
    FOR k FROM 1 TO SIZE(SSHISTORY) DO item:=SSHISTORY(k); items:=CONCAT(items,{STRING(k)+". "+item(2)}); END;
    items:=CONCAT(items,{"Volver"});
    op:=SSMenu("Recientes / banco",items,op);
    IF op==0 OR op>SIZE(SSHISTORY) THEN SSEVAL_EVENTS:=savedEvents; SSREAD_META:=savedMeta; RETURN 1; END;
    item:=SSHISTORY(op);
    IF item(1)==5 THEN
      SSInfoView(item(2),item(3),item(5)+"\nProgreso [realizados,total]: "+STRING(item(4))+"\nNo mide RAM libre ni identifica la causa de un reinicio. No registra expresiones ni listas completas.",SSAccent(5));
      CONTINUE;
    END;
    IF item(1)==1 THEN
      SSResultBrowse(item(2),item(3),item(4),item(5),item(6));
    ELSE
    IF item(1)==3 THEN
      filas:=item(3); nombres:={};
      salidaGuardada:={}; entradaGuardada:={};
      IF SIZE(filas)>=2 THEN salidaGuardada:=filas(1); entradaGuardada:=filas(2); END;
      // Reabrir solo estructuras conocidas; no inferir una sesion desde una formula.
      compatible:=0;
      IF (item(2)=="Resultados del muestreo" OR item(2)=="Secuencia por expresion") AND SIZE(filas)==2 THEN
        IF SIZE(salidaGuardada)>=4 AND SIZE(entradaGuardada)>=2 THEN
        IF TYPE(salidaGuardada(2))==6 AND TYPE(entradaGuardada(2))==2 THEN
          IF SIZE(salidaGuardada(2))>0 AND MID(entradaGuardada(2),1,7)<>"TRAMOS:" THEN compatible:=1; END;
        END;
        END;
      END;
      IF item(2)=="Resultados DFT y Fourier" AND (SIZE(filas)==3 OR SIZE(filas)==5) THEN
        fila:=filas(3); parametros:=fila(2);
        IF TYPE(parametros)==6 THEN IF SIZE(parametros)==3 THEN
          IF parametros(1)>=1 AND parametros(1)<=3 AND parametros(1)==FLOOR(parametros(1)) AND parametros(3)==SIZE(salidaGuardada(2)) AND parametros(3)==SIZE(entradaGuardada(2)) AND parametros(3)>0 THEN compatible:=2; END;
        END; END;
      END;
      IF item(2)=="Resultados de cuantizacion" AND SIZE(filas)==12 THEN
        fila:=filas(12); parametros:=fila(2);
        IF TYPE(parametros)==6 THEN IF SIZE(parametros)==8 THEN
          IF SIZE(salidaGuardada(2))>0 AND SIZE(salidaGuardada(2))==SIZE(entradaGuardada(2)) AND parametros(7)>=1 AND parametros(8)<=SIZE(salidaGuardada(2)) AND parametros(7)<=parametros(8) THEN compatible:=3; END;
        END; END;
      END;
      IF item(2)=="Resultados del filtro" AND SIZE(filas)==4 THEN
        fila:=filas(4); parametros:=fila(2);
        IF TYPE(parametros)==6 THEN IF SIZE(parametros)==5 THEN compatible:=4; END; END;
      END;
      IF item(2)=="Resultados de cambio de tasa" AND SIZE(filas)==9 THEN
        fila:=filas(9); parametros:=fila(2);
        IF TYPE(parametros)==6 THEN IF SIZE(parametros)==12 THEN compatible:=5; END; END;
      END;
      IF compatible>0 THEN
        reabrir:=SSMenu("Calculo guardado",{"Reabrir resultado / editar","Consultar datos guardados","Volver a Recientes"},1);
        IF reabrir==0 OR reabrir==3 THEN CONTINUE; END;
        IF reabrir==1 THEN
          SSEVAL_EVENTS:={}; SSREAD_META:={};
          IF compatible==1 THEN
            fila:=filas(1); IF SIZE(fila)>=5 THEN SSEVAL_EVENTS:=fila(5); END;
            IF item(2)=="Resultados del muestreo" THEN SSSampleResults(fila(2),fila(3),fila(4),{entradaGuardada(2),"EDITABLE"});
            ELSE SSSequenceExprResults(fila(2),fila(3),entradaGuardada(2)); END;
          ELSE
          IF compatible==2 THEN
            // Resultado ya ordenado: no aplicar fftshift por segunda vez.
            IF SIZE(filas)==5 THEN
              fila:=filas(4); r:=filas(5);
              SSDFTResults(salidaGuardada(2),{"Fourier recuperada",entradaGuardada(2),"ORDERED",fila(2),r(2)},parametros(1),parametros(2),parametros(3));
            ELSE
              SSInfoView("Registro anterior","Entrada original no disponible","Solo se guardo el registro usado. Si hubo truncamiento, no se pueden recuperar las muestras descartadas. Puede reemplazar la lista al editar.",SSAccent(4));
              SSDFTResults(salidaGuardada(2),{"Fourier recuperada",entradaGuardada(2),"ORDERED"},parametros(1),parametros(2),parametros(3));
            END;
          ELSE
          IF compatible==3 THEN
            SSQuantResults(salidaGuardada(2),entradaGuardada(2),parametros(1),parametros(2),parametros(3),parametros(4),parametros(5),0,{parametros(6),parametros(7),parametros(8),salidaGuardada(3),salidaGuardada(4)});
          ELSE
          IF compatible==4 THEN
            SSDigitalFilterResults(salidaGuardada(2),entradaGuardada(2),parametros(1),parametros(2),parametros(3),parametros(4),parametros(5));
          ELSE
            fila:=filas(5); r:=fila(2); fila:=filas(4); texto:=fila(2);
            SSRateResults(salidaGuardada(2),entradaGuardada(2),salidaGuardada(3),r(1),r(2),r(3),parametros(9),texto,parametros);
          END; END; END;
          END;
          SSEVAL_EVENTS:=savedEvents; SSREAD_META:=savedMeta;
          item:={}; filas:={}; fila:={}; salidaGuardada:={}; entradaGuardada:={}; parametros:={}; CONTINUE;
        END;
      END;
      FOR k FROM 1 TO SIZE(filas) DO fila:=filas(k); nombres:=CONCAT(nombres,{fila(1)}); END;
      nombres:=CONCAT(nombres,{"Contexto del registro","Volver"}); vista:=1;
      REPEAT
        vista:=SSMenu(item(2),nombres,vista);
        IF vista==0 OR vista==SIZE(nombres) THEN BREAK; END;
        IF vista==SIZE(nombres)-1 THEN SSInfoView(item(2),"Registro guardado",item(4)+"\nSe guardaron datos y parametros, no una captura. Es una copia del resultado, no una sesion reanudable de todos los formularios. Listas: tabla, grafico y exportacion. Recientes conserva hasta 8 registros y reemplaza los mas antiguos.",SSAccent(5));
        ELSE
          fila:=filas(vista);
          IF SIZE(fila)>=4 AND TYPE(fila(2))==6 THEN
            IF SIZE(fila(2))==0 THEN
              SSInfoView(fila(1),"Sin muestras guardadas","Esta vista no se habia calculado o no corresponde al resultado. Consulte los parametros y la expresion del registro.",SSAccent(5));
              CONTINUE;
            END;
            detalle:=1;
            REPEAT
              detalle:=SSMenu(fila(1),{"Tabla de valores","Grafico de parte real","Exportar / usar como banco","Volver al registro"},detalle);
              IF detalle==0 OR detalle==4 THEN BREAK; END;
              SSEVAL_EVENTS:={}; IF SIZE(fila)>=5 THEN SSEVAL_EVENTS:=fila(5); END;
              IF detalle==1 THEN SSDataView(fila(2),fila(3),fila(4),fila(1),"eje","valor",SSAccent(5)); END;
              IF detalle==2 THEN SSPlotDiscrete(fila(2),fila(3),fila(4),fila(1),"eje guardado"); END;
              IF detalle==3 THEN SSExportData(fila(2),fila(3),fila(4),fila(1)); END;
            UNTIL 0;
          ELSE
            texto:=fila(2); IF TYPE(texto)<>2 THEN texto:=STRING(texto,1,12,{3,".E-",0}); END;
            SSFormulaView(item(2),fila(1),texto,SSAccent(5));
          END;
        END;
      UNTIL 0;
      filas:={}; fila:={}; nombres:={};
    ELSE
    IF item(1)==4 THEN
      r:=SSPlotPZ(item(3),item(4),2,{"Filtro guardado: plano z",1,item(5),1});
      r:={};
    ELSE
      sub:=SSMenu("Senal guardada",{"Ver datos y eje","Ver tabla","Reutilizar como banco","Volver"},1);
      IF sub==1 THEN SSInfoView(item(2),"Datos de origen",SSDataSummary(item(3),item(4),item(5),item(2)),SSAccent(5)); END;
      IF sub==2 THEN SSEVAL_EVENTS:=item(6); SSDataView(item(3),item(4),item(5),item(2),"eje","valor",SSAccent(5)); END;
      IF sub==3 THEN
        SSDATA:=item(3); SSDATA_N0:=item(4); SSDATA_DX:=item(5); SSDATA_NAME:=item(2); SSDATA_EVENTS:=item(6);
        SSInfoView("Banco actualizado",item(2),"La senal esta disponible en Fuente de datos > Usar banco SignalLab. No se cambiaron las listas L0 y L1 de Home.",SSAccent(5));
      END;
    END;
    END;
    END;
  UNTIL 0;
END;

SSDrawCursor(y,x0,dx,idx,first,last,ymin,ymax)
BEGIN
  LOCAL xp:=168;
  LOCAL yp;
  LOCAL color:=RGB(190,24,93);
  IF last>first THEN xp:=ROUND(30+(idx-first)*276/(last-first),0); END;
  LINE_P(xp,47,xp,183,color);
  IF SSIsDrawable(y(idx)) THEN
    IF RE(y(idx))>=ymin AND RE(y(idx))<=ymax THEN
      yp:=ROUND(184-(RE(y(idx))-ymin)*138/(ymax-ymin),0);
      RECT_P(xp-3,MAX(46,yp-3),xp+3,MIN(184,yp+3),color,color);
    END;
  END;
  RECT_P(8,198,312,214,RGB(255,255,255),RGB(255,255,255));
  TEXTOUT_P("#"+STRING(idx)+" x="+SSFmt(x0+(idx-1)*dx,6)+" y="+SSFmt(y(idx),6),10,200,1,color,300);
END;

SSCursorDetail(y,x0,dx,idx,titulo)
BEGIN
  LOCAL selected:=idx;
  LOCAL anchor:=0;
  LOCAL op:=1;
  LOCAL delta;
  LOCAL texto;
  IF TYPE(idx)==6 THEN selected:=idx(1); anchor:=idx(2); END;
  REPEAT
    op:=SSMenu("Lecturas del grafico",{"Valor del punto actual B","Fijar este punto como A","Medir de A a B","Borrar referencia A","Contexto del grafico","Volver"},op);
    IF op==0 OR op==6 THEN RETURN anchor; END;
    IF op==1 THEN
      SSInfoView(titulo,"Punto actual B","Fila="+STRING(selected)+"\nEje="+STRING(x0+(selected-1)*dx)+"\nValor="+STRING(y(selected))+"\nPrecision numerica almacenada, sin redondeo de tabla. El grafico usa la parte real. Un limite no convierte un punto indefinido en definido.",SSAccent(3));
    END;
    IF op==2 THEN RETURN selected; END;
    IF op==3 THEN
      IF anchor==0 THEN
        SSInfoView(titulo,"Falta la referencia A","Fije un punto como A, vuelva al grafico y mueva el cursor al segundo punto B. ENTER abre esta medicion.",SSAccent(3));
      ELSE
        delta:=(selected-anchor)*dx;
        texto:="A: fila "+STRING(anchor)+", eje="+STRING(x0+(anchor-1)*dx)+", valor="+STRING(y(anchor))+"\nB: fila "+STRING(selected)+", eje="+STRING(x0+(selected-1)*dx)+", valor="+STRING(y(selected))+"\nDelta eje="+STRING(delta);
        IF SSIsDrawable(y(anchor)) AND SSIsDrawable(y(selected)) THEN
          texto:=texto+"\nDelta valor="+STRING(y(selected)-y(anchor));
          IF delta<>0 THEN texto:=texto+"\nPendiente secante="+STRING((y(selected)-y(anchor))/delta); END;
        ELSE texto:=texto+"\nDelta valor y pendiente: no disponibles en puntos no finitos."; END;
        IF delta<>0 THEN texto:=texto+"\n1/|Delta eje|="+STRING(1/ABS(delta));
        ELSE texto:=texto+"\nPendiente e inverso: no definidos si Delta eje=0."; END;
        texto:=texto+"\nUnidades: las del eje y valor de origen. Solo si el eje es tiempo en segundos, el inverso esta en Hz. Es una frecuencia estimada UNICAMENTE si A y B delimitan un periodo completo; no se detecta periodicidad automaticamente.";
        SSInfoView(titulo,"Medicion A -> B",texto,SSAccent(3));
      END;
    END;
    IF op==4 THEN RETURN 0; END;
    IF op==5 THEN SSInfoView(titulo,"Metodo, unidades y limites",SSDataSummary(y,x0,dx,titulo)+"\nLas curvas ordinarias unen muestras. La curva SINC del filtro ideal evalua su modelo por columna y se recalcula con el zoom horizontal; sus puntos y cursor siguen siendo muestras, no las columnas de dibujo. Los tallos son muestras, o areas si asi lo indica Dirac. Las lecturas usan datos originales y la pendiente es secante, no derivada simbolica. A se conserva solo mientras este grafico permanece abierto.",SSAccent(3)); END;
  UNTIL 0;
END;

SSTheoryView(titulo,paginas,color)
BEGIN
  LOCAL touch;
  LOCAL button;
  LOCAL touchKeys;
  LOCAL page:=1;
  LOCAL first:=1;
  LOCAL lines;
  LOCAL k;
  LOCAL key:=-1;
  REPEAT
    lines:=SSWrapText(paginas(page),47);
    SSHeader(titulo,"Pagina "+STRING(page)+" de "+STRING(SIZE(paginas)),color);
    RECT_P(8,47,311,210,RGB(203,213,225),RGB(255,255,255));
    FOR k FROM 0 TO 7 DO
      IF first+k<=SIZE(lines) THEN TEXTOUT_P(lines(first+k),15,53+19*k,1,RGB(30,41,59)); END;
    END;
    IF first>1 THEN TEXTOUT_P("^",298,50,1,color); END;
    IF first+7<SIZE(lines) THEN TEXTOUT_P("v",298,194,1,color); END;
    SSFooter({"Pag -","Pag +","Subir","Bajar","Volver"},"");
    key:=SSPause();
    IF TYPE(key)==6 THEN
      touch:=key; key:=-1;
      IF touch(5)==0 AND touch(2)>=216 AND touch(4)>=216 THEN
        button:=1+FLOOR(touch(3)*5/320);
        IF button==1+FLOOR(touch(1)*5/320) THEN
          touchKeys:={7,8,2,12,4}; key:=touchKeys(button);
        END;
      END;
      IF touch(5)==1 AND touch(2)>=47 AND touch(2)<=210 AND touch(4)<216 THEN
        IF ABS(touch(3)-touch(1))>ABS(touch(4)-touch(2)) THEN
          IF touch(3)<touch(1) THEN key:=8; ELSE key:=7; END;
        ELSE first:=MAX(1,MIN(MAX(1,SIZE(lines)-7),first+ROUND((touch(2)-touch(4))/19,0))); END;
      END;
    END;
    IF key==7 THEN page:=MAX(1,page-1); first:=1; END;
    IF key==8 THEN page:=MIN(SIZE(paginas),page+1); first:=1; END;
    IF key==2 THEN first:=MAX(1,first-1); END;
    IF key==12 THEN first:=MIN(MAX(1,SIZE(lines)-7),first+1); END;
  UNTIL key==4 OR key==30;
  RETURN 1;
END;

SSMathTextView(titulo,etiqueta,txt,detalle1,detalle2,nota,color)
BEGIN
  LOCAL op:=1;
  SSFormulaView(titulo,etiqueta,txt,color);
  REPEAT
    op:=SSMenu("Formula y condiciones",{"Formula Textbook","Limites y condiciones","Expresion lineal completa","Continuar al integrando","Volver"},op);
    IF op==0 OR op==5 THEN RETURN 4; END;
    IF op==1 THEN SSFormulaView(titulo,etiqueta,txt,color); END;
    IF op==2 THEN SSInfoView(titulo,"Ventana de solapamiento",detalle1+"\n"+detalle2+"\n"+nota,color); END;
    IF op==3 THEN SSInfoView(titulo,etiqueta,txt,color); END;
    IF op==4 THEN RETURN 30; END;
  UNTIL 0;
END;

SSConvMathView(f,g,t0,t1,color)
BEGIN
  LOCAL fu:=SSReplaceX(f,"(u)");
  LOCAL gt:=SSReplaceX(g,"(t-u)");
  LOCAL limiteL:="max("+STRING(t0,1,12,{3,".E-",0})+",t-("+STRING(t1,1,12,{3,".E-",0})+"))";
  LOCAL limiteU:="min("+STRING(t1,1,12,{3,".E-",0})+",t-("+STRING(t0,1,12,{3,".E-",0})+"))";
  LOCAL propiedad:="";
  LOCAL cmd;
  LOCAL resultado;
  LOCAL txt;
  LOCAL etiqueta:="RESULTADO PARA L<=U";
  LOCAL nota:="CAS en ventana; y(t)=0 si L>U.";
  LOCAL key;
  LOCAL tieneDirac:=INSTRING(UPPER(f+g),"DIRAC(")>0;

  IFERR propiedad:=SSDiracShift(f,g); THEN propiedad:=""; END;
  IF propiedad=="" THEN
    IFERR propiedad:=SSDiracShift(g,f); THEN propiedad:=""; END;
  END;

  IF propiedad<>"" THEN
    txt:="y(t)="+propiedad;
    etiqueta:="PROPIEDAD DEL IMPULSO";
    nota:="Impulso afin; coeficientes a 12 digitos. Grafico aproximado.";
  ELSE
    IF tieneDirac THEN
      txt:="y(t)=int(("+fu+")*("+gt+"),u,"+limiteL+","+limiteU+")";
      etiqueta:="INTEGRAL PLANTEADA, NO EVALUADA";
      nota:="Sin atajo afin verificado; grafico aproximado.";
    ELSE
      cmd:="simplify(int(("+fu+")*("+gt+"),u,"+limiteL+","+limiteU+"))";
      IFERR
        resultado:=SSCASString(cmd);
        txt:="y(t)="+resultado;
        IF resultado=="" THEN
          txt:="y(t)=int(("+fu+")*("+gt+"),u,"+limiteL+","+limiteU+")";
          nota:="Forma integral exacta; y(t)=0 si L>U.";
        END;
        IF INSTRING(UPPER(resultado),"INT(")>0 THEN nota:="Integral exacta no elemental; y(t)=0 si L>U."; END;
      THEN
        txt:="y(t)=int(("+fu+")*("+gt+"),u,"+limiteL+","+limiteU+")";
        nota:="Forma integral exacta; y(t)=0 si L>U.";
      END;
    END;
  END;

  key:=SSMathTextView("Resultado matematico",etiqueta,txt,"L="+limiteL,"U="+limiteU,nota,color);
  IF key==30 THEN
    SSMathTextView("Integrando sustituido","x(u) * h(t-u)","("+fu+")*("+gt+")","L="+limiteL,"U="+limiteU,"Expresion usada por el motor simbolico.",color);
  END;
  RETURN 1;
END;

SSConvCAS(f,g)
BEGIN
  LOCAL fu:=SSReplaceX(f,"(u)");
  LOCAL gt:=SSReplaceX(g,"(t-u)");
  LOCAL propiedad:="";
  LOCAL cmd:="simplify(int(("+fu+")*("+gt+"),u,-infinity,+infinity))";
  LOCAL resultado;
  IFERR
    propiedad:=SSDiracShift(f,g);
  THEN
    propiedad:="";
  END;
  IF propiedad=="" THEN
    IFERR
      propiedad:=SSDiracShift(g,f);
    THEN
      propiedad:="";
    END;
  END;
  IF propiedad<>"" THEN
    SSResultBrowse("Convolucion simbolica","Resultado y propiedad",{{"Resultado y(t)",propiedad}},"x(t)="+f+"; h(t)="+g,"Convolucion con Dirac: x(t)*delta(t-a)=x(t-a). Verifique soporte y condiciones.");
    RETURN 1;
  END;
  IFERR
    resultado:=SSCASString(cmd);
  THEN
    SSResultBrowse("Convolucion pendiente","Integral no resuelta",{{"Integral planteada",cmd},{"Integrando", "("+fu+")*("+gt+")"}},"x(t)="+f+"; h(t)="+g,"El CAS no pudo cerrar la integral. Se presenta el planteo, no un resultado cerrado.");
    RETURN 0;
  END;
  IF resultado=="" THEN
    SSResultBrowse("Convolucion pendiente","Integral no resuelta",{{"Integral planteada",cmd},{"Integrando", "("+fu+")*("+gt+")"}},"x(t)="+f+"; h(t)="+g,"El CAS no pudo cerrar la integral. Se presenta el planteo, no un resultado cerrado.");
    RETURN 0;
  END;
  SSResultBrowse("Convolucion simbolica","Resultado CAS",{{"Resultado y(t)",resultado},{"Integral solicitada",cmd}},"x(t)="+f+"; h(t)="+g,"Verifique condiciones y supuestos sobre t. Una integral pendiente no es una forma cerrada.");
  RETURN 1;
END;

SSDataView(y,x0,dx,titulo,xlabel,ylabel,color)
BEGIN
  LOCAL touch;
  LOCAL button;
  LOCAL touchKeys;
  LOCAL limpia:=1;
  LOCAL shownList;
  LOCAL estadoVista;
  LOCAL N:=SIZE(y);
  LOCAL sel:=1;
  LOCAL first:=1;
  LOCAL last;
  LOCAL row;
  LOCAL yy;
  LOCAL xv;
  LOCAL shown;
  LOCAL key:=-1;
  IF N==0 THEN RETURN 0; END;
  REPEAT
    estadoVista:="Original | 5 limpia";
    IF limpia==1 THEN estadoVista:="Cero <=1E-10 | 5 original"; END;
    first:=MAX(1,MIN(first,N-7));
    IF sel<first THEN first:=sel; END;
    IF sel>first+7 THEN first:=sel-7; END;
    last:=MIN(N,first+7);
    SSHeader(titulo,estadoVista+" | N="+STRING(N),color);
    RECT_P(8,44,311,61,RGB(226,232,240),RGB(226,232,240));
    TEXTOUT_P("#",15,47,1,RGB(71,85,105));
    TEXTOUT_P(xlabel,55,47,1,RGB(71,85,105));
    TEXTOUT_P(ylabel,166,47,1,RGB(71,85,105));
    FOR row FROM first TO last DO
      yy:=63+(row-first)*18;
      xv:=x0+(row-1)*dx;
      // La vista limpia no cambia el original consultado/exportado.
      shown:=y(row);
      // Limpiar solo la celda visible, no una copia de toda la senal.
      IF limpia==1 THEN shownList:=SSCleanComplex({{shown},1E-10}); shown:=shownList(1); END;
      IF row==sel THEN
        RECT_P(8,yy,311,yy+16,color,color);
        TEXTOUT_P(STRING(row),14,yy+2,1,RGB(255,255,255));
        TEXTOUT_P(SSFmt(xv,5),53,yy+2,1,RGB(255,255,255));
        TEXTOUT_P(SSFmt(shown,5),164,yy+2,1,RGB(255,255,255));
      ELSE
        RECT_P(8,yy,311,yy+16,RGB(226,232,240),RGB(255,255,255));
        TEXTOUT_P(STRING(row),14,yy+2,1,RGB(71,85,105));
        TEXTOUT_P(SSFmt(xv,5),53,yy+2,1,RGB(30,41,59));
        TEXTOUT_P(SSFmt(shown,5),164,yy+2,1,RGB(30,41,59));
      END;
    END;
    SSFooter({"Pag -","Pag +","Detalle","Vista","Exportar","Volver"},"");
    key:=SSPause();
    IF TYPE(key)==6 THEN
      touch:=key; key:=-1;
      IF touch(5)==0 AND touch(2)>=216 AND touch(4)>=216 THEN
        button:=1+FLOOR(touch(3)*6/320);
        IF button==1+FLOOR(touch(1)*6/320) THEN
          touchKeys:={7,8,30,38,50,4}; key:=touchKeys(button);
        END;
      END;
      IF touch(2)>=63 AND touch(2)<=205 AND touch(4)>=63 AND touch(4)<=205 THEN
        IF touch(5)==0 AND touch(1)>=8 AND touch(1)<=311 AND touch(3)>=8 AND touch(3)<=311 THEN
          row:=first+FLOOR((touch(4)-63)/18);
          IF row<=last AND row==first+FLOOR((touch(2)-63)/18) AND (touch(4)-63) MOD 18<=16 THEN
            IF row==sel THEN key:=30; ELSE sel:=row; END;
          END;
        END;
        IF touch(5)==1 THEN
          IF ABS(touch(3)-touch(1))>ABS(touch(4)-touch(2)) THEN
            IF touch(3)<touch(1) THEN key:=8; ELSE key:=7; END;
          ELSE
            button:=ROUND((touch(2)-touch(4))/18,0);
            first:=MAX(1,MIN(MAX(1,N-7),first+button));
            sel:=MAX(first,MIN(MIN(N,first+7),sel+button));
          END;
        END;
      END;
    END;
    IF key==38 THEN limpia:=1-limpia; END;
    IF key==2 THEN sel:=MAX(1,sel-1); END;
    IF key==12 THEN sel:=MIN(N,sel+1); END;
    IF key==7 THEN sel:=MAX(1,sel-8); first:=MAX(1,first-8); END;
    IF key==8 THEN sel:=MIN(N,sel+8); first:=MIN(MAX(1,N-7),first+8); END;
    IF key==30 THEN
      xv:=x0+(sel-1)*dx;
      IF SSEventText(sel)=="" THEN
        SSResultBrowse(titulo,"Detalle del punto",{{xlabel,xv},{ylabel,y(sel)}},"Fila "+STRING(sel),"Valores almacenados. Textbook no cambia los datos ni aplica la limpieza visual de la tabla.");
      ELSE
        SSResultBrowse(titulo,"Detalle del punto",{{xlabel,xv},{ylabel,y(sel)}},"Fila "+STRING(sel),SSEventText(sel)+"\nValores almacenados. Un limite no convierte una singularidad en un punto definido.");
      END;
    END;
    IF key==50 THEN SSExportData(y,x0,dx,titulo); END;
  UNTIL key==4;
  RETURN 1;
END;

SSDataViewPair(x,y,n0,titulo,color)
BEGIN
  LOCAL touch;
  LOCAL button;
  LOCAL touchKeys;
  LOCAL limpia:=1;
  LOCAL shownListX;
  LOCAL estadoVista;
  LOCAL N:=MIN(SIZE(x),SIZE(y));
  LOCAL sel:=1;
  LOCAL first:=1;
  LOCAL last;
  LOCAL row;
  LOCAL yy;
  LOCAL shownX;
  LOCAL shownY;
  LOCAL shownError;
  LOCAL key:=-1;
  IF N==0 THEN RETURN 0; END;
  REPEAT
    estadoVista:="Original | 5 limpia";
    IF limpia==1 THEN estadoVista:="Cero <=1E-10 | 5 original"; END;
    first:=MAX(1,MIN(first,N-7));
    IF sel<first THEN first:=sel; END;
    IF sel>first+7 THEN first:=sel-7; END;
    last:=MIN(N,first+7);
    SSHeader(titulo,estadoVista,color);
    RECT_P(8,44,311,61,RGB(226,232,240),RGB(226,232,240));
    TEXTOUT_P("n",13,47,1,RGB(71,85,105));
    TEXTOUT_P("x[n]",55,47,1,RGB(71,85,105));
    TEXTOUT_P("y[n]",139,47,1,RGB(71,85,105));
    TEXTOUT_P("error",223,47,1,RGB(71,85,105));
    FOR row FROM first TO last DO
      yy:=63+(row-first)*18;
      shownX:=x(row); shownY:=y(row);
      IF limpia==1 THEN
        shownListX:=SSCleanComplex({{shownX,shownY},1E-10});
        shownX:=shownListX(1); shownY:=shownListX(2);
      END;
      shownError:=y(row)-x(row);
      IF limpia==1 THEN
        shownError:=SSCleanComplex({{shownError},1E-10}); shownError:=shownError(1);
      END;
      IF row==sel THEN
        RECT_P(8,yy,311,yy+16,color,color);
        TEXTOUT_P(STRING(n0+row-1),12,yy+2,1,RGB(255,255,255));
        TEXTOUT_P(SSFmt(shownX,3),51,yy+2,1,RGB(255,255,255));
        TEXTOUT_P(SSFmt(shownY,3),135,yy+2,1,RGB(255,255,255));
        TEXTOUT_P(SSFmt(shownError,3),219,yy+2,1,RGB(255,255,255));
      ELSE
        RECT_P(8,yy,311,yy+16,RGB(226,232,240),RGB(255,255,255));
        TEXTOUT_P(STRING(n0+row-1),12,yy+2,1,RGB(71,85,105));
        TEXTOUT_P(SSFmt(shownX,3),51,yy+2,1,RGB(30,41,59));
        TEXTOUT_P(SSFmt(shownY,3),135,yy+2,1,RGB(30,41,59));
        TEXTOUT_P(SSFmt(shownError,3),219,yy+2,1,RGB(30,41,59));
      END;
    END;
    SSFooter({"Pag -","Pag +","Detalle","Vista","Volver"},"");
    key:=SSPause();
    IF TYPE(key)==6 THEN
      touch:=key; key:=-1;
      IF touch(5)==0 AND touch(2)>=216 AND touch(4)>=216 THEN
        button:=1+FLOOR(touch(3)*5/320);
        IF button==1+FLOOR(touch(1)*5/320) THEN
          touchKeys:={7,8,30,38,4}; key:=touchKeys(button);
        END;
      END;
      IF touch(2)>=63 AND touch(2)<=205 AND touch(4)>=63 AND touch(4)<=205 THEN
        IF touch(5)==0 AND touch(1)>=8 AND touch(1)<=311 AND touch(3)>=8 AND touch(3)<=311 THEN
          row:=first+FLOOR((touch(4)-63)/18);
          IF row<=last AND row==first+FLOOR((touch(2)-63)/18) AND (touch(4)-63) MOD 18<=16 THEN
            IF row==sel THEN key:=30; ELSE sel:=row; END;
          END;
        END;
        IF touch(5)==1 THEN
          IF ABS(touch(3)-touch(1))>ABS(touch(4)-touch(2)) THEN
            IF touch(3)<touch(1) THEN key:=8; ELSE key:=7; END;
          ELSE
            button:=ROUND((touch(2)-touch(4))/18,0);
            first:=MAX(1,MIN(MAX(1,N-7),first+button));
            sel:=MAX(first,MIN(MIN(N,first+7),sel+button));
          END;
        END;
      END;
    END;
    IF key==38 THEN limpia:=1-limpia; END;
    IF key==2 THEN sel:=MAX(1,sel-1); END;
    IF key==12 THEN sel:=MIN(N,sel+1); END;
    IF key==7 THEN sel:=MAX(1,sel-8); first:=MAX(1,first-8); END;
    IF key==8 THEN sel:=MIN(N,sel+8); first:=MIN(MAX(1,N-7),first+8); END;
    IF key==30 THEN
      SSResultBrowse(titulo,"Detalle comparativo",{{"Indice n",n0+sel-1},{"Entrada x[n]",x(sel)},{"Salida y[n]",y(sel)},{"Error y[n]-x[n]",y(sel)-x(sel)}},"Fila "+STRING(sel),"Valores almacenados; no se aplica la limpieza visual de la tabla.");
    END;
  UNTIL key==4;
  RETURN 1;
END;

SSMenuColor(titulo)
BEGIN
  LOCAL nombre:=UPPER(titulo);
  IF INSTRING(nombre,"LTI")>0 OR INSTRING(nombre,"CONVOL")>0 OR INSTRING(nombre,"ENTRADA")>0 THEN RETURN SSAccent(2); END;
  IF INSTRING(nombre,"TRANSFORM")>0 OR INSTRING(nombre,"LAPLACE")>0 OR INSTRING(nombre,"DOMINIO")>0 THEN RETURN SSAccent(3); END;
  IF INSTRING(nombre,"FOURIER")>0 OR INSTRING(nombre,"DFT")>0 OR INSTRING(nombre,"ESPECTRO")>0 OR INSTRING(nombre,"VENTANA")>0 THEN RETURN SSAccent(4); END;
  IF INSTRING(nombre,"MUESTRE")>0 OR INSTRING(nombre,"CUANT")>0 OR INSTRING(nombre,"TASA")>0 OR INSTRING(nombre,"A/D")>0 OR INSTRING(nombre,"D/A")>0 THEN RETURN SSAccent(5); END;
  IF INSTRING(nombre,"FILTRO")>0 OR INSTRING(nombre,"FIR")>0 OR INSTRING(nombre,"IIR")>0 THEN RETURN SSAccent(6); END;
  IF INSTRING(nombre,"CONTROL")>0 OR INSTRING(nombre,"BODE")>0 OR INSTRING(nombre,"POLO")>0 THEN RETURN SSAccent(7); END;
  IF INSTRING(nombre,"TEORIA")>0 OR INSTRING(nombre,"CONCEPTO")>0 THEN RETURN SSAccent(8); END;
  RETURN SSAccent(1);
END;

SSMenuInfo(titulo,idx)
BEGIN
  LOCAL d:="Seleccione una opcion para ver su uso.";
  LOCAL e:="ENTER abre | ESC vuelve";
  LOCAL orden;
  LOCAL item:="";
  IF TYPE(idx)==6 THEN item:=idx(2); idx:=idx(1); END;
  IF titulo=="Senales continuas y discretas" THEN orden:={1,5,2,3,4,6}; idx:=orden(idx); END;
  IF titulo=="Muestreo, conversion A/D y D/A" THEN orden:={5,1,2,6,3,4,7,8}; idx:=orden(idx); END;
  IF INSTRING(titulo,"Analisis interactivo de H(")>0 THEN
    IF idx==1 THEN d:="Abre el plano; ENTER/ESC vuelven aqui."; e:="+/- zoom; circulo unidad en z"; END;
    IF idx==2 THEN d:="Consulta posiciones, ganancia y estado."; e:="Conserva multiplicidades"; END;
    IF idx==3 THEN d:="Formula actual en formato Textbook."; e:="Se actualiza al editar el diseno"; END;
    IF idx==4 THEN d:="Modifica numerador y denominador."; e:="En z: b0,b1,... y a0,a1,..."; END;
    IF idx==5 THEN d:="Cursor: agregar, mover o eliminar puntos."; e:="ENTER acciones; guardar o cancelar"; END;
    IF idx==6 THEN d:="K del producto de factores, no DC."; e:="No cambia posiciones ni estabilidad"; END;
    IF idx==7 THEN d:="Respuesta digital de la H actual."; e:="Magnitud, fase o dB; -pi...pi"; END;
    IF idx==8 THEN d:="Filtra una secuencia con este diseno."; e:="Causal, estado inicial cero"; END;
    IF idx==9 THEN d:="Consulta o exporta b y a por separado."; e:="Cada exportacion reemplaza el banco"; END;
    IF idx==10 THEN d:="Cierra este analisis."; e:="Exporte antes los coeficientes"; END;
  END;
  IF titulo=="Intervalo para SNR" THEN
    IF idx==1 THEN d:="Todas las muestras, incluida la ultima."; e:="No depende del zoom ni del grafico"; END;
    IF idx==2 THEN d:="n=0 es la primera muestra de la tabla."; e:="Elegira si incluir o excluir el final"; END;
    IF idx==3 THEN d:="Usa el tiempo o eje del registro original."; e:="Ej: t=0 a 2.5; paso Ts=0.5"; END;
    IF idx==4 THEN d:="Conserva el intervalo actual."; e:="No modifica senales ni cuantizacion"; END;
  END;
  IF titulo=="Resultado simbolico" THEN
    IF idx==1 THEN d:="Consulta la expresion calculada."; e:="Flechas desplazan formulas largas"; END;
    IF idx==2 THEN d:="Revisa los datos que ingresaste."; e:="Se conserva la entrada original"; END;
    IF idx==3 THEN d:="Variable de salida y condiciones."; e:="Interpretacion del resultado"; END;
    IF idx==4 THEN d:="Muestra la formula como texto."; e:="Alternativa completa al modo Textbook"; END;
    IF idx==5 THEN d:="Regresa al menu de operaciones."; e:="Tambien puedes pulsar ESC"; END;
  END;
  IF titulo=="Fourier continua directa" OR titulo=="Fourier continua inversa" THEN
    d:="Resultado de Fourier en ventana finita."; e:="w en rad/s; t en segundos";
    IF idx==1 THEN d:="Formula CAS o suma numerica explicita."; e:="Textbook y expresion lineal"; END;
    IF idx==2 THEN d:="Magnitud de la salida numerica."; e:="No reemplaza el resultado simbolico"; END;
    IF idx==3 THEN d:="Fase de la salida, en radianes."; e:="En magnitud nula la fase es N/D, no cero. Los saltos no se unen con rectas."; END;
    IF idx==4 THEN d:="Consulta los datos de entrada."; e:="La expresion se conserva"; END;
    IF idx==5 THEN d:="Tabla de salida real y compleja."; e:="Inversa: luego muestra parte real"; END;
    IF idx==6 THEN d:="Guarda valores complejos y su eje."; e:="Elija banco, listas o tabla; no se escriben todos los destinos automaticamente"; END;
    IF idx==7 THEN d:="Convencion, ventana y aproximacion."; e:="No cambia los ajustes del CAS"; END;
    IF idx==8 THEN d:="Regresa al menu Fourier."; e:="ESC tambien vuelve"; END;
  END;
  IF titulo=="Formula de Fourier" THEN
    IF idx==1 THEN d:="Intenta resolver sobre todo el eje."; e:="Requiere convergencia o distribuciones"; END;
    IF idx==2 THEN d:="Integra solo la ventana ingresada."; e:="No es la transformada completa"; END;
    IF idx==3 THEN d:="Expande la suma usada por el grafico."; e:="Formula aproximada, puede ser larga"; END;
    IF idx==4 THEN d:="Vuelve al centro de resultados."; e:="Conserva las formulas calculadas"; END;
  END;
  IF titulo=="Interpretar datos" THEN
    IF idx==1 THEN d:="Mantiene la informacion del eje."; e:="Cambio de tasa y reconstruccion"; END;
    IF idx==2 THEN d:="Usa solo la lista de valores."; e:="Referencia nueva: 0, 1, 2, ..."; END;
    IF idx==3 THEN d:="No carga ninguna muestra."; e:="El banco guardado no se modifica"; END;
  END;
  IF titulo=="Recientes / banco" THEN d:="Resultados guardados sin recalcular."; e:="Hasta 8 registros; limite de memoria"; END;
  IF titulo=="Formula y condiciones" THEN d:="Formula y supuestos por separado."; e:="Textbook conserva una vista lineal"; END;
  IF titulo=="Transformada Z" THEN
    IF idx==1 THEN d:="Lista finita e indice inicial."; e:="Ej: {1,2,1}, n inicial=0"; END;
    IF idx==2 THEN d:="Formula en n minuscula."; e:="Ej: (1/2)^n*Heaviside(n)"; END;
    IF idx==3 THEN d:="Busca una formula por tablas y CAS."; e:="Entrada x[n]; use n. Revise condiciones y region de convergencia del resultado."; END;
    IF idx==4 THEN d:="Regresa al menu de transformadas."; e:="No inicia un calculo nuevo."; END;
  END;
  IF titulo=="Resultados de transformada Z" THEN
    IF idx==1 THEN d:="Expresion calculada en z y contexto."; e:="Textbook o vista lineal"; END;
    IF idx==2 THEN d:="Modulo en el contorno z=r*exp(i*w)."; e:="Radio inicial r=1; revise la ROC"; END;
    IF idx==3 THEN d:="Fase principal del resultado en radianes."; e:="En ceros no esta definida"; END;
    IF idx==4 THEN d:="101 valores complejos con eje w."; e:="ENTER detalle; N/D no es cero"; END;
    IF idx==5 THEN d:="Exporta X(z) evaluada en el contorno."; e:="L0 valores; L1 w; radio en el nombre"; END;
    IF idx==6 THEN d:="Elija un radio positivo dentro de la ROC."; e:="Se recalcula; no cambia X(z)"; END;
    IF idx==7 THEN d:="Entrada, radio y alcance de los graficos."; e:="No es un diagrama de polos y ceros"; END;
    IF idx==8 THEN d:="Regresa al menu Transformadas."; e:="ESC tambien vuelve"; END;
  END;
  IF titulo=="Fourier discreta" THEN
    IF idx==1 THEN d:="DFT de lista o expresion sobre n=0...N-1."; e:="N natural es la cantidad cargada"; END;
    IF idx==2 THEN d:="IDFT desde una lista de coeficientes."; e:="Salida temporal discreta"; END;
    IF idx==3 THEN d:="DTFT continua en w de una secuencia finita."; e:="Expresion o lista; conserva n inicial"; END;
    IF idx==4 THEN d:="DTFT simbolica de la senal completa."; e:="Usa tablas, propiedades y CAS. No confundir con la DTFT de una lista truncada."; END;
    IF idx==5 THEN d:="Regresa al menu Fourier."; e:="ESC tambien vuelve"; END;
  END;
  IF titulo=="Resultados DTFT finita" THEN
    IF idx==1 THEN d:="Suma explicita de las muestras del intervalo."; e:="No es la DTFT de una senal infinita"; END;
    IF idx==2 THEN d:="Modulo en w=-pi...pi rad/muestra."; e:="DTFT continua; 201 puntos dibujados"; END;
    IF idx==3 THEN d:="Fase principal en radianes."; e:="El indice inicial cambia la fase"; END;
    IF idx==4 THEN d:="Resultado complejo y frecuencia w."; e:="ENTER detalle; + exporta"; END;
    IF idx==5 THEN d:="Muestras usadas, con indices enteros."; e:="Fuera del intervalo se supone cero"; END;
    IF idx==6 THEN d:="Exporta valores complejos con eje w."; e:="No exporta muestras temporales"; END;
    IF idx==7 THEN d:="Ventana, formula y limites numericos."; e:="No confundir DTFT, DFT y serie"; END;
    IF idx==8 THEN d:="Activa u oculta la DFT del mismo registro."; e:="Luego abra magnitud o fase; tecla 1 alterna"; END;
    IF idx==9 THEN d:="Regresa al menu Fourier."; e:="ESC tambien vuelve"; END;
  END;
  IF titulo=="Entrada serie continua" THEN
    IF idx==1 THEN d:="Expresion de un periodo, armonicos -K a K."; e:="Use X; tabla, formula y suma parcial"; END;
    IF idx==2 THEN d:="Pulsos repetidos sin escribir formula."; e:="T=2, A=1, ancho=1, centro=0"; END;
    IF idx==3 THEN d:="Impulsos ideales con area definida."; e:="T=2, area=1: todos |c[k]|=0.5"; END;
    IF idx==4 THEN d:="Regresa al menu Fourier."; e:="ESC tambien cancela"; END;
  END;
  IF titulo=="Fourier de tren periodico" THEN
    IF idx==1 THEN d:="Coeficientes de -K a K, incluido c[0]."; e:="ENTER detalle; + exporta la tabla"; END;
    IF idx==2 THEN d:="Espectro de lineas por armonico k."; e:="Frecuencia de cada linea: k/T Hz"; END;
    IF idx==3 THEN d:="Fase en radianes por armonico."; e:="En coeficientes nulos la fase es N/D"; END;
    IF idx==4 THEN d:="Formula general y valor medio c[0]."; e:="Los coeficientes son analiticos"; END;
    IF idx==5 THEN d:="Muestra la forma de la entrada."; e:="Dirac: tallos de area, no altura"; END;
    IF idx==6 THEN d:="Suma finita de los armonicos elegidos."; e:="No confundir un pico con una Dirac"; END;
    IF idx==7 THEN d:="Guarda c[k] y su eje de armonicos."; e:="L0=coeficientes; L1=k; M0=tabla"; END;
    IF idx==8 THEN d:="Definicion, parametros y limites."; e:="Diferencia entre ancho y area"; END;
    IF idx==9 THEN d:="Edita T, A, B, ancho, centro o K."; e:="Conserva los demas parametros"; END;
    IF idx==10 THEN d:="Regresa al menu Fourier."; e:="ESC tambien vuelve"; END;
  END;
  IF titulo=="Fourier por expresion" THEN
    IF idx==1 THEN d:="Todos los coeficientes de -K a K."; e:="ENTER detalle complejo; + exporta"; END;
    IF idx==2 THEN d:="Magnitud por indice armonico entero."; e:="Frecuencia fisica: k/T Hz"; END;
    IF idx==3 THEN d:="Fase en radianes; en cero no definida."; e:="En coeficientes nulos la fase es N/D"; END;
    IF idx==4 THEN d:="Suma explicita o coeficiente general CAS."; e:="Aproximacion numerica y simbolica separadas"; END;
    IF idx==5 THEN d:="Muestras de un periodo de la expresion."; e:="Tiempo t; grafico de la parte real"; END;
    IF idx==6 THEN d:="Reconstruccion usando todos los c[k]."; e:="Parte real; ENTER tabla compleja"; END;
    IF idx==7 THEN d:="Guarda coeficientes complejos y eje k."; e:="L0=c[k]; L1=k; M0=tabla"; END;
    IF idx==8 THEN d:="Periodo, precision y alcance del calculo."; e:="N>2*K no garantiza precision suficiente"; END;
    IF idx==9 THEN d:="Edita expresion, periodo, K o precision N."; e:="Recalcula; exporta otra vez si cambias"; END;
    IF idx==10 THEN d:="Regresa al menu Fourier."; e:="ESC tambien vuelve"; END;
  END;
  IF INSTRING(titulo,"Generador discreto")>0 THEN
    IF idx==1 THEN d:="Impulso unitario o escalado."; e:="Ej: A=1, p=0"; END;
    IF idx==2 THEN d:="Escalon desplazado."; e:="Ej: A=1, p=0"; END;
    IF idx==3 THEN d:="Rampa discreta desplazada."; e:="Ej: A=1, p=0"; END;
    IF idx==4 THEN d:="Exponencial discreta."; e:="Ej: A=1, base=0.8"; END;
    IF idx==5 THEN d:="Seno discreto con fase."; e:="Ej: w/pi=0.25, fase=0"; END;
    IF idx==6 THEN d:="Pulso de ancho configurable."; e:="Ej: A=1, p=0, ancho=3"; END;
    IF idx==7 THEN d:="Escriba cualquier formula x[n]."; e:="Ej: COS(pi*X/4)"; END;
  END;
  IF INSTRING(titulo,"Cambio de tasa")>0 THEN
    IF idx==1 THEN d:="Conserva una muestra cada M."; e:="Lista o expresion; ej: COS(X), M=2"; END;
    IF idx==2 THEN d:="Inserta L-1 ceros entre muestras."; e:="Lista o expresion; ej: X^2, L=3"; END;
    IF idx==3 THEN d:="Agrega muestras por rectas entre puntos."; e:="Lista o expresion; ej: SIN(X), L=4"; END;
