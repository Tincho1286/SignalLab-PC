    IF idx==9 THEN d:="Regresa al tablero de modulos."; e:="Presione ENTER para volver"; END;
  END;
  // El rotulo real resuelve menus dinamicos: no inferir la accion por su numero.
  IF titulo=="Fuente de datos" THEN
    IF item=="Usar lista L0 de Home" THEN d:="Carga los valores guardados en L0."; e:="L0 no contiene tiempos. Luego elija indices desde cero o asocie un eje uniforme de L1."; END;
  END;
  IF titulo=="Destino de exportacion" THEN
    IF idx==1 THEN d:="Guarda valores y eje dentro de SignalLab."; e:="Menor consumo. Reemplaza el banco anterior; no escribe listas Home ni historial."; END;
    IF idx==2 THEN d:="Guarda valores en L0 y su eje en L1."; e:="Reemplaza ambas listas de Home. El banco y M0 no se actualizan."; END;
    IF idx==3 THEN d:="Guarda dos columnas: eje y valor."; e:="Reemplaza M0. Las listas y el banco no se actualizan."; END;
    IF idx==4 THEN d:="Actualiza banco, listas y tabla."; e:="Genera varias copias y consume mas memoria. No agrega el registro al historial."; END;
    IF idx==5 THEN d:="Agrega este resultado a Recientes."; e:="El historial tiene limites de cantidad y memoria; no es una copia de seguridad permanente."; END;
  END;
  IF titulo=="Resultados de cuantizacion" THEN
    IF idx==1 THEN d:="Compara entrada, cuantizacion y error."; e:="Cada fila conserva el eje original. Error = xq-x; no es el error relativo."; END;
    IF idx==2 THEN d:="Superpone original y cuantizada."; e:="Los niveles dependen del rango, bits, redondeo y opcion de nivel cero."; END;
    IF idx==3 THEN d:="Grafica el error con su signo."; e:="Error = xq-x. Un error negativo indica que xq es menor que x."; END;
    IF idx==4 THEN d:="Consulta niveles, paso y SNR."; e:="SNR lineal = suma |x|^2 / suma |xq-x|^2. En dB se aplica 10*log10(SNR)."; END;
    IF idx==5 THEN d:="Elige las muestras usadas para SNR."; e:="Por n: la primera muestra es n=0. Por eje: usa el tiempo original. El final se confirma como incluido o excluido."; END;
  END;
  IF titulo=="Correlacion y autocorrelacion" THEN
    d:="Mide similitud al desplazar una senal.";
    IF idx==1 OR idx==2 THEN e:="Entrada discreta: lista o formula. Elija registro finito (lineal) o un periodo (circular). Normalizacion disponible en el resultado."; END;
    IF idx==3 OR idx==4 THEN e:="Entrada continua con X como tiempo. El calculo numerico usa una ventana finita; no supone periodicidad."; END;
    IF idx==5 THEN e:="Ingrese un periodo discreto completo. El retardo es circular; no se agregan ceros fuera del periodo."; END;
    IF idx==6 THEN e:="Ingrese la formula de un periodo y T. Integra un periodo con extension periodica; la escala se elige en el resultado."; END;
  END;
  IF titulo=="Modelo de correlacion discreta" THEN
    IF idx==1 THEN d:="Fuera del registro se supone cero."; e:="Correlacion lineal: el solapamiento cambia con el retardo. No es la autocorrelacion de una senal periodica."; END;
    IF idx==2 THEN d:="La lista representa un periodo."; e:="Correlacion circular: los indices se repiten modulo L. No duplica la muestra del extremo final."; END;
  END;
  IF titulo=="Escala de correlacion" THEN
    d:="Cambia la escala, no el retardo ni el signo.";
    IF idx==1 THEN e:="Suma discreta o integral continua sin dividir por energia ni longitud."; END;
    IF idx==2 THEN e:="Divide por la energia de referencia indicada en la opcion. En autocorrelacion, el valor en retardo cero es 1 si la energia es positiva."; END;
    IF idx==3 THEN e:="Divide por la longitud L o el periodo T. No es la normalizacion por energia."; END;
  END;
  IF titulo=="Metodo D/A" THEN
    IF idx==1 THEN d:="Mantiene la muestra hasta la siguiente."; e:="Reconstruccion por escalones; Ts fija la distancia temporal."; END;
    IF idx==2 THEN d:="Une muestras mediante segmentos rectos."; e:="No es un filtro ideal ni una reconstruccion SINC."; END;
    IF idx==3 THEN d:="Suma funciones SINC desplazadas."; e:="Usa Ts y el registro finito. La reconstruccion ideal infinita exige banda limitada y muestreo sin aliasing."; END;
  END;
  IF item=="FIR Hamming centrado" THEN d:="Filtra con un nucleo FIR finito y centrado."; e:="Reduce altas frecuencias. Al centrarlo se compensa el retardo del nucleo; los bordes dependen del registro disponible."; END;
  IF item=="IIR causal por coeficientes b/a" THEN d:="Aplica una ecuacion en diferencias."; e:="b={b0,b1,...}, a={a0,a1,...}; a0 no puede ser cero. Estado inicial nulo. Ejemplo: b={0.5}, a={1,-0.5}."; END;
  IF item=="Pasa bajos ideal: amplitud y corte" THEN d:="Define un filtro rectangular en frecuencia."; e:="Ingrese ganancia A y corte fc en ciclos/muestra o wc en rad/muestra. La salida discreta y la curva SINC extra son vistas diferentes."; END;
  IF item=="Sin filtro" THEN d:="Desactiva el filtrado opcional."; e:="Conserva la operacion principal. No modifica las muestras originales."; END;
  IF titulo=="Resultado simbolico" THEN
    IF item=="Aplicar propiedad" THEN d:="Transforma el par simbolico actual."; e:="Desplazamiento, escala, derivacion o modulacion segun el dominio. Revise condiciones en cada resultado."; END;
    IF item=="Ver transformada calculada" THEN d:="Abre la formula obtenida y sus condiciones."; e:="Textbook tiene una vista lineal alternativa para expresiones largas."; END;
  END;
  IF titulo=="Resultados DFT y Fourier" THEN
    IF INSTRING(item,"DTFT")>0 THEN d:="Activa u oculta la DTFT del mismo registro."; e:="La DFT aparece como muestras; la DTFT como curva continua en omega. No son dos senales de entrada distintas."; END;
    IF item=="Editar entrada / N" THEN d:="Recalcula desde una nueva lista o longitud."; e:="N natural es la longitud de la lista. Cancelar o ingresar datos invalidos conserva la salida anterior. Al cambiar N se aplica truncamiento o zero-padding."; END;
    IF item=="Mas vistas" THEN d:="Magnitud, fase y componentes por separado."; e:="En IDFT la vista principal conserva el signo. Para salida compleja consulte Re e Im; no se sustituye x[n] por |x[n]|."; END;
    IF INSTRING(item,"parte real")>0 THEN d:="Dibuja Re(x[n]) conservando el signo."; e:="Una muestra -8 aparece en -8. La tabla y la exportacion conservan tambien la componente imaginaria."; END;
    IF INSTRING(item,"parte imaginaria")>0 THEN d:="Dibuja Im(x[n]) como senal con signo."; e:="Una salida real tiene componente imaginaria nula, salvo residuos numericos. Original conserva las cifras almacenadas."; END;
  END;
  IF item=="Reabrir resultado / editar" THEN d:="Recupera un centro compatible para editarlo."; e:="Muestreo, DFT/IDFT/serie, cuantizacion, filtros y cambio de tasa segun los parametros guardados. El cambio de tasa recalcula sus auxiliares; cancelar conserva el registro. Guardados anteriores incompletos solo se consultan."; END;
  IF item=="Original / limpia" THEN d:="Alterna precision original y limpieza visual."; e:="Los residuos pequenos se muestran como cero segun el umbral indicado. No cambia los valores almacenados ni recalcula la senal."; END;
  IF item=="Autoescala" THEN d:="Ajusta los ejes a los datos disponibles."; e:="Solo cambia la vista; no modifica muestras. N/D no se interpreta como cero."; END;
  IF titulo=="Agregar por coordenadas" THEN
    IF item=="Polo" THEN d:="Agrega un polo escribiendo Re e Im."; e:="Ejemplo: Re=0.7, Im=0.4 situa el polo en 0.7+0.4*i. Im=0 da un polo real. No usa la posicion del cursor."; END;
    IF item=="Cero" THEN d:="Agrega un cero escribiendo Re e Im."; e:="Ejemplo: Re=1, Im=0 crea un cero en z=1. Se agrega un solo punto; los pares conjugados siguen en Mas."; END;
  END;
  IF item=="Agregar por coordenadas" THEN d:="Elija polo o cero y escriba su posicion."; e:="No necesita colocar el cursor. Hasta 32 puntos de cada tipo; modulo <=1E6. Cancelar el formulario no cambia el diseno."; END;
  IF item=="Ver H(z) del diseno" THEN d:="Muestra la transferencia actual en Textbook."; e:="Incluye los cambios sin guardar y la ganancia K. Volver conserva el editor; Guardar y volver aplica el diseno."; END;
  IF item=="Guardar en Recientes y salir" OR item=="Guardar en Recientes y volver" THEN d:="Conserva datos y parametros antes de salir."; e:="Abra Recientes desde el inicio. Hasta 8 registros; se reemplazan los mas antiguos. Si falla, permanece abierto. No sobrescribe L0, L1 ni el banco."; END;
  IF item=="Salir sin guardar" OR item=="Descartar cambios" THEN d:="Sale sin crear una copia nueva."; e:="Se pierden los cambios actuales no guardados. Las copias anteriores en Recientes y los datos exportados se conservan."; END;
  IF item=="Seguir en el resultado" OR item=="Seguir editando" THEN d:="Cancela la salida y conserva el trabajo."; e:="Vuelve al mismo resultado o diseno. ESC en esta pregunta hace lo mismo; no descarta datos."; END;
  IF item=="Mostrar/ocultar contraria" THEN d:="Alterna DFT y DTFT superpuestas."; e:="Ambas corresponden al mismo registro. Conserva sus vistas individuales."; END;
  IF item=="Activar/desactivar cursor" THEN d:="Alterna movimiento y lectura de puntos."; e:="Con cursor activo, las flechas seleccionan muestras. ENTER abre las lecturas del punto."; END;
  IF item=="Fijar este punto como A" THEN d:="Guarda el punto de referencia A."; e:="Mueva el cursor hasta otro punto B y elija Medir de A a B."; END;
  IF INSTRING(item,"Exportar")>0 THEN
    d:="Guarda los datos de esta opcion.";
    e:="Elija el destino: banco, listas L0/L1, tabla M0 o historial. Solo se actualiza lo seleccionado. Los valores y su eje se conservan; no se exporta una imagen.";
  END;
  IF d=="Seleccione una opcion para ver su uso." THEN
    d:="Abre: "+item+".";
    e:="Esta opcion pertenece a "+titulo+". Revise el titulo y las unidades del formulario o resultado antes de confirmar.";
    IF INSTRING(item,"Tabla")>0 OR INSTRING(item,"tabla")>0 THEN d:="Consulta los valores, no solo su grafico."; e:="Toque una fila y luego Detalle para ver la precision guardada. N/D indica un valor no disponible, no cero."; END;
    IF INSTRING(item,"Fase")>0 OR INSTRING(item,"fase")>0 THEN d:="Muestra el argumento del resultado complejo."; e:="La fase se expresa en radianes. En magnitud nula no esta definida; no debe interpretarse como cero."; END;
    IF INSTRING(item,"Magnitud")>0 OR INSTRING(item,"modulo")>0 THEN d:="Muestra el modulo del resultado."; e:="La magnitud es no negativa. Para una senal con signo use la vista de parte real. Revise si la escala es lineal o dB."; END;
    IF INSTRING(item,"Textbook")>0 OR INSTRING(item,"Formula")>0 THEN d:="Consulta la representacion matematica."; e:="Arrastre para desplazar. Texto muestra la expresion lineal completa; Volver regresa al resultado."; END;
    IF INSTRING(item,"Editar")>0 THEN d:="Modifica parametros de este calculo."; e:="Al confirmar se recalcula el resultado. Los datos exportados antes no se actualizan: vuelva a exportar si desea reemplazarlos."; END;
  END;
  IF item=="Eje y unidades" OR item=="Eje: w o Hz" THEN d:="Cambia coordenadas, no amplitudes ni fase."; e:="DFT: k o w rad/muestra. Hz requiere Ts en segundos: f=w/(2*pi*Ts). No aplica automaticamente un desplazamiento de fase por el origen temporal."; END;
  IF item=="Vista por indice n" THEN d:="Muestra las mismas muestras con n=0,1,..."; e:="No cambia Ts: el tiempo sigue siendo t0+n*Ts. Exportar desde esta vista guarda indices; la exportacion habitual conserva tiempo. Los limites de singularidades se consultan en la vista temporal."; END;
  IF item=="Tiempo fisico / exportar" THEN d:="Asocia segundos a la salida discreta."; e:="Indique Ts y tiempo de la primera muestra de entrada. Diezmado: Ts salida=M*Ts. Expansion/interpolacion: Ts/L. La vista principal mantiene n entero."; END;
  IF item=="Vistas y exportacion con eje original" THEN d:="Conserva el tiempo o indice importado."; e:="Tabla, comparacion, error y exportacion sobre el eje original. No cambia el intervalo de SNR, que sigue indicando sus indices efectivos."; END;
  IF item=="Editar cuantizador" THEN d:="Recalcula desde la entrada no cuantizada."; e:="Cambie bits, rango, metodo y offset sin acumular cuantizaciones. Se conserva el intervalo SNR. Cancelar mantiene salida y parametros anteriores."; END;
  IF item=="Editar H(z)" THEN d:="Modifica b y a del modelo actual."; e:="El resultado cambia solo al confirmar ambas listas. Corte, Q y tipo anteriores dejan de describir el diseno: se informa modelo por coeficientes."; END;
  IF INSTRING(item,"Fase desenrollada")>0 OR INSTRING(item,"Fase extendida")>0 THEN d:="Continua la fase por saltos de 2*pi."; e:="No une huecos N/D. Requiere una malla que resuelva las vueltas; no corrige por si sola el ruido ni una ventana temporal insuficiente."; END;
  IF INSTRING(item,"Retardo de grupo")>0 THEN d:="Estima -d(fase)/dw sin unir huecos."; e:="Muestras en sistemas digitales; segundos en H(jw). Se deriva respecto de w, aunque el eje sea Hz o logaritmico. Poco fiable cerca de ceros espectrales."; END;
  IF INSTRING(item,"PSD calibrada")>0 THEN d:="Densidad bilateral compensada por ventana."; e:="Divide |DFT|^2 por fs*sum(ventana^2). Unidades x^2/Hz, no amplitud. Confirme fs en Hz y si desea conservar DC."; END;
  IF INSTRING(item,"PSD Welch")>0 THEN d:="Promedia densidades de segmentos solapados."; e:="Elija longitud, solape y ventana. Solo segmentos completos; hasta 128. Se informa la cola omitida. La entrada original se conserva."; END;
  IF item=="Ultima operacion registrada" THEN d:="Consulta el ultimo estado registrado."; e:="Ayuda a informar fallos; no mide RAM ni demuestra la causa de un reinicio. No guarda expresiones ni listas completas."; END;
  IF item=="Limpiar contexto temporal" THEN d:="Libera marcas y metadatos transitorios."; e:="No borra banco, historial, L0/L1 ni M0. No equivale a un reinicio ni libera resultados guardados."; END;
  IF INSTRING(item,"Volver")==1 OR item=="Cancelar" THEN
    d:="Regresa sin iniciar un calculo.";
    e:="Vuelve al menu anterior. Los datos ya exportados no se borran; los cambios sin confirmar dependen del formulario.";
  END;
  RETURN {d,e};
END;

SSMenuIcon(titulo,x,y,color)
BEGIN
  LOCAL k;
  LOCAL px;
  LOCAL py;
  LOCAL hgt;
  LOCAL known:=0;
  RECT_P(x,y,x+48,y+42,RGB(203,213,225),RGB(248,250,252));
  IF INSTRING(titulo,"Senales continuas")>0 THEN
    known:=1;
    LINE_P(x+4,y+22,x+44,y+22,RGB(148,163,184));
    LINE_P(x+24,y+5,x+24,y+37,RGB(148,163,184));
    FOR k FROM 0 TO 7 DO
      px:=x+4+5*k; py:=y+22-ROUND(12*SSSinR(3.141592653589793*k/4),0);
      IF k>0 THEN LINE_P(px-5,y+22-ROUND(12*SSSinR(3.141592653589793*(k-1)/4),0),px,py,color); END;
    END;
  END;
  IF INSTRING(titulo,"Sistemas LTI")>0 THEN
    known:=1;
    RECT_P(x+3,y+8,x+18,y+21,color,RGB(255,255,255)); TEXTOUT_P("x",x+8,y+10,1,color);
    RECT_P(x+3,y+26,x+18,y+39,color,RGB(255,255,255)); TEXTOUT_P("h",x+8,y+28,1,color);
    LINE_P(x+19,y+15,x+30,y+22,color); LINE_P(x+19,y+32,x+30,y+22,color);
    RECT_P(x+31,y+15,x+45,y+29,color,color); TEXTOUT_P("y",x+36,y+18,1,RGB(255,255,255));
  END;
  IF INSTRING(titulo,"Transformadas")>0 THEN
    known:=1;
    TEXTOUT_P("L",x+7,y+7,3,color); TEXTOUT_P("Z",x+27,y+23,3,color);
    LINE_P(x+19,y+22,x+31,y+16,color);
  END;
  IF INSTRING(titulo,"Fourier")>0 THEN
    known:=1;
    LINE_P(x+4,y+35,x+44,y+35,RGB(148,163,184));
    FOR k FROM 0 TO 5 DO
      hgt:=2;
      IF k==0 THEN hgt:=25; END;
      IF k==1 THEN hgt:=12; END;
      IF k==2 THEN hgt:=7; END;
      IF k==3 THEN hgt:=4; END;
      IF k==4 THEN hgt:=3; END;
      px:=x+6+7*k; py:=y+34-hgt;
      LINE_P(px,y+35,px,py,color); RECT_P(px-1,py-1,px+1,py+1,color,color);
    END;
  END;
  IF INSTRING(titulo,"Muestreo, conversion")>0 THEN
    known:=1;
    LINE_P(x+4,y+35,x+44,y+35,RGB(148,163,184));
    FOR k FROM 0 TO 5 DO px:=x+6+7*k; py:=y+21-ROUND(12*SSSinR(3.141592653589793*k/5),0); LINE_P(px,y+35,px,py,color); RECT_P(px-2,py-2,px+2,py+2,color,color); END;
  END;
  IF INSTRING(titulo,"Filtros")>0 THEN
    known:=1;
    LINE_P(x+4,y+35,x+44,y+35,RGB(148,163,184)); LINE_P(x+4,y+5,x+4,y+35,RGB(148,163,184));
    LINE_P(x+5,y+9,x+24,y+9,color); LINE_P(x+24,y+9,x+30,y+31,color); LINE_P(x+30,y+31,x+43,y+34,color);
  END;
  IF INSTRING(titulo,"control")>0 OR INSTRING(titulo,"Control")>0 THEN
    known:=1;
    LINE_P(x+24,y+4,x+24,y+38,RGB(148,163,184)); LINE_P(x+4,y+21,x+44,y+21,RGB(148,163,184));
    LINE_P(x+10,y+12,x+16,y+18,color); LINE_P(x+10,y+18,x+16,y+12,color);
    LINE_P(x+32,y+26,x+38,y+32,color); LINE_P(x+32,y+32,x+38,y+26,color);
  END;
  IF INSTRING(titulo,"Teoria por programa")>0 THEN
    known:=1;
    RECT_P(x+12,y+5,x+36,y+37,color,color); TEXTOUT_P("i",x+21,y+10,3,RGB(255,255,255));
  END;
  IF known==0 THEN
    RECT_P(x+6,y+7,x+14,y+15,color,color);
    RECT_P(x+6,y+18,x+14,y+26,color,color);
    RECT_P(x+6,y+29,x+14,y+37,color,color);
    LINE_P(x+19,y+11,x+42,y+11,color);
    LINE_P(x+19,y+22,x+38,y+22,color);
    LINE_P(x+19,y+33,x+44,y+33,color);
  END;
  RETURN 1;
END;

SSMenu(titulo,items,seleccion)
BEGIN
  LOCAL touch;
  LOCAL button;
  LOCAL touchKeys;
  LOCAL n:=SIZE(items);
  LOCAL sel:=MAX(1,MIN(SIZE(items),seleccion));
  LOCAL key:=-1;
  LOCAL first;
  LOCAL last;
  LOCAL row;
  LOCAL yy;
  LOCAL color;
  LOCAL registroSalida:={};
  LOCAL opcionSalida:=0;
  LOCAL confirmarSalida;
  LOCAL guardadoSalida;
  LOCAL info;
  LOCAL lineas;
  LOCAL tinta;
  LOCAL fondo;
  LOCAL j;
  LOCAL dibujado:=0;
  LOCAL paginaDibujada:=0;
  LOCAL completa:=1;
  LOCAL infoSel:=0;
  LOCAL rotulos:={};
  LOCAL desplazamientoX;
  LOCAL desplazamientoY;
  // Descriptor opcional: {titulo, registro real para Recientes, opcion Salir}.
  // Solo el centro propietario lo usa; cerrar una tabla no pierde su centro.
  IF TYPE(titulo)==6 THEN
    registroSalida:=titulo(2); opcionSalida:=titulo(3); titulo:=titulo(1);
  END;
  color:=SSMenuColor(titulo);
  IF n==0 THEN RETURN 0; END;
  REPEAT
    first:=1+3*FLOOR((sel-1)/3);
    last:=MIN(n,first+2);
    IF first<>paginaDibujada THEN
      rotulos:={};
      FOR row FROM first TO last DO rotulos:=CONCAT(rotulos,{SSWrapText(items(row),32)}); END;
    END;
    // No borrar la pantalla al seleccionar ni al ignorar un toque.
    // Rotulos de la pagina e informacion seleccionada se reutilizan.
    IF completa OR first<>paginaDibujada OR sel<>dibujado THEN
    IF completa THEN
    SSHeader(titulo,"Pagina "+STRING(1+FLOOR((sel-1)/3))+"/"+STRING(CEILING(n/3))+"   |   Opcion "+STRING(sel)+" de "+STRING(n),color);
    IF SIZE(registroSalida)>0 THEN SSFooter({"Pag -","Pag +","Abrir","Guardar","Volver"},"");
    ELSE SSFooter({"Pag -","Pag +","Abrir","Ayuda","Volver"},""); END;
    ELSE
      RECT_P(9,23,319,39,RGB(15,23,42),RGB(15,23,42));
      TEXTOUT_P("Pagina "+STRING(1+FLOOR((sel-1)/3))+"/"+STRING(CEILING(n/3))+"   |   Opcion "+STRING(sel)+" de "+STRING(n),11,25,1,RGB(225,235,248),305);
    END;
    FOR row FROM first TO first+2 DO
      IF completa OR first<>paginaDibujada OR row==sel OR row==dibujado THEN
      yy:=46+(row-first)*40;
      IF row>last THEN RECT_P(8,yy,306,yy+36,RGB(245,247,251),RGB(245,247,251));
      ELSE
      tinta:=RGB(30,41,59); fondo:=RGB(255,255,255);
      IF row==sel THEN fondo:=RGB(229,239,250); END;
      RECT_P(8,yy,306,yy+36,RGB(203,213,225),fondo);
      IF row==sel THEN RECT_P(8,yy,11,yy+36,color,color); END;
      RECT_P(17,yy+10,36,yy+26,color,color);
      TEXTOUT_P(STRING(row),20,yy+13,1,RGB(255,255,255));
      lineas:=rotulos(row-first+1);
      IF SIZE(lineas)==1 THEN TEXTOUT_P(lineas(1),44,yy+11,2,tinta,258);
      ELSE
        TEXTOUT_P(lineas(1),44,yy+3,2,tinta,258);
        IF SIZE(lineas)>2 THEN lineas(2):=LEFT(lineas(2),29)+"..."; END;
        TEXTOUT_P(lineas(2),44,yy+19,2,tinta,258);
      END;
      END;
      END;
    END;
    RECT_P(312,46,315,161,RGB(225,232,240),RGB(225,232,240));
    yy:=46+FLOOR(104*(sel-1)/MAX(1,n-1)); RECT_P(312,yy,315,yy+10,color,color);
    IF infoSel<>sel THEN info:=SSMenuInfo(titulo,{sel,items(sel)}); infoSel:=sel; END;
    IF info(1)=="Seleccione una opcion para ver su uso." THEN
      info:={"Seleccion: "+items(sel),"ENTER confirma | ESC cancela"};
    END;
    RECT_P(8,168,311,212,RGB(215,223,235),RGB(255,255,255));
    RECT_P(8,168,11,212,color,color);
    lineas:=SSWrapText(info(1),48);
    FOR j FROM 1 TO MIN(2,SIZE(lineas)) DO TEXTOUT_P(lineas(j),17,173+(j-1)*12,1,RGB(51,65,85)); END;
    IF SIZE(registroSalida)>0 THEN TEXTOUT_P("Guardar conserva una copia sin salir",17,199,1,color);
    ELSE TEXTOUT_P("Toque: seleccionar | otro toque: abrir",17,199,1,color); END;
    dibujado:=sel; paginaDibujada:=first; completa:=0;
    END;
    key:=SSPause();
    IF TYPE(key)==6 THEN
      touch:=key; key:=-1;
      IF touch(5)==0 AND touch(2)>=216 AND touch(4)>=216 THEN
        button:=1+FLOOR(touch(3)*5/320);
        IF button==1+FLOOR(touch(1)*5/320) THEN
          touchKeys:={7,8,30,48,4}; key:=touchKeys(button);
          IF button==4 AND SIZE(registroSalida)>0 THEN key:=39; END;
        END;
      END;
      IF touch(2)>=46 AND touch(2)<=162 AND touch(4)>=46 AND touch(4)<=162 THEN
        IF touch(5)==0 AND touch(1)>=8 AND touch(1)<=306 AND touch(3)>=8 AND touch(3)<=306 THEN
          row:=first+FLOOR((touch(4)-46)/40);
          IF row<=last AND row==first+FLOOR((touch(2)-46)/40) AND (touch(4)-46) MOD 40<=36 AND (touch(2)-46) MOD 40<=36 THEN
            IF row==sel THEN key:=30; ELSE sel:=row; END;
          END;
        END;
      END;
      IF touch(5)==1 AND touch(2)>=45 AND touch(2)<216 THEN
        desplazamientoX:=touch(3)-touch(1); desplazamientoY:=touch(4)-touch(2);
        // Separar deslizamiento intencional de vibracion del dedo.
        // Si empieza en el contenido, puede terminar sobre la franja inferior.
        IF MAX(ABS(desplazamientoX),ABS(desplazamientoY))>=24 THEN
          IF ABS(desplazamientoX)>ABS(desplazamientoY) THEN
            IF desplazamientoX<0 THEN key:=8; ELSE key:=7; END;
          ELSE IF desplazamientoY<0 THEN key:=8; ELSE key:=7; END; END;
        END;
      END;
      IF touch(5)==0 AND touch(2)>=168 AND touch(2)<=212 AND touch(4)>=168 AND touch(4)<=212 THEN key:=48; END;
    END;
    IF key==48 THEN SSInfoView(titulo,items(sel),"QUE HACE"+CHAR(10)+info(1)+CHAR(10)+CHAR(10)+"DATOS Y ALCANCE"+CHAR(10)+info(2)+CHAR(10)+CHAR(10)+"Volver cierra esta ayuda. En el menu, Abrir o ENTER ejecuta la opcion seleccionada.",color); completa:=1; END;
    IF key==2 THEN sel:=sel-1; IF sel<1 THEN sel:=n; END; END;
    IF key==12 THEN sel:=sel+1; IF sel>n THEN sel:=1; END; END;
    IF key==7 THEN sel:=MAX(1,sel-3); END;
    IF key==8 THEN sel:=MIN(n,sel+3); END;
    IF key==39 AND SIZE(registroSalida)>0 THEN
      guardadoSalida:=SSHistoryAdd(registroSalida);
      IF guardadoSalida THEN SSInfoView("Guardado en Recientes","El resultado sigue abierto","Se guardaron los datos originales, el eje y los parametros disponibles. Puede continuar o volver al menu; la copia guardada se conserva.",color);
      ELSE SSInfoView("No se pudo guardar","El resultado sigue abierto","Recientes tiene presupuesto limitado. Exporte la lista al banco o a Home. No se descarto ni recorto el calculo.",color); END;
      key:=-1; completa:=1;
    END;
    IF SIZE(registroSalida)>0 AND (key==4 OR (key==30 AND sel==opcionSalida)) THEN
      guardadoSalida:=0;
      IFERR guardadoSalida:=SSHistoryAdd({"MATCH",registroSalida}); THEN guardadoSalida:=0; END;
      IF guardadoSalida THEN key:=4;
      ELSE
      confirmarSalida:=SSMenu("Antes de salir",{"Guardar en Recientes y salir","Salir sin guardar","Seguir en el resultado"},3);
      IF confirmarSalida==1 THEN
        guardadoSalida:=0;
        IFERR guardadoSalida:=SSHistoryAdd(registroSalida); THEN guardadoSalida:=0; END;
        IF guardadoSalida==1 THEN key:=4;
        ELSE
          SSInfoView("No se pudo guardar","El resultado sigue abierto","No se salio ni se descarto el resultado. Recientes admite 16000 caracteres por registro, 8 registros y 32000 en total. Exporte listas grandes al banco o a Home desde sus tablas; luego elija Salir sin guardar.",SSAccent(5));
          key:=-1; completa:=1;
        END;
      ELSE
        IF confirmarSalida==2 THEN key:=4;
        ELSE key:=-1; completa:=1; END;
      END;
      END;
    END;
  UNTIL key==30 OR key==4;
  IF key==4 THEN RETURN 0; END;
  RETURN sel;
END;

SSDashboard(seleccion)
BEGIN
  LOCAL touch;
  LOCAL button;
  LOCAL touchKeys;
  LOCAL sel:=MAX(1,MIN(8,seleccion));
  LOCAL key:=-1;
  LOCAL row;
  LOCAL col;
  LOCAL idx;
  LOCAL first;
  LOCAL xx;
  LOCAL yy;
  LOCAL color;
  LOCAL fondo;
  LOCAL dibujado:=0;
  LOCAL paginaDibujada:=0;
  LOCAL completa:=1;
  LOCAL desplazamientoX;
  LOCAL desplazamientoY;
  LOCAL nombres:={"SENALES","SISTEMAS LTI","TRANSFORMADAS","FOURIER","MUESTREO A/D","FILTROS","CONTROL","TEORIA"};
  LOCAL detalles:={"Crear, operar y medir","Conv. y correlacion","Laplace, Z y propiedades","Series, DFT y DTFT","Muestras y conversion","Diseno, FIR e IIR","H(jw), Bode y polos","Conceptos y ejemplos"};
  LOCAL iconos:={"Senales continuas","Sistemas LTI","Transformadas","Fourier","Muestreo, conversion","Filtros","Control","Teoria por programa"};
  REPEAT
    first:=1+4*FLOOR((sel-1)/4);
    IF completa OR first<>paginaDibujada OR sel<>dibujado THEN
    IF completa THEN
      SSHeader("SignalLab 5.0","MODULOS  "+STRING(1+FLOOR((sel-1)/4))+"/2  |  Sistemas y Senales",SSAccent(first));
      TEXTOUT_P("Toque un modulo | deslice para ver mas",12,199,1,RGB(71,85,105));
      SSFooter({"Pag -","Pag +","Recientes","Ayuda","Salir"},"");
    ELSE
      IF first<>paginaDibujada THEN
        RECT_P(9,23,319,39,RGB(15,23,42),RGB(15,23,42));
        TEXTOUT_P("MODULOS  "+STRING(1+FLOOR((sel-1)/4))+"/2  |  Sistemas y Senales",11,25,1,RGB(225,235,248),305);
        color:=SSAccent(first); RECT_P(0,0,4,39,color,color); RECT_P(0,40,319,41,color,color);
      END;
    END;
    FOR row FROM 0 TO 1 DO
      FOR col FROM 0 TO 1 DO
        idx:=first+row*2+col; xx:=8+col*156; yy:=47+row*73; color:=SSAccent(idx);
        IF completa OR first<>paginaDibujada OR idx==sel OR idx==dibujado THEN
        fondo:=RGB(255,255,255); IF idx==sel THEN fondo:=RGB(229,239,250); END;
        RECT_P(xx,yy,xx+148,yy+66,RGB(203,213,225),fondo);
        IF idx==sel THEN RECT_P(xx,yy,xx+3,yy+66,color,color); END;
        SSMenuIcon(iconos(idx),xx+7,yy+5,color);
        TEXTOUT_P(nombres(idx),xx+57,yy+12,1,RGB(15,23,42),88);
        TEXTOUT_P("ABRIR  >",xx+57,yy+29,1,color);
        TEXTOUT_P(detalles(idx),xx+7,yy+51,1,RGB(71,85,105),138);
        END;
      END;
    END;
    dibujado:=sel; paginaDibujada:=first; completa:=0;
    END;
    key:=SSPause();
    IF TYPE(key)==6 THEN
      touch:=key; key:=-1;
      IF touch(5)==0 AND touch(2)>=216 AND touch(4)>=216 THEN
        button:=1+FLOOR(touch(3)*5/320);
        IF button==1+FLOOR(touch(1)*5/320) THEN
          touchKeys:={45,50,48,49,4}; key:=touchKeys(button);
        END;
      END;
      IF touch(5)==0 AND touch(2)>=47 AND touch(2)<=186 AND touch(4)>=47 AND touch(4)<=186 AND touch(1)>=8 AND touch(1)<=312 AND touch(3)>=8 AND touch(3)<=312 THEN
        col:=FLOOR((touch(3)-8)/156); row:=FLOOR((touch(4)-47)/73);
        IF col<=1 AND (touch(3)-8) MOD 156<=148 AND (touch(1)-8) MOD 156<=148 AND (touch(4)-47) MOD 73<=66 AND (touch(2)-47) MOD 73<=66 THEN
          IF col==FLOOR((touch(1)-8)/156) AND row==FLOOR((touch(2)-47)/73) THEN sel:=first+row*2+col; key:=30; END;
        END;
      END;
      IF touch(5)==1 AND touch(2)>=47 AND touch(2)<216 THEN
        desplazamientoX:=touch(3)-touch(1); desplazamientoY:=touch(4)-touch(2);
        IF MAX(ABS(desplazamientoX),ABS(desplazamientoY))>=24 THEN
          IF ABS(desplazamientoX)>ABS(desplazamientoY) THEN
            IF desplazamientoX<0 THEN key:=50; ELSE key:=45; END;
          ELSE IF desplazamientoY<0 THEN key:=50; ELSE key:=45; END; END;
        END;
      END;
    END;
    IF key==49 THEN SSInfoView("Como navegar","Tactil y teclado","INICIO"+CHAR(10)+"Toque un modulo para abrirlo. Pag - y Pag + muestran los otros modulos."+CHAR(10)+CHAR(10)+"MENUS"+CHAR(10)+"Toque una opcion para seleccionarla y leer su resumen. Otro toque sobre la seleccion, Abrir o ENTER la ejecuta. Ayuda explica datos y limites."+CHAR(10)+CHAR(10)+"GRAFICOS"+CHAR(10)+"Arrastre con un dedo para mover. H-/H+ cambian el eje horizontal; V-/V+ el vertical. Mas abre tabla, cursor y autoescala."+CHAR(10)+CHAR(10)+"TABLAS Y FORMULAS"+CHAR(10)+"Toque una fila y luego Detalle. En Textbook arrastre para desplazar y use +/-. Volver o ESC regresa. Los formularios conservan los controles nativos de HP. No se usa pellizco de dos dedos.",SSAccent(sel)); END;
    IF key==48 THEN SSHistoryMenu(); END;
    IF key==49 OR key==48 THEN completa:=1; END;
    IF key==45 THEN sel:=MAX(1,sel-4); END;
    IF key==50 THEN sel:=MIN(8,sel+4); END;
    IF key==7 THEN sel:=sel-1; IF sel<1 THEN sel:=8; END; END;
    IF key==8 THEN sel:=sel+1; IF sel>8 THEN sel:=1; END; END;
    IF key==2 THEN sel:=sel-2; IF sel<1 THEN sel:=sel+8; END; END;
    IF key==12 THEN sel:=sel+2; IF sel>8 THEN sel:=sel-8; END; END;
  UNTIL key==30 OR key==4;
  IF key==4 THEN RETURN 0; END;
  RETURN sel;
END;

SSPlot(x,n0,titulo)
BEGIN
  RETURN SSPlotDiscrete(x,n0,1,titulo,"n");
END;

SSGraphAxes(xmin,xmax,ymin,ymax)
BEGIN
  LOCAL k;
  LOCAL px;
  LOCAL py;
  LOCAL xr:=xmax-xmin;
  LOCAL yr:=ymax-ymin;
  FOR k FROM 0 TO 5 DO
    px:=25+ROUND(286*k/5,0); LINE_P(px,47,px,183,RGB(241,245,249));
    py:=47+ROUND(136*k/5,0); LINE_P(25,py,311,py,RGB(226,232,240));
  END;
  IF ymin<=0 AND ymax>=0 THEN py:=184-ROUND((0-ymin)*138/yr,0); LINE_P(24,py,312,py,RGB(100,116,139)); END;
  IF xmin<=0 AND xmax>=0 AND ABS(xr)>1E-15 THEN px:=30+ROUND((0-xmin)*276/xr,0); LINE_P(px,46,px,184,RGB(100,116,139)); END;
  TEXTOUT_P(SSFmt(xmin,{3,ABS(xr)*1E-12}),27,188,1,RGB(71,85,105));
  TEXTOUT_P(SSFmt((xmin+xmax)/2,{3,ABS(xr)*1E-12}),145,188,1,RGB(71,85,105));
  TEXTOUT_P(SSFmt(xmax,{3,ABS(xr)*1E-12}),270,188,1,RGB(71,85,105));
  TEXTOUT_P(SSFmt(ymax,{3,ABS(yr)*1E-12}),28,49,1,RGB(71,85,105));
  TEXTOUT_P(SSFmt((ymin+ymax)/2,{3,ABS(yr)*1E-12}),28,111,1,RGB(71,85,105));
  TEXTOUT_P(SSFmt(ymin,{3,ABS(yr)*1E-12}),28,172,1,RGB(71,85,105));
  RETURN 1;
END;

SSPlotDiscrete(x,x0,dx,titulo,xlabel)
BEGIN
  LOCAL touch;
  LOCAL button;
  LOCAL touchKeys;
  LOCAL touchDrag:=0;
  LOCAL original:=x;
  LOCAL limpia:=1;
  LOCAL limpiaAnterior:=-1;
  LOCAL estadoVista;
  LOCAL cursor:=0;
  LOCAL anchor:=0;
  LOCAL selected:=1;
  LOCAL N:=SIZE(x);
  LOCAL k;
  LOCAL xp;
  LOCAL yp;
  LOCAL base;
  LOCAL ymin;
  LOCAL ymax;
  LOCAL rango;
  LOCAL gy;
  LOCAL gx;
  LOCAL key;
  LOCAL color:=SSAccent(1);
  LOCAL first:=1;
  LOCAL last;
  LOCAL viewN:=N;
  LOCAL count;
  LOCAL newN;
  LOCAL centerIdx;
  LOCAL paso;
  LOCAL yZoom:=1;
  LOCAL yPan:=0;
  LOCAL yCenter;
  LOCAL xv0;
  LOCAL xv1;
  LOCAL dataYmin:=0;
  LOCAL dataYmax:=0;
  LOCAL found:=0;
  IF N==0 THEN RETURN 0; END;
  IF TYPE(x)<>6 OR SSIsDrawable(x0)==0 OR SSIsDrawable(dx)==0 THEN RETURN 0; END;
  IF IM(x0)<>0 OR IM(dx)<>0 OR dx<=0 THEN SSInfoView(titulo,"Eje invalido","Use origen real y paso positivo. No se dibujaron datos sobre un eje invalido.",color); RETURN 0; END;
  REPEAT
  IF limpia<>limpiaAnterior THEN
  x:=original; estadoVista:="Original | 5 limpia";
  IF limpia==1 THEN x:=SSCleanComplex({original,1E-10}); estadoVista:="Cero <=1E-10 | 5 original"; END;
  found:=0;
  FOR k FROM 1 TO N DO
    IF SSIsDrawable(x(k)) THEN
      IF found==0 THEN dataYmin:=RE(x(k)); dataYmax:=RE(x(k)); found:=1;
      ELSE dataYmin:=MIN(dataYmin,RE(x(k))); dataYmax:=MAX(dataYmax,RE(x(k))); END;
    END;
  END;
  IF found==0 THEN SSInfoView(titulo,"Sin valores representables","Todas las muestras son N/D o estan fuera de rango. No se sustituyeron por ceros.",color); RETURN 0; END;
  dataYmin:=MIN(0,dataYmin); dataYmax:=MAX(0,dataYmax);
  IF dataYmax==dataYmin THEN dataYmin:=-1; dataYmax:=1; END;
  limpiaAnterior:=limpia;
  END;
    viewN:=MAX(1,MIN(N,viewN)); first:=MAX(1,MIN(N-viewN+1,first)); last:=MIN(N,first+viewN-1); count:=last-first+1;
    selected:=MAX(first,MIN(last,selected));
    ymin:=dataYmin; ymax:=dataYmax;
    yCenter:=(ymax+ymin)/2+yPan; rango:=(ymax-ymin)*1.2/yZoom; ymin:=yCenter-rango/2; ymax:=yCenter+rango/2;
    xv0:=x0+(first-1)*dx; xv1:=x0+(last-1)*dx;
    SSHeader(titulo,xlabel+"="+SSFmt(xv0,5)+" ... "+SSFmt(xv1,5)+" | "+STRING(count)+" visibles",color);
    RECT_P(24,46,312,184,RGB(203,213,225),RGB(255,255,255));
    SSGraphAxes(xv0,xv1,ymin,ymax);
    base:=ROUND(184-(0-ymin)*138/rango,0); base:=MAX(46,MIN(184,base));
    FOR k FROM first TO last DO
      IF count==1 THEN xp:=168; ELSE xp:=ROUND(30+(k-first)*276/(count-1),0); END;
      IF SSIsDrawable(x(k)) THEN
        // Recortar el tallo, sin convertir su extremo exterior en muestra.
        IF MAX(0,RE(x(k)))>=ymin AND MIN(0,RE(x(k)))<=ymax THEN
          yp:=ROUND(184-(MAX(ymin,MIN(ymax,RE(x(k))))-ymin)*138/rango,0);
          LINE_P(xp,base,xp,yp,color);
        END;
        IF RE(x(k))>=ymin AND RE(x(k))<=ymax THEN
          yp:=ROUND(184-(RE(x(k))-ymin)*138/rango,0);
          IF SSEventType(k)==1 THEN
            RECT_P(xp-3,MAX(46,yp-3),xp+3,MIN(184,yp+3),color);
            RECT_P(xp-1,MAX(46,yp-1),xp+1,MIN(184,yp+1),RGB(255,255,255),RGB(255,255,255));
          ELSE RECT_P(xp-2,MAX(46,yp-2),xp+2,MIN(184,yp+2),color,color); END;
        END;
      END;
      // N/D: no dibujar marcador ni inventar una muestra.
    END;
    TEXTOUT_P(estadoVista,28,202,1,RGB(71,85,105));
    IF cursor==1 THEN
      IF anchor>=first AND anchor<=last THEN SSDrawCursor(x,x0,dx,anchor,first,last,ymin,ymax); END;
      SSDrawCursor(x,x0,dx,selected,first,last,ymin,ymax);
      IF anchor>0 THEN TEXTOUT_P("A=#"+STRING(anchor),250,48,1,RGB(190,24,93),58); END;
    END;
    touchDrag:=0;
    SSFooter({"H-","H+","V-","V+","Mas","Volver"},"");
    key:=SSPause();
    IF TYPE(key)==6 THEN
      touch:=key; key:=-1;
      IF touch(5)==0 AND touch(2)>=216 AND touch(4)>=216 THEN
        button:=1+FLOOR(touch(3)*6/320);
        IF button==1+FLOOR(touch(1)*6/320) THEN
          touchKeys:={45,50,35,40,49,4}; key:=touchKeys(button);
        END;
      END;
      IF touch(1)>=24 AND touch(1)<=312 AND touch(2)>=46 AND touch(2)<=184 AND touch(4)<216 THEN
        IF touch(5)==0 AND touch(3)>=24 AND touch(3)<=312 AND touch(4)>=46 AND touch(4)<=184 THEN
          selected:=MAX(first,MIN(last,ROUND(first+(touch(3)-30)*(count-1)/276,0))); cursor:=1;
        END;
        IF touch(5)==1 THEN
          cursor:=0; touchDrag:=1;
          first:=MAX(1,MIN(N-viewN+1,first-ROUND((touch(3)-touch(1))*(count-1)/276,0)));
          yPan:=yPan+(touch(4)-touch(2))*rango/138;
        END;
      END;
    END;
    IF key==49 THEN
      button:=SSMenu("Acciones del grafico",{"Tabla completa","Lectura del cursor","Activar/desactivar cursor","Original / limpia","Autoescala","Volver al grafico"},1);
      key:=-1;
      IF button==1 THEN cursor:=0; key:=30; END;
      IF button==2 THEN cursor:=1; key:=30; END;
      IF button==3 THEN key:=48; END;
      IF button==4 THEN key:=38; END;
      IF button==5 THEN key:=47; END;
    END;
    IF key==38 THEN limpia:=1-limpia; yZoom:=1; yPan:=0; END;
    IF key==48 THEN cursor:=1-cursor; END;
    IF key==30 THEN
      IF cursor==1 THEN anchor:=SSCursorDetail(original,x0,dx,{selected,anchor},titulo);
      ELSE SSDataView(original,x0,dx,titulo,xlabel,"valor",color); END;
    END;
    IF key==50 THEN
      centerIdx:=first+(count-1)/2; IF N==1 THEN newN:=1; ELSE newN:=MAX(2,FLOOR(count/1.5)); END;
      first:=ROUND(centerIdx-(newN-1)/2,0); viewN:=newN;
    END;
    IF key==45 THEN
      centerIdx:=first+(count-1)/2; IF N==1 THEN newN:=1; ELSE newN:=MIN(N,MAX(count+1,ROUND(count*1.5,0))); END;
      first:=ROUND(centerIdx-(newN-1)/2,0); viewN:=newN;
    END;
    IF key==40 THEN yZoom:=MIN(64,yZoom*1.25); END;
    IF key==35 THEN yZoom:=MAX(0.125,yZoom/1.25); END;
    paso:=MAX(1,FLOOR(count/4));
    IF key==7 THEN
      IF cursor==1 THEN selected:=MAX(1,selected-1); IF selected<first THEN first:=selected; END;
      ELSE first:=MAX(1,first-paso); END;
    END;
    IF key==8 THEN
      IF cursor==1 THEN selected:=MIN(N,selected+1); IF selected>last THEN first:=selected-viewN+1; END;
      ELSE first:=MIN(N-viewN+1,first+paso); END;
    END;
    IF key==2 THEN yPan:=yPan+0.15*rango; END;
    IF key==12 THEN yPan:=yPan-0.15*rango; END;
    IF key==47 THEN first:=1; viewN:=N; yZoom:=1; yPan:=0; selected:=1; END;
  UNTIL key==4;
  RETURN 1;
END;

SSPlotXY(y,x0,dx,titulo,subtitulo)
BEGIN
  LOCAL loDer;
  LOCAL hiDer;
  LOCAL denDer;
  LOCAL baseYLista:=0;
  LOCAL baseYMin;
  LOCAL baseYMax;
  LOCAL touch;
  LOCAL button;
  LOCAL touchKeys;
  LOCAL touchDrag:=0;
  LOCAL respuesta:=0;
  LOCAL recalcular:=1;
  LOCAL base0:=x0;
  LOCAL base1:=x0+(SIZE(y)-1)*dx;
  LOCAL r0:=base0;
  LOCAL r1:=base1;
  LOCAL ancho;
  LOCAL centro;
  LOCAL espectro;
  LOCAL eventos:=SSEVAL_EVENTS;
  LOCAL faseGrafico:=INSTRING(UPPER(titulo),"FASE")>0;
  LOCAL original:=y;
  LOCAL limpia:=1;
  LOCAL limpiaAnterior:=-1;
  LOCAL curvaLimpiaAnterior:=-1;
  LOCAL estadoVista;
  LOCAL ideal:=0;
  LOCAL escalon:=0;
  LOCAL modelo;
  LOCAL muestrasModelo;
  LOCAL curva;
  LOCAL curvaOriginal;
  LOCAL curvaFirst:=-1;
  LOCAL curvaLast:=-1;
  LOCAL q;
  LOCAL j;
  LOCAL u;
  LOCAL v;
  LOCAL suma;
  LOCAL pirad:=3.141592653589793;
  LOCAL cursor:=0;
  LOCAL anchor:=0;
  LOCAL selected:=1;
  LOCAL N:=SIZE(y);
  LOCAL k;
  LOCAL px;
  LOCAL py;
  LOCAL oldx;
  LOCAL oldy;
  LOCAL ymin;
  LOCAL ymax;
  LOCAL rango;
  LOCAL gy;
  LOCAL gx;
  LOCAL key;
  LOCAL color:=SSAccent(3);
  LOCAL first:=1;
  LOCAL last;
  LOCAL viewN:=N;
  LOCAL count;
  LOCAL newN;
  LOCAL centerIdx;
  LOCAL paso;
  LOCAL yZoom:=1;
  LOCAL yPan:=0;
  LOCAL yCenter;
  LOCAL xv0;
  LOCAL xv1;
  LOCAL dataYmin:=0;
  LOCAL dataYmax:=0;
  LOCAL found:=0;
  LOCAL haveOld:=0;
  LOCAL clipA;
  LOCAL clipB;
  LOCAL deltaY;
  LOCAL segX1;
  LOCAL segX2;
  LOCAL segY1;
  LOCAL segY2;
  // Metadatos del ideal: {subtitulo,entrada,A,fc,origen,escala,offset}.
  // El eje sigue siendo el indice de salida; no se inventan muestras discretas.
  IF TYPE(subtitulo)==6 THEN
    modelo:=subtitulo; subtitulo:=modelo(1);
    IF TYPE(modelo(2))==2 THEN
      IF modelo(2)=="RESPONSE" THEN respuesta:=1; SSEVAL_EVENTS:={}; faseGrafico:=modelo(6)==2; END;
      IF modelo(2)=="ZOH" THEN escalon:=1; END;
    ELSE muestrasModelo:=modelo(2); ideal:=1; END;
  END;
  IF N==0 THEN RETURN 0; END;
  IF TYPE(y)<>6 OR SSIsDrawable(x0)==0 OR SSIsDrawable(dx)==0 THEN RETURN 0; END;
  IF IM(x0)<>0 OR IM(dx)<>0 OR dx<=0 THEN SSInfoView(titulo,"Eje invalido","Use origen real y paso positivo. No se dibujaron datos sobre un eje invalido.",color); RETURN 0; END;
  REPEAT
  IF respuesta==1 AND recalcular==1 THEN
    SSHeader(titulo,"Recalculando ventana visible...",color);
    N:=277; x0:=r0; dx:=(r1-r0)/(N-1);
    espectro:=SSFResponse(modelo(3),modelo(4),{N,x0,dx,modelo(5)});
    original:=MAKELIST(SSUndef(),k,1,N,1);
    IF modelo(6)==4 OR modelo(6)==5 THEN
      original:=SSPhase({espectro,"UNWRAP",dx});
      IF modelo(6)==5 THEN
        y:=original; original:=MAKELIST(SSUndef(),k,1,N,1);
        FOR k FROM 1 TO N DO
          IF SSIsDrawable(y(k)) THEN
            loDer:=k; hiDer:=k;
            IF k>1 THEN IF SSIsDrawable(y(k-1)) THEN loDer:=k-1; END; END;
            IF k<N THEN IF SSIsDrawable(y(k+1)) THEN hiDer:=k+1; END; END;
            IF hiDer>loDer THEN
              denDer:=(hiDer-loDer)*dx;
              IF modelo(5)==3 THEN denDer:=10^(x0+(hiDer-1)*dx)-10^(x0+(loDer-1)*dx); END;
              IF denDer>0 THEN original(k):=-(y(hiDer)-y(loDer))/denDer; END;
            END;
          END;
        END;
      END;
    ELSE
    IF modelo(6)==2 THEN original:=SSPhase(espectro);
    ELSE
      FOR k FROM 1 TO N DO
        IF SSIsDrawable(espectro(k)) THEN
          IF modelo(6)==1 THEN original(k):=ABS(espectro(k));
          ELSE IF ABS(espectro(k))==0 THEN original(k):=SSNegInf(); ELSE original(k):=20*LOG(ABS(espectro(k))); END; END;
        END;
      END;
    END;
    END;
    espectro:={}; limpiaAnterior:=-1;
    first:=1; viewN:=N; selected:=1; anchor:=0; recalcular:=0;
  END;
  IF limpia<>limpiaAnterior THEN
  y:=original; estadoVista:="Original | 5 limpia";
  IF limpia==1 THEN y:=SSCleanComplex({original,1E-10}); estadoVista:="Cero <=1E-10 | 5 original"; END;
  limpiaAnterior:=limpia;
  END;
  IF respuesta==1 THEN estadoVista:="277 puntos visibles | 5 vista"; END;
  found:=0;
  FOR k FROM 1 TO N DO
    IF SSIsDrawable(y(k)) THEN
      IF found==0 THEN dataYmin:=RE(y(k)); dataYmax:=RE(y(k)); found:=1;
      ELSE dataYmin:=MIN(dataYmin,RE(y(k))); dataYmax:=MAX(dataYmax,RE(y(k))); END;
    END;
  END;
  IF found==0 THEN SSInfoView(titulo,"Sin valores representables","Toda esta ventana es N/D o fuera de rango. Revise expresion, coeficientes y dominio; un polo no se transforma en cero.",color); SSEVAL_EVENTS:=eventos; RETURN 0; END;
  dataYmin:=MIN(0,dataYmin); dataYmax:=MAX(0,dataYmax);
  IF dataYmax==dataYmin THEN dataYmin:=-1; dataYmax:=1; END;
    viewN:=MAX(1,MIN(N,viewN)); first:=MAX(1,MIN(N-viewN+1,first)); last:=MIN(N,first+viewN-1); count:=last-first+1;
    selected:=MAX(first,MIN(last,selected));
    IF ideal==1 THEN
      IF first<>curvaFirst OR last<>curvaLast THEN
        SSHeader(titulo,"Evaluando SINC en la ventana...",color);
        curvaOriginal:=MAKELIST(0,q,0,276,1);
        FOR q FROM 0 TO 276 DO
          // Una evaluacion del modelo por columna, nueva al hacer zoom horizontal.
          u:=modelo(6)*(x0+(first-1+(count-1)*q/276)*dx)+modelo(7)-modelo(5);
          suma:=0;
          IFERR
            FOR j FROM 1 TO SIZE(muestrasModelo) DO
              v:=muestrasModelo(j);
              IF ABS(v)>0 THEN
                gx:=u-(j-1); gy:=2*modelo(4)*gx;
                IF gx==0 THEN suma:=suma+v*2*modelo(3)*modelo(4);
                ELSE
                  // Limite estable cerca del origen; ceros enteros exactos.
                  IF ABS(gy)<1E-6 THEN suma:=suma+v*2*modelo(3)*modelo(4)*(1-(pirad*gy)^2/6);
                  ELSE IF gy<>FLOOR(gy) THEN suma:=suma+v*modelo(3)*SSSinR(pirad*gy)/(pirad*gx); END; END;
                END;
              END;
            END;
          THEN suma:=SSUndef(); END;
          curvaOriginal(q+1):=suma;
        END;
        curvaFirst:=first; curvaLast:=last; curvaLimpiaAnterior:=-1;
      END;
      IF limpia<>curvaLimpiaAnterior THEN
      curva:=curvaOriginal;
      IF limpia==1 THEN curva:=SSCleanComplex({curvaOriginal,1E-10}); END;
      curvaLimpiaAnterior:=limpia;
      END;
      // Incluir crestas entre muestras, sin recortarlas al rango de los puntos.
      FOR q FROM 1 TO SIZE(curva) DO
        IF SSIsDrawable(curva(q)) THEN dataYmin:=MIN(dataYmin,RE(curva(q))); dataYmax:=MAX(dataYmax,RE(curva(q))); END;
      END;
    END;
    // Fijar tambien la escala base: recalcular X no cambia unidades por pixel Y.
    IF baseYLista==0 THEN baseYMin:=dataYmin; baseYMax:=dataYmax; baseYLista:=1; END;
    ymin:=baseYMin; ymax:=baseYMax;
    yCenter:=(ymax+ymin)/2+yPan; rango:=(ymax-ymin)*1.2/yZoom; ymin:=yCenter-rango/2; ymax:=yCenter+rango/2;
    xv0:=x0+(first-1)*dx; xv1:=x0+(last-1)*dx;
    SSHeader(titulo,subtitulo+" | "+SSFmt(xv0,4)+" ... "+SSFmt(xv1,4),color);
    RECT_P(24,46,312,184,RGB(203,213,225),RGB(255,255,255));
    SSGraphAxes(xv0,xv1,ymin,ymax); haveOld:=0;
    FOR k FROM first TO last DO
      IF count==1 THEN px:=168; ELSE px:=ROUND(30+(k-first)*276/(count-1),0); END;
      IF SSIsDrawable(y(k)) THEN
        // Guardar la ordenada real: recortar cada segmento antes de proyectar.
        py:=RE(y(k));
        IF faseGrafico AND haveOld==1 THEN IF ABS(py-oldy)>=pirad*(1-1E-8) THEN haveOld:=0; END; END;
        IF SSEventType(k)==1 THEN
          IF py>=ymin AND py<=ymax THEN
            gy:=ROUND(184-(py-ymin)*138/rango,0);
            RECT_P(px-3,MAX(46,gy-3),px+3,MIN(184,gy+3),color);
            RECT_P(px-1,MAX(46,gy-1),px+1,MIN(184,gy+1),RGB(255,255,255),RGB(255,255,255));
          END;
          haveOld:=0;
        ELSE
          IF haveOld==1 AND ideal==0 THEN
            IF escalon THEN
              // Retencion derecha: horizontal hasta la siguiente muestra, luego salto.
              IF oldy>=ymin AND oldy<=ymax THEN
                gy:=ROUND(184-(oldy-ymin)*138/rango,0);
                LINE_P(oldx,gy,px,gy,color);
              END;
              IF MAX(oldy,py)>=ymin AND MIN(oldy,py)<=ymax THEN
                segY1:=ROUND(184-(MAX(ymin,MIN(ymax,oldy))-ymin)*138/rango,0);
                segY2:=ROUND(184-(MAX(ymin,MIN(ymax,py))-ymin)*138/rango,0);
                LINE_P(px,segY1,px,segY2,color);
              END;
            ELSE
            IF MAX(oldy,py)>=ymin AND MIN(oldy,py)<=ymax THEN
              clipA:=0; clipB:=1; deltaY:=py-oldy;
              IF deltaY<>0 THEN
                clipA:=MAX(0,MIN((ymin-oldy)/deltaY,(ymax-oldy)/deltaY));
                clipB:=MIN(1,MAX((ymin-oldy)/deltaY,(ymax-oldy)/deltaY));
              END;
              IF clipA<=clipB THEN
                segX1:=ROUND(oldx+clipA*(px-oldx),0);
                segX2:=ROUND(oldx+clipB*(px-oldx),0);
                segY1:=MAX(ymin,MIN(ymax,oldy));
                segY2:=MAX(ymin,MIN(ymax,py));
                segY1:=ROUND(184-(segY1-ymin)*138/rango,0);
                segY2:=ROUND(184-(segY2-ymin)*138/rango,0);
                LINE_P(segX1,segY1,segX2,segY2,color);
              END;
            END;
            END;
          END;
          IF py>=ymin AND py<=ymax THEN
            gy:=ROUND(184-(py-ymin)*138/rango,0);
            RECT_P(px-1,MAX(46,gy-1),px+1,MIN(184,gy+1),color,color);
          END;
          oldx:=px; oldy:=py; haveOld:=1;
        END;
      ELSE
        // N/D: dejar un hueco y cortar la continuidad, sin marcas rojas.
        haveOld:=0;
      END;
    END;
    IF ideal==1 AND count>1 THEN
      haveOld:=0;
      FOR q FROM 0 TO 276 DO
        px:=30+q;
        IF SSIsDrawable(curva(q+1)) THEN
          py:=RE(curva(q+1));
          IF haveOld==1 THEN
            IF MAX(oldy,py)>=ymin AND MIN(oldy,py)<=ymax THEN
              clipA:=0; clipB:=1; deltaY:=py-oldy;
              IF deltaY<>0 THEN
                clipA:=MAX(0,MIN((ymin-oldy)/deltaY,(ymax-oldy)/deltaY));
                clipB:=MIN(1,MAX((ymin-oldy)/deltaY,(ymax-oldy)/deltaY));
              END;
              IF clipA<=clipB THEN
                segX1:=ROUND(oldx+clipA*(px-oldx),0); segX2:=ROUND(oldx+clipB*(px-oldx),0);
                segY1:=ROUND(184-(MAX(ymin,MIN(ymax,oldy))-ymin)*138/rango,0);
                segY2:=ROUND(184-(MAX(ymin,MIN(ymax,py))-ymin)*138/rango,0);
                LINE_P(segX1,segY1,segX2,segY2,color);
              END;
            END;
          END;
          oldx:=px; oldy:=py; haveOld:=1;
        ELSE haveOld:=0; END;
      END;
    END;
    TEXTOUT_P(estadoVista,28,202,1,RGB(71,85,105));
    IF cursor==1 THEN
      IF anchor>=first AND anchor<=last THEN SSDrawCursor(y,x0,dx,anchor,first,last,ymin,ymax); END;
      SSDrawCursor(y,x0,dx,selected,first,last,ymin,ymax);
      IF anchor>0 THEN TEXTOUT_P("A=#"+STRING(anchor),250,48,1,RGB(190,24,93),58); END;
    END;
    touchDrag:=0;
    SSFooter({"H-","H+","V-","V+","Mas","Volver"},"");
    key:=SSPause();
    IF TYPE(key)==6 THEN
      touch:=key; key:=-1;
      IF touch(5)==0 AND touch(2)>=216 AND touch(4)>=216 THEN
        button:=1+FLOOR(touch(3)*6/320);
        IF button==1+FLOOR(touch(1)*6/320) THEN
          touchKeys:={45,50,35,40,49,4}; key:=touchKeys(button);
        END;
      END;
      IF touch(1)>=24 AND touch(1)<=312 AND touch(2)>=46 AND touch(2)<=184 AND touch(4)<216 THEN
        IF touch(5)==0 AND touch(3)>=24 AND touch(3)<=312 AND touch(4)>=46 AND touch(4)<=184 THEN
          selected:=MAX(first,MIN(last,ROUND(first+(touch(3)-30)*(count-1)/276,0))); cursor:=1;
        END;
        IF touch(5)==1 THEN
          cursor:=0; touchDrag:=1;
          IF respuesta==1 THEN
            IF ABS(touch(3)-touch(1))>0 THEN
              ancho:=r1-r0;
              r0:=MAX(base0,MIN(base1-ancho,r0-(touch(3)-touch(1))*ancho/276)); r1:=r0+ancho;
              recalcular:=1;
            END;
          ELSE
          first:=MAX(1,MIN(N-viewN+1,first-ROUND((touch(3)-touch(1))*(count-1)/276,0)));
          END;
          yPan:=yPan+(touch(4)-touch(2))*rango/138;
        END;
      END;
    END;
    IF key==49 THEN
      button:=SSMenu("Acciones del grafico",{"Tabla completa","Lectura del cursor","Activar/desactivar cursor","Original / limpia","Autoescala","Volver al grafico"},1);
      key:=-1;
      IF button==1 THEN cursor:=0; key:=30; END;
      IF button==2 THEN cursor:=1; key:=30; END;
      IF button==3 THEN key:=48; END;
      IF button==4 THEN key:=38; END;
      IF button==5 THEN key:=47; END;
    END;
    IF key==38 THEN limpia:=1-limpia; yZoom:=1; yPan:=0; baseYLista:=0; END;
    IF key==48 THEN cursor:=1-cursor; END;
    IF key==30 THEN
      IF cursor==1 THEN anchor:=SSCursorDetail(original,x0,dx,{selected,anchor},titulo);
      ELSE SSDataView(original,x0,dx,titulo,"eje","valor",color); END;
    END;
    IF respuesta==0 AND key==50 THEN
      centerIdx:=first+(count-1)/2; IF N==1 THEN newN:=1; ELSE newN:=MAX(2,FLOOR(count/1.5)); END;
      first:=ROUND(centerIdx-(newN-1)/2,0); viewN:=newN;
    END;
    IF respuesta==0 AND key==45 THEN
      centerIdx:=first+(count-1)/2; IF N==1 THEN newN:=1; ELSE newN:=MIN(N,MAX(count+1,ROUND(count*1.5,0))); END;
      first:=ROUND(centerIdx-(newN-1)/2,0); viewN:=newN;
    END;
    IF key==40 THEN yZoom:=MIN(64,yZoom*1.25); END;
    IF key==35 THEN yZoom:=MAX(0.125,yZoom/1.25); END;
    paso:=MAX(1,FLOOR(count/4));
    IF key==7 THEN
      IF cursor==1 THEN selected:=MAX(1,selected-1); IF selected<first THEN first:=selected; END;
      ELSE first:=MAX(1,first-paso); END;
    END;
    IF key==8 THEN
      IF cursor==1 THEN selected:=MIN(N,selected+1); IF selected>last THEN first:=selected-viewN+1; END;
      ELSE first:=MIN(N-viewN+1,first+paso); END;
    END;
    IF key==2 THEN yPan:=yPan+0.15*rango; END;
    IF key==12 THEN yPan:=yPan-0.15*rango; END;
    IF key==47 THEN first:=1; viewN:=N; yZoom:=1; yPan:=0; selected:=1; baseYLista:=0; END;
    IF respuesta==1 THEN
      ancho:=r1-r0; centro:=r0+ancho/2;
      IF key==50 THEN ancho:=MAX((base1-base0)*1E-9,ancho/1.5); recalcular:=1; END;
      IF key==45 THEN ancho:=MIN(base1-base0,ancho*1.5); recalcular:=1; END;
      IF cursor==0 AND key==7 THEN centro:=centro-ancho/4; recalcular:=1; END;
      IF cursor==0 AND key==8 THEN centro:=centro+ancho/4; recalcular:=1; END;
      IF recalcular==1 THEN
        r0:=MAX(base0,MIN(base1-ancho,centro-ancho/2)); r1:=r0+ancho;
        IF r1<=r0 THEN r0:=base0; r1:=base1; END;
        // Cambiar X no reinicia zoom/desplazamiento Y; solo Auto lo restaura.
      END;
      IF key==47 THEN r0:=base0; r1:=base1; recalcular:=1; END;
    END;
  UNTIL key==4;
  IF respuesta==1 THEN SSEVAL_EVENTS:=eventos; END;
  RETURN 1;
END;

SSPlotLine(y,titulo)
BEGIN
  RETURN SSPlotXY(y,0,1,titulo,"Curva calculada");
END;

SSPlotDual(x,y,titulo)
BEGIN
  LOCAL touch;
  LOCAL button;
  LOCAL touchKeys;
  LOCAL originalX:=x;
  LOCAL originalY:=y;
  LOCAL limpia:=1;
  LOCAL limpiaAnterior:=-1;
  LOCAL estadoVista;
  LOCAL discreto:=0;
  LOCAL nombre:=titulo;
  LOCAL unidad:="t (s)";
  LOCAL eje0:=0;
  LOCAL ejePaso:=1;
  LOCAL temporal:=0;
  LOCAL N:=MIN(SIZE(x),SIZE(y));
  LOCAL k;
  LOCAL px;
  LOCAL py1;
  LOCAL py2;
  LOCAL oldx;
  LOCAL old1;
  LOCAL old2;
  LOCAL ymin;
  LOCAL ymax;
  LOCAL rango;
  LOCAL base;
  LOCAL key;
  LOCAL first:=1;
  LOCAL last;
  LOCAL viewN:=N;
  LOCAL count;
  LOCAL newN;
  LOCAL centerIdx;
  LOCAL paso;
  LOCAL yZoom:=1;
  LOCAL yPan:=0;
  LOCAL yCenter;
  LOCAL dataYmin:=0;
  LOCAL dataYmax:=0;
  LOCAL found:=0;
  LOCAL have1:=0;
  LOCAL have2:=0;
  LOCAL channels:={x,y};
  LOCAL previous:={0,0};
  LOCAL connected:={0,0};
  LOCAL j;
  LOCAL value;
  LOCAL oldValue;
  LOCAL color;
  LOCAL deltaY;
  LOCAL clipA;
  LOCAL clipB;
  LOCAL segX1;
  LOCAL segX2;
  LOCAL segY1;
  LOCAL segY2;
  LOCAL espectral:=0;
  LOCAL principal;
  LOCAL superpuesta;
  LOCAL componente;
  LOCAL wmin;
  LOCAL wmax;
  LOCAL wk;
  LOCAL origenes;
  LOCAL pasos;
  LOCAL leyenda;
  // Vista espectral con DOS rejillas independientes. No cambia el comparador
  // anterior: solo se activa con metadatos explicitos FOURIER de 9 campos.
  IF TYPE(titulo)==6 THEN
    IF SIZE(titulo)==9 OR SIZE(titulo)==10 THEN IF titulo(4)=="FOURIER" THEN espectral:=1; END; END;
  END;
  IF espectral==1 THEN
    unidad:="w rad/muestra"; IF SIZE(titulo)==10 THEN unidad:=titulo(10); END;
    nombre:=titulo(1); principal:=titulo(7); componente:=titulo(8); superpuesta:=titulo(9);
    origenes:={titulo(2),titulo(5)}; pasos:={titulo(3),titulo(6)};
    N:=SIZE(originalX); viewN:=N;
    IF N<2 OR SIZE(originalY)==0 THEN RETURN superpuesta; END;
    REPEAT
      IF limpia<>limpiaAnterior THEN
      channels:={}; value:=0;
      x:=originalX; y:=originalY; estadoVista:="Original | 5 limpia";
      IF limpia==1 THEN x:=SSCleanComplex({x,1E-10}); y:=SSCleanComplex({y,1E-10}); estadoVista:="Cero <=1E-10 | 5 original"; END;
      channels:={x,y};
      FOR j FROM 1 TO 2 DO
        value:=channels(j);
        FOR k FROM 1 TO SIZE(value) DO
          IF SSIsDrawable(value(k)) THEN
            IF componente==2 THEN value(k):=ABS(value(k));
            ELSE
              IF ABS(value(k))==0 THEN value(k):=SSUndef();
              ELSE value(k):=IM(LN(value(k)/ABS(value(k)))); END;
            END;
          END;
        END;
        channels(j):=value;
      END;
      value:=0; x:={}; y:={}; limpiaAnterior:=limpia;
      END;
      viewN:=MAX(2,MIN(N,viewN)); first:=MAX(1,MIN(N-viewN+1,first)); last:=first+viewN-1; count:=viewN;
      wmin:=titulo(2)+(first-1)*titulo(3); wmax:=titulo(2)+(last-1)*titulo(3);
      found:=0; dataYmin:=0; dataYmax:=0;
      FOR j FROM 1 TO 2 DO
        IF j==principal OR superpuesta==1 THEN
          value:=channels(j);
          FOR k FROM 1 TO SIZE(value) DO
            wk:=origenes(j)+(k-1)*pasos(j);
            IF wk>=wmin-1E-12 AND wk<=wmax+1E-12 AND SSIsDrawable(value(k)) THEN
              dataYmin:=MIN(dataYmin,value(k)); dataYmax:=MAX(dataYmax,value(k)); found:=1;
            END;
          END;
        END;
      END;
      IF componente==3 THEN dataYmin:=-3.141592653589793; dataYmax:=3.141592653589793; END;
      IF found==0 OR dataYmax==dataYmin THEN dataYmin:=-1; dataYmax:=1; END;
      yCenter:=(dataYmin+dataYmax)/2+yPan; rango:=(dataYmax-dataYmin)*1.2/yZoom;
      ymin:=yCenter-rango/2; ymax:=yCenter+rango/2;
      leyenda:="Azul: DTFT | Naranja: DFT";
      IF superpuesta==0 THEN
        IF principal==1 THEN leyenda:="Azul: DTFT | DFT oculta"; ELSE leyenda:="Naranja: DFT | DTFT oculta"; END;
      END;
      SSHeader(nombre,leyenda,SSAccent(4));
      RECT_P(24,46,312,184,RGB(203,213,225),RGB(255,255,255));
      SSGraphAxes(wmin,wmax,ymin,ymax);
      FOR j FROM 1 TO 2 DO
        IF j==principal OR superpuesta==1 THEN
          value:=channels(j); have1:=0; old1:=0;
          IF j==1 THEN color:=SSAccent(1); ELSE color:=SSAccent(5); END;
          FOR k FROM 1 TO SIZE(value) DO
            wk:=origenes(j)+(k-1)*pasos(j);
            IF wk>=wmin-1E-12 AND wk<=wmax+1E-12 THEN
              px:=MAX(30,MIN(306,ROUND(30+276*(wk-wmin)/(wmax-wmin),0)));
              IF SSIsDrawable(value(k)) THEN
                py2:=value(k);
                // No unir saltos de la fase principal a traves de +/-pi.
                IF componente==3 AND ABS(py2-old1)>3.141592653589793 THEN have1:=0; END;
                IF j==1 AND have1==1 THEN
                  IF MAX(old1,py2)>=ymin AND MIN(old1,py2)<=ymax THEN
                    clipA:=0; clipB:=1; deltaY:=py2-old1;
                    IF deltaY<>0 THEN
                      clipA:=MAX(0,MIN((ymin-old1)/deltaY,(ymax-old1)/deltaY));
                      clipB:=MIN(1,MAX((ymin-old1)/deltaY,(ymax-old1)/deltaY));
                    END;
                    IF clipA<=clipB THEN
                      segX1:=ROUND(oldx+clipA*(px-oldx),0); segX2:=ROUND(oldx+clipB*(px-oldx),0);
                      segY1:=ROUND(184-(MAX(ymin,MIN(ymax,old1))-ymin)*138/rango,0);
                      segY2:=ROUND(184-(MAX(ymin,MIN(ymax,py2))-ymin)*138/rango,0);
                      LINE_P(segX1,segY1,segX2,segY2,color);
                    END;
                  END;
                END;
                IF j==2 AND MAX(0,py2)>=ymin AND MIN(0,py2)<=ymax THEN
                  base:=ROUND(184-(MAX(ymin,MIN(ymax,0))-ymin)*138/rango,0);
                  py1:=ROUND(184-(MAX(ymin,MIN(ymax,py2))-ymin)*138/rango,0);
                  LINE_P(px,base,px,py1,color);
                END;
                IF py2>=ymin AND py2<=ymax THEN
                  py1:=ROUND(184-(py2-ymin)*138/rango,0);
                  IF j==2 THEN RECT_P(px-2,MAX(46,py1-2),px+2,MIN(184,py1+2),color,color);
                  ELSE RECT_P(px-1,MAX(46,py1-1),px+1,MIN(184,py1+1),color,color); END;
                END;
                old1:=py2; oldx:=px; have1:=1;
              ELSE have1:=0; END;
            ELSE have1:=0; END;
          END;
        END;
      END;
      TEXTOUT_P(unidad+" | "+estadoVista,28,190,1,RGB(71,85,105));
      IF principal==1 THEN leyenda:="1: DFT on/off"; ELSE leyenda:="1: DTFT on/off"; END;
    SSFooter({"H-","H+","V-","V+","Mas","Volver"},"");
    key:=SSPause();
    IF TYPE(key)==6 THEN
      touch:=key; key:=-1;
      IF touch(5)==0 AND touch(2)>=216 AND touch(4)>=216 THEN
        button:=1+FLOOR(touch(3)*6/320);
        IF button==1+FLOOR(touch(1)*6/320) THEN
          touchKeys:={45,50,35,40,49,4}; key:=touchKeys(button);
        END;
      END;
      IF touch(1)>=24 AND touch(1)<=312 AND touch(2)>=46 AND touch(2)<=184 AND touch(4)<216 THEN
        IF touch(5)==0 AND touch(3)>=24 AND touch(3)<=312 AND touch(4)>=46 AND touch(4)<=184 THEN key:=30; END;
        IF touch(5)==1 THEN
          first:=MAX(1,MIN(N-viewN+1,first-ROUND((touch(3)-touch(1))*(count-1)/276,0)));
          yPan:=yPan+(touch(4)-touch(2))*rango/138;
        END;
      END;
    END;
    IF key==49 THEN
      IF espectral==1 THEN
        button:=SSMenu("Acciones de comparacion",{"Tablas","Mostrar/ocultar contraria","Original / limpia","Autoescala","Volver al grafico"},1);
        touchKeys:={30,42,38,47,-1};
      ELSE
        button:=SSMenu("Acciones de comparacion",{"Tablas","Original / limpia","Autoescala","Volver al grafico"},1);
        touchKeys:={30,38,47,-1};
      END;
      key:=-1; IF button>0 THEN key:=touchKeys(button); END;
    END;
      IF key==42 THEN superpuesta:=1-superpuesta; yZoom:=1; yPan:=0; END;
      IF key==38 THEN limpia:=1-limpia; yZoom:=1; yPan:=0; END;
      IF key==30 THEN
        base:=SSMenu("Datos de la comparacion",{"DTFT: tabla compleja","DFT: tabla compleja","Volver al grafico"},1);
        IF base==1 THEN SSDataView(originalX,titulo(2),titulo(3),"DTFT del mismo registro; "+unidad,unidad,"X(w)",SSAccent(1)); END;
        IF base==2 THEN SSDataView(originalY,titulo(5),titulo(6),"DFT: frecuencias exactas; "+unidad,unidad,"X[k]",SSAccent(5)); END;
      END;
      IF key==50 THEN centerIdx:=first+(count-1)/2; newN:=MAX(2,FLOOR(count/1.5)); first:=ROUND(centerIdx-(newN-1)/2,0); viewN:=newN; END;
      IF key==45 THEN centerIdx:=first+(count-1)/2; newN:=MIN(N,MAX(count+1,ROUND(count*1.5,0))); first:=ROUND(centerIdx-(newN-1)/2,0); viewN:=newN; END;
      IF key==40 THEN yZoom:=MIN(64,yZoom*1.25); END;
      IF key==35 THEN yZoom:=MAX(0.125,yZoom/1.25); END;
      paso:=MAX(1,FLOOR(count/4));
      IF key==7 THEN first:=MAX(1,first-paso); END;
      IF key==8 THEN first:=MIN(N-viewN+1,first+paso); END;
      IF key==2 THEN yPan:=yPan+0.15*rango; END;
      IF key==12 THEN yPan:=yPan-0.15*rango; END;
      IF key==47 THEN first:=1; viewN:=N; yZoom:=1; yPan:=0; END;
    UNTIL key==4;
    RETURN superpuesta;
  END;
  IF TYPE(titulo)==6 THEN
    nombre:=titulo(1); eje0:=titulo(2); ejePaso:=titulo(3); temporal:=1;
    IF SIZE(titulo)>3 THEN unidad:=titulo(4); END;
  END;
  IF unidad=="n" THEN discreto:=1; END;
  IF N==0 THEN RETURN 0; END;
  REPEAT
  IF limpia<>limpiaAnterior THEN
  channels:={};
  x:=originalX; y:=originalY; estadoVista:="Original | 5 limpia";
  IF limpia==1 THEN x:=SSCleanComplex({originalX,1E-10}); y:=SSCleanComplex({originalY,1E-10}); estadoVista:="Cero <=1E-10 | 5 original"; END;
  channels:={x,y}; found:=0;
  FOR k FROM 1 TO N DO
    IF SSIsDrawable(x(k)) THEN
      IF found==0 THEN dataYmin:=RE(x(k)); dataYmax:=RE(x(k)); found:=1;
      ELSE dataYmin:=MIN(dataYmin,RE(x(k))); dataYmax:=MAX(dataYmax,RE(x(k))); END;
    END;
    IF SSIsDrawable(y(k)) THEN
      IF found==0 THEN dataYmin:=RE(y(k)); dataYmax:=RE(y(k)); found:=1;
      ELSE dataYmin:=MIN(dataYmin,RE(y(k))); dataYmax:=MAX(dataYmax,RE(y(k))); END;
    END;
  END;
  IF found==0 THEN dataYmin:=-1; dataYmax:=1; END;
  dataYmin:=MIN(0,dataYmin); dataYmax:=MAX(0,dataYmax);
  IF dataYmax==dataYmin THEN dataYmin:=-1; dataYmax:=1; END;
  limpiaAnterior:=limpia;
  END;
    viewN:=MAX(1,MIN(N,viewN)); first:=MAX(1,MIN(N-viewN+1,first)); last:=MIN(N,first+viewN-1); count:=last-first+1;
    ymin:=dataYmin; ymax:=dataYmax;
    yCenter:=(ymax+ymin)/2+yPan; rango:=(ymax-ymin)*1.2/yZoom; ymin:=yCenter-rango/2; ymax:=yCenter+rango/2;
    SSHeader(nombre,"Azul: original | Naranja: resultado",SSAccent(5));
    RECT_P(24,46,312,184,RGB(203,213,225),RGB(255,255,255));
    SSGraphAxes(eje0+(first-1)*ejePaso,eje0+(last-1)*ejePaso,ymin,ymax); connected:={0,0};
    FOR k FROM first TO last DO
      IF count==1 THEN px:=168; ELSE px:=ROUND(30+(k-first)*276/(count-1),0); END;
      FOR j FROM 1 TO 2 DO
        value:=channels(j); value:=value(k);
        IF j==1 THEN color:=SSAccent(1); ELSE color:=SSAccent(5); END;
        IF SSIsDrawable(value) THEN
          value:=RE(value); oldValue:=previous(j);
          IF connected(j)==1 AND discreto==0 THEN
            IF MAX(oldValue,value)>=ymin AND MIN(oldValue,value)<=ymax THEN
              clipA:=0; clipB:=1; deltaY:=value-oldValue;
              IF deltaY<>0 THEN
                clipA:=MAX(0,MIN((ymin-oldValue)/deltaY,(ymax-oldValue)/deltaY));
                clipB:=MIN(1,MAX((ymin-oldValue)/deltaY,(ymax-oldValue)/deltaY));
              END;
              IF clipA<=clipB THEN
                segX1:=ROUND(oldx+clipA*(px-oldx),0); segX2:=ROUND(oldx+clipB*(px-oldx),0);
                segY1:=MAX(ymin,MIN(ymax,oldValue)); segY2:=MAX(ymin,MIN(ymax,value));
                segY1:=ROUND(184-(segY1-ymin)*138/rango,0); segY2:=ROUND(184-(segY2-ymin)*138/rango,0);
                LINE_P(segX1,segY1,segX2,segY2,color);
              END;
            END;
          END;
          IF discreto==1 THEN
            IF MAX(0,value)>=ymin AND MIN(0,value)<=ymax THEN
              base:=ROUND(184-(MAX(ymin,MIN(ymax,0))-ymin)*138/rango,0);
              py1:=ROUND(184-(MAX(ymin,MIN(ymax,value))-ymin)*138/rango,0);
              LINE_P(px,base,px,py1,color);
            END;
          END;
          IF value>=ymin AND value<=ymax THEN
            py1:=ROUND(184-(value-ymin)*138/rango,0);
            RECT_P(px-1,MAX(46,py1-1),px+1,MIN(184,py1+1),color,color);
          END;
          previous(j):=value; connected(j):=1;
        ELSE connected(j):=0; END;
      END;
      oldx:=px;
    END;
    TEXTOUT_P(estadoVista,28,202,1,RGB(71,85,105));
    SSFooter({"H-","H+","V-","V+","Mas","Volver"},"");
    key:=SSPause();
    IF TYPE(key)==6 THEN
      touch:=key; key:=-1;
      IF touch(5)==0 AND touch(2)>=216 AND touch(4)>=216 THEN
        button:=1+FLOOR(touch(3)*6/320);
        IF button==1+FLOOR(touch(1)*6/320) THEN
          touchKeys:={45,50,35,40,49,4}; key:=touchKeys(button);
        END;
      END;
      IF touch(1)>=24 AND touch(1)<=312 AND touch(2)>=46 AND touch(2)<=184 AND touch(4)<216 THEN
        IF touch(5)==0 AND touch(3)>=24 AND touch(3)<=312 AND touch(4)>=46 AND touch(4)<=184 THEN key:=30; END;
        IF touch(5)==1 THEN
          first:=MAX(1,MIN(N-viewN+1,first-ROUND((touch(3)-touch(1))*(count-1)/276,0)));
          yPan:=yPan+(touch(4)-touch(2))*rango/138;
        END;
      END;
    END;
    IF key==49 THEN
      IF espectral==1 THEN
        button:=SSMenu("Acciones de comparacion",{"Tablas","Mostrar/ocultar contraria","Original / limpia","Autoescala","Volver al grafico"},1);
        touchKeys:={30,42,38,47,-1};
      ELSE
        button:=SSMenu("Acciones de comparacion",{"Tablas","Original / limpia","Autoescala","Volver al grafico"},1);
        touchKeys:={30,38,47,-1};
      END;
      key:=-1; IF button>0 THEN key:=touchKeys(button); END;
    END;
    IF key==38 THEN limpia:=1-limpia; yZoom:=1; yPan:=0; END;
    IF key==30 THEN
      IF temporal==0 THEN SSDataViewPair(originalX,originalY,0,nombre,SSAccent(5));
      ELSE
        SSDataView(originalX,eje0,ejePaso,"Original: "+nombre,unidad,"x",SSAccent(5));
        SSDataView(originalY,eje0,ejePaso,"Resultado: "+nombre,unidad,"y",SSAccent(5));
      END;
    END;
    IF key==50 THEN
      centerIdx:=first+(count-1)/2; IF N==1 THEN newN:=1; ELSE newN:=MAX(2,FLOOR(count/1.5)); END;
      first:=ROUND(centerIdx-(newN-1)/2,0); viewN:=newN;
    END;
    IF key==45 THEN
      centerIdx:=first+(count-1)/2; IF N==1 THEN newN:=1; ELSE newN:=MIN(N,MAX(count+1,ROUND(count*1.5,0))); END;
      first:=ROUND(centerIdx-(newN-1)/2,0); viewN:=newN;
    END;
    IF key==40 THEN yZoom:=MIN(64,yZoom*1.25); END;
    IF key==35 THEN yZoom:=MAX(0.125,yZoom/1.25); END;
    paso:=MAX(1,FLOOR(count/4));
    IF key==7 THEN first:=MAX(1,first-paso); END;
    IF key==8 THEN first:=MIN(N-viewN+1,first+paso); END;
    IF key==2 THEN yPan:=yPan+0.15*rango; END;
    IF key==12 THEN yPan:=yPan-0.15*rango; END;
    IF key==47 THEN first:=1; viewN:=N; yZoom:=1; yPan:=0; END;
  UNTIL key==4;
  RETURN 1;
END;

SSPlotPZ(b,a,dominio,titulo)
BEGIN
  LOCAL touch;
  LOCAL button;
  LOCAL touchKeys;
  LOCAL zeros;
  LOCAL poles;
  LOCAL directo:=TYPE(titulo)==6;
  LOCAL editar:=0;
  LOCAL nombre:=titulo;
  LOCAL cursor:=0;
  LOCAL paso:=0.05;
  LOCAL key;
  LOCAL accion;
  LOCAL grupo;
  LOCAL lista;
  LOCAL indice;
  LOCAL nuevo;
  LOCAL realNuevo;
  LOCAL imagNuevo;
  LOCAL nuevoPaso;
  LOCAL temporal;
  LOCAL j;
  LOCAL cantidad;
  LOCAL scale:=1.2;
  LOCAL plano:="z";
  LOCAL k;
  LOCAL ang;
  LOCAL x1;
  LOCAL y1;
  LOCAL x2;
  LOCAL y2;
  LOCAL px;
  LOCAL py;
  LOCAL ganancia:=1;
  LOCAL numerador;
  LOCAL denominador;
  LOCAL formula;
  LOCAL valido;
  LOCAL persistir:=0;
  IF directo THEN IF SIZE(titulo)>=3 THEN ganancia:=titulo(3); END; END;
  IF directo THEN IF SIZE(titulo)>=4 THEN persistir:=titulo(4); END; END;
  IF directo THEN
    nombre:=titulo(1); editar:=titulo(2); zeros:=b; poles:=a;
  ELSE
    IF dominio==2 THEN cantidad:=MAX(SIZE(b),SIZE(a)); b:=SSPad(b,cantidad); a:=SSPad(a,cantidad); END;
    zeros:=SSPolyRoots(b); poles:=SSPolyRoots(a);
  END;
  FOR k FROM 1 TO SIZE(zeros) DO scale:=MAX(scale,1.15*ABS(zeros(k))); END;
  FOR k FROM 1 TO SIZE(poles) DO scale:=MAX(scale,1.15*ABS(poles(k))); END;
  IF dominio==1 THEN plano:="s"; END;
  REPEAT
  SSHeader(nombre,"o = cero   x = polo | plano "+plano,SSAccent(7));
  RECT_P(24,46,312,184,RGB(203,213,225),RGB(255,255,255));
  LINE_P(168,48,168,182,RGB(148,163,184)); LINE_P(26,115,310,115,RGB(148,163,184));
  IF dominio==2 THEN
    x1:=168+ROUND(63/scale,0); y1:=115;
    FOR k FROM 1 TO 64 DO
      ang:=2*3.141592653589793*k/64; x2:=168+ROUND(63*SSCosR(ang)/scale,0); y2:=115-ROUND(63*SSSinR(ang)/scale,0);
      IF x1>=25 AND x1<=311 AND x2>=25 AND x2<=311 AND y1>=47 AND y1<=183 AND y2>=47 AND y2<=183 THEN
      LINE_P(x1,y1,x2,y2,RGB(148,163,184));
      END;
      x1:=x2; y1:=y2;
    END;
  END;
  FOR k FROM 1 TO SIZE(zeros) DO
    px:=168+ROUND(63*RE(zeros(k))/scale,0); py:=115-ROUND(63*IM(zeros(k))/scale,0);
    IF px>=30 AND px<=306 AND py>=52 AND py<=178 THEN
    RECT_P(px-4,py-4,px+4,py+4,SSAccent(1)); RECT_P(px-2,py-2,px+2,py+2,RGB(255,255,255),RGB(255,255,255));
    END;
  END;
  FOR k FROM 1 TO SIZE(poles) DO
    px:=168+ROUND(63*RE(poles(k))/scale,0); py:=115-ROUND(63*IM(poles(k))/scale,0);
    IF px>=30 AND px<=306 AND py>=52 AND py<=178 THEN
    LINE_P(px-4,py-4,px+4,py+4,SSAccent(7)); LINE_P(px-4,py+4,px+4,py-4,SSAccent(7));
    END;
  END;
  TEXTOUT_P("Re +/-"+SSFmt(142*scale/63,3)+" | Im +/-"+SSFmt(scale,3),26,187,1,RGB(71,85,105));
  IF editar THEN
    px:=168+ROUND(63*RE(cursor)/scale,0); py:=115-ROUND(63*IM(cursor)/scale,0);
    IF px>=30 AND px<=306 AND py>=52 AND py<=178 THEN
      LINE_P(px-5,py,px+5,py,SSAccent(2)); LINE_P(px,py-5,px,py+5,SSAccent(2));
    END;
    TEXTOUT_P("Cursor="+SSFmt(cursor,4)+" | paso="+SSFmt(paso,4),26,202,1,RGB(71,85,105));
    SSFooter({"+","-","Agregar","H(z)","Mas","Salir"},"");
  ELSE
    IF dominio==2 THEN TEXTOUT_P("Escala igual en Re e Im; circulo |z|=1",26,202,1,RGB(71,85,105));
    ELSE TEXTOUT_P("Escala igual en Re e Im; eje imaginario",26,202,1,RGB(71,85,105)); END;
    SSFooter({"+","-","Auto","Volver"},"");
  END;
  key:=SSPause();
  IF TYPE(key)==6 THEN
    touch:=key; key:=-1;
    IF touch(5)==0 AND touch(2)>=216 AND touch(4)>=216 THEN
      cantidad:=4; touchKeys:={50,45,47,4};
      IF editar THEN cantidad:=6; touchKeys:={50,45,42,43,30,4}; END;
      button:=1+FLOOR(touch(3)*cantidad/320);
      IF button==1+FLOOR(touch(1)*cantidad/320) THEN key:=touchKeys(button); END;
    END;
    IF editar AND touch(1)>=24 AND touch(1)<=312 AND touch(2)>=46 AND touch(2)<=184 AND touch(3)>=24 AND touch(3)<=312 AND touch(4)>=46 AND touch(4)<=184 THEN
      cursor:=(touch(3)-168)*scale/63+(0,1)*(115-touch(4))*scale/63;
    END;
  END;
  IF key==4 THEN
    IF editar THEN
      IF STRING(zeros)==STRING(b) AND STRING(poles)==STRING(a) THEN RETURN {}; END;
      accion:=SSMenu("Cambios del filtro",{"Guardar en Recientes y volver","Descartar cambios","Seguir editando"},3);
      IF accion==1 THEN
        valido:=0;
        IFERR valido:=SSHistoryAdd({4,"Filtro en plano z",zeros,poles,ganancia}); THEN valido:=0; END;
        IF valido THEN RETURN {zeros,poles};
        ELSE SSInfoView("No se guardo el filtro","La edicion sigue abierta","No se descartaron los puntos. Reduzca el diseno o exporte sus coeficientes. Recientes tiene limites de memoria.",SSAccent(7)); END;
      END;
      IF accion==2 THEN RETURN {}; END;
      key:=-1;
    ELSE RETURN 1; END;
  END;
  IF key==30 AND editar==0 THEN RETURN 1; END;
  IF key==50 THEN scale:=MAX(1E-6,scale/1.5); END;
  IF key==45 THEN scale:=MIN(1E12,scale*1.5); END;
  IF key==47 THEN
    scale:=1.2;
    FOR k FROM 1 TO SIZE(zeros) DO scale:=MAX(scale,1.15*ABS(zeros(k))); END;
    FOR k FROM 1 TO SIZE(poles) DO scale:=MAX(scale,1.15*ABS(poles(k))); END;
    IF editar THEN scale:=MAX(scale,1.15*ABS(cursor)); END;
  END;
  IF editar THEN
    IF key==7 THEN cursor:=cursor-paso; END;
    IF key==8 THEN cursor:=cursor+paso; END;
    IF key==2 THEN cursor:=cursor+(0,1)*paso; END;
    IF key==12 THEN cursor:=cursor-(0,1)*paso; END;
    IF key==7 OR key==8 OR key==2 OR key==12 THEN scale:=MAX(scale,MAX(1.1*ABS(IM(cursor)),0.5*ABS(RE(cursor)))); END;
    IF key==30 THEN
      accion:=SSMenu("Posicionar polos y ceros",{"Agregar cero en cursor","Agregar polo en cursor","Cero y su conjugado","Polo y su conjugado","Mover un cero al cursor","Mover un polo al cursor","Eliminar un cero","Eliminar un polo","Coordenadas exactas del cursor","Cambiar paso de las flechas","Guardar y volver","Volver al plano","Autoescala","Agregar por coordenadas","Ver H(z) del diseno"},1);
      IF accion==11 THEN
        IF persistir==0 THEN RETURN {zeros,poles}; END;
        valido:=SSHistoryAdd({4,"Filtro en plano z",zeros,poles,ganancia});
        IF valido THEN RETURN {zeros,poles};
        ELSE SSInfoView("No se guardo el filtro","La edicion sigue abierta","No se descartan los puntos actuales ni se cambia el registro anterior.",SSAccent(7)); END;
      END;
      IF accion==13 THEN
        scale:=MAX(1.2,1.15*ABS(cursor));
        FOR k FROM 1 TO SIZE(zeros) DO scale:=MAX(scale,1.15*ABS(zeros(k))); END;
        FOR k FROM 1 TO SIZE(poles) DO scale:=MAX(scale,1.15*ABS(poles(k))); END;
      END;
      IF accion==14 THEN key:=42; END;
      IF accion==15 THEN key:=43; END;
      IF accion==9 THEN
        realNuevo:=RE(cursor); imagNuevo:=IM(cursor);
        IF INPUT(realNuevo,"Cursor: parte real","Re=","Ejemplo: 0.7",realNuevo) THEN
          IF INPUT(imagNuevo,"Cursor: parte imaginaria","Im=","Ejemplo: 0.4 (sin i)",imagNuevo) THEN
            IF SSIsDrawable(realNuevo) AND SSIsDrawable(imagNuevo) THEN
              IF IM(realNuevo)==0 AND IM(imagNuevo)==0 AND ABS(realNuevo)<=1E6 AND ABS(imagNuevo)<=1E6 THEN cursor:=realNuevo+(0,1)*imagNuevo; scale:=MAX(scale,1.15*ABS(cursor)); END;
            END;
          END;
        END;
      END;
      IF accion==10 THEN
        nuevoPaso:=paso;
        IF INPUT(nuevoPaso,"Paso del cursor","Paso=","Real positivo, 1E-6...1E3",paso) THEN
          IF SSIsDrawable(nuevoPaso) THEN IF IM(nuevoPaso)==0 AND nuevoPaso>=1E-6 AND nuevoPaso<=1E3 THEN paso:=nuevoPaso; END; END;
        END;
      END;
      IF accion>=1 AND accion<=8 THEN
        grupo:=accion-2*FLOOR(accion/2); lista:=poles; IF grupo==1 THEN lista:=zeros; END;
        cantidad:=1; IF (accion==3 OR accion==4) AND IM(cursor)<>0 THEN cantidad:=2; END;
        IF accion<=4 THEN
          IF SIZE(lista)+cantidad<=32 AND ABS(cursor)<=1E6 THEN
            lista:=CONCAT(lista,{cursor}); IF cantidad==2 THEN lista:=CONCAT(lista,{CONJ(cursor)}); END;
          ELSE SSInfoView("Punto no agregado","Limite del editor","Hasta 32 ceros y 32 polos; modulo de cada punto <=1E6. No se modifico el diseno.",SSAccent(7)); END;
        ELSE
          IF SIZE(lista)>0 THEN
            SSDataView(lista,1,1,"Elegir indice del punto","#","posicion",SSAccent(7)); indice:=1;
            IF INPUT(indice,"Punto a modificar","Indice=","1..."+STRING(SIZE(lista))+"; se modifica SOLO ese punto",1) THEN
              IF TYPE(indice)==0 THEN
                IF indice==FLOOR(indice) AND indice>=1 AND indice<=SIZE(lista) THEN
                  IF accion<=6 THEN IF ABS(cursor)<=1E6 THEN lista(indice):=cursor; END;
                  ELSE
                    temporal:={}; FOR j FROM 1 TO SIZE(lista) DO IF j<>indice THEN temporal:=CONCAT(temporal,{lista(j)}); END; END; lista:=temporal; temporal:={};
                  END;
                END;
              END;
            END;
          ELSE SSInfoView("Sin puntos","Lista vacia","Agregue primero un punto de este tipo.",SSAccent(7)); END;
        END;
        IF grupo==1 THEN zeros:=lista; ELSE poles:=lista; END;
        lista:={};
      END;
    END;
    IF key==42 THEN
      grupo:=SSMenu("Agregar por coordenadas",{"Polo","Cero","Volver"},1);
      IF grupo==1 OR grupo==2 THEN
        lista:=poles; IF grupo==2 THEN lista:=zeros; END;
        IF SIZE(lista)>=32 THEN
          SSInfoView("Punto no agregado","Hasta 32 puntos de cada tipo","Elimine un punto de este tipo antes de agregar otro. El diseno no cambio.",SSAccent(7));
        ELSE
          realNuevo:=0; imagNuevo:=0; temporal:="Agregar polo"; IF grupo==2 THEN temporal:="Agregar cero"; END;
          IF INPUT({{realNuevo,[0]},{imagNuevo,[0]}},temporal,{"Parte real","Parte imag."},{"Ejemplo 0.7: posicion 0.7+0.4*i","Ejemplo 0.4, sin i. Use 0 para punto real."},{0,0}) THEN
            valido:=SSIsDrawable(realNuevo) AND SSIsDrawable(imagNuevo);
            IF valido THEN
              IF IM(realNuevo)<>0 OR IM(imagNuevo)<>0 THEN valido:=0; END;
              nuevo:=realNuevo+(0,1)*imagNuevo;
              IF ABS(nuevo)>1E6 THEN valido:=0; END;
            END;
            IF valido THEN
              lista:=CONCAT(lista,{nuevo});
              IF grupo==1 THEN poles:=lista; ELSE zeros:=lista; END;
              scale:=MAX(scale,1.15*ABS(nuevo));
            ELSE SSInfoView("Posicion no valida","No se agrego el punto","Re e Im deben ser reales finitos; modulo de la posicion <=1E6. El diseno no cambio.",SSAccent(7)); END;
          END;
        END;
        lista:={};
      END;
    END;
    IF key==43 THEN
      numerador:={ganancia}; denominador:={1}; valido:=1;
      IFERR
        FOR k FROM 1 TO SIZE(zeros) DO numerador:=SSConv(numerador,{1,-zeros(k)}); END;
        FOR k FROM 1 TO SIZE(poles) DO denominador:=SSConv(denominador,{1,-poles(k)}); END;
        FOR k FROM 1 TO SIZE(numerador) DO IF SSIsDrawable(numerador(k))==0 THEN valido:=0; END; END;
        FOR k FROM 1 TO SIZE(denominador) DO IF SSIsDrawable(denominador(k))==0 THEN valido:=0; END; END;
        IF valido THEN formula:="("+SSPolyText(numerador,"z")+")/("+SSPolyText(denominador,"z")+")"; END;
      THEN valido:=0; END;
      IF valido THEN
        SSResultBrowse("H(z) del editor","Diseno actual, sin guardar",formula,"K="+STRING(ganancia),"Incluye todos los puntos actuales, incluso cambios sin guardar. K se conserva del filtro de origen. No cancela factores. Volver regresa al plano sin perder cambios; Mas > Guardar y volver los aplica al filtro.");
      ELSE SSInfoView("H(z) no disponible","Error o desbordamiento","El diseno sigue intacto. Reduzca el orden o el modulo de las raices.",SSAccent(7)); END;
      numerador:={}; denominador:={}; formula:="";
    END;
    // El OK tactil del INPUT no debe accionar Cancelar en el plano de abajo.
    IF key==30 OR key==42 THEN
      REPEAT
        temporal:={{},{}};
        IFERR temporal:=MOUSE; THEN temporal:={{},{}}; END;
      UNTIL SIZE(temporal(1))==0 AND SIZE(temporal(2))==0;
      temporal:={};
    END;
  END;
  UNTIL 0;
END;

SSRootLocusPlot(a,b,k0,k1,N)
BEGIN
  LOCAL touch;
  LOCAL button;
  LOCAL touchKeys;
  LOCAL key;
  LOCAL idx;
  LOCAL j;
  LOCAL gain;
  LOCAL roots;
  LOCAL scale:=1;
  LOCAL px;
  LOCAL py;
  FOR idx FROM 0 TO N-1 DO
    gain:=k0+(k1-k0)*idx/(N-1); roots:=SSPolyRoots(SSPolyAdd(a,b,1,gain));
    FOR j FROM 1 TO SIZE(roots) DO scale:=MAX(scale,1.15*ABS(roots(j))); END;
  END;
  SSHeader("Lugar de raices","K="+STRING(k0)+" ... "+STRING(k1),SSAccent(7));
  RECT_P(24,46,312,184,RGB(203,213,225),RGB(255,255,255));
  LINE_P(168,48,168,182,RGB(148,163,184)); LINE_P(26,115,310,115,RGB(148,163,184));
  FOR idx FROM 0 TO N-1 DO
    gain:=k0+(k1-k0)*idx/(N-1); roots:=SSPolyRoots(SSPolyAdd(a,b,1,gain));
    FOR j FROM 1 TO SIZE(roots) DO
      px:=168+ROUND(110*RE(roots(j))/scale,0); py:=115-ROUND(63*IM(roots(j))/scale,0);
      IF idx==0 THEN RECT_P(px-3,py-3,px+3,py+3,SSAccent(2),SSAccent(2));
      ELSE IF idx==N-1 THEN RECT_P(px-3,py-3,px+3,py+3,SSAccent(7),SSAccent(7));
      ELSE RECT_P(px-1,py-1,px+1,py+1,SSAccent(3),SSAccent(3)); END; END;
    END;
  END;
  TEXTOUT_P(SSFmt(-scale,2),26,187,1,RGB(71,85,105)); TEXTOUT_P("0",164,187,1,RGB(71,85,105)); TEXTOUT_P(SSFmt(scale,2),275,187,1,RGB(71,85,105));
  TEXTOUT_P("verde K0 | rojo K1 | escala Re/Im +/-"+SSFmt(scale,2),28,202,1,RGB(71,85,105));
  REPEAT
    SSFooter({"Volver"},"");
    key:=SSPause();
    IF TYPE(key)==6 THEN
      touch:=key; key:=-1;
      IF touch(5)==0 AND touch(2)>=216 AND touch(4)>=216 THEN
        button:=1+FLOOR(touch(3)*1/320);
        IF button==1+FLOOR(touch(1)*1/320) THEN
          touchKeys:={4}; key:=touchKeys(button);
        END;
      END;
    END;
  UNTIL key==4 OR key==30;
  RETURN 1;
END;

SSSecondOrderPlot(wn,zeta)
BEGIN
  LOCAL idx;
  LOCAL N:=96;
  LOCAL t;
  LOCAL tmax:=6/(MAX(0.25,zeta)*wn);
  LOCAL wd;
  LOCAL r1;
  LOCAL r2;
  LOCAL y:=MAKELIST(0,idx,1,N,1);
  IF zeta==0 THEN tmax:=8/wn; END;
  IF zeta>=1 THEN tmax:=8*(zeta+SQRT(zeta^2-1))/wn; END;
  FOR idx FROM 0 TO N-1 DO
    t:=tmax*idx/(N-1);
    IF zeta<0.999 THEN
      wd:=wn*SQRT(1-zeta^2);
      y(idx+1):=1-EXP(-zeta*wn*t)*(SSCosR(wd*t)+zeta/SQRT(1-zeta^2)*SSSinR(wd*t));
    ELSE
      IF zeta<1.001 THEN y(idx+1):=1-EXP(-wn*t)*(1+wn*t);
      ELSE
        r1:=-wn/(zeta+SQRT(zeta^2-1)); r2:=-wn*(zeta+SQRT(zeta^2-1));
        y(idx+1):=1+(r2*EXP(r1*t)-r1*EXP(r2*t))/(r1-r2);
      END;
    END;
  END;
  SSPlotXY(y,0,tmax/(N-1),"Respuesta escalon 2do orden","Eje temporal t"); RETURN 1;
END;

SSSymbolicResults(titulo,etiqueta,resultado,entrada,nota)
BEGIN
  LOCAL guardado:=SSHistoryAdd({1,titulo,etiqueta,resultado,entrada,nota});
  IF guardado==0 THEN RETURN SSResultBrowse({titulo,1},etiqueta,resultado,entrada,nota); END;
  RETURN SSResultBrowse(titulo,etiqueta,resultado,entrada,nota);
END;

SSResultBrowse(titulo,etiqueta,resultado,entrada,nota)
BEGIN
  LOCAL op:=1;
  LOCAL items;
  LOCAL fila;
  LOCAL j;
  LOCAL valor;
  LOCAL sub;
  LOCAL registroSalida:={};
  IF TYPE(titulo)==6 THEN
    IF titulo(2)==1 THEN registroSalida:={1,titulo(1),etiqueta,resultado,entrada,nota}; END;
    titulo:=titulo(1);
  END;
  // Resultados multiples: cada valor tiene su propia vista, sin ejecutar el CAS.
  IF TYPE(resultado)==6 THEN
    items:={};
    FOR j FROM 1 TO SIZE(resultado) DO fila:=resultado(j); items:=CONCAT(items,{fila(1)}); END;
    items:=CONCAT(items,{"Entrada y contexto","Volver"});
    REPEAT
      op:=SSMenu({titulo,registroSalida,SIZE(items)},items,op);
      IF op==0 OR op==SIZE(resultado)+2 THEN RETURN 1; END;
      IF op==SIZE(resultado)+1 THEN
        SSInfoView(titulo,etiqueta,entrada+"\n"+nota+"\nTextbook solo cambia la presentacion. No certifica exactitud ni resuelve operaciones pendientes.",SSAccent(3));
      ELSE
        fila:=resultado(op); valor:=fila(2);
        IF TYPE(valor)<>2 THEN valor:=STRING(valor,1,12,{3,".E-",0}); END;
        SSFormulaView(titulo,fila(1),valor,SSAccent(3));
        sub:=1;
        REPEAT
          sub:=SSMenu(fila(1),{"Volver al resultado","Texto lineal completo","Contexto y condiciones","Ver Textbook otra vez"},sub);
          IF sub==0 OR sub==1 THEN BREAK; END;
          IF sub==4 THEN SSFormulaView(titulo,fila(1),valor,SSAccent(3)); END;
          IF sub==2 THEN SSInfoView(titulo,fila(1),valor,SSAccent(3)); END;
          IF sub==3 THEN SSInfoView(titulo,etiqueta,entrada+"\n"+nota,SSAccent(3)); END;
        UNTIL 0;
      END;
    UNTIL 0;
  END;
  SSFormulaView(titulo,etiqueta,resultado,SSAccent(3));
  REPEAT
    op:=SSMenu({"Resultado simbolico",registroSalida,5},{"Resultado Textbook","Ver entrada utilizada","Interpretacion y condiciones","Expresion lineal completa","Volver"},op);
    IF op==0 OR op==5 THEN RETURN 1; END;
    IF op==1 THEN SSFormulaView(titulo,etiqueta,resultado,SSAccent(3)); END;
    IF op==2 THEN SSInfoView(titulo,"Entrada utilizada",entrada,SSAccent(3)); END;
    IF op==3 THEN SSInfoView(titulo,"Metodo y condiciones",nota+"\nTextbook es un formato de presentacion: no certifica exactitud. Una formula ingresada no es un resultado calculado; una integral o suma pendiente tampoco es una solucion cerrada. Las unidades y condiciones son las del problema y no se infieren automaticamente.",SSAccent(3)); END;
    IF op==4 THEN SSInfoView(titulo,"Expresion lineal completa",resultado,SSAccent(3)); END;
  UNTIL op==5;
  RETURN 1;
END;

SSCASResult(comando,titulo,entrada,nota)
BEGIN
  LOCAL resultado:=SSCASString(comando);
  IF resultado=="" THEN
    SSInfoView("SignalLab","Aviso",titulo+"\n\nNo se obtuvo un resultado simbolico.\nLa expresion no pudo resolverse en el CAS interno.\n\nRevise la sintaxis y que las variables simbolicas no tengan valores asignados.",SSAccent(1));
    RETURN "";
  END;
  SSSymbolicResults(titulo,"Expresion calculada",resultado,entrada,nota);
  RETURN resultado;
END;

SSCASString(comando)
BEGIN
  LOCAL resultado;
  IFERR
    // EVAL interpreta la cadena como expresion y CAS la ejecuta en el
    // entorno simbolico. Este patron evita que CAS reciba solo texto.
    resultado:=CAS(EVAL(comando));
  THEN
    RETURN "";
  END;
  IF UPPER(STRING(resultado))=="UNDEF" OR INSTRING(UPPER(STRING(resultado)),"ERROR")>0 THEN RETURN ""; END;
  RETURN STRING(resultado);
END;

SSCASTransformString(tipo,f,comando)
BEGIN
  LOCAL resultado;
  LOCAL texto;
  IFERR
    // Las transformadas se invocan directamente en el espacio CAS.
    // Expresion y variables viajan como cadenas para evitar Home/PPL.
    IF tipo==1 THEN resultado:=CAS.laplace(f,"t","s"); END;
    IF tipo==2 THEN resultado:=CAS.ilaplace(f,"s","t"); END;
    IF tipo==3 THEN resultado:=CAS.ztrans(f,"n","z"); END;
    IF tipo==4 THEN resultado:=CAS.invztrans(f,"z","n"); END;
  THEN
    RETURN "";
  END;
  texto:=STRING(resultado);
  IF UPPER(texto)=="UNDEF" OR INSTRING(UPPER(texto),"ERROR")>0 THEN RETURN ""; END;
  IF UPPER(texto)==UPPER(comando) THEN RETURN ""; END;
  RETURN texto;
END;

SSCASRunTransform(tipo,f,comando,titulo)
BEGIN
  // Consulta recursiva interna: titulo={profundidad}, retorna formula/metodo/condiciones.
  // Tipos 1..4: Laplace/Z e inversas; 5/6: Fourier/IFourier; 7: DTFT bilateral.
  LOCAL profundidad:=0;
  LOCAL interno:=TYPE(titulo)==6;
  LOCAL src:=f;
  LOCAL resultado:="";
  LOCAL metodo:="PENDIENTE";
  LOCAL condiciones:="";
  LOCAL axis:="sltrtime";
  LOCAL freq:="sltrfreq";
  LOCAL chars:="ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_";
  LOCAL funcs:="|ABS|SIN|COS|TAN|EXP|LN|SQRT|SINH|COSH|CONJ|RE|IM|SIGN|FLOOR|CEILING|";
  LOCAL texto;
  LOCAL token;
  LOCAL pos;
  LOCAL fin;
  LOCAL nivel;
  LOCAL corte;
  LOCAL operador;
  LOCAL izquierda;
  LOCAL derecha;
  LOCAL r1;
  LOCAL r2;
  LOCAL arg:="";
  LOCAL nombre:="";
  LOCAL a;
  LOCAL b;
  LOCAL residuo;
  LOCAL aux;
  LOCAL af:=0;
  LOCAL expAbs:=0;
  LOCAL coefAbs;
  LOCAL argAbs;
  LOCAL u:="sltrfreq";
  LOCAL salida:="w";
  LOCAL nombresEntrada:="|";
  LOCAL indiceSalida:=0;
  LOCAL coefSinc;
  LOCAL etiqueta:="Formula simbolica";
  LOCAL nota;
  LOCAL respuesta;
  LOCAL dual:=0;
  LOCAL permitirCAS:=0;
  LOCAL normalizarEntrada:=0;
  LOCAL propiedad:=0;
  LOCAL elegir;
  LOCAL ordenProp:=1;
  LOCAL jprop;
  LOCAL baseProp;
  LOCAL resultadoBase;
  LOCAL metodoBase;
  LOCAL condicionesBase;
  LOCAL propiedadLista;
  LOCAL cancelarProp;
  LOCAL operacionProp:="";
  LOCAL reglaProp:="";
  LOCAL inicialesProp:="";
  LOCAL derivadaProp;
  LOCAL valorProp;
  LOCAL segundaProp:="EXP(-X^2)";
  LOCAL modulacionProp:=1;
  LOCAL frecuenciaProp:="1";
  LOCAL faseProp:="0";
  LOCAL omegaProp;
  LOCAL phiProp;
  LOCAL masProp;
  LOCAL menosProp;
  LOCAL integrandoProp;
  LOCAL limiteProp;
  LOCAL auxiliarProp:="sltraux";
  LOCAL pendientesProp:=0;
  LOCAL avisoProp:="";
  LOCAL cleanInput;
  LOCAL cleanAtoms;
  LOCAL cleanNames;
  LOCAL cleanAtom;
  LOCAL cleanName;
  LOCAL cleanIndex;
  LOCAL cleanStart;
  LOCAL cleanDepth;
  LOCAL cleanOk;
  LOCAL cleanRestored;
  LOCAL cleanProtected:="|SUM|DIRAC|HEAVISIDE|PV|INT|INTEGRATE|LIMIT|DIFF|SUBST|";
  IF interno THEN profundidad:=titulo(1); END;
  IF interno THEN
    IF SIZE(titulo)>=2 THEN permitirCAS:=titulo(2); END;
    IF SIZE(titulo)>=3 THEN normalizarEntrada:=titulo(3); END;
  END;
  IF profundidad>12 OR DIM(src)>4096 THEN
    IF interno THEN RETURN {"","PENDIENTE","Expresion demasiado extensa para el reconocimiento por tablas.",src}; END;
    SSInfoView(titulo,"Expresion demasiado extensa","Use hasta 4096 caracteres; el reconocimiento admite hasta 12 niveles de operaciones.",SSAccent(3)); RETURN 0;
  END;
  IF interno==0 OR normalizarEntrada THEN
    IF tipo==1 THEN salida:="s"; END; IF tipo==2 OR tipo==6 THEN salida:="t"; END;
    IF tipo==3 THEN salida:="z"; END; IF tipo==4 THEN salida:="n"; END;
    // w puede ser un parametro de entrada; no confundirlo con el eje del resultado.
    IF interno==0 AND (tipo==5 OR tipo==7) THEN
      pos:=1;
      WHILE pos<=DIM(src) DO
        token:=MID(src,pos,1);
        IF INSTRING(chars,UPPER(token))>0 THEN
          fin:=pos+1; WHILE fin<=DIM(src) AND INSTRING(chars,UPPER(MID(src,fin,1)))>0 DO fin:=fin+1; END;
          nombresEntrada:=nombresEntrada+MID(src,pos,fin-pos)+"|"; pos:=fin;
        ELSE pos:=pos+1; END;
      END;
      IF INSTRING(nombresEntrada,"|w|")>0 THEN
        salida:="omega";
        WHILE INSTRING(nombresEntrada,"|"+salida+"|")>0 AND indiceSalida<32 DO
          indiceSalida:=indiceSalida+1; salida:="omega"+STRING(indiceSalida);
        END;
        IF INSTRING(nombresEntrada,"|"+salida+"|")>0 THEN
          SSInfoView(titulo,"Nombre de salida no disponible","Renombre algun parametro omega para distinguir entrada y frecuencia de salida.",SSAccent(3)); RETURN 0;
        END;
      END;
    END;
    IF INSTRING(LOWER(src),"sltr")>0 THEN
      IF interno THEN RETURN {"","PENDIENTE","Nombre reservado sltr en la segunda entrada.",""}; END;
      SSInfoView(titulo,"Nombre reservado","No use nombres que contengan sltr; se reservan para el calculo aislado.",SSAccent(3)); RETURN 0;
    END;
    IF SSCASString("eval("+axis+")")<>axis OR SSCASString("eval("+freq+")")<>freq THEN
      IF interno THEN RETURN {"","PENDIENTE","Simbolos internos ocupados.",""}; END;
      SSInfoView(titulo,"Simbolos ocupados","sltrtime o sltrfreq no estan libres. No se borraron sus variables ni se inicio el calculo.",SSAccent(3)); RETURN 0;
    END;
    // Normalizar identificadores completos; no reemplazar letras dentro de nombres.
    texto:=""; pos:=1;
    WHILE pos<=DIM(src) DO
      token:=MID(src,pos,1);
      IF INSTRING(chars,UPPER(token))>0 THEN
        fin:=pos+1; WHILE fin<=DIM(src) AND INSTRING(chars,UPPER(MID(src,fin,1)))>0 DO fin:=fin+1; END;
        token:=MID(src,pos,fin-pos); pos:=fin;
        IF token==salida OR (tipo==7 AND token=="m") THEN
          IF interno THEN RETURN {"","PENDIENTE","Parametro reservado en la segunda entrada: "+token,""}; END;
          SSInfoView(titulo,"Parametro ambiguo","El nombre "+token+" se reserva para la salida o sus replicas. Renombre ese parametro, por ejemplo w0, antes de calcular.",SSAccent(3)); RETURN 0;
        END;
        IF INSTRING(funcs,"|"+UPPER(token)+"|")>0 THEN token:=LOWER(token); END;
        IF UPPER(token)=="HEAVISIDE" THEN token:="Heaviside"; END;
        IF UPPER(token)=="DIRAC" THEN token:="Dirac"; END;
        IF UPPER(token)=="SINC" THEN token:="sinc"; END;
        IF UPPER(token)=="PI" THEN token:="pi"; END;
        IF token=="j" THEN token:="i"; END;
        IF token=="X" OR token=="x" THEN token:=axis; END;
        IF (tipo==1 OR tipo==5) AND token=="t" THEN token:=axis; END;
        IF tipo==2 AND token=="s" THEN token:=axis; END;
        IF (tipo==3 OR tipo==7) AND (token=="n" OR token=="N") THEN token:=axis; END;
        IF tipo==4 AND (token=="z" OR token=="Z") THEN token:=axis; END;
        IF tipo==6 AND (token=="w" OR token=="W") THEN token:=axis; END;
      ELSE pos:=pos+1; END;
      IF token<>" " THEN texto:=texto+token; END;
    END;
    src:=texto;
  END;
  // La inversa usa dualidad F^-1{g}(t)=F{g}(-t)/(2*pi), sin cambiar convencion.
  IF tipo==6 THEN
    r1:=SSCASRunTransform(5,src,"",{profundidad+1});
    IF r1(1)<>"" THEN resultado:="("+r1(1)+")/(2*pi)"; dual:=1; metodo:=r1(2); condiciones:=r1(3)+" Dualidad: evaluar la frecuencia en -t y dividir por 2*pi."; END;
  ELSE
    // Quitar solo parentesis que encierran TODA la expresion.
    REPEAT
      corte:=0; nivel:=0;
      IF DIM(src)>1 AND LEFT(src,1)=="(" THEN
        FOR pos FROM 1 TO DIM(src) DO
          token:=MID(src,pos,1); IF token=="(" THEN nivel:=nivel+1; END;
          IF token==")" THEN nivel:=nivel-1; END;
          IF nivel==0 THEN corte:=pos; BREAK; END;
        END;
      END;
      IF corte==DIM(src) THEN src:=MID(src,2,DIM(src)-2); ELSE BREAK; END;
    UNTIL 0;
    // Linealidad: separar sumas/restas al nivel exterior, nunca exponentes E-3.
    corte:=0; nivel:=0;
    FOR pos FROM 1 TO DIM(src) DO
      token:=MID(src,pos,1);
      IF token=="(" THEN nivel:=nivel+1; END; IF token==")" THEN nivel:=nivel-1; END;
      IF nivel==0 AND pos>1 AND (token=="+" OR token=="-") THEN
        aux:=MID(src,pos-1,1);
        IF INSTRING("+-*/^Ee",aux)==0 THEN corte:=pos; END;
      END;
    END;
    IF corte>0 THEN
      operador:=MID(src,corte,1); izquierda:=LEFT(src,corte-1); derecha:=MID(src,corte+1,DIM(src)-corte);
      r1:=SSCASRunTransform(tipo,izquierda,"",{profundidad+1}); r2:=SSCASRunTransform(tipo,derecha,"",{profundidad+1});
      IF r1(1)<>"" AND r2(1)<>"" THEN resultado:="("+r1(1)+")"+operador+"("+r2(1)+")"; metodo:="Linealidad: "+r1(2)+" / "+r2(2); condiciones:=r1(3)+" "+r2(3); END;
    END;
    IF resultado=="" AND LEFT(src,1)=="-" THEN
      r1:=SSCASRunTransform(tipo,MID(src,2,DIM(src)-1),"",{profundidad+1});
      IF r1(1)<>"" THEN resultado:="-("+r1(1)+")"; metodo:=r1(2); condiciones:=r1(3); END;
    END;
    // Multiplicacion/division por una expresion independiente del tiempo/indice.
    IF resultado=="" THEN
      nivel:=0; corte:=0;
      FOR pos FROM 1 TO DIM(src) DO
        token:=MID(src,pos,1);
        IF token=="(" THEN nivel:=nivel+1; END; IF token==")" THEN nivel:=nivel-1; END;
        IF nivel==0 AND (token=="*" OR token=="/") THEN corte:=pos; END;
      END;
      IF corte>0 THEN
          token:=MID(src,corte,1); izquierda:=LEFT(src,corte-1); derecha:=MID(src,corte+1,DIM(src)-corte);
          aux:="1";
          IF token=="/" THEN aux:=SSCASString("simplify("+derecha+")"); END;
          IF INSTRING(derecha,axis)==0 AND aux<>"0" THEN
            r1:=SSCASRunTransform(tipo,izquierda,"",{profundidad+1});
            IF r1(1)<>"" THEN resultado:="("+r1(1)+")"+token+"("+derecha+")"; metodo:=r1(2); condiciones:=r1(3)+" Todo divisor constante debe ser no nulo."; END;
          END;
          IF token=="*" AND INSTRING(izquierda,axis)==0 THEN
            r1:=SSCASRunTransform(tipo,derecha,"",{profundidad+1});
            IF r1(1)<>"" THEN resultado:="("+izquierda+")*("+r1(1)+")"; metodo:=r1(2); condiciones:=r1(3); END;
          END;
      END;
    END;
    aux:="1";
    IF resultado=="" AND INSTRING(src,axis)==0 THEN aux:=UPPER(SSCASString("simplify("+src+")")); END;
    IF resultado=="" AND INSTRING(src,axis)==0 AND aux<>"" AND aux<>"UNDEF" AND aux<>"NAN" AND INSTRING(aux,"INFINITY")==0 AND (tipo==1 OR tipo==3 OR tipo==5 OR tipo==7) THEN
      IF src=="0" THEN resultado:="0";
      ELSE
        IF tipo==1 THEN resultado:="("+src+")/"+u; END;
        IF tipo==3 THEN resultado:="("+src+")*"+u+"/("+u+"-1)"; END;
        IF tipo==5 THEN resultado:="2*pi*("+src+")*Dirac("+u+")"; END;
        IF tipo==7 THEN resultado:="2*pi*("+src+")*sum(Dirac("+u+"-2*pi*m),m,-infinity,infinity)"; END;
      END;
      metodo:="TABLA: constante";
      IF tipo==1 THEN condiciones:="Laplace unilateral t>=0; Re(s)>0 para constante no nula."; END;
      IF tipo==3 THEN condiciones:="Z unilateral n>=0; |z|>1 para constante no nula."; END;
      IF tipo==5 OR tipo==7 THEN condiciones:="Distribucion Dirac; no es una curva ordinaria. m recorre todos los enteros en DTFT."; END;
    END;
    // sin(a*t+b)/d(t) es c*sinc(a*t+b) SOLO si (a*t+b)/d(t)=c constante.
    // Reutiliza el par sinc y sus condiciones, sin asumir que cualquier cociente es sinc.
    IF resultado=="" AND tipo==5 THEN
      nivel:=0; corte:=0;
      FOR pos FROM 1 TO DIM(src) DO
        token:=MID(src,pos,1);
        IF token=="(" THEN nivel:=nivel+1; END; IF token==")" THEN nivel:=nivel-1; END;
        IF nivel==0 AND token=="/" THEN corte:=pos; END;
      END;
      IF corte>0 THEN
        izquierda:=LEFT(src,corte-1); derecha:=MID(src,corte+1,DIM(src)-corte);
        REPEAT
          nivel:=0; fin:=0;
          IF LEFT(izquierda,1)=="(" THEN
            FOR pos FROM 1 TO DIM(izquierda) DO
              token:=MID(izquierda,pos,1); IF token=="(" THEN nivel:=nivel+1; END; IF token==")" THEN nivel:=nivel-1; END;
              IF nivel==0 THEN fin:=pos; BREAK; END;
            END;
          END;
          IF fin==DIM(izquierda) AND fin>1 THEN izquierda:=MID(izquierda,2,DIM(izquierda)-2); ELSE BREAK; END;
        UNTIL 0;
        IF LEFT(izquierda,4)=="sin(" AND RIGHT(izquierda,1)==")" AND INSTRING(derecha,axis)>0 THEN
          nivel:=1; fin:=5;
          WHILE fin<=DIM(izquierda) AND nivel>0 DO
            token:=MID(izquierda,fin,1); IF token=="(" THEN nivel:=nivel+1; END; IF token==")" THEN nivel:=nivel-1; END; fin:=fin+1;
          END;
          IF nivel==0 AND fin==DIM(izquierda)+1 THEN
            arg:=MID(izquierda,5,DIM(izquierda)-5);
            coefSinc:=SSCASString("simplify(("+arg+")/("+derecha+"))");
            aux:=UPPER(coefSinc);
            IF coefSinc<>"" AND coefSinc<>"0" AND INSTRING(coefSinc,axis)==0 AND INSTRING(aux,"UNDEF")==0 AND INSTRING(aux,"NAN")==0 AND INSTRING(aux,"INFINITY")==0 THEN
              residuo:=SSCASString("simplify(("+arg+")-("+coefSinc+")*("+derecha+"))");
              IF residuo=="0" THEN
                r1:=SSCASRunTransform(5,"sinc("+arg+")","",{profundidad+1});
                IF r1(1)<>"" THEN
                  resultado:="("+coefSinc+")*("+r1(1)+")";
                  metodo:="TABLA: seno sobre argumento proporcional";
                  condiciones:=r1(3)+" Cociente interpretado por continuidad en su singularidad removible.";
                END;
              END;
            END;
          END;
        END;
      END;
    END;
    // Pares de funciones con argumento afin a*tiempo+b.
    IF resultado=="" AND (tipo==1 OR tipo==3 OR tipo==5 OR tipo==7) THEN
      corte:=INSTRING(src,"(");
      IF corte>1 AND RIGHT(src,1)==")" THEN
        nombre:=LEFT(src,corte-1); arg:=MID(src,corte+1,DIM(src)-corte-1);
        IF nombre=="sin" OR nombre=="cos" OR nombre=="exp" OR nombre=="Dirac" OR nombre=="Heaviside" OR nombre=="sinc" THEN
          // exp(c*abs(a*t+b)): par bilateral de decaimiento, con Re(c)<0.
          IF nombre=="exp" AND tipo==5 THEN
            corte:=INSTRING(arg,"abs(");
            IF corte>0 THEN
              nivel:=1; fin:=corte+4;
              WHILE fin<=DIM(arg) AND nivel>0 DO
                token:=MID(arg,fin,1); IF token=="(" THEN nivel:=nivel+1; END; IF token==")" THEN nivel:=nivel-1; END;
                fin:=fin+1;
              END;
              IF nivel==0 THEN
                argAbs:=MID(arg,corte+4,fin-corte-5);
                coefAbs:=SSCASString("simplify(("+arg+")/abs("+argAbs+"))");
                IF coefAbs<>"" AND INSTRING(coefAbs,axis)==0 THEN
                  residuo:=SSCASString("simplify(("+arg+")-("+coefAbs+")*abs("+argAbs+"))");
                  IF residuo=="0" THEN expAbs:=1; END;
                  aux:=SSCASString("evalf(re("+coefAbs+"))");
                  IFERR residuo:=EXPR(aux); IF SSIsDrawable(residuo) THEN IF RE(residuo)>=0 THEN expAbs:=0; END; END; THEN residuo:=0; END;
                  IF expAbs THEN arg:=argAbs; END;
                END;
              END;
            END;
          END;
          a:=SSCASString("simplify(diff(("+arg+"),"+axis+"))");
          b:=SSCASString("simplify(subst(("+arg+"),"+axis+",0))");
          IF a<>"" AND b<>"" AND a<>"0" AND INSTRING(a,axis)==0 AND INSTRING(b,axis)==0 THEN
            residuo:=SSCASString("simplify(("+arg+")-("+a+")*"+axis+"-("+b+"))");
            IF residuo=="0" THEN af:=1; END;
          END;
          IF af AND (nombre<>"exp" OR expAbs) THEN
            respuesta:={a,b};
            FOR pos FROM 1 TO 2 DO
              aux:=SSCASString("evalf(im("+respuesta(pos)+"))");
              IFERR residuo:=EXPR(aux); IF SSIsDrawable(residuo) THEN IF ABS(residuo)>0 THEN af:=0; END; END; THEN residuo:=0; END;
            END;
          END;
          IF af THEN
            condiciones:="Argumento afin: a="+a+", b="+b+". Las reglas sin/cos/Dirac/Heaviside/sinc requieren a real no nulo y b real. Parametros no verificados: resultado CONDICIONAL.";
            IF nombre=="sin" OR nombre=="cos" THEN
              IF tipo==1 THEN
                aux:="("+u+"^2+("+a+")^2)";
                IF nombre=="cos" THEN resultado:="("+u+"*cos("+b+")-("+a+")*sin("+b+"))/"+aux;
                ELSE resultado:="(("+a+")*cos("+b+")+"+u+"*sin("+b+"))/"+aux; END;
                condiciones:=condiciones+" Unilateral; Re(s)>0 para a,b reales.";
              END;
              IF tipo==3 THEN
                aux:="("+u+"^2-2*"+u+"*cos("+a+")+1)";
                IF nombre=="cos" THEN resultado:="(cos("+b+")*("+u+"^2-"+u+"*cos("+a+"))-sin("+b+")*"+u+"*sin("+a+"))/"+aux;
                ELSE resultado:="(sin("+b+")*("+u+"^2-"+u+"*cos("+a+"))+cos("+b+")*"+u+"*sin("+a+"))/"+aux; END;
                condiciones:=condiciones+" Unilateral; |z|>1 para a,b reales.";
              END;
              IF tipo==5 OR tipo==7 THEN
                izquierda:="Dirac("+u+"-("+a+"))"; derecha:="Dirac("+u+"+("+a+"))";
                IF tipo==7 THEN izquierda:="sum(Dirac("+u+"-("+a+")-2*pi*m),m,-infinity,infinity)"; derecha:="sum(Dirac("+u+"+("+a+")-2*pi*m),m,-infinity,infinity)"; END;
                IF nombre=="cos" THEN resultado:="pi*(exp(i*("+b+"))*"+izquierda+"+exp(-i*("+b+"))*"+derecha+")";
                ELSE resultado:="pi*(exp(i*("+b+"))*"+izquierda+"-exp(-i*("+b+"))*"+derecha+")/i"; END;
                // Fase nula: no generar factores unidad, aun sin CAS disponible.
                IF b=="0" THEN
                  IF nombre=="cos" THEN resultado:="pi*("+izquierda+"+"+derecha+")";
                  ELSE resultado:="pi*("+izquierda+"-"+derecha+")/i"; END;
                END;
                condiciones:=condiciones+" Distribucion, no valores de una curva. En DTFT las replicas se separan 2*pi; m entero.";
              END;
            END;
            IF nombre=="exp" THEN
              IF tipo==1 THEN resultado:="exp("+b+")/("+u+"-("+a+"))"; condiciones:="Laplace unilateral; Re(s)>Re("+a+")."; END;
              IF tipo==3 THEN resultado:="exp("+b+")*"+u+"/("+u+"-exp("+a+"))"; condiciones:="Z unilateral; |z|>|exp("+a+")|."; END;
              IF tipo==5 AND expAbs THEN
                resultado:="(-2*("+coefAbs+")*abs("+a+"))*exp(i*"+u+"*("+b+")/("+a+"))/(("+coefAbs+")^2*("+a+")^2+"+u+"^2)";
                condiciones:="exp(c*abs(a*t+b)): c="+coefAbs+", a="+a+", b="+b+". Re(c)<0; a real no nulo, b real. Resultado condicionado a estos supuestos; decaimiento bilateral.";
              END;
            END;
            IF nombre=="Dirac" AND tipo==5 THEN resultado:="exp(i*"+u+"*("+b+")/("+a+"))/abs("+a+")"; END;
            IF nombre=="Dirac" AND (tipo==3 OR tipo==7) THEN
              aux:=SSCASString("simplify(-("+b+")/("+a+"))");
              IFERR
                residuo:=EXPR(aux);
                IF SSIsDrawable(residuo) THEN
                  IF IM(residuo)==0 THEN
                    IF residuo==FLOOR(residuo) THEN
                      IF tipo==3 THEN resultado:=u+"^(-("+aux+"))"; IF residuo<0 THEN resultado:="0"; END;
                      ELSE resultado:="exp(-i*"+u+"*("+aux+"))"; END;
                    ELSE resultado:="0"; END;
                  END;
                END;
              THEN residuo:=0; END;
              condiciones:="Dirac discreta = impulso unitario, NO distribucion continua: vale 1 solo si su argumento es cero en un indice entero. Z es unilateral n>=0; DTFT bilateral. No lleva 1/abs(a).";
            END;
            IF nombre=="Heaviside" AND tipo==5 THEN
              resultado:="pi*Dirac("+u+")+sign("+a+")*exp(i*"+u+"*("+b+")/("+a+"))/(i*"+u+")";
              condiciones:=condiciones+" El termino 1/(i*w) es VALOR PRINCIPAL (PV), no una funcion evaluable en w=0. Diferencias de escalones pueden cancelar Dirac/PV; use limites en singularidades removibles.";
            END;
            IF nombre=="sinc" AND tipo==5 THEN
              resultado:="pi*exp(i*"+u+"*("+b+")/("+a+"))*(Heaviside("+u+"+abs("+a+"))-Heaviside("+u+"-abs("+a+")))/abs("+a+")";
              condiciones:=condiciones+" Aqui sinc(v)=sin(v)/v, sinc(0)=1, NO sin(pi*v)/(pi*v). Valores de frontera segun convencion Heaviside(0).";
            END;
            IF resultado<>"" THEN metodo:="TABLA: "+nombre+" afin"; END;
          END;
        END;
      END;
    END;
  END;
    // Una sola consulta CAS al final, no una por cada subexpresion no reconocida.
    IF resultado=="" AND (interno==0 OR permitirCAS==1) THEN
      IFERR
        IF tipo==1 THEN respuesta:=CAS.laplace(src,axis,freq); END;
        IF tipo==2 THEN respuesta:=CAS.ilaplace(src,axis,freq); END;
        IF tipo==3 THEN respuesta:=CAS.ztrans(src,axis,freq); END;
        IF tipo==4 THEN respuesta:=CAS.invztrans(src,axis,freq); END;
        IF tipo==5 THEN respuesta:=CAS.int("("+src+")*exp(-i*"+freq+"*"+axis+")",axis,"-infinity","infinity"); END;
        IF tipo==6 THEN respuesta:=CAS.int("("+src+")*exp(i*"+freq+"*"+axis+")/(2*pi)",axis,"-infinity","infinity"); END;
        IF tipo==7 THEN respuesta:=CAS.sum("("+src+")*exp(-i*"+freq+"*"+axis+")",axis,"-infinity","infinity"); END;
        resultado:=STRING(respuesta);
      THEN resultado:=""; END;
      metodo:="CAS: revisar condiciones";
      condiciones:="No se deduce automaticamente convergencia, ROC ni soporte. Laplace/Z de CAS son unilaterales; las inversas se interpretan con el soporte causal correspondiente. Fourier/DTFT completos son bilaterales. Parametros con valor guardado pueden ser evaluados por CAS.";
      texto:=UPPER(resultado);
      IF resultado=="" OR texto=="UNDEF" OR texto=="NAN" OR INSTRING(texto,"ERROR")>0 OR INSTRING(texto,"INFINITY")>0 OR INSTRING(texto,"LAPLACE(")>0 OR INSTRING(texto,"ZTRANS(")>0 OR INSTRING(texto,"INT(")>0 OR INSTRING(texto,"INTEGRATE(")>0 OR INSTRING(texto,"SUM(")>0 OR INSTRING(texto,"LIMIT(")>0 OR INSTRING(resultado,CHAR(8747))>0 OR INSTRING(resultado,axis)>0 THEN resultado:=""; metodo:="PENDIENTE"; END;
    END;
  IF interno THEN RETURN {resultado,metodo,condiciones,src}; END;
  IF resultado=="" THEN
    SSInfoView(titulo,"PENDIENTE: sin formula cerrada","Entrada: "+f+"\nNo se reconocio un par aplicable ni se obtuvo una solucion CAS cerrada. Esto no demuestra divergencia. No se sustituyo el resultado por cero. Puede usar el modo numerico con su ventana, que es un calculo diferente.",SSAccent(7)); RETURN 0;
  END;
  // El resultado base vive hasta salir por su menu protegido, no por cancelar un campo.
  resultadoBase:=resultado; metodoBase:=metodo; condicionesBase:=condiciones;
  REPEAT
  resultado:=resultadoBase; metodo:=metodoBase; condiciones:=condicionesBase;
  propiedad:=0; pendientesProp:=0; inicialesProp:=""; cancelarProp:=0;
  // Propiedades aplicadas a una transformada base ya resuelta, sin cambiar graficos.
  IF tipo==1 OR tipo==3 OR tipo==5 OR tipo==7 THEN
    elegir:=SSMenu({"Resultado simbolico",{3,"Resultado simbolico",{{"Transformada",resultado},{"Entrada",f},{"Metodo",metodo}},condiciones},3},{"Ver transformada calculada","Aplicar propiedad","Volver"},1);
    IF elegir==0 OR elegir==3 THEN RETURN 0; END;
    IF elegir==2 THEN
      propiedadLista:=0;
      REPEAT
      izquierda:="Derivada temporal"; derecha:="Integral acumulada";
      IF tipo==3 OR tipo==7 THEN izquierda:="Diferencia x[n]-x[n-1]"; derecha:="Suma acumulada"; END;
      propiedad:=SSMenu({"Aplicar propiedad",{3,"Aplicar propiedad",{{"Transformada base",resultado},{"Entrada",f},{"Metodo",metodo}},condiciones},7},{izquierda,derecha,"Multiplicar por X^k","Modular: exp / cos / sin","Convolucion con otra senal","Producto con otra senal","Volver"},1);
      IF propiedad==0 OR propiedad==7 THEN cancelarProp:=1; BREAK; END;
      baseProp:=resultado;
      IF propiedad==1 OR propiedad==3 THEN
        IF INPUT(ordenProp,"Orden de la propiedad","k=","Entero de 1 a 6",ordenProp)==0 THEN cancelarProp:=1; BREAK; END;
        IF TYPE(ordenProp)<>0 THEN cancelarProp:=1; BREAK; END;
        IF ordenProp<1 OR ordenProp>6 OR ordenProp<>FLOOR(ordenProp) THEN SSInfoView(titulo,"Orden invalido","Use un entero de 1 a 6.",SSAccent(3)); cancelarProp:=1; BREAK; END;
      END;
      IF propiedad==1 THEN
        IF tipo==5 THEN
          resultado:="(i*"+freq+")^"+STRING(ordenProp)+"*("+baseProp+")";
          reglaProp:="F{x^(k)}=(i*w)^k*F(w)";
          avisoProp:="Derivada temporal, en sentido clasico con terminos de borde nulos, o distribucional cuando corresponda. No es derivar el modulo ni la fase.";
        END;
        IF tipo==1 THEN
          resultado:=freq+"^"+STRING(ordenProp)+"*("+baseProp+")";
          derivadaProp:=src;
          FOR jprop FROM 0 TO ordenProp-1 DO
            valorProp:="limit(("+derivadaProp+"),"+axis+",0,1)";
            aux:=SSCASString(valorProp);
            IF aux<>"" THEN valorProp:=aux; ELSE pendientesProp:=1; END;
            resultado:=resultado+"-("+freq+"^"+STRING(ordenProp-1-jprop)+")*("+valorProp+")";
            inicialesProp:=inicialesProp+"x^"+STRING(jprop)+"(0+)="+valorProp+"; ";
            derivadaProp:="diff(("+derivadaProp+"),"+axis+")";
          END;
          reglaProp:="L{x^(k)}=s^k*F(s)-sum(s^(k-1-j)*x^(j)(0+),j,0,k-1)";
          avisoProp:="Derivada clasica de la rama t>0; usa limites derechos 0+, NO se suponen condiciones iniciales nulas. No incluye el impulso de arranque de una extension causal ni sustituye una derivada distribucional en t=0. Requiere esos limites finitos.";
          IF INSTRING(UPPER(src),"DIRAC(")>0 THEN SSInfoView(titulo,"Derivada unilateral no aplicable","Esta propiedad usa derivadas clasicas y limites 0+. No se aplica a una entrada con Dirac. Transforme la expresion distribucional directamente.",SSAccent(3)); cancelarProp:=1; BREAK; END;
        END;
        IF tipo==3 OR tipo==7 THEN
          aux:="exp(-i*"+freq+")"; IF tipo==3 THEN aux:=freq+"^(-1)"; END;
          resultado:="(1-("+aux+"))^"+STRING(ordenProp)+"*("+baseProp+")";
          reglaProp:="Diferencia atrasada de orden k: (1-retardo)^k*F";
          avisoProp:="No se usa derivada temporal para indices discretos. En Z se asume extension causal x[n]=0 para n<0, incluidas las condiciones de arranque. DTFT: secuencia bilateral.";
        END;
        operacionProp:=izquierda+", orden "+STRING(ordenProp);
      END;
      IF propiedad==2 THEN
        IF tipo==1 THEN resultado:="("+baseProp+")/"+freq; reglaProp:="L{int(x(v),v,0,t)}=F(s)/s"; avisoProp:="Integral desde 0 hasta t, con valor inicial de la integral cero. No es una primitiva con constante arbitraria. Revise ROC y polo adicional en cero."; END;
        IF tipo==3 THEN resultado:="("+baseProp+")/(1-"+freq+"^(-1))"; reglaProp:="Z{sum(x[k],k,0,n)}=F(z)/(1-z^(-1))"; avisoProp:="Suma acumulada causal desde n=0, con suma previa cero. La ROC debe incluir convergencia del acumulador (|z|>1), salvo cancelaciones validas."; END;
        IF tipo==5 OR tipo==7 THEN
          IF INSTRING(UPPER(baseProp),"DIRAC(")>0 OR INSTRING(UPPER(baseProp),"SUM(")>0 OR INSTRING(condiciones,"PRINCIPAL")>0 THEN SSInfoView(titulo,"Acumulacion no certificada","Esta regla requiere un espectro ordinario y finito en cero. No se multiplican aqui Dirac o valores principales existentes.",SSAccent(3)); cancelarProp:=1; BREAK; END;
          valorProp:="limit(("+baseProp+"),"+freq+",0)"; aux:=SSCASString(valorProp);
          IF aux<>"" THEN valorProp:=aux; ELSE pendientesProp:=1; END;
          IF tipo==5 THEN
            resultado:="("+baseProp+")/(i*"+freq+")+pi*("+valorProp+")*Dirac("+freq+")";
            reglaProp:="F{int(x(v),v,-infinity,t)}=PV(F(w)/(i*w))+pi*F(0)*Dirac(w)";
          ELSE
            resultado:="("+baseProp+")/(1-exp(-i*"+freq+"))+pi*("+valorProp+")*sum(Dirac("+freq+"-2*pi*m),m,-infinity,infinity)";
            reglaProp:="DTFT{sum(x[k],k,-infinity,n)}=PV(F/(1-exp(-i*w)))+pi*F(0)*sum(Dirac(w-2*pi*m))";
          END;
          avisoProp:="Acumulacion desde -infinity, condicionada a su existencia y a un espectro regular en cero (por ejemplo entrada integrable/sumable). El cociente es VALOR PRINCIPAL (PV). Se conserva el termino Dirac de continua: no se omite F(0). No es un valor ordinario en las singularidades.";
        END;
        operacionProp:=derecha;
      END;
      IF propiedad==3 THEN
        resultado:=baseProp;
        FOR jprop FROM 1 TO ordenProp DO
          aux:="i"; IF tipo==1 THEN aux:="-1"; END; IF tipo==3 THEN aux:="(-"+freq+")"; END;
          resultado:="("+aux+")*diff(("+resultado+"),"+freq+")";
          IF INSTRING(UPPER(resultado),"SUM(")==0 THEN
            texto:=SSCASString(resultado); IF texto<>"" THEN resultado:=texto; ELSE pendientesProp:=1; END;
          ELSE pendientesProp:=1; END;
        END;
        reglaProp:="Fourier/DTFT: i^k*d^kF/dw^k; Laplace: (-1)^k*d^kF/ds^k; Z: (-z*d/dz)^k F";
        avisoProp:="Se aplica el operador repetidamente. En Z NO es (-z)^k*d^kF/dz^k: las derivadas actuan tambien sobre z. Requiere existencia de la transformada ponderada; para distribuciones se usa derivada distribucional.";
        operacionProp:="Multiplicacion por X^"+STRING(ordenProp);
      END;
      IF propiedad==4 THEN
        modulacionProp:=SSMenu("Modulacion",{"exp(i*(w0*X+phi))","cos(w0*X+phi)","sin(w0*X+phi)","Volver"},1);
        IF modulacionProp==0 OR modulacionProp==4 THEN cancelarProp:=1; BREAK; END;
        IF INPUT(frecuenciaProp,"Modulacion","w0=","Real. Texto CAS exacto: pi/4, 2, w0",frecuenciaProp)==0 THEN cancelarProp:=1; BREAK; END;
        IF INPUT(faseProp,"Fase de modulacion","phi=","Real, radianes. Ej: pi/2 o 0",faseProp)==0 THEN cancelarProp:=1; BREAK; END;
        IF TYPE(frecuenciaProp)<>2 OR TYPE(faseProp)<>2 THEN cancelarProp:=1; BREAK; END;
        r1:={frecuenciaProp,faseProp};
        FOR jprop FROM 1 TO 2 DO
          texto:=r1(jprop); pos:=1;
          IF texto=="" OR INSTRING(LOWER(texto),"sltr")>0 THEN SSInfoView(titulo,"Parametro invalido","Use una constante o parametro real, sin nombres reservados sltr.",SSAccent(3)); cancelarProp:=1; BREAK; END;
          WHILE pos<=DIM(texto) DO
            token:=MID(texto,pos,1);
            IF INSTRING(chars,UPPER(token))>0 THEN
              fin:=pos+1; WHILE fin<=DIM(texto) AND INSTRING(chars,UPPER(MID(texto,fin,1)))>0 DO fin:=fin+1; END;
              token:=MID(texto,pos,fin-pos); pos:=fin;
              IF INSTRING("|X|x|t|s|n|N|z|Z|w|m|","|"+token+"|")>0 THEN SSInfoView(titulo,"Parametro no constante","No use la variable de senal/salida. Puede usar pi/4, w0 o phi0 como parametros reales.",SSAccent(3)); cancelarProp:=1; BREAK; END;
            ELSE pos:=pos+1; END;
          END;
          IF cancelarProp THEN BREAK; END;
          aux:=SSCASString("simplify("+texto+")");
          IF aux=="" OR INSTRING(UPPER(aux),"INFINITY")>0 OR UPPER(aux)=="NAN" THEN SSInfoView(titulo,"Parametro no valido","El CAS no obtuvo una expresion finita para frecuencia/fase.",SSAccent(3)); cancelarProp:=1; BREAK; END;
          r1(jprop):=aux;
          texto:=SSCASString("evalf(im("+aux+"))");
          af:=1;
          IFERR residuo:=EXPR(texto); IF SSIsDrawable(residuo) THEN IF ABS(residuo)>0 THEN af:=0; END; END; THEN residuo:=0; END;
          IF af==0 THEN SSInfoView(titulo,"Parametro no real","Frecuencia y fase deben ser reales. Para parametros simbolicos esta es una condicion del resultado.",SSAccent(3)); cancelarProp:=1; BREAK; END;
        END;
        IF cancelarProp THEN BREAK; END;
        omegaProp:=r1(1); phiProp:=r1(2);
        masProp:=freq+"-("+omegaProp+")"; menosProp:=freq+"+("+omegaProp+")";
        IF tipo==1 THEN masProp:=freq+"-i*("+omegaProp+")"; menosProp:=freq+"+i*("+omegaProp+")"; END;
        IF tipo==3 THEN masProp:=freq+"*exp(-i*("+omegaProp+"))"; menosProp:=freq+"*exp(i*("+omegaProp+"))"; END;
        // Sustitucion lexical: no evaluar una suma infinita de Dirac al desplazarla.
        r1:={"",""}; r2:={masProp,menosProp};
        FOR jprop FROM 1 TO 2 DO
          texto:=""; pos:=1;
          WHILE pos<=DIM(baseProp) DO
            token:=MID(baseProp,pos,1);
            IF INSTRING(chars,UPPER(token))>0 THEN
              fin:=pos+1; WHILE fin<=DIM(baseProp) AND INSTRING(chars,UPPER(MID(baseProp,fin,1)))>0 DO fin:=fin+1; END;
              token:=MID(baseProp,pos,fin-pos); pos:=fin;
              IF token==freq THEN token:="("+r2(jprop)+")"; END;
            ELSE pos:=pos+1; END;
            texto:=texto+token;
          END;
          r1(jprop):=texto;
        END;
        masProp:="exp(i*("+phiProp+"))*("+r1(1)+")"; menosProp:="exp(-i*("+phiProp+"))*("+r1(2)+")";
        resultado:=masProp;
        IF modulacionProp==2 THEN resultado:="("+masProp+"+"+menosProp+")/2"; END;
        IF modulacionProp==3 THEN resultado:="("+masProp+"-"+menosProp+")/(2*i)"; END;
        reglaProp:="exp(i*w0*X): Fourier/DTFT F(w-w0), Laplace F(s-i*w0), Z F(z*exp(-i*w0)). cos/sin: suma/diferencia de ambos desplazamientos.";
        avisoProp:="w0="+omegaProp+", phi="+phiProp+" rad. Ambos deben ser reales; los parametros simbolicos no verificados quedan condicionados. Se conserva el texto CAS (pi/4 no se convierte deliberadamente a decimal). Parametros guardados en CAS pueden evaluarse. La ROC de Laplace se traslada; en Z se rota. Para cos/sin se requiere una region comun de convergencia. DTFT conserva replicas cada 2*pi.";
        operacionProp:="Modulacion, opcion "+STRING(modulacionProp);
      END;
      IF propiedad==5 OR propiedad==6 THEN
        IF tipo==1 OR tipo==3 THEN segundaProp:="exp(-2*X)"; END;
        IF INPUT(segundaProp,"Segunda senal","h(X)=","Use X; mismo dominio que x",segundaProp)==0 THEN cancelarProp:=1; BREAK; END;
        r2:=SSCASRunTransform(tipo,segundaProp,"",{profundidad+1,1,1});
        IF r2(4)=="" THEN SSInfoView(titulo,"Segunda entrada no valida",r2(3),SSAccent(3)); cancelarProp:=1; BREAK; END;
        IF propiedad==5 THEN
          IF r2(1)=="" THEN SSInfoView(titulo,"Convolucion pendiente","No se obtuvo la transformada de h. No se multiplica por cero ni se omite esa entrada.",SSAccent(3)); cancelarProp:=1; BREAK; END;
          IF (INSTRING(UPPER(baseProp),"DIRAC(")>0 OR INSTRING(condiciones,"PRINCIPAL")>0) AND (INSTRING(UPPER(r2(1)),"DIRAC(")>0 OR INSTRING(r2(3),"PRINCIPAL")>0) THEN SSInfoView(titulo,"Producto distribucional no definido","No se multiplica Dirac por Dirac ni dos espectros singulares sin justificar que el producto exista. Esta convolucion no se certifica automaticamente.",SSAccent(3)); cancelarProp:=1; BREAK; END;
          resultado:="("+baseProp+")*("+r2(1)+")";
          reglaProp:="Transformada de x*h = F*H";
          avisoProp:="Convolucion LINEAL, no circular. Fourier/DTFT: bilateral, condicionada a existencia. Laplace/Z: convolucion causal desde 0, con entradas nulas antes de 0. La ROC requiere una interseccion de convergencia; no se infiere de una cancelacion algebraica.";
          condiciones:=condiciones+"\nSegunda transformada: "+r2(3);
          operacionProp:="Convolucion con h="+segundaProp;
        ELSE
          operacionProp:="Producto punto a punto por h="+segundaProp;
          IF tipo==1 OR tipo==3 THEN
            r1:=SSCASRunTransform(tipo,"("+src+")*("+r2(4)+")","",{profundidad+1,1});
            resultado:=r1(1);
            IF resultado=="" THEN SSInfoView(titulo,"Producto pendiente","El CAS no resolvio la transformada del producto. F*H seria una convolucion en el dominio original, NO este producto.",SSAccent(3)); cancelarProp:=1; BREAK; END;
            reglaProp:="Laplace/Z del producto x*h punto a punto: consulta CAS directa";
            avisoProp:="No se aplica F*H: eso corresponde a convolucion. No se implementa aqui la integral de contorno de Bromwich/Z. Se transforma la expresion del producto y se conservan las condiciones del CAS.";
            condiciones:=condiciones+"\n"+r1(3);
          ELSE
            IF r2(1)=="" THEN SSInfoView(titulo,"Producto pendiente","No se obtuvo H para plantear su convolucion espectral.",SSAccent(3)); cancelarProp:=1; BREAK; END;
            IF INSTRING(UPPER(baseProp),"SUM(")>0 OR INSTRING(UPPER(r2(1)),"SUM(")>0 OR INSTRING(condiciones,"PRINCIPAL")>0 OR INSTRING(r2(3),"PRINCIPAL")>0 THEN SSInfoView(titulo,"Producto espectral no certificado","No se integra automaticamente un tren infinito de Dirac ni un valor principal ya existente. Para multiplicar por seno/coseno use Modulacion. No se reemplaza el producto por F*H.",SSAccent(3)); cancelarProp:=1; BREAK; END;
            IF SSCASString("eval("+auxiliarProp+")")<>auxiliarProp THEN SSInfoView(titulo,"Simbolo auxiliar ocupado","sltraux no esta libre. No se borro su valor ni se integro con ese valor.",SSAccent(3)); cancelarProp:=1; BREAK; END;
            izquierda:=SSCASString("subst(("+baseProp+"),"+freq+","+auxiliarProp+")");
            derecha:=SSCASString("subst(("+r2(1)+"),"+freq+",("+freq+"-"+auxiliarProp+"))");
            IF izquierda=="" OR derecha=="" THEN SSInfoView(titulo,"Producto pendiente","No se pudo construir la convolucion espectral.",SSAccent(3)); cancelarProp:=1; BREAK; END;
            limiteProp:="-infinity,infinity"; IF tipo==7 THEN limiteProp:="-pi,pi"; END;
            integrandoProp:="("+izquierda+")*("+derecha+")/(2*pi)";
            resultado:="int("+integrandoProp+","+auxiliarProp+","+limiteProp+")";
            texto:=SSCASString(resultado); IF texto<>"" THEN resultado:=texto; ELSE pendientesProp:=1; END;
            reglaProp:="F{x*h punto a punto}=(1/(2*pi))*convolucion de F y H en frecuencia";
            avisoProp:="Fourier continua integra todo el eje. DTFT integra UN periodo [-pi,pi] con espectros periodicos; no es una convolucion lineal truncada. Se requiere que producto e integral existan. Una integral sin resolver se muestra como PENDIENTE, no como solucion cerrada.";
            condiciones:=condiciones+"\nSegunda transformada: "+r2(3);
          END;
        END;
      END;
      metodo:="PROPIEDAD: "+operacionProp;
      condiciones:=condiciones+"\nRegla: "+reglaProp+"\n"+avisoProp;
      IF inicialesProp<>"" THEN condiciones:=condiciones+"\nIniciales calculadas: "+inicialesProp; END;
      propiedadLista:=1;
      UNTIL 1;
      IF propiedadLista==0 THEN CONTINUE; END;
    END;
  END;
  // Simplificar solo al final; no evaluar texto con variables de presentacion guardadas.
  IF INSTRING(UPPER(resultado),"SUM(")==0 THEN
    IFERR respuesta:=CAS.simplify(resultado); aux:=STRING(respuesta); THEN aux:=""; END;
    IF aux<>"" AND UPPER(aux)<>"UNDEF" AND INSTRING(UPPER(aux),"ERROR")==0 AND INSTRING(UPPER(aux),"NAN")==0 AND INSTRING(UPPER(aux),"INFINITY")==0 THEN resultado:=aux; END;
  ELSE
    // Simplificar el algebra exterior SIN pedir al CAS sumas distribucionales.
    // Atomos opacos, sin asignar/purgar variables. Limites conservadores de tamano.
    cleanOk:=DIM(resultado)<=6000; cleanInput:=""; cleanAtoms:={}; cleanNames:={}; pos:=1;
    WHILE pos<=DIM(resultado) AND cleanOk DO
      token:=MID(resultado,pos,1);
      IF INSTRING(chars,UPPER(token))>0 THEN
        cleanStart:=pos; fin:=pos+1;
        WHILE fin<=DIM(resultado) AND INSTRING(chars,UPPER(MID(resultado,fin,1)))>0 DO fin:=fin+1; END;
        token:=MID(resultado,pos,fin-pos); pos:=fin;
        IF INSTRING(cleanProtected,"|"+UPPER(token)+"|")>0 AND MID(resultado,pos,1)=="(" THEN
          cleanDepth:=1; pos:=pos+1;
          WHILE pos<=DIM(resultado) AND cleanDepth>0 DO
            aux:=MID(resultado,pos,1);
            IF aux=="(" THEN cleanDepth:=cleanDepth+1; END;
            IF aux==")" THEN cleanDepth:=cleanDepth-1; END;
            pos:=pos+1;
          END;
          IF cleanDepth<>0 THEN cleanOk:=0; END;
          cleanAtom:=MID(resultado,cleanStart,pos-cleanStart); cleanIndex:=0;
          FOR fin FROM 1 TO SIZE(cleanAtoms) DO IF cleanAtoms(fin)==cleanAtom THEN cleanIndex:=fin; BREAK; END; END;
          IF cleanIndex==0 THEN
            cleanIndex:=SIZE(cleanAtoms)+1; cleanName:="sltrclean"+STRING(cleanIndex);
            IF cleanIndex>32 OR INSTRING(resultado,cleanName)>0 THEN cleanOk:=0;
            ELSE IF SSCASString("eval("+cleanName+")")<>cleanName THEN cleanOk:=0; END; END;
            cleanAtoms:=CONCAT(cleanAtoms,{cleanAtom}); cleanNames:=CONCAT(cleanNames,{cleanName});
          END;
          token:=cleanNames(cleanIndex);
        END;
      ELSE pos:=pos+1; END;
      cleanInput:=cleanInput+token;
    END;
    // No inferir que un atomo espectral sea real/positivo por ser un simbolo.
    aux:=UPPER(cleanInput);
    IF INSTRING(aux,"CONJ(")>0 OR INSTRING(aux,"RE(")>0 OR INSTRING(aux,"IM(")>0 OR INSTRING(aux,"ABS(")>0 OR INSTRING(aux,"SIGN(")>0 THEN cleanOk:=0; END;
    IF cleanOk THEN
      IFERR respuesta:=CAS.simplify(cleanInput); aux:=STRING(respuesta); THEN aux:=""; END;
      texto:=UPPER(aux);
      IF aux<>"" AND DIM(aux)<=6000 AND INSTRING(texto,"UNDEF")==0 AND INSTRING(texto,"ERROR")==0 AND INSTRING(texto,"NAN")==0 AND INSTRING(texto,"INFINITY")==0 THEN
        cleanRestored:=""; pos:=1;
        WHILE pos<=DIM(aux) DO
          token:=MID(aux,pos,1);
          IF INSTRING(chars,UPPER(token))>0 THEN
            fin:=pos+1; WHILE fin<=DIM(aux) AND INSTRING(chars,UPPER(MID(aux,fin,1)))>0 DO fin:=fin+1; END;
            token:=MID(aux,pos,fin-pos); pos:=fin;
            FOR cleanIndex FROM 1 TO SIZE(cleanNames) DO
              IF token==cleanNames(cleanIndex) THEN token:="("+cleanAtoms(cleanIndex)+")"; BREAK; END;
            END;
          ELSE pos:=pos+1; END;
          cleanRestored:=cleanRestored+token;
        END;
        // Si no mejora o quedan marcadores, conservar la formula original.
        IF INSTRING(LOWER(cleanRestored),"sltrclean")==0 AND DIM(cleanRestored)<=DIM(resultado) THEN resultado:=cleanRestored; END;
      END;
    END;
  END;
  IF propiedad>0 THEN
    texto:=UPPER(resultado);
    IF INSTRING(texto,"DIFF(")>0 OR INSTRING(texto,"INT(")>0 OR INSTRING(texto,"INTEGRATE(")>0 OR INSTRING(texto,"LIMIT(")>0 OR INSTRING(texto,"SUBST(")>0 OR INSTRING(resultado,CHAR(8747))>0 THEN pendientesProp:=1; END;
    IF INSTRING(texto,"UNDEF")>0 OR INSTRING(texto,"NAN")>0 OR INSTRING(texto,"ERROR")>0 THEN pendientesProp:=1; END;
    IF INSTRING(texto,"INFINITY")>0 AND INSTRING(texto,"SUM(DIRAC(")==0 THEN pendientesProp:=1; END;
    IF pendientesProp THEN
      metodo:="PENDIENTE: "+operacionProp;
      condiciones:=condiciones+"\nLa regla quedo planteada, pero falta resolver una operacion o un limite finito. NO es una solucion cerrada ni demuestra existencia/convergencia. Los nombres sltrtime/sltrfreq/sltraux son variables internas del planteo.";
    END;
  END;
  IF tipo==1 THEN salida:="s"; END; IF tipo==2 OR tipo==6 THEN salida:="t"; END;
  IF tipo==3 THEN salida:="z"; END; IF tipo==4 THEN salida:="n"; END;
  texto:=""; pos:=1;
  WHILE pos<=DIM(resultado) DO
    token:=MID(resultado,pos,1);
    IF INSTRING(chars,UPPER(token))>0 THEN
      fin:=pos+1; WHILE fin<=DIM(resultado) AND INSTRING(chars,UPPER(MID(resultado,fin,1)))>0 DO fin:=fin+1; END;
      token:=MID(resultado,pos,fin-pos); pos:=fin;
      IF token==freq THEN token:=salida; IF dual THEN token:="(-t)"; END; END;
    ELSE pos:=pos+1; END;
    texto:=texto+token;
  END;
  nota:=metodo+"\n"+condiciones+"\nConvencion Fourier: integral con exp(-i*w*t); inversa con 1/(2*pi). DTFT: sum bilateral con exp(-i*w*n), w rad/muestra. Las reglas de tabla son exactas BAJO sus condiciones. Dirac y PV se muestran simbolicamente, no como puntos ordinarios. No se modifican variables ni modos. Los graficos numericos anteriores conservan su ventana y no se reemplazan por esta formula.";
  etiqueta:="Tabla: revisar condiciones";
  IF (tipo==5 OR tipo==7) AND salida<>"w" THEN nota:=nota+"\nEl simbolo w pertenece a la entrada y se conserva como parametro. La frecuencia de salida se llama "+salida+"; no son la misma variable."; END;
  nota:=nota+"\nIMPORTANTE: frecuencias y fases angulares en radianes. Use modo radianes en CAS para evaluar/simplificar trigonometria; la app no cambia ese ajuste.";
  IF INSTRING(metodo,"CAS")>0 THEN etiqueta:="CAS: revisar condiciones"; END;
  IF propiedad>0 THEN etiqueta:="Propiedad: revisar condiciones"; END;
  IF pendientesProp THEN etiqueta:="PENDIENTE: regla planteada"; END;
  izquierda:="Entrada: "+f;
  IF propiedad>0 THEN izquierda:="Senal base: "+f+"\nOperacion: "+operacionProp; END;
  SSSymbolicResults(titulo,etiqueta+" en "+salida,texto,izquierda,nota);
  UNTIL tipo==2 OR tipo==4 OR tipo==6;
  RETURN 1;
END;

SSTransformGuide(tipo)
BEGIN
  IF tipo==1 THEN RETURN {"x(t)=","Use t minuscula. Ej: exp(-2*t)","La entrada usa t minuscula como tiempo; s es la variable del resultado X(s). Escriba la formula, sin x(t)= ni laplace(...). Multiplique con * y use parentesis: exp(-2*t)*Heaviside(t). La transformada requiere convergencia; la expresion por si sola no determina todos los supuestos ni la region de convergencia.","X(s) - resultado en s"}; END;
  IF tipo==2 THEN RETURN {"X(s)=","Use s minuscula. Ej: 1/(s+2)","Ingrese una expresion en s minuscula, por ejemplo 1/(s+2). Escriba solo la formula, sin X(s)= ni ilaplace(...). El resultado x(t) usa t minuscula como tiempo. La interpretacion depende de la causalidad y de las condiciones de la transformada original.","x(t) - resultado en t"}; END;
  IF tipo==3 THEN RETURN {"x[n]=","Use n minuscula. Ej: (1/2)^n","Ingrese una formula en n minuscula, el indice entero: (1/2)^n*Heaviside(n). Escriba solo la formula, sin x[n]= ni ztrans(...). El resultado X(z) usa z minuscula. Para una lista finita ingrese las muestras con llaves e indique el indice de la primera. La region de convergencia y el soporte completan la interpretacion.","X(z) - resultado en z"}; END;
  RETURN {"X(z)=","Use z minuscula. Ej: z/(z-1/2)","Ingrese una formula en z minuscula, por ejemplo z/(z-1/2). Escriba solo la formula, sin X(z)= ni invztrans(...). El resultado x[n] usa n como indice entero. En la transformada Z bilateral una misma expresion puede corresponder a diferentes secuencias segun su region de convergencia; revise el soporte asumido.","x[n] - resultado en n"};
END;

SSSampleResults(x,t0,Ts,f)
BEGIN
  LOCAL op:=1;
  LOCAL validas:=0;
  LOCAL k;
  LOCAL editable:=0;
  LOCAL candidato;
  LOCAL nueva;
  LOCAL eventos;
  LOCAL confirmar;
  LOCAL expr;
  LOCAL origen;
  LOCAL paso;
  LOCAL cantidad;
  IF TYPE(f)==6 THEN editable:=1; f:=f(1); END;
  FOR k FROM 1 TO SIZE(x) DO IF SSIsDrawable(x(k)) THEN validas:=validas+1; END; END;
  IF validas==0 THEN
    SSInfoView("Muestreo sin valores finitos","0 de "+STRING(SIZE(x))+" muestras evaluables","No se obtuvo una muestra numerica finita. Esto no significa que la senal sea cero.\n\nExpresion: "+f+"\n\nt inicial="+SSFmt(t0,8)+"; Ts="+SSFmt(Ts,8)+".\n\nRevise la expresion, parametros sin valor y dominio de la ventana. Use X como tiempo y * para multiplicar. Ejemplo: 5*COS(2*pi*2000*X)+3*COS(2*pi*3000*X).\n\nPuede elegir Editar parametros sin volver a cargar todo. Los puntos no definidos se conservan como N/D; no se inventan ceros.",SSAccent(5));
  END;
  REPEAT
    op:=SSMenu({"Resultados del muestreo",{3,"Resultados del muestreo",{{"Muestras x[n]",x,t0,Ts,SSEVAL_EVENTS},{"Expresion x(t)",f}},"Eje temporal; t0="+STRING(t0)+"; Ts="+STRING(Ts)},8},{"Tabla n, t y x[n]","Grafico con eje temporal","Formula utilizada","Exportar muestras","Metodo, unidades y limites","Editar parametros","Vista por indice n","Volver"},op);
    IF op==0 OR op==8 THEN RETURN 1; END;
    IF op==7 THEN
      confirmar:=SSMenu("Indice n desde 0",{"Tabla por indice","Grafico por indice","Exportar con indice n","Volver"},1);
      eventos:=SSEVAL_EVENTS; SSEVAL_EVENTS:={};
      IF confirmar==1 THEN SSDataView(x,0,1,"Muestreo; n desde 0","n","x[n]",SSAccent(5)); END;
      IF confirmar==2 THEN SSPlotDiscrete(x,0,1,"Muestreo por indice","n; t=t0+n*Ts"); END;
      IF confirmar==3 THEN SSExportData(x,0,1,"Muestreo; n desde 0, no segundos"); END;
      SSEVAL_EVENTS:=eventos; eventos:={};
    END;
    IF op==6 THEN
      IF editable==0 THEN RETURN 2; END;
      candidato:={f,t0,Ts,SIZE(x)};
      expr:=f; origen:=t0; paso:=Ts; cantidad:=SIZE(x); confirmar:=0;
      IF INPUT(expr,"Editar muestreo","x(t)=","X es t",expr) THEN
        IF INPUT(origen,"Editar muestreo","t inicial=","Origen temporal",origen) THEN
          IF INPUT(paso,"Editar muestreo","Ts=","Paso real positivo",paso) THEN
            IF INPUT(cantidad,"Editar muestreo","N=","Entero de 1 a 4096",cantidad) THEN confirmar:=1; END;
          END;
        END;
      END;
      candidato:={expr,origen,paso,cantidad};
      IF confirmar THEN
        confirmar:=TYPE(candidato(1))==2;
        FOR k FROM 2 TO 4 DO IF TYPE(candidato(k))<>0 THEN confirmar:=0; END; END;
        IF confirmar THEN
          IF DIM(candidato(1))==0 OR DIM(candidato(1))>4096 OR SSIsDrawable(candidato(2))==0 OR SSIsDrawable(candidato(3))==0 OR candidato(3)<=0 OR candidato(4)<1 OR candidato(4)>4096 OR candidato(4)<>FLOOR(candidato(4)) THEN confirmar:=0; END;
        END;
        IF confirmar THEN
          eventos:=SSEVAL_EVENTS;
          nueva:=SSEvalExpr(candidato(1),candidato(2),candidato(3),candidato(4));
          IF SIZE(nueva)==candidato(4) THEN x:=nueva; f:=candidato(1); t0:=candidato(2); Ts:=candidato(3);
          ELSE SSEVAL_EVENTS:=eventos; END;
          nueva:={}; eventos:={};
        ELSE SSInfoView("Muestreo","Parametros no validos","Se conserva el resultado anterior. Use formula en X, Ts positivo y N entero de 1 a 4096.",SSAccent(5)); END;
      END;
    END;
    IF op==1 THEN SSDataView(x,t0,Ts,"Muestras x[n]","t","x[n]",SSAccent(5)); END;
    IF op==2 THEN SSPlotDiscrete(x,t0,Ts,"Muestras discretas x[n]","t"); END;
    IF op==3 THEN
      IF MID(f,1,7)=="TRAMOS:" THEN SSInfoView("Definicion por tramos","X representa t",f,SSAccent(5));
      ELSE SSSymbolicResults("Expresion muestreada","x(t) | X representa t",f,"x(t)="+f,"x[n]=x(t0+n*Ts). "+SSDataSummary(x,t0,Ts,"Muestras")+"\nLos puntos singulares se interpretan segun las marcas de la tabla."); END;
    END;
    IF op==4 THEN SSExportData(x,t0,Ts,"Muestreo de "+f); END;
    IF op==5 THEN SSInfoView("Muestreo","Evaluacion numerica",SSDataSummary(x,t0,Ts,"x[n]=x(t0+n*Ts)")+"\nfs=1/Ts="+STRING(1/Ts)+" por unidad temporal. Es Hz solo si Ts esta en segundos. N fija la ventana, no modifica Ts. Las celdas redondean; ENTER permite consultar mas cifras. No se comprueba banda limitada a partir de una expresion arbitraria; una tabla finita no demuestra ausencia de aliasing.",SSAccent(5)); END;
  UNTIL 0;
END;

SSRateResults(x,y,n0,operacion,factor,fase,fuente,f,pasoEntrada)
BEGIN
  LOCAL reanudar:=0;
  LOCAL estadoGuardado;
  LOCAL TsFisico:=1;
  LOCAL tiempo0:=0;
  LOCAL tiempoSalida;
  LOCAL pasoTiempo;
  LOCAL nuevoEje;
  LOCAL op:=1;
  LOCAL editar;
  LOCAL nuevoFactor;
  LOCAL nuevaFase;
  LOCAL nuevoCorte;
  LOCAL nuevaLong;
  LOCAL filtro:=0;
  LOCAL corte:=0.4/factor;
  LOCAL longitud:=31;
  LOCAL h:={1};
  LOCAL filtrada:=x;
  LOCAL sinFiltro:=y;
  LOCAL mitad;
  LOCAL k;
  LOCAL j;
  LOCAL pos;
  LOCAL suma;
  LOCAL u;
  LOCAL ok;
  LOCAL detalle:="Sin filtro opcional.";
  LOCAL pirad:=3.141592653589793;
  LOCAL salida0:=factor*n0;
  LOCAL salidaDx:=1;
  LOCAL primeraFase;
  LOCAL regla;
  LOCAL baseFiltro;
  LOCAL ganancia:=1;
  LOCAL nuevaGanancia;
  LOCAL tituloFiltro;
  LOCAL ayudaCorte;
  LOCAL limiteCorte;
  LOCAL etiquetaFiltrada;
  LOCAL bIIR:={0.5};
  LOCAL aIIR:={1,-0.5};
  LOCAL nuevoB;
  LOCAL nuevoA;
  LOCAL polosIIR;
  LOCAL estadoIIR:="";
  LOCAL nuevoEstado;
  LOCAL previo;
  LOCAL validoIIR;
  LOCAL seleccionIIR;
  LOCAL escalaIIR;
  LOCAL unidadIdeal;
  LOCAL consultaFiltro;
  LOCAL vistaIdeal;
  LOCAL etapaSpec:=1;
  LOCAL vistaSpec:=1;
  LOCAL datosSpec;
  LOCAL origenSpec;
  LOCAL nombreSpec;
  LOCAL valoresSpec;
  LOCAL faseSpec;
  LOCAL notaSpec;
  LOCAL validoSpec;
  LOCAL escalaSpec;
  LOCAL nombre:="Cambio de tasa";
  LOCAL entrada:="Secuencia finita";
  IF operacion==1 THEN nombre:="Salida diezmada"; END;
  IF operacion==2 THEN nombre:="Salida expandida"; END;
  IF operacion==3 THEN nombre:="Salida interpolada lineal"; END;
  IF operacion==4 THEN nombre:="Salida interpolada SINC"; END;
  IF operacion==5 THEN nombre:="Salida ZOH"; END;
  IF fuente==2 THEN entrada:="x[n]="+f+"; n="+STRING(n0)+"..."+STRING(n0+SIZE(x)-1); END;
  IF operacion==2 THEN ganancia:=factor; filtrada:=y; END;
  IF TYPE(pasoEntrada)==6 THEN
    estadoGuardado:=pasoEntrada; pasoEntrada:=estadoGuardado(10);
    filtro:=estadoGuardado(1); corte:=estadoGuardado(2); longitud:=estadoGuardado(3); ganancia:=estadoGuardado(4);
    bIIR:=estadoGuardado(5); aIIR:=estadoGuardado(6); estadoIIR:=estadoGuardado(7); detalle:=estadoGuardado(8);
    TsFisico:=estadoGuardado(11); tiempo0:=estadoGuardado(12);
    reanudar:=1; estadoGuardado:={};
  END;
  REPEAT
    // El eje es el indice de SALIDA, no el tiempo fisico de entrada.
    salida0:=factor*n0; salidaDx:=1;
    primeraFase:=fase-n0-factor*FLOOR((fase-n0)/factor);
    regla:="Indice de salida n entero, paso 1. Las muestras originales x[k] quedan en n=L*k; entre ellas se insertan o interpolan valores. La ventana termina en L*(n final).";
    IF operacion==1 THEN
      salida0:=-FLOOR((fase-n0)/factor);
      regla:="y[n]=x[M*n+p], o x filtrada[M*n+p]. p es la fase respecto del indice 0, no de la primera fila. n inicial=ceil((n inicial de entrada-p)/M). Paso de salida=1.";
    END;
    etiquetaFiltrada:="Entrada filtrada";
    IF operacion==2 THEN etiquetaFiltrada:="Salida expandida y filtrada"; END;
    consultaFiltro:="Coeficientes del filtro";
    IF filtro==3 THEN consultaFiltro:="Formula y nucleo ideal"; END;
    vistaIdeal:={};
    IF filtro==3 THEN
      IF operacion==2 THEN vistaIdeal:={"SINC del registro | puntos: muestras",sinFiltro,ganancia,corte,factor*n0,1,0};
      ELSE vistaIdeal:={"SINC del registro | puntos: muestras",x,ganancia,corte,n0,factor,fase}; END;
    END;
    IF reanudar THEN op:=-1;
    ELSE op:=SSMenu({"Resultados de cambio de tasa",{3,"Resultados de cambio de tasa",{{"Entrada x[n]",x,n0,1},{"Salida y[n]",y,salida0,salidaDx},{"Salida sin filtro",sinFiltro,salida0,salidaDx},{"Expresion de origen",f},{"Operacion y factor",{operacion,factor,fase}},{"Filtro opcional",{filtro,corte,longitud,ganancia}},{"IIR b",bIIR,0,1},{"IIR a",aIIR,0,1},{"Reanudar cambio de tasa",{filtro,corte,longitud,ganancia,bIIR,aIIR,estadoIIR,detalle,fuente,pasoEntrada,TsFisico,tiempo0}}},entrada+"\n"+regla+"\n"+detalle},14},{"Tabla de entrada","Tabla de salida y[n]","Grafico discreto y[n]","Exportar salida","Parametros usados","Editar factor y fase","Filtro opcional antialias/recup.","Comparar con y sin filtro",etiquetaFiltrada,consultaFiltro,"Curva SINC (extra)","Espectros por etapa","Tiempo fisico / exportar","Volver"},op); END;
    IF op==0 OR op==14 THEN RETURN 1; END;
    IF op==13 THEN
      nuevoEje:=SSReadListDirect("Eje temporal de entrada","{Ts,t inicial}=","Ts en segundos; t inicial corresponde a la PRIMERA muestra x",{TsFisico,tiempo0});
      IF SIZE(nuevoEje)==2 THEN
        IF TYPE(nuevoEje(1))==0 AND TYPE(nuevoEje(2))==0 THEN
          IF nuevoEje(1)>=1E-12 AND nuevoEje(1)<=1E12 AND ABS(nuevoEje(2))<=1E12 THEN
            tiempoSalida:=nuevoEje(2); pasoTiempo:=nuevoEje(1)/factor;
            IF operacion==1 THEN tiempoSalida:=nuevoEje(2)+primeraFase*nuevoEje(1); pasoTiempo:=factor*nuevoEje(1); END;
            u:=tiempoSalida+(SIZE(y)-1)*pasoTiempo;
            IF SIZE(y)>1 AND (tiempoSalida+pasoTiempo==tiempoSalida OR u-pasoTiempo==u) THEN
              SSInfoView("Eje temporal","Paso no representable","Reduzca el origen temporal o aumente Ts. Se conservan el eje temporal anterior, los indices n y las amplitudes; no se exporta el candidato.",SSAccent(5));
            ELSE
              TsFisico:=nuevoEje(1); tiempo0:=nuevoEje(2);
              editar:=SSMenu("Salida: eje t en segundos",{"Tabla con tiempo","Grafico con tiempo","Exportar con tiempo","Volver"},1);
              IF editar==1 THEN SSDataView(y,tiempoSalida,pasoTiempo,"Salida; t en segundos","t s","y",SSAccent(5)); END;
              IF editar==2 THEN SSPlotDiscrete(y,tiempoSalida,pasoTiempo,"Salida; tiempo fisico","t s; n sigue entero"); END;
              IF editar==3 THEN SSExportData(y,tiempoSalida,pasoTiempo,"Cambio de tasa; t en segundos"); END;
            END;
          ELSE SSInfoView("Eje temporal","Valores no validos","Use 1E-12<=Ts<=1E12 y |t inicial|<=1E12. El eje n original se conserva.",SSAccent(5)); END;
        END;
      END;
      nuevoEje:={};
    END;
    IF op==6 OR op==7 OR reanudar THEN previo:={factor,fase,filtro,corte,longitud,ganancia,bIIR,aIIR,estadoIIR,y,filtrada,sinFiltro,h,detalle}; END;
    IF op==1 THEN SSDataView(x,n0,1,"Entrada al cambio de tasa","n","x[n]",SSAccent(5)); END;
    IF op==2 THEN SSDataView(y,salida0,salidaDx,nombre,"n","y[n]",SSAccent(5)); END;
    IF op==3 THEN
      SSPlotDiscrete(y,salida0,salidaDx,nombre,"n entero de salida | tabla y exportacion");
    END;
    IF op==11 THEN
      IF filtro==3 THEN
        SSInfoView("Curva del filtro ideal","SINC evaluada, no union lineal","La curva evalua el nucleo SINC de la entrada finita en cada columna visible y se recalcula al acercar o mover horizontalmente. Los puntos y el cursor siguen siendo las muestras de salida con n entero; la tabla y exportacion no agregan indices fraccionarios. No se supone un coseno infinito ni periodicidad: el recorte puede producir ondulaciones, especialmente en los extremos. ENTER consulta muestras originales. Tecla 5 alterna limpieza visual de residuos, sin modificar datos.",SSAccent(5));
        SSPlotXY(y,salida0,salidaDx,nombre,vistaIdeal);
      ELSE SSInfoView("Curva SINC adicional","Disponible con filtro ideal","Esta vista evalua el nucleo del pasa bajos ideal entre muestras. Elija ese filtro en Diezmado o Expansion. Para FIR, IIR e interpolaciones, consulte las muestras reales de salida en Grafico discreto y[n].",SSAccent(5)); END;
    END;
    IF op==4 THEN SSExportData(y,salida0,salidaDx,nombre+" | "+detalle); END;
    IF op==5 THEN SSInfoView(nombre,"Parametros e indices",entrada+"\nFactor="+STRING(factor)+"\nFase p="+STRING(fase)+"\n"+SSDataSummary(y,salida0,salidaDx,nombre)+"\n"+regla+"\n"+detalle+"\nn no es tiempo: Ts fisico de salida seria M*Ts al diezmar o Ts/L al interpolar. Esta exportacion guarda indices, no segundos. Editar no sobrescribe el banco ni Home hasta exportar de nuevo.",SSAccent(5)); END;
    ok:=reanudar;
    IF op==6 THEN
      nuevoFactor:=factor; nuevaFase:=fase;
      IF INPUT(nuevoFactor,"Editar factor","M o L=","Entero positivo; conserva la entrada",factor) THEN
        IF TYPE(nuevoFactor)==0 THEN
          IF nuevoFactor>=1 AND nuevoFactor==FLOOR(nuevoFactor) AND nuevoFactor<=2048 THEN
            ok:=1;
            IF operacion==1 THEN IF INPUT(nuevaFase,"Editar diezmado","fase p=","0..M-1; y[n]=x[M*n+p]",fase)==0 THEN ok:=0; END; END;
            IF TYPE(nuevaFase)<>0 THEN ok:=0; ELSE IF nuevaFase<>FLOOR(nuevaFase) OR nuevaFase<0 OR nuevaFase>=nuevoFactor THEN ok:=0; END; END;
            IF operacion==1 AND ok==1 THEN
              IF nuevaFase-n0-nuevoFactor*FLOOR((nuevaFase-n0)/nuevoFactor)>=SIZE(x) THEN ok:=0; END;
            END;
            IF operacion>1 AND (SIZE(x)-1)*nuevoFactor+1>2048 THEN ok:=0; END;
            IF operacion==4 AND (SIZE(x)-1)*nuevoFactor+1>1024 THEN ok:=0; END;
            IF ok==1 THEN
              factor:=nuevoFactor; fase:=nuevaFase;
              // Al cambiar M, el corte vuelve al 80% del nuevo Nyquist.
              IF filtro<>3 THEN corte:=0.4/factor; END;
              IF operacion==1 AND factor==1 THEN filtro:=0; END;
              IF operacion==2 AND filtro<>3 THEN ganancia:=factor; END;
              IF filtro==1 THEN SSInfoView("Filtro reajustado","Cambio del factor","El corte se ajusto a 0.4/factor. En expansion la ganancia se ajusta a L. Puede modificar ambos en Filtro opcional.",SSAccent(5)); END;
              IF filtro==2 THEN SSInfoView("IIR conservado","Cambio del factor","Se mantienen b y a, incluida su ganancia. Revise si el filtro sigue siendo adecuado para el nuevo M/L: no se redisena ni se multiplica automaticamente por L.",SSAccent(5)); END;
              IF filtro==3 THEN SSInfoView("Ideal conservado","Cambio del factor","Se mantienen amplitud A y corte normalizado fc. Revise su relacion con 0.5/M o 0.5/L. No se redisenan ni se multiplica A por L automaticamente.",SSAccent(5)); END;
            ELSE SSInfoView("SignalLab","Aviso","Cambio cancelado o invalido. Se conserva el resultado anterior.",SSAccent(1)); END;
          ELSE SSInfoView("SignalLab","Aviso","Use un factor entero valido; se conserva el resultado.",SSAccent(1)); END;
        ELSE SSInfoView("SignalLab","Aviso","El factor debe ser real.",SSAccent(1)); END;
      END;
    END;
    IF op==7 THEN
      IF (operacion<>1 AND operacion<>2) OR (operacion==1 AND factor==1) THEN
        SSInfoView("Filtro opcional","Diezmado o expansion","Antialias ANTES de diezmar (M>1), o recuperacion DESPUES de expansion con ceros. Para estudiar expandir y filtrar, elija Expansion; las interpolaciones lineal/SINC/ZOH tienen sus propios nucleos.",SSAccent(5));
      ELSE
        tituloFiltro:="Antialias de diezmado"; ayudaCorte:="Ciclos/muestra ENTRADA; fc < 0.5/M"; limiteCorte:=0.5/factor;
        IF operacion==2 THEN
          tituloFiltro:="Recuperacion tras expansion"; ayudaCorte:="Ciclos/muestra SALIDA; 0 < fc < 0.5"; limiteCorte:=0.5;
          SSInfoView(tituloFiltro,"x -> expansion L -> filtro -> y","El filtro se aplica despues de insertar L-1 ceros. Ideal: amplitud A y corte fc, modelo SINC no causal. FIR Hamming: aproximacion centrada, corte y ganancia editables. IIR: b y a de H(z), causal con retardo y transitorio. Referencia de recuperacion: fc=0.5/L en tasa de SALIDA y A=L. Puede estudiar otros valores.",SSAccent(5));
        END;
        editar:=SSMenu(tituloFiltro,{"Sin filtro","FIR Hamming centrado","IIR causal por coeficientes b/a","Pasa bajos ideal: amplitud y corte","Volver"},1+filtro);
        IF editar==1 THEN filtro:=0; ok:=1; END;
        IF editar==2 THEN
          nuevoCorte:=corte; nuevaLong:=longitud; nuevaGanancia:=ganancia;
          IF INPUT(nuevoCorte,"Corte FIR","fc=",ayudaCorte,corte) THEN
            IF INPUT(nuevaLong,"Longitud FIR","Taps=","Impar de 15 a 101; mas taps, mayor costo",longitud) THEN
              validoIIR:=1;
              IF operacion==1 THEN nuevaGanancia:=1; END;
              IF operacion==2 THEN validoIIR:=INPUT(nuevaGanancia,"Ganancia DC de recuperacion","G=","Propuesta L; 1 normalizada; 0 < G <= 1E6",ganancia); END;
              IF TYPE(nuevoCorte)==0 AND TYPE(nuevaLong)==0 THEN
                IF nuevoCorte>=1E-9 AND nuevoCorte<limiteCorte AND nuevaLong>=15 AND nuevaLong<=101 AND nuevaLong==FLOOR(nuevaLong) AND nuevaLong-2*FLOOR(nuevaLong/2)==1 AND SIZE(x)<=2048 AND validoIIR==1 THEN
                  ok:=1;
                  IF TYPE(nuevaGanancia)<>0 THEN ok:=0;
                  ELSE IF nuevaGanancia<=0 OR nuevaGanancia>1E6 THEN ok:=0; END; END;
                  FOR k FROM 1 TO SIZE(x) DO IF SSIsDrawable(x(k))==0 THEN ok:=0; END; END;
                  IF operacion==2 AND (SIZE(x)-1)*factor+1>2048 THEN ok:=0; END;
                  IF ok==1 THEN filtro:=1; corte:=nuevoCorte; longitud:=nuevaLong; ganancia:=nuevaGanancia; END;
                END;
              END;
              IF ok==0 AND validoIIR==1 THEN SSInfoView("SignalLab","Aviso","Parametros invalidos o datos no finitos. Se conserva el resultado.",SSAccent(1)); END;
            END;
          END;
        END;
        IF editar==4 THEN
          SSInfoView("Pasa bajos ideal","Carga directa A y fc","A es la altura real no negativa de H en la banda pasante, no la amplitud de x. fc se carga en ciclos/muestra o wc en rad/muestra. Referencia: diezmado fc=0.5/M, A=1; expansion fc=0.5/L, A=L. Se permiten otros cortes hasta Nyquist para teoria. Modelo no causal, respuesta SINC infinita. Se supone cero fuera de la entrada y se muestra solo su ventana. No usa Hamming, orden ni coeficientes b/a. Hasta 2048 muestras; registros largos pueden tardar.",SSAccent(5));
          nuevaGanancia:=ganancia; nuevoCorte:=corte;
          IF filtro<>3 THEN nuevoCorte:=0.5/factor; nuevaGanancia:=1; IF operacion==2 THEN nuevaGanancia:=factor; END; END;
          IF INPUT(nuevaGanancia,"Amplitud del filtro ideal","A=","Altura de H; 0..1E6; propuesta 1 o L",nuevaGanancia) THEN
            unidadIdeal:=SSMenu("Unidad de frecuencia de corte",{"fc en ciclos/muestra","wc en radianes/muestra","Cancelar"},1);
            IF unidadIdeal==1 OR unidadIdeal==2 THEN
              ayudaCorte:="ENTRADA: 0 <= fc <= 0.5";
              IF operacion==2 THEN ayudaCorte:="SALIDA: 0 <= fc <= 0.5"; END;
              IF unidadIdeal==2 THEN
                nuevoCorte:=2*pirad*nuevoCorte;
                ayudaCorte:="ENTRADA: 0 <= wc <= pi (radianes)";
                IF operacion==2 THEN ayudaCorte:="SALIDA: 0 <= wc <= pi (radianes)"; END;
              END;
              IF INPUT(nuevoCorte,"Corte del filtro ideal","fc o wc=",ayudaCorte,nuevoCorte) THEN
                IF TYPE(nuevaGanancia)==0 AND TYPE(nuevoCorte)==0 THEN
                  IF unidadIdeal==2 THEN nuevoCorte:=nuevoCorte/(2*pirad); END;
                  IF SSIsDrawable(nuevaGanancia) AND SSIsDrawable(nuevoCorte) THEN
                    IF nuevaGanancia>=0 AND nuevaGanancia<=1E6 AND nuevoCorte>=0 AND nuevoCorte<=0.5 AND SIZE(x)<=2048 THEN
                      ok:=1;
                      FOR k FROM 1 TO SIZE(x) DO IF SSIsDrawable(x(k))==0 THEN ok:=0; END; END;
                      IF operacion==2 AND (SIZE(x)-1)*factor+1>2048 THEN ok:=0; END;
                      IF ok==1 THEN filtro:=3; ganancia:=nuevaGanancia; corte:=nuevoCorte; END;
                    END;
                  END;
                END;
                IF ok==0 THEN SSInfoView("SignalLab","Aviso","A o corte invalidos, o datos no finitos. Se conserva el resultado anterior.",SSAccent(1)); END;
              END;
            END;
          END;
        END;
        IF editar==3 THEN
          SSInfoView("IIR causal","H(z)=(b0+b1/z+...)/(a0+a1/z+...)","Ingrese b={b0,b1,...} y a={a0,a1,...}, de 1 a 33 coeficientes, a0 distinto de cero. Ejemplo pasa bajos: b={0.5}, a={1,-0.5}, ganancia DC=1. Para ganancia 2: b={1}, misma a. Se normaliza por a0; se RESTAN los terminos a1,a2... en la recurrencia. Estado inicial cero antes de la primera muestra del registro. Se conserva el retardo, sin filtrado de ida/vuelta. Los coeficientes pueden describir cualquier filtro, no se garantiza rechazo de alias/imagenes.",SSAccent(5));
          nuevoB:=SSReadListDirect("IIR: numerador","b=","{b0,b1,...}; potencias z^0,z^-1,...",bIIR);
          nuevoA:={}; validoIIR:=0;
          IF SIZE(nuevoB)>0 THEN nuevoA:=SSReadListDirect("IIR: denominador","a=","{a0,a1,...}; ej {1,-0.5}; a0<>0",aIIR); END;
          IF SIZE(nuevoB)>0 AND SIZE(nuevoA)>0 THEN
            validoIIR:=1;
            IF SIZE(nuevoB)>33 OR SIZE(nuevoA)>33 OR SIZE(x)>2048 THEN validoIIR:=0; END;
            IF operacion==2 AND (SIZE(x)-1)*factor+1>2048 THEN validoIIR:=0; END;
            FOR k FROM 1 TO SIZE(nuevoB) DO IF SSIsDrawable(nuevoB(k))==0 THEN validoIIR:=0; END; END;
            FOR k FROM 1 TO SIZE(nuevoA) DO IF SSIsDrawable(nuevoA(k))==0 THEN validoIIR:=0; END; END;
            FOR k FROM 1 TO SIZE(x) DO IF SSIsDrawable(x(k))==0 THEN validoIIR:=0; END; END;
            IF validoIIR==1 THEN
              IF ABS(nuevoA(1))==0 THEN validoIIR:=0;
              ELSE
                IFERR escalaIIR:=nuevoA(1); nuevoB:=nuevoB/escalaIIR; nuevoA:=nuevoA/escalaIIR;
                THEN validoIIR:=0; END;
                FOR k FROM 1 TO SIZE(nuevoB) DO IF SSIsDrawable(nuevoB(k))==0 THEN validoIIR:=0; END; END;
                FOR k FROM 1 TO SIZE(nuevoA) DO IF SSIsDrawable(nuevoA(k))==0 THEN validoIIR:=0; END; END;
              END;
            END;
            IF validoIIR==1 THEN
              polosIIR:=SSPolyRoots(nuevoA);
              nuevoEstado:="Polos del denominador dentro del circulo unidad (estimacion numerica).";
              seleccionIIR:=0;
              IF SIZE(polosIIR)<>SIZE(nuevoA)-1 THEN seleccionIIR:=1; nuevoEstado:="No se pudo verificar la estabilidad por raices.";
              ELSE
                FOR k FROM 1 TO SIZE(polosIIR) DO
                  IF SSIsDrawable(polosIIR(k))==0 THEN seleccionIIR:=1; nuevoEstado:="Raices no evaluables: estabilidad no verificada.";
                  ELSE IF ABS(polosIIR(k))>=1-1E-9 THEN seleccionIIR:=1; nuevoEstado:="Hay polos fuera o muy cerca del circulo unidad: posible inestabilidad o limite de estabilidad."; END; END;
                END;
              END;
              IF seleccionIIR==1 THEN
                SSInfoView("Advertencia IIR","Estabilidad y analisis teorico",nuevoEstado+"\nPolos="+STRING(polosIIR)+"\nPuede continuar para estudiar un registro finito. Cancelaciones polo-cero no se analizan; una salida acotada aqui no prueba estabilidad. Si el calculo desborda se conserva el resultado anterior.",SSAccent(7));
                seleccionIIR:=SSMenu("IIR: confirmar advertencia",{"Cancelar cambio","Aplicar para analisis teorico"},1);
                IF seleccionIIR<>2 THEN validoIIR:=0; END;
              END;
              IF validoIIR==1 THEN bIIR:=nuevoB; aIIR:=nuevoA; estadoIIR:=nuevoEstado; filtro:=2; ok:=1; END;
            ELSE SSInfoView("SignalLab","Aviso","Coeficientes invalidos: listas de 1...33 valores finitos, a0<>0 y hasta 2048 muestras. Se conserva el resultado.",SSAccent(1)); END;
          END;
        END;
      END;
    END;
    IF ok==1 THEN
      baseFiltro:=x; h:={1}; detalle:="Sin filtro opcional.";
      IF operacion==2 THEN sinFiltro:=SSExpand(x,factor); baseFiltro:=sinFiltro; END;
      filtrada:=baseFiltro;
      IF filtro==1 THEN
        validoIIR:=1;
        IFERR
        FOR k FROM 1 TO SIZE(baseFiltro) DO IF SSIsDrawable(baseFiltro(k))==0 THEN validoIIR:=0; END; END;
        IF validoIIR THEN
        mitad:=(longitud-1)/2; h:=MAKELIST(0,k,1,longitud,1); suma:=0;
        FOR k FROM 0 TO longitud-1 DO
          u:=k-mitad;
          IF u==0 THEN h(k+1):=2*corte;
          ELSE h(k+1):=SSSinR(2*pirad*corte*u)/(pirad*u); END;
          h(k+1):=h(k+1)*(0.54-0.46*SSCosR(2*pirad*k/(longitud-1)));
          suma:=suma+h(k+1);
        END;
        IF SSIsDrawable(suma)==0 OR suma==0 THEN validoIIR:=0; END;
        IF validoIIR THEN
        h:=ganancia*h/suma;
        FOR k FROM 1 TO SIZE(baseFiltro) DO
          IF (k-1) MOD 16==0 THEN IF SSHeader("Filtro FIR",{k-1,SIZE(baseFiltro)},"PROGRESS")==0 THEN validoIIR:=0; BREAK; END; END;
          suma:=0;
          FOR j FROM 1 TO longitud DO
            pos:=k+mitad-(j-1);
            IF pos>=1 AND pos<=SIZE(baseFiltro) THEN suma:=suma+h(j)*baseFiltro(pos); END;
          END;
          filtrada(k):=suma;
        END;
        FOR k FROM 1 TO SIZE(filtrada) DO IF SSIsDrawable(filtrada(k))==0 THEN validoIIR:=0; END; END;
        END;
        END;
        THEN validoIIR:=0; END;
        detalle:="FIR Hamming, taps="+STRING(longitud)+", fc="+STRING(corte)+" ciclos/muestra de entrada. Nuevo Nyquist="+STRING(0.5/factor)+". Ganancia DC normalizada a 1. Convolucion centrada: compensa el retardo de "+STRING(mitad)+" muestras, requiere datos futuros. Fuera de la lista se supone cero: hay efectos de borde. La banda de transicion es finita; no garantiza eliminar todo alias ni recupera alias anterior.";
        IF operacion==2 THEN detalle:="Expansion L="+STRING(factor)+" -> FIR Hamming de recuperacion/anti-imagenes, taps="+STRING(longitud)+", fc="+STRING(corte)+" ciclos/muestra de SALIDA, ganancia DC="+STRING(ganancia)+". Referencia ideal fc=0.5/L="+STRING(0.5/factor)+". Se permite un corte distinto para analisis teorico: no garantiza eliminar imagenes. Retardo de "+STRING(mitad)+" muestras compensado (no causal); ceros fuera del registro. Se conserva solo la ventana de la expansion, sin colas de convolucion: hay efectos de borde. Los indices siguen siendo enteros, paso 1."; END;
        IF validoIIR==0 THEN
          IF reanudar THEN RETURN 0; END;
          factor:=previo(1); fase:=previo(2); filtro:=previo(3); corte:=previo(4); longitud:=previo(5); ganancia:=previo(6); bIIR:=previo(7); aIIR:=previo(8); estadoIIR:=previo(9);
          y:=previo(10); filtrada:=previo(11); sinFiltro:=previo(12); h:=previo(13); detalle:=previo(14); ok:=0;
          SSInfoView("FIR no aplicado","Se conserva el resultado anterior","Calculo cancelado, entrada no finita o resultado fuera de rango. No se usan muestras parciales ni N/D como numeros. Los datos exportados no se modificaron.",SSAccent(5));
        END;
      END;
      IF filtro==3 AND ok==1 THEN
        validoIIR:=1;
        IFERR
          // Solo se necesitan retardos |k-j| <= N-1 para esta ventana.
          // Sin ventana ni normalizacion: es la convolucion ideal de la entrada finita.
          h:=MAKELIST(0,k,1,SIZE(baseFiltro),1); h(1):=2*ganancia*corte;
          FOR k FROM 1 TO SIZE(baseFiltro)-1 DO
            u:=2*corte*k;
            IF u<>FLOOR(u) THEN h(k+1):=ganancia*SSSinR(pirad*u)/(pirad*k); END;
          END;
          FOR k FROM 1 TO SIZE(baseFiltro) DO
            IF (k-1) MOD 4==0 THEN
              IF SSHeader("Filtro ideal",{k-1,SIZE(baseFiltro)},"PROGRESS")==0 THEN validoIIR:=0; BREAK; END;
            END;
            suma:=0;
            FOR j FROM 1 TO SIZE(baseFiltro) DO
              IF ABS(baseFiltro(j))>0 THEN suma:=suma+h(ABS(k-j)+1)*baseFiltro(j); END;
            END;
            filtrada(k):=suma;
          END;
          FOR k FROM 1 TO SIZE(filtrada) DO IF SSIsDrawable(filtrada(k))==0 THEN validoIIR:=0; END; END;
        THEN validoIIR:=0; END;
        IF validoIIR==1 THEN
          detalle:="Pasa bajos IDEAL, A="+STRING(ganancia)+", fc="+STRING(corte)+" ciclos/muestra; wc="+STRING(2*pirad*corte)+" rad/muestra. H=A para |w|<wc y 0 fuera, extension 2*pi periodica. En el salto se toma A/2; fc=0 anula y fc=0.5 multiplica por A. h[0]=2*A*fc; h[k]=A*sin(2*pi*fc*k)/(pi*k), k<>0. SINC infinita y no causal, fase cero. Entrada cero fuera del registro: se suman TODAS sus muestras, sin ventana Hamming ni renormalizacion. Solo se conserva la ventana de salida, no sus colas infinitas. Exportar recorta esas colas. Los indices siguen enteros.";
          IF operacion==1 THEN detalle:="Ideal ANTES de diezmar, corte en tasa de ENTRADA. Referencia fc<=0.5/M; un corte mayor permite alias. "+detalle;
          ELSE detalle:="Ideal DESPUES de expandir, corte en tasa de SALIDA. Referencia fc=0.5/L, A=L; otros valores permiten estudios teoricos. "+detalle; END;
        ELSE
          IF reanudar THEN RETURN 0; END;
          factor:=previo(1); fase:=previo(2); filtro:=previo(3); corte:=previo(4); longitud:=previo(5); ganancia:=previo(6); bIIR:=previo(7); aIIR:=previo(8); estadoIIR:=previo(9);
          y:=previo(10); filtrada:=previo(11); sinFiltro:=previo(12); h:=previo(13); detalle:=previo(14); ok:=0;
          SSInfoView("Ideal no aplicado","Se conserva el resultado anterior","Calculo cancelado o valores fuera del rango representable. No se usa una salida parcial. Los datos exportados no se modificaron.",SSAccent(7));
        END;
      END;
      IF filtro==2 AND ok==1 THEN
        validoIIR:=1;
        IFERR filtrada:=SSDiffEq(bIIR,aIIR,baseFiltro); THEN validoIIR:=0; END;
        IF validoIIR==1 THEN
          IF SIZE(filtrada)<>SIZE(baseFiltro) THEN validoIIR:=0;
          ELSE FOR k FROM 1 TO SIZE(filtrada) DO IF SSIsDrawable(filtrada(k))==0 THEN validoIIR:=0; END; END; END;
        END;
        IF validoIIR==1 THEN
          h:=bIIR;
          detalle:="IIR causal, estado inicial cero ANTES del primer indice del registro. b="+STRING(bIIR)+"; a="+STRING(aIIR)+". a0 normalizado a 1. Se conservan la fase y el transitorio, sin compensar retardo. Misma longitud del registro: la cola posterior no se muestra. "+estadoIIR+" No se garantiza funcion antialias/anti-imagenes por cargar coeficientes arbitrarios.";
          IF operacion==1 THEN detalle:="IIR -> diezmado M="+STRING(factor)+". Coeficientes en la tasa de ENTRADA. "+detalle;
          ELSE detalle:="Expansion L="+STRING(factor)+" -> IIR. Coeficientes en la tasa de SALIDA; ganancia definida por b/a, sin factor L automatico. "+detalle; END;
        ELSE
          IF reanudar THEN RETURN 0; END;
          factor:=previo(1); fase:=previo(2); filtro:=previo(3); corte:=previo(4); longitud:=previo(5); ganancia:=previo(6); bIIR:=previo(7); aIIR:=previo(8); estadoIIR:=previo(9);
          y:=previo(10); filtrada:=previo(11); sinFiltro:=previo(12); h:=previo(13); detalle:=previo(14); ok:=0;
          SSInfoView("IIR no aplicado","Se conserva el resultado anterior","La recurrencia produjo un error, desbordamiento o valores fuera del rango representable. Reduzca ganancia/longitud del registro o revise polos. No se reemplazo la salida por ceros ni se modificaron datos exportados.",SSAccent(7));
        END;
      END;
      IF ok==1 THEN
      IF operacion==1 THEN
        primeraFase:=fase-n0-factor*FLOOR((fase-n0)/factor);
        sinFiltro:=SSDecimate(x,factor,primeraFase); y:=SSDecimate(filtrada,factor,primeraFase);
      END;
      IF operacion==2 THEN y:=filtrada; END;
      IF operacion==3 THEN y:=SSLinearInterp(x,factor); END;
      IF operacion==4 THEN
        y:=SSSincInterp({x,"PROGRESS"},factor);
        IF SIZE(y)==0 THEN
          IF reanudar THEN RETURN 0; END;
          factor:=previo(1); fase:=previo(2); filtro:=previo(3); corte:=previo(4); longitud:=previo(5); ganancia:=previo(6); bIIR:=previo(7); aIIR:=previo(8); estadoIIR:=previo(9);
          y:=previo(10); filtrada:=previo(11); sinFiltro:=previo(12); h:=previo(13); detalle:=previo(14);
        END;
      END;
      IF operacion==5 THEN y:=SSZeroOrderHold(x,factor); END;
      END;
      SSEVAL_EVENTS:={};
    END;
    IF op==8 THEN
      IF operacion==1 OR operacion==2 THEN
        editar:=1;
        IF filtro==3 THEN editar:=SSMenu("Comparar filtro ideal",{"Muestras sin/con filtro","Curva SINC de la salida","Volver"},1); END;
        IF editar==1 THEN
          SSInfoView("Comparacion de muestras","Tallos, sin union lineal","Azul: salida sin filtro. Naranja: salida con el filtro elegido. Ambas usan n entero, paso 1. Los tallos no representan una reconstruccion lineal. La tabla de salida contiene estas mismas muestras con filtro. Para ver el ideal entre muestras use Curva SINC (extra).\n"+detalle,SSAccent(5));
          SSPlotDual(sinFiltro,y,{"Muestras sin/con filtro",salida0,salidaDx,"n"});
        END;
        IF editar==2 THEN SSPlotXY(y,salida0,salidaDx,nombre,vistaIdeal); END;
      ELSE SSInfoView("Comparacion","Diezmado o expansion","El filtro opcional se aplica al diezmar o expandir con ceros.",SSAccent(5)); END;
    END;
    IF op==9 THEN
      IF operacion==2 THEN SSDataView(filtrada,salida0,1,"Expansion despues del filtro","n","y[n]",SSAccent(5));
      ELSE SSDataView(filtrada,n0,1,"Entrada despues del filtro","n","x filtrada",SSAccent(5)); END;
    END;
    IF op==10 THEN
      IF filtro==2 THEN
        seleccionIIR:=SSMenu("Consultar filtro IIR",{"Funcion H(z)","Numerador b[k]","Denominador a[k]","Estado y convenciones","Volver"},1);
        IF seleccionIIR==1 THEN SSSymbolicResults("Filtro IIR aplicado","H(z) | coeficientes normalizados","("+SSZSequenceExpr(bIIR,0)+")/("+SSZSequenceExpr(aIIR,0)+")","b="+STRING(bIIR)+"; a="+STRING(aIIR),detalle); END;
        IF seleccionIIR==2 THEN SSDataView(bIIR,0,1,"Numerador IIR","k","b[k]",SSAccent(5)); END;
        IF seleccionIIR==3 THEN SSDataView(aIIR,0,1,"Denominador IIR","k","a[k]",SSAccent(5)); END;
        IF seleccionIIR==4 THEN SSInfoView("Filtro IIR","Recurrencia y estabilidad",detalle,SSAccent(5)); END;
      ELSE
        IF filtro==3 THEN
          seleccionIIR:=SSMenu("Consultar filtro ideal",{"Respuesta H y contexto","Formula de h[k]","Nucleo h[k] para k >= 0","Volver"},1);
          IF seleccionIIR==1 THEN SSInfoView("Respuesta ideal H","Amplitud y frecuencia de corte",detalle,SSAccent(5)); END;
          IF seleccionIIR==2 THEN SSSymbolicResults("Nucleo del filtro ideal","h[k] para k distinto de 0",STRING(ganancia)+"*sin(2*pi*"+STRING(corte)+"*k)/(pi*k)","En k=0: h[0]="+STRING(2*ganancia*corte),detalle); END;
          IF seleccionIIR==3 THEN
            SSInfoView("Nucleo ideal","h[-k]=h[k]","La tabla muestra k=0...N-1, los retardos necesarios para el registro actual. h existe tambien para k negativos y fuera de esta tabla. No es una lista b de un FIR causal.",SSAccent(5));
            SSDataView(h,0,1,"Ideal h[k], mitad positiva","k","h[k]",SSAccent(5));
          END;
        ELSE SSDataView(h,0,1,"Coeficientes FIR causal","k","h[k]",SSAccent(5)); END;
      END;
    END;
    IF op==12 THEN
      REPEAT
        etapaSpec:=SSMenu("Espectros por etapa",{"Original x[n]","Salida sin filtro opcional",etiquetaFiltrada,"Salida final y[n]","Volver"},etapaSpec);
        IF etapaSpec==0 OR etapaSpec==5 THEN BREAK; END;
        datosSpec:=x; origenSpec:=n0; nombreSpec:="Original x[n]"; validoSpec:=1;
        IF etapaSpec==2 THEN
          datosSpec:=sinFiltro; origenSpec:=salida0; nombreSpec:="Salida sin filtro";
          IF operacion>2 THEN datosSpec:=y; nombreSpec:="Salida interpolada"; END;
        END;
        IF etapaSpec==3 THEN
          datosSpec:=filtrada; nombreSpec:=etiquetaFiltrada;
          IF operacion==2 THEN origenSpec:=salida0; END;
          IF filtro==0 THEN
            validoSpec:=0;
            SSInfoView("Etapa filtrada","Sin filtro opcional aplicado","Consulte Original o Salida final. Las interpolaciones lineal, SINC y ZOH incorporan su propio nucleo en la salida; no tienen una etapa de filtro opcional separada.",SSAccent(5));
          END;
        END;
        IF etapaSpec==4 THEN datosSpec:=y; origenSpec:=salida0; nombreSpec:="Salida final y[n]"; END;
        IF validoSpec THEN
          FOR k FROM 1 TO SIZE(datosSpec) DO IF SSIsDrawable(datosSpec(k))==0 THEN validoSpec:=0; END; END;
          IF SIZE(datosSpec)==0 THEN validoSpec:=0; END;
          IF validoSpec==0 THEN SSInfoView("Espectro no calculado","Registro vacio o con N/D","No se omiten muestras invalidas ni se sustituyen por cero. Revise la tabla de esta etapa.",SSAccent(5)); END;
        END;
        IF validoSpec THEN
          // DTFT del registro completo, sin dividir por N ni transformar la curva extra.
          IFERR valoresSpec:=SSCTFT(datosSpec,origenSpec,1,-pirad,2*pirad/200,201);
          THEN validoSpec:=0; END;
          IF validoSpec THEN
            FOR k FROM 1 TO SIZE(valoresSpec) DO IF SSIsDrawable(valoresSpec(k))==0 THEN validoSpec:=0; END; END;
          END;
          IF validoSpec==0 THEN SSInfoView("Espectro no calculado","Error o desbordamiento","No se modifico la salida. Revise la amplitud y longitud del registro.",SSAccent(5)); END;
          IF validoSpec THEN
            escalaSpec:=0;
            FOR k FROM 1 TO SIZE(valoresSpec) DO escalaSpec:=MAX(escalaSpec,ABS(valoresSpec(k))); END;
            faseSpec:={};
            notaSpec:="DTFT: suma de x[n]*exp(-i*w*n) sobre TODAS las "+STRING(SIZE(datosSpec))+" muestras del registro, desde n="+STRING(origenSpec)+". No se divide por N. Se muestran 201 frecuencias entre -pi y pi; no son 201 muestras temporales. w en rad/muestra de ESTA etapa; fase en radianes, indefinida en ceros (limpieza relativa 1E-12 solo para fase). Tabla/exportacion conservan el espectro complejo original.\nCero fuera del registro: no es el espectro de una senal infinita ni una densidad de potencia. El recorte de colas del filtro produce fuga espectral; no se fuerza a cero la banda rechazada.";
            IF operacion==1 THEN notaSpec:=notaSpec+"\nOriginal y entrada filtrada: tasa de entrada. Salidas: Ts'=M*Ts; una misma w representa otra frecuencia fisica.";
            ELSE notaSpec:=notaSpec+"\nOriginal: tasa de entrada. Expansion/interpolacion y filtrada: Ts'=Ts/L. Una misma w representa otra frecuencia fisica."; END;
            vistaSpec:=1;
            REPEAT
              vistaSpec:=SSMenu("Espectro: "+nombreSpec,{"Magnitud |X(w)|","Fase en radianes","Tabla compleja X(w)","Exportar espectro","Convenciones y registro","Volver"},vistaSpec);
              IF vistaSpec==0 OR vistaSpec==6 THEN BREAK; END;
              IF vistaSpec==1 THEN SSPlotXY(SSMag(valoresSpec),-pirad,2*pirad/200,"Magnitud: "+nombreSpec,"w rad/muestra | DTFT del registro"); END;
              IF vistaSpec==2 THEN
                faseSpec:=SSPhase(SSCleanComplex({valoresSpec,1E-12*escalaSpec}));
                SSPlotXY(faseSpec,-pirad,2*pirad/200,"Fase: "+nombreSpec,"w rad/muestra | fase rad");
                faseSpec:={};
              END;
              IF vistaSpec==3 THEN SSDataView(valoresSpec,-pirad,2*pirad/200,"DTFT: "+nombreSpec,"w","X(w)",SSAccent(3)); END;
              IF vistaSpec==4 THEN SSExportData(valoresSpec,-pirad,2*pirad/200,"DTFT: "+nombreSpec+" | w rad/muestra de esta etapa"); END;
              IF vistaSpec==5 THEN SSInfoView("Espectro: "+nombreSpec,"Registro finito, sin normalizar",notaSpec,SSAccent(3)); END;
            UNTIL 0;
            valoresSpec:={}; faseSpec:={};
          END;
        END;
        datosSpec:={}; valoresSpec:={}; faseSpec:={};
      UNTIL 0;
    END;
    // No retener snapshots ni copias de calculo al volver al menu de resultados.
    previo:={}; baseFiltro:={}; vistaIdeal:={};
    IF reanudar THEN reanudar:=0; op:=1; END;
  UNTIL 0;
END;

SSDFTResults(y,titulo,modo,natural,Nused)
BEGIN
  LOCAL op:=1;
  LOCAL ordered:=0;
  LOCAL candidato;
  LOCAL nuevoN;
  LOCAL nuevoResultado;
  LOCAL nuevaNatural;
  LOCAL entradaOriginal;
  LOCAL candidatoOriginal;
  LOCAL ejeModo:=1;
  LOCAL ejeFactor:=1;
  LOCAL TsFisico:=1;
  LOCAL origenFisico:=0;
  LOCAL nuevaTs;
  LOCAL nuevoOrigen;
  LOCAL nuevaUnidad;
  LOCAL faseVista;
  LOCAL vistaExtra;
  LOCAL valoresExtra;
  LOCAL valido;
  LOCAL registro:={};
  LOCAL continua:={};
  LOCAL superpuesta:=0;
  LOCAL opciones;
  LOCAL nombreGrafico;
  LOCAL pirad:=3.141592653589793;
  LOCAL faseRad;
  LOCAL formulaRegistro:="";
  LOCAL terminoRegistro;
  LOCAL variableRegistro:="k";
  LOCAL signoRegistro:="-i";
  LOCAL subRegistro:=1;
  LOCAL idx;
  LOCAL z:=y;
  LOCAL x0:=0;
  LOCAL dx:=1;
  LOCAL eje:="n";
  LOCAL nota:="IDFT: x[n]=(1/N) sum X[k] exp(j2pi kn/N)";
  // En DFT directa el titulo puede transportar el registro realmente usado,
  // ya truncado/rellenado. Las llamadas de IDFT/serie conservan su contrato.
  IF TYPE(titulo)==6 THEN
    IF SIZE(titulo)>=3 THEN ordered:=titulo(3)=="ORDERED"; END;
    registro:=titulo(2); entradaOriginal:=registro;
    IF SIZE(titulo)>=4 THEN entradaOriginal:=titulo(4); END;
    IF SIZE(titulo)>=5 THEN
      opciones:=titulo(5);
      ejeModo:=opciones(1); TsFisico:=opciones(2); origenFisico:=opciones(3);
    END;
    titulo:=titulo(1);
  END;
  IF modo==1 THEN
    IF ordered==0 THEN z:=SSShiftSpectrum(y); END;
    x0:=SSDFTAxis0(Nused); dx:=2*3.141592653589793/Nused; eje:="w";
    nota:="DFT reordenada en -pi <= w < pi";
  END;
  IF modo==2 THEN
    IF ordered==0 THEN z:=SSShiftSpectrum(y); END;
    x0:=-FLOOR(Nused/2); dx:=1; eje:="k";
    nota:="Serie discreta: c[k]=DFT{x[n]}/N";
  END;
  y:={}; // z es la salida activa; no retener otra copia al editar/recalcular.
  REPEAT
    ejeFactor:=1;
    IF modo==1 THEN x0:=SSDFTAxis0(Nused); dx:=2*pirad/Nused; eje:="w rad/muestra"; END;
    IF modo==2 THEN x0:=-FLOOR(Nused/2); dx:=1; eje:="k armonico"; END;
    IF modo==3 THEN x0:=0; dx:=1; eje:="n"; END;
    IF modo<3 AND ejeModo==2 THEN
      IF modo==1 THEN ejeFactor:=Nused/(2*pirad); END;
      x0:=-FLOOR(Nused/2); dx:=1; eje:="k centrado";
    END;
    IF modo<3 AND ejeModo==3 THEN
      ejeFactor:=1/(2*pirad*TsFisico); x0:=-FLOOR(Nused/2)/(Nused*TsFisico); dx:=1/(Nused*TsFisico); eje:="f Hz";
    END;
    IF modo==3 AND ejeModo==3 THEN x0:=origenFisico; dx:=TsFisico; eje:="t s"; END;
    opciones:={"Tabla compleja ordenada","Modulo / magnitud","Fase / angulo","N y criterio usado","Exportar resultado","Formula y eje","Mas vistas","Editar entrada / N","Eje y unidades","Fase extendida / retardo","Volver"};
    IF modo==3 THEN opciones(2):="Senal x[n]: parte real"; opciones(3):="Senal x[n]: parte imaginaria"; END;
    IF modo==1 AND SIZE(registro)>0 THEN
      nombreGrafico:="DTFT superpuesta: NO"; IF superpuesta==1 THEN nombreGrafico:="DTFT superpuesta: SI"; END;
      opciones(7):=nombreGrafico;
    END;
    op:=SSMenu({"Resultados DFT y Fourier",{3,"Resultados DFT y Fourier",{{"Resultado ordenado",z,x0,dx},{"Entrada disponible",registro,0,1},{"Modo, N natural, N usado",{modo,natural,Nused}},{"Entrada original completa",entradaOriginal,0,1},{"Eje, Ts, origen",{ejeModo,TsFisico,origenFisico}}},titulo+"\n"+nota+"\nEje="+eje},SIZE(opciones)},opciones,op);
    IF op==0 OR op==SIZE(opciones) THEN RETURN 1; END;
    IF op==7 THEN
      IF modo==1 AND SIZE(registro)>0 THEN
        superpuesta:=1-superpuesta;
        IF superpuesta==0 THEN continua:={}; END;
      ELSE
        vistaExtra:=SSMenu("Vistas del resultado",{"Magnitud","Fase (rad)","Parte real","Parte imaginaria","Volver"},1);
        IF vistaExtra>=1 AND vistaExtra<=4 THEN
          valoresExtra:=z;
          IF vistaExtra==1 THEN valoresExtra:=SSMag(z); nombreGrafico:="Magnitud"; END;
          IF vistaExtra==2 THEN valoresExtra:=SSPhase(z); nombreGrafico:="Fase (rad)"; END;
          IF vistaExtra==3 OR vistaExtra==4 THEN
            nombreGrafico:="Parte real"; IF vistaExtra==4 THEN nombreGrafico:="Parte imaginaria"; END;
            FOR idx FROM 1 TO SIZE(z) DO
              IF SSIsDrawable(z(idx)) THEN
                IF vistaExtra==3 THEN valoresExtra(idx):=RE(z(idx)); ELSE valoresExtra(idx):=IM(z(idx)); END;
              ELSE valoresExtra(idx):=SSUndef(); END;
            END;
          END;
          SSPlotDiscrete(valoresExtra,x0,dx,nombreGrafico+" "+titulo,eje);
          valoresExtra:={};
        END;
      END;
    END;
    IF op==8 THEN
      candidato:=SSReadListDirect("Editar registro","Lista=","Entrada original completa; antes de recortar/rellenar",entradaOriginal);
      IF SIZE(candidato)==0 THEN CONTINUE; END;
      valido:=SIZE(candidato)<=1024;
      FOR idx FROM 1 TO SIZE(candidato) DO IF SSIsDrawable(candidato(idx))==0 THEN valido:=0; END; END;
      IF valido==0 THEN SSInfoView(titulo,"Registro no valido","Use de 1 a 1024 muestras finitas. Se conserva el resultado anterior.",SSAccent(4)); CONTINUE; END;
      nuevaNatural:=SIZE(candidato); nuevoN:=nuevaNatural;
      IF INPUT(nuevoN,"Longitud del calculo","N=","Entero 1..1024; natural = longitud de la lista",nuevoN)==0 THEN candidato:={}; CONTINUE; END;
      IF TYPE(nuevoN)<>0 THEN candidato:={}; CONTINUE; END;
      IF nuevoN<1 OR nuevoN>1024 OR nuevoN<>FLOOR(nuevoN) THEN SSInfoView(titulo,"N no valido","No se modifico la entrada ni el resultado anterior.",SSAccent(4)); candidato:={}; CONTINUE; END;
      candidatoOriginal:=candidato; candidato:=SSPad(candidato,nuevoN);
      IF modo==3 THEN nuevoResultado:=SSIDFT({candidato,"PROGRESS"});
      ELSE nuevoResultado:=SSDFT({candidato,"PROGRESS"}); END;
      IF SIZE(nuevoResultado)<>nuevoN THEN candidato:={}; candidatoOriginal:={}; nuevoResultado:={}; CONTINUE; END;
      valido:=1;
      FOR idx FROM 1 TO nuevoN DO IF SSIsDrawable(nuevoResultado(idx))==0 THEN valido:=0; END; END;
      IF valido==0 THEN
        SSInfoView(titulo,"Recalculo no valido","La transformada nueva contiene N/D o desbordamientos. Se conserva la entrada y salida anterior.",SSAccent(4));
        candidato:={}; candidatoOriginal:={}; nuevoResultado:={}; CONTINUE;
      END;
      IF modo==2 THEN
        FOR idx FROM 1 TO nuevoN DO IF SSIsDrawable(nuevoResultado(idx)) THEN nuevoResultado(idx):=nuevoResultado(idx)/nuevoN; END; END;
      END;
      // Confirmar juntos: cancelar nunca pisa la salida anterior.
      registro:=candidato; entradaOriginal:=candidatoOriginal; candidatoOriginal:={}; Nused:=nuevoN; natural:=nuevaNatural; z:=nuevoResultado;
      IF modo==1 THEN z:=SSShiftSpectrum(z); x0:=SSDFTAxis0(Nused); dx:=2*pirad/Nused; END;
      IF modo==2 THEN z:=SSShiftSpectrum(z); x0:=-FLOOR(Nused/2); END;
      continua:={}; formulaRegistro:=""; candidato:={}; nuevoResultado:={};
      CONTINUE;
    END;
    IF op==1 THEN SSDataView(z,x0,dx,titulo+"; "+eje,eje,"valor",SSAccent(4)); END;
    IF (op==2 OR op==3) AND superpuesta==1 THEN
      IF SIZE(continua)==0 THEN
        SSHeader("Comparacion DFT / DTFT","Calculando la misma ventana...",SSAccent(4));
        continua:=SSCTFT({registro,"PROGRESS"},0,1,-pirad,2*pirad/200,201);
        IF SIZE(continua)==0 THEN CONTINUE; END;
      END;
      nombreGrafico:="Magnitud DFT / DTFT"; IF op==3 THEN nombreGrafico:="Fase DFT / DTFT (rad)"; END;
      superpuesta:=SSPlotDual(continua,z,{nombreGrafico+" | "+eje,-pirad*ejeFactor,2*pirad*ejeFactor/200,"FOURIER",x0,dx,2,op,superpuesta,eje});
    ELSE
      IF op==2 THEN
        IF modo==3 THEN SSPlotDiscrete(z,x0,dx,"Parte real "+titulo,eje);
        ELSE SSPlotDiscrete(SSMag(z),x0,dx,"Modulo "+titulo,eje); END;
      END;
      IF op==3 THEN
        IF modo==3 THEN
          valoresExtra:=z;
          FOR idx FROM 1 TO SIZE(z) DO IF SSIsDrawable(z(idx)) THEN valoresExtra(idx):=IM(z(idx)); ELSE valoresExtra(idx):=SSUndef(); END; END;
          SSPlotDiscrete(valoresExtra,x0,dx,"Parte imaginaria "+titulo,eje); valoresExtra:={};
        ELSE
        IF modo==1 THEN
          faseRad:=SSPhase(z);
          SSPlotDiscrete(faseRad,x0,dx,"Fase "+titulo+" (rad)",eje);
        ELSE SSPlotDiscrete(SSPhase(z),x0,dx,"Fase "+titulo,eje); END;
        END;
      END;
    END;
    IF op==4 THEN SSInfoView(titulo,"Metodo numerico y ventana","N natural="+STRING(natural)+"\nN utilizado="+STRING(Nused)+"\nN mayor: zero-padding; no agrega informacion ni mejora la resolucion fisica. N menor: truncamiento. DFT usa FFT si N es potencia de dos y suma directa en otras longitudes; IDFT divide por N y serie discreta usa DFT/N. La fase de una magnitud cero queda N/D, no se representa como un angulo valido.",SSAccent(4)); END;
    IF op==5 THEN SSExportData(z,x0,dx,titulo+"; "+eje); END;
    IF op==6 THEN
      subRegistro:=SSMenu("Formula y eje",{"Formula del registro Textbook","Unidades y convenciones","Volver"},1);
      IF subRegistro==1 THEN
        IF SIZE(registro)>0 THEN
          IF formulaRegistro=="" THEN
            IF modo==3 THEN variableRegistro:="n"; signoRegistro:="i"; END;
            FOR idx FROM 1 TO SIZE(registro) DO
              IF registro(idx)<>0 THEN
                terminoRegistro:="("+STRING(RE(registro(idx)),1,12,{3,".E-",0})+"+("+STRING(IM(registro(idx)),1,12,{3,".E-",0})+")*i)";
                IF idx>1 THEN terminoRegistro:=terminoRegistro+"*exp("+signoRegistro+"*2*pi*"+variableRegistro+"*"+STRING(idx-1)+"/"+STRING(Nused)+")"; END;
                IF formulaRegistro<>"" THEN formulaRegistro:=formulaRegistro+"+"; END;
                formulaRegistro:=formulaRegistro+terminoRegistro;
              END;
            END;
            IF formulaRegistro=="" THEN formulaRegistro:="0"; END;
            IF modo==2 OR modo==3 THEN formulaRegistro:="("+formulaRegistro+")/"+STRING(Nused); END;
          END;
          SSSymbolicResults(titulo,"Formula en "+variableRegistro,formulaRegistro,"N="+STRING(Nused),"Suma finita expandida de los datos realmente usados, no una transformada infinita. DFT usa k entero; IDFT usa n entero y divide por N; serie discreta divide por N. Los coeficientes se serializan con 12 cifras: es exacta para esos numeros escritos, que pueden ser aproximaciones de la expresion de entrada. Incluye truncamiento/zero-padding elegido; no se reconstruye una ley simbolica desde la tabla de salida.");
          formulaRegistro:=""; terminoRegistro:="";
        ELSE SSInfoView(titulo,"Registro no disponible","Esta ruta no conserva la entrada necesaria para expandir la formula. Consulte las convenciones; no se inventa una expresion desde los resultados.",SSAccent(4)); END;
      END;
      IF subRegistro==2 THEN SSInfoView(titulo,"Formula, unidades y alcance",nota+"\nN="+STRING(Nused)+"\nEje inicial="+SSFmt(x0,8)+"\nPaso="+SSFmt(dx,8)+"\nDFT: w en radianes/muestra; f=w/(2*pi*Ts) en Hz si Ts esta en segundos. Serie: k es el indice armonico. IDFT: n es la posicion desde cero. El eje importado no corrige automaticamente la fase. DFT conserva la escala sin dividir por N; no es un espectro continuo ni una densidad por Hz. En DFT directa, DTFT superpuesta compara el mismo registro ya truncado o rellenado. Curva azul: 201 evaluaciones DTFT; tallos naranjas: bins DFT exactos, no interpolados. Tecla 1 muestra/oculta la contraria, ENTER abre tablas separadas. Fase de cero: sin punto en la comparacion.",SSAccent(4)); END;
    END;
    IF op==9 THEN
      nuevaUnidad:=SSMenu("Eje y unidades",{"Indice n / frecuencia original","Bins k centrados (DFT/serie)","Hz / segundos: indicar Ts","Volver"},ejeModo);
      IF nuevaUnidad==1 OR (nuevaUnidad==2 AND modo<3) THEN ejeModo:=nuevaUnidad; END;
      IF nuevaUnidad==3 THEN
        nuevaTs:=TsFisico; nuevoOrigen:=origenFisico;
        IF INPUT(nuevaTs,"Unidades fisicas","Ts (s)=","Paso temporal original; no el paso de frecuencia",TsFisico) THEN
          IF SSIsDrawable(nuevaTs) THEN IF IM(nuevaTs)==0 AND nuevaTs>=1E-12 AND nuevaTs<=1E12 THEN
            nuevaUnidad:=1;
            IF modo==3 THEN nuevaUnidad:=INPUT(nuevoOrigen,"Eje temporal","t inicial=","Solo cambia el eje, no los valores",origenFisico); END;
            IF nuevaUnidad AND SSIsDrawable(nuevoOrigen) THEN IF IM(nuevoOrigen)==0 THEN
              TsFisico:=nuevaTs; origenFisico:=nuevoOrigen; ejeModo:=3;
            END; END;
          END; END;
        END;
      END;
    END;
    IF op==10 THEN
      faseVista:=SSMenu("Analisis de fase",{"Fase desenrollada","Retardo de grupo (muestras)","Volver"},1);
      IF faseVista==1 OR faseVista==2 THEN
        IF faseVista==2 AND modo==3 THEN
          SSInfoView("Retardo de grupo","Solo para espectros","La IDFT es una senal temporal. Use la DFT de una respuesta impulsional para estudiar el retardo del sistema.",SSAccent(4));
        ELSE
          nombreGrafico:="Fase desenrollada (rad)";
          valoresExtra:=SSPhase({z,"UNWRAP",2*pirad/Nused});
          IF faseVista==2 THEN nombreGrafico:="Retardo de grupo (muestras)"; valoresExtra:=SSPhase({z,"DELAY",2*pirad/Nused}); END;
          SSInfoView(nombreGrafico,"Estimacion sobre la malla","No se unen huecos de fase indefinida. Desenrollado por diferencias menores a pi: una malla insuficiente puede ocultar vueltas. El retardo usa diferencias finitas respecto de w rad/muestra, no del eje de visualizacion. No interpretar cerca de ceros espectrales.",SSAccent(4));
          SSPlotXY(valoresExtra,x0,dx,nombreGrafico,eje); valoresExtra:={};
        END;
      END;
    END;
  UNTIL 0;
END;

SSSequenceExprResults(x,n0,f)
BEGIN
  LOCAL op:=1;
  LOCAL edit;
  LOCAL expr;
  LOCAL origen;
  LOCAL cantidad;
  LOCAL nueva;
  REPEAT
    op:=SSMenu({"Secuencia por expresion",{3,"Secuencia por expresion",{{"Secuencia x[n]",x,n0,1,SSEVAL_EVENTS},{"Expresion",f}},"X representa n; solo la ventana calculada."},7},{"Tabla numerica x[n]","Grafico discreto x[n]","Expresion e intervalo","Exportar secuencia","Metodo y contexto","Editar parametros","Volver"},op);
    IF op==0 OR op==7 THEN RETURN 1; END;
    IF op==1 THEN SSDataView(x,n0,1,"Secuencia por expresion","n","x[n]",SSAccent(1)); END;
    IF op==2 THEN SSPlot(x,n0,"Secuencia por expresion"); END;
    IF op==3 THEN
      IF MID(f,1,7)=="TRAMOS:" THEN SSInfoView("Definicion por tramos","X representa n",f,SSAccent(1));
      ELSE SSSymbolicResults("Secuencia por expresion","x[n] | X representa n",f,"x[n]="+f,SSDataSummary(x,n0,1,"Secuencia generada")); END;
    END;
    IF op==4 THEN SSExportData(x,n0,1,"Secuencia: "+f); END;
    IF op==5 THEN SSInfoView("Secuencia generada","Evaluacion numerica en indices",SSDataSummary(x,n0,1,"x[n]")+"\nX representa n entero; no se supone un Ts fisico. Solo se exporta la ventana calculada, no una funcion infinita ni su continuacion periodica. La tabla redondea para leer; el detalle y la exportacion conservan las cifras almacenadas.",SSAccent(1)); END;
    IF op==6 THEN
      IF MID(f,1,7)=="TRAMOS:" THEN RETURN 2; END;
      expr:=f; origen:=n0; cantidad:=SIZE(x); edit:=0;
      IF INPUT(expr,"Editar secuencia","Formula=","X representa n",f) THEN
        IF INPUT(origen,"Editar secuencia","n inicial=","Indice entero",n0) THEN
          IF INPUT(cantidad,"Editar secuencia","N=","Entero de 1 a 1024",cantidad) THEN edit:=1; END;
        END;
      END;
      IF edit==1 THEN
        IF TYPE(origen)<>0 OR TYPE(cantidad)<>0 THEN edit:=0;
        ELSE IF origen<>FLOOR(origen) OR ABS(origen)>1E12 OR cantidad<>FLOOR(cantidad) OR cantidad<1 OR cantidad>1024 OR DIM(expr)==0 THEN edit:=0; END; END;
        IF edit==1 THEN
          nueva:=SSEvalExpr({expr,"DISCRETE"},origen,1,cantidad);
          IF SIZE(nueva)>0 THEN x:=nueva; n0:=origen; f:=expr; END;
        ELSE SSInfoView("SignalLab","Aviso","Entrada invalida. Se conserva la secuencia anterior.",SSAccent(1)); END;
      END;
    END;
  UNTIL 0;
END;

SSQuantResults(x,xq,bits,qlo,qhi,paso,niveles,snr,modo)
BEGIN
  LOCAL restaurar;
  LOCAL nuevos;
  LOCAL nuevoModo;
  LOCAL resultadoNuevo;
  LOCAL valida;
  LOCAL notaBase;
  LOCAL vistaEje;
  LOCAL op:=1;
  LOCAL signalEnergy;
  LOCAL errorEnergy;
  LOCAL snrLinear:=0;
  LOCAL firstSNR:=1;
  LOCAL lastSNR:=SIZE(x);
  LOCAL countSNR:=SIZE(x);
  LOCAL calcularSNR:=1;
  LOCAL axis0:=SSReadOrigin(0);
  LOCAL axisStep:=SSReadStep(1);
  LOCAL axisLabel:="n desde 0 (sin eje asociado)";
  LOCAL scopeSNR:="Registro completo";
  LOCAL contextSNR;
  LOCAL selection;
  LOCAL lower;
  LOCAL upper;
  LOCAL firstNew;
  LOCAL lastNew;
  LOCAL upperMode;
  LOCAL labelLower;
  LOCAL labelUpper;
  LOCAL helpLower;
  LOCAL helpUpper;
  LOCAL nuevoScope;
  LOCAL confirmar;
  LOCAL posLower;
  LOCAL posUpper;
  LOCAL j;
  LOCAL met:="redondeo";
  LOCAL kzero:=0;
  LOCAL realLo:=qlo;
  LOCAL realHi:=qhi;
  LOCAL offsetMode:="Sin offset: rango original";
  LOCAL formula:="a+Delta*Q((x(n)-a)/Delta)";
  LOCAL nota:="a es el nivel minimo efectivo. Se satura al rango efectivo antes de Q. Truncamiento usa FLOOR: nivel inferior, no hacia cero. Error firmado: xq[n]-x[n].";
  IF TYPE(modo)==6 THEN
    restaurar:=modo; modo:=restaurar(1); firstSNR:=restaurar(2); lastSNR:=restaurar(3);
    axis0:=restaurar(4); axisStep:=restaurar(5); axisLabel:="Eje recuperado (t o n)";
    scopeSNR:="Intervalo recuperado; ambos extremos incluidos";
  END;
  IF TYPE(SSREAD_META)==6 THEN IF SIZE(SSREAD_META)==4 THEN IF SSREAD_META(1)==1 THEN axisLabel:="Eje importado (t o n)"; END; END; END;
  IF SSIsDrawable(axis0)==0 OR SSIsDrawable(axisStep)==0 THEN axis0:=0; axisStep:=1; axisLabel:="n desde 0 (eje no valido)"; END;
  IF IM(axis0)<>0 OR IM(axisStep)<>0 OR axisStep<=0 THEN axis0:=0; axisStep:=1; axisLabel:="n desde 0 (eje no valido)"; END;
  nota:=nota+" SNR usa el intervalo indicado, incluidos sus ceros interiores. No cambia las listas, el banco, los niveles ni los graficos. No depende del zoom ni redondea residuos. Psenal=Es/N; Perror=Eerror/N, con el mismo N seleccionado. SNR lineal=Psenal/Perror. SNR dB=10*(log10(Es)-log10(Eerror)). Incluye continua y error por saturacion, sin restar la media. No usa 6.02*bits+1.76. Sin nivel cero, los ceros seleccionados tambien pueden aportar error.";
  notaBase:=nota;
  REPEAT
  nota:=notaBase; met:="redondeo"; kzero:=0; realLo:=qlo; realHi:=qhi;
  offsetMode:="Sin offset: rango original"; formula:="a+Delta*Q((x(n)-a)/Delta)";
  IF modo==2 OR modo==4 THEN met:="truncamiento"; END;
  IF modo>2 THEN
    kzero:=MAX(0,MIN(niveles-1,FLOOR(-qlo/paso+0.5)));
    realLo:=-kzero*paso; realHi:=(niveles-1-kzero)*paso;
    offsetMode:="Con offset: nivel en cero";
    formula:="Delta*(Q(x(n)/Delta+k0)-k0)";
    nota:=nota+" k0 es el codigo del nivel cero. Se mantienen L y Delta; se desplazan los extremos hasta medio paso. En empate se desplazan hacia abajo. No se suma offset a x[n].";
  END;
    IF calcularSNR==1 THEN
    countSNR:=lastSNR-firstSNR+1; signalEnergy:=0; errorEnergy:=0;
    FOR j FROM firstSNR TO lastSNR DO
      signalEnergy:=signalEnergy+ABS(x(j))^2;
      errorEnergy:=errorEnergy+ABS(xq(j)-x(j))^2;
    END;
    IF errorEnergy>0 THEN
      snrLinear:=signalEnergy/errorEnergy;
      IF signalEnergy>0 THEN snr:=10*(LOG(signalEnergy)-LOG(errorEnergy)); ELSE snr:="-infinity"; END;
    ELSE
      IF signalEnergy>0 THEN snrLinear:="+infinity"; snr:="+infinity";
      ELSE snrLinear:="Indefinida: energia y error nulos"; snr:=snrLinear; END;
    END;
    calcularSNR:=0;
    END;
    contextSNR:=scopeSNR+"\nIndices efectivos: n="+STRING(firstSNR-1)+"..."+STRING(lastSNR-1)+", AMBOS INCLUIDOS. N="+STRING(countSNR)+" de "+STRING(SIZE(x))+". n=0 es la primera muestra de esta tabla.\n"+axisLabel+"; origen="+STRING(axis0)+"; paso="+STRING(axisStep)+"\nCoordenadas efectivas: "+STRING(axis0+(firstSNR-1)*axisStep)+"..."+STRING(axis0+(lastSNR-1)*axisStep)+".\n"+nota;
    op:=SSMenu({"Resultados de cuantizacion",{3,"Resultados de cuantizacion",{{"Entrada x",x,axis0,axisStep},{"Salida cuantizada",xq,axis0,axisStep},{"SNR lineal",snrLinear},{"SNR dB",snr},{"n inicial-final incluidos",{firstSNR-1,lastSNR-1}},{"Bits y niveles",{bits,niveles}},{"Rango solicitado",{qlo,qhi}},{"Rango efectivo y paso",{realLo,realHi,paso}},{"Metodo",met},{"Offset",offsetMode},{"Formula",formula},{"Reanudar cuantizador",{bits,qlo,qhi,paso,niveles,modo,firstSNR,lastSNR}}},contextSNR},8},{"Tabla x, xq y error","Grafico comparativo","Grafico del error xq-x","Parametros y formula","Intervalo para SNR","Editar cuantizador","Vistas y exportacion con eje original","Volver"},op);
    IF op==0 OR op==8 THEN RETURN 1; END;
    IF op==6 THEN
      nuevos:=SSReadListDirect("Editar cuantizador","{bits,min,max}=","Bits 1...24; min < max; conserva entrada e intervalo SNR",{bits,qlo,qhi});
      valida:=SIZE(nuevos)==3;
      IF valida THEN
        FOR j FROM 1 TO 3 DO IF SSIsDrawable(nuevos(j))==0 THEN valida:=0; ELSE IF IM(nuevos(j))<>0 THEN valida:=0; END; END; END;
      END;
      IF valida THEN
        IF nuevos(1)<1 OR nuevos(1)>24 OR nuevos(1)<>FLOOR(nuevos(1)) OR nuevos(3)<=nuevos(2) THEN valida:=0; END;
      END;
      IF valida THEN
        nuevoModo:=SSMenu("Metodo / offset",{"Redondeo sin offset","Truncamiento sin offset","Redondeo: nivel cero","Truncamiento: nivel cero","Cancelar"},modo);
        IF nuevoModo<1 OR nuevoModo>4 THEN CONTINUE; END;
        IF nuevoModo>2 AND (nuevos(2)>0 OR nuevos(3)<0) THEN valida:=0; END;
        IF valida THEN
          IFERR resultadoNuevo:=SSQuantize(x,nuevos(1),nuevos(2),nuevos(3),nuevoModo); THEN valida:=0; END;
          IF valida THEN
            bits:=nuevos(1); qlo:=nuevos(2); qhi:=nuevos(3); modo:=nuevoModo;
            xq:=resultadoNuevo(1); paso:=resultadoNuevo(2); niveles:=resultadoNuevo(3); calcularSNR:=1;
          END;
          resultadoNuevo:={};
        END;
      END;
      IF valida==0 AND SIZE(nuevos)>0 THEN SSInfoView("Cuantizador","Cambio no aplicado","Revise bits, rango y que el offset incluya cero. La salida anterior se conserva.",SSAccent(5)); END;
      nuevos:={}; CONTINUE;
    END;
    IF op==7 THEN
      vistaEje:=SSMenu("Eje original: "+axisLabel,{"Tabla salida xq","Comparar x y xq","Error xq-x","Exportar xq con eje","Volver"},1);
      IF vistaEje==1 THEN SSDataView(xq,axis0,axisStep,"Cuantizacion; eje original","t o n","xq",SSAccent(5)); END;
      IF vistaEje==2 THEN SSPlotDual(x,xq,{"Cuantizacion; eje original",axis0,axisStep,"eje"}); END;
      IF vistaEje==3 THEN SSPlotDiscrete(xq-x,axis0,axisStep,"Error; eje original","t o n"); END;
      IF vistaEje==4 THEN SSExportData(xq,axis0,axisStep,"Cuantizacion; eje original"); END;
    END;
    IF op==1 THEN SSDataViewPair(x,xq,0,"Cuantizacion",SSAccent(5)); END;
    IF op==2 THEN SSPlotDual(x,xq,"Cuantizacion"); END;
    IF op==3 THEN SSPlotDiscrete(xq-x,0,1,"Error e[n]=xq[n]-x[n]","n"); END;
    IF op==4 THEN
      SSResultBrowse("Cuantizacion",offsetMode,{{"Muestras usadas N",countSNR},{"SNR lineal (sin unidad)",snrLinear},{"SNR en dB",snr},{"Potencia media senal",signalEnergy/countSNR},{"Potencia media error",errorEnergy/countSNR},{"n primero/ultimo INCLUIDOS",{firstSNR-1,lastSNR-1}},{"Eje efectivo primera/ultima",{axis0+(firstSNR-1)*axisStep,axis0+(lastSNR-1)*axisStep}},{"Muestras totales",SIZE(x)},{"Formula xq(n)",formula},{"Error e(n)","xq(n)-x(n)"},{"Paso Delta",paso},{"Niveles",niveles},{"Bits",bits},{"Rango solicitado",{qlo,qhi}},{"Rango efectivo",{realLo,realHi}},{"Desplazamiento",realLo-qlo},{"k0 (solo con offset)",kzero}},"Q: "+met,contextSNR);
    END;
    IF op==5 THEN
      selection:=SSMenu("Intervalo para SNR",{"Registro completo","Por indices n (desde 0)","Por eje original (t o n)","Volver"},1);
      IF selection==1 THEN firstSNR:=1; lastSNR:=SIZE(x); scopeSNR:="Registro completo; ultimo n INCLUIDO"; calcularSNR:=1; op:=4; END;
      IF selection==2 OR selection==3 THEN
        REPEAT
        lower:=firstSNR-1; upper:=lastSNR-1; upperMode:=1;
        labelLower:="n inicial="; labelUpper:="n final=";
        helpLower:="INCLUIDO; n=0 es la primera muestra";
        helpUpper:="Luego elija INCLUIR o EXCLUIR este n";
        IF selection==2 THEN
          SSInfoView("SNR por indices n","Mismos n de la tabla de cuantizacion","n=0 es la primera muestra, n=1 la segunda. No son segundos ni numeros de fila. Rango disponible: 0..."+STRING(SIZE(x)-1)+". El inicio siempre se incluye. Luego se elige incluir o excluir el n final. Ejemplo: n=0 a 4 INCLUIDO usa 5 muestras; EXCLUIDO usa n=0...3, 4 muestras. Antes de aplicar vera el resumen.",SSAccent(5));
        END;
        IF selection==3 THEN
          lower:=axis0+(firstSNR-1)*axisStep; upper:=axis0+(lastSNR-1)*axisStep;
          labelLower:="Eje inicial="; labelUpper:="Eje final=";
          helpLower:="INCLUIDO; coordenada original, no fila";
          helpUpper:="Luego elija INCLUIR o EXCLUIR el final";
          SSInfoView("Intervalo para SNR",axisLabel,"Origen="+STRING(axis0)+"; paso="+STRING(axisStep)+". El inicio se incluye; luego elija incluir o excluir el final. Use las coordenadas originales, no el indice del grafico. Ejemplo: inicio 0, final 2.5 excluido, Ts=0.5 selecciona 0,0.5,1,1.5,2. Los ceros interiores se conservan. Solo cambia la medicion SNR.",SSAccent(5));
        END;
        IF INPUT(lower,"Intervalo para SNR",labelLower,helpLower,lower)==0 THEN BREAK; END;
        IF INPUT(upper,"Intervalo para SNR",labelUpper,helpUpper,upper)==0 THEN BREAK; END;
        IF SSIsDrawable(lower)==0 OR SSIsDrawable(upper)==0 THEN SSInfoView("Intervalo no valido","Seleccion anterior conservada","Use limites reales finitos.",SSAccent(5)); BREAK; END;
        IF IM(lower)<>0 OR IM(upper)<>0 OR upper<lower THEN SSInfoView("Intervalo no valido","Seleccion anterior conservada","Use limites reales ordenados.",SSAccent(5)); BREAK; END;
          upperMode:=SSMenu("Final="+STRING(upper)+": incluir?",{"INCLUIR muestra del final","EXCLUIR muestra del final","Cancelar"},1);
          IF upperMode==0 OR upperMode==3 THEN BREAK; END;
        IF selection==3 THEN
          IF upper<axis0 OR lower>axis0+(SIZE(x)-1)*axisStep THEN SSInfoView("Intervalo sin muestras","Seleccion anterior conservada","El intervalo no contiene datos del registro.",SSAccent(5)); BREAK; END;
          posLower:=(MAX(lower,axis0)-axis0)/axisStep;
          posUpper:=(MIN(upper,axis0+(SIZE(x)-1)*axisStep)-axis0)/axisStep;
          // Ajustar solo coordenadas casi enteras, no amplitudes ni ceros.
          IF ABS(posLower-ROUND(posLower,0))<=1E-9 THEN posLower:=ROUND(posLower,0); END;
          IF ABS(posUpper-ROUND(posUpper,0))<=1E-9 THEN posUpper:=ROUND(posUpper,0); END;
          firstNew:=MAX(1,1-FLOOR(-posLower)); lastNew:=MIN(SIZE(x),1+FLOOR(posUpper));
          IF upperMode==2 AND upper<=axis0+(SIZE(x)-1)*axisStep THEN lastNew:=MIN(SIZE(x),-FLOOR(-posUpper)); END;
        ELSE
          IF lower<>FLOOR(lower) OR upper<>FLOOR(upper) OR lower<0 OR upper>SIZE(x) OR lower>=SIZE(x) OR (upper==SIZE(x) AND upperMode==1) THEN SSInfoView("Indices n no validos","Seleccion anterior conservada","Use n enteros de 0 a "+STRING(SIZE(x)-1)+". Puede usar n="+STRING(SIZE(x))+" como final EXCLUIDO para llegar hasta la ultima muestra.",SSAccent(5)); BREAK; END;
          firstNew:=lower+1; lastNew:=upper+1;
          IF upperMode==2 THEN lastNew:=upper; END;
        END;
        IF firstNew>lastNew THEN SSInfoView("Intervalo sin muestras","Seleccion anterior conservada","Ninguna muestra cae dentro de los limites elegidos.",SSAccent(5)); BREAK; END;
        nuevoScope:="Indices n solicitados: ";
        IF selection==3 THEN nuevoScope:="Eje original solicitado: "; END;
        nuevoScope:=nuevoScope+STRING(lower)+" a "+STRING(upper)+"; inicio INCLUIDO, final ";
        IF upperMode==1 THEN nuevoScope:=nuevoScope+"INCLUIDO."; ELSE nuevoScope:=nuevoScope+"EXCLUIDO."; END;
        SSInfoView("Confirmar intervalo SNR","Vista previa; aun no aplicado",nuevoScope+"\n\nSe usaran n="+STRING(firstNew-1)+" hasta n="+STRING(lastNew-1)+", AMBOS INCLUIDOS.\nCantidad: "+STRING(lastNew-firstNew+1)+" muestras.\nEje original: "+STRING(axis0+(firstNew-1)*axisStep)+"..."+STRING(axis0+(lastNew-1)*axisStep)+".\nLos ceros interiores se incluyen. No se recortan las senales.",SSAccent(5));
        confirmar:=SSMenu("Aplicar intervalo SNR",{"Aplicar: "+STRING(lastNew-firstNew+1)+" muestras","Cancelar; conservar anterior"},1);
        IF confirmar<>1 THEN BREAK; END;
        firstSNR:=firstNew; lastSNR:=lastNew; scopeSNR:=nuevoScope; calcularSNR:=1;
        op:=4;
        UNTIL 1;
      END;
    END;
  UNTIL 0;
END;

SSConvDiscreteResults(x,nx,h,nh,y)
BEGIN
  LOCAL op:=1;
  LOCAL ny:=FLOOR(nx)+FLOOR(nh);
  REPEAT
    op:=SSMenu({"Resultados de convolucion",{3,"Resultados de convolucion",{{"Entrada x[n]",x,FLOOR(nx),1},{"Impulso h[n]",h,FLOOR(nh),1},{"Salida y[n]",y,ny,1}},"Convolucion lineal discreta; valores complejos originales, no modulo."},6},{"Tabla salida y[n]","Tabla entrada x[n]","Tabla impulso h[n]","Grafico de y[n]","Resultado matematico","Volver"},op);
    IF op==0 OR op==6 THEN RETURN 1; END;
    IF op==1 THEN SSDataView(y,ny,1,"Salida y[n]","n","y[n]",SSAccent(2)); END;
    IF op==2 THEN SSDataView(x,FLOOR(nx),1,"Entrada x[n]","n","x[n]",SSAccent(1)); END;
    IF op==3 THEN SSDataView(h,FLOOR(nh),1,"Impulso h[n]","n","h[n]",SSAccent(2)); END;
    IF op==4 THEN SSPlot(y,ny,"Convolucion y[n]"); END;
    IF op==5 THEN
      SSResultBrowse("Convolucion discreta","Resultado y definicion",{{"Salida y[n] completa",y},{"Sumatoria y(n)","sum(x(k)*h(n-k),k,-infinity,infinity)"}},"n inicial="+STRING(ny)+"; N="+STRING(SIZE(y)),"Lista ordenada por n; cero fuera del soporte. La sumatoria es la definicion, no una evaluacion CAS.\n"+SSSeqMath(y,ny,"y"));
    END;
  UNTIL 0;
END;

SSConvContinuousResults(x,h,y,t0,t1,dt,f,g,nota)
BEGIN
  LOCAL op:=1;
  REPEAT
    op:=SSMenu({"Convolucion continua",{3,"Convolucion continua",{{"x(t)",x,t0,dt},{"h(t)",h,t0,dt},{"y(t)",y,2*t0,dt},{"Expresion x",f},{"Expresion h",g}},nota+"\nVentana="+STRING(t0)+"..."+STRING(t1)},8},{"Datos de salida y(t)","Datos de entrada x(t)","Datos del impulso h(t)","Grafico de salida y(t)","Graficos de x(t) y h(t)","Resultado matematico","Desarrollo y metodo","Volver"},op);
    IF op==0 OR op==8 THEN RETURN 1; END;
    IF op==1 THEN SSDataView(y,2*t0,dt,"Salida y(t)","t","y(t)",SSAccent(2)); END;
    IF op==2 THEN SSDataView(x,t0,dt,"Entrada x(t)","t","x(t)",SSAccent(1)); END;
    IF op==3 THEN SSDataView(h,t0,dt,"Respuesta h(t)","t","h(t)",SSAccent(2)); END;
    IF op==4 THEN SSPlotXY(y,2*t0,dt,"Salida de convolucion y(t)","Integral numerica"); END;
    IF op==5 THEN
      SSPlotXY(x,t0,dt,"Entrada continua x(t)","Evaluada en la ventana elegida");
      SSPlotXY(h,t0,dt,"Respuesta continua h(t)","Impulsos aproximados si corresponde");
    END;
    IF op==6 THEN SSConvMathView(f,g,t0,t1,SSAccent(2)); END;
    IF op==7 THEN SSResultBrowse("Convolucion continua","Desarrollo y metodo",{{"Definicion y(t)","int(x(u)*h(t-u),u,-infinity,infinity)"},{"Entrada x(u)",SSReplaceX(f,"(u)")},{"Respuesta h(t-u)",SSReplaceX(g,"(t-u)")},{"Paso numerico",dt},{"Ventana de entrada",{t0,t1}},{"Soporte numerico",{2*t0,2*t1}}},"Suma de Riemann", "La integral mostrada es la definicion. Resultado matematico consulta la forma calculada y los limites de solapamiento. "+nota); END;
  UNTIL 0;
END;

SSConvDFTResults(x,h,y,tipo)
BEGIN
  LOCAL op:=1;
  LOCAL N:=SIZE(y);
  LOCAL imaginaria;
  LOCAL k;
  REPEAT
    op:=SSMenu({"Convolucion por DFT",{3,"Convolucion por DFT",{{"Entrada x",x,0,1},{"Entrada h",h,0,1},{"Salida y",y,0,1},{"Tipo: 1 lineal, 2 circular",tipo}},"N="+STRING(N)+". Valores originales con signo y parte compleja."},6},{"Tabla del resultado","Grafico y[n]: parte real","Resultado matematico","Metodo y teorema","Grafico y[n]: parte imaginaria","Volver"},op);
    IF op==0 OR op==6 THEN RETURN 1; END;
    IF op==1 THEN SSDataView(y,0,1,"Resultado de convolucion","n","y[n]",SSAccent(4)); END;
    IF op==2 THEN SSPlot(y,0,"Salida y[n]: parte real"); END;
    IF op==5 THEN
      imaginaria:=MAKELIST(0,k,1,N,1);
      FOR k FROM 1 TO N DO imaginaria(k):=IM(y(k)); END;
      SSPlot(imaginaria,0,"Salida y[n]: parte imaginaria");
    END;
    IF op==3 THEN
      IF tipo==1 THEN SSResultBrowse("Convolucion lineal","Salida calculada",{{"Salida y[n] completa",y},{"Definicion y(n)","sum(x(k)*h(n-k),k,-infinity,infinity)"}},"n=0..."+STRING(N-1),"La lista es la salida calculada, no su modulo.\n"+SSSeqMath(y,0,"y")); END;
      IF tipo==2 THEN SSResultBrowse("Convolucion circular","Un periodo de salida",{{"Salida yN[n] completa",y},{"Definicion yN(n)","sum(x(k)*h(irem(n-k+N,N)),k,0,N-1)"},{"Longitud N",N}},"n=0..."+STRING(N-1),"Extension periodica de N muestras. En la formula, x y h son las entradas rellenadas; para un periodo 0<=n<N, irem(n-k+N,N) expresa el indice circular."); END;
    END;
    IF op==4 THEN
      IF tipo==1 THEN SSResultBrowse("Teorema de convolucion","Lineal por DFT",{{"Producto Y(k)","X(k)*H(k)"},{"Inversa y(n)","sum(Y(k)*exp(i*2*pi*k*n/N),k,0,N-1)/N"},{"Longitud N",N}},"X y H son DFT de x y h rellenadas a N=Nx+Nh-1.","Formulas de referencia. La salida se calcula por DFT, producto e IDFT."); END;
      IF tipo==2 THEN SSResultBrowse("Teorema circular","Equivalencia DFT",{{"Producto Y(k)","X(k)*H(k)"},{"Inversa yN(n)","sum(Y(k)*exp(i*2*pi*k*n/N),k,0,N-1)/N"},{"Longitud N",N}},"X y H son DFT de las entradas de longitud N.","Formulas de referencia. El calculo circular existente usa la suma con indices modulo N."); END;
    END;
  UNTIL 0;
END;

// ---------- Modulo Senales ----------

SSGenerate(tipo,n0,n1,A,p,q,w)
BEGIN
  LOCAL n;
  LOCAL k;
  LOCAL x:=MAKELIST(0,n,n0,n1,1);
  LOCAL ang;
  FOR n FROM n0 TO n1 DO
    k:=n-n0+1;
    IF tipo==1 AND n==p THEN x(k):=A; END;
    IF tipo==2 AND n>=p THEN x(k):=A; END;
    IF tipo==3 AND n>=p THEN x(k):=A*(n-p); END;
    IF tipo==4 THEN x(k):=A*q^(n-p); END;
    IF tipo==5 THEN ang:=3.141592653589793*(w*(n-p)+q); x(k):=A*SSSinR(ang); END;
    IF tipo==6 AND n>=p AND n<p+q THEN x(k):=A; END;
  END;
  RETURN x;
END;

UIGenerator()
BEGIN
  LOCAL tipo:=1;
  LOCAL n0:=-5;
  LOCAL n1:=5;
  LOCAL N;
  LOCAL A:=1;
  LOCAL p:=0;
  LOCAL q:=0.8;
  LOCAL w:=0.25;
  LOCAL f:="COS(pi*X/4)";
  LOCAL salida;
  tipo:=SSMenu("Generador discreto",{"Impulso","Escalon","Rampa","Exponencial","Seno","Pulso rectangular","Expresion matematica x[n]"},tipo); IF tipo==0 THEN RETURN 0; END;
  IF INPUT(n0,"Intervalo","n inicial=","Indice inicial",-5)==0 THEN RETURN 0; END;
  IF INPUT(n1,"Intervalo","n final=","Indice final",5)==0 THEN RETURN 0; END;
  n0:=FLOOR(n0); n1:=FLOOR(n1);
  IF n1<n0 OR n1-n0+1>1024 THEN SSInfoView("Generador","Intervalo no valido","Use entre 1 y 1024 indices enteros. Este limite se aplica a todos los tipos de senal.",SSAccent(1)); RETURN 0; END;
  IF tipo==7 THEN
    N:=n1-n0+1; IF N>1024 THEN SSInfoView("SignalLab","Aviso","Use como maximo 1024 indices por expresion.",SSAccent(1)); RETURN 0; END;
    IF INPUT(f,"Secuencia por expresion","x[n]=","X es n. Ej: COS(X) o (0.8)^X",f)==0 THEN RETURN 0; END;
    salida:=SSEvalExpr({f,"DISCRETE"},n0,1,N); IF SIZE(salida)==0 THEN RETURN 0; END;
    SSSequenceExprResults(salida,n0,f); RETURN 1;
  END;
  IF INPUT(A,"Amplitud","A=","Amplitud",1)==0 THEN RETURN 0; END;
  IF INPUT(p,"Referencia","p=","Desplazamiento",0)==0 THEN RETURN 0; END;
  p:=FLOOR(p);
  IF tipo==4 THEN IF INPUT(q,"Exponencial","base=","Base a",0.8)==0 THEN RETURN 0; END; END;
  IF tipo==5 THEN
    IF INPUT(w,"Seno","w/pi=","Frecuencia normalizada",0.25)==0 THEN RETURN 0; END;
    IF INPUT(q,"Seno","phi/pi=","Fase normalizada",0)==0 THEN RETURN 0; END;
  END;
  IF tipo==6 THEN IF INPUT(q,"Pulso","ancho=","Cantidad de muestras",3)==0 THEN RETURN 0; END; q:=FLOOR(q); END;
  salida:=SSGenerate(tipo,n0,n1,A,p,q,w);
  SSShow(salida,n0,"Senal generada x[n]"); RETURN 1;
END;

UISampleExpr()
BEGIN
  LOCAL f:="SIN(X)";
  LOCAL t0:=0;
  LOCAL Ts:=0.1;
  LOCAL N:=21;
  LOCAL x;
  LOCAL modo:=1;
  LOCAL tramos:={};
  LOCAL cantidad:=2;
  LOCAL a:=0;
  LOCAL b:=1;
  LOCAL exterior:=0;
  LOCAL expr:="1";
  LOCAL i;
  LOCAL j;
  LOCAL p;
  LOCAL val;
  LOCAL fila;
  LOCAL eventos:={};
  LOCAL e;
  LOCAL pasoTxt:="Ts=";
  LOCAL origenTxt:="t inicial=";
  LOCAL resultado;
  LOCAL editar;
  LOCAL candidato;
  LOCAL nuevosTramos;
  LOCAL elegido;
  LOCAL valido;
  modo:=SSMenu("Expresion o tramos",{"Muestrear expresion x(t)","Tramos continuos x(t)","Tramos discretos x[n]","Volver"},1);
  IF modo==0 OR modo==4 THEN RETURN 0; END;
  IF modo==1 THEN
    IF INPUT(f,"Muestrear x(t)","x(t)=","X tiempo; sinc: SIN(pi*X)/(pi*X)",f)==0 THEN RETURN 0; END;
  ELSE
    SSInfoView("Senal por tramos","Intervalos [a,b)","Ingrese de 1 a 8 tramos ordenados, sin superposicion. Cada tramo incluye a y excluye b; si se tocan, el punto comun pertenece al tramo derecho. Huecos y exterior usan un valor constante. X es t en continuo o n en discreto. Ejemplo: [0,1): X; [1,2): 2-X; exterior 0. Se evalua solo la expresion activa, no productos por escalones.",SSAccent(1));
    IF INPUT(cantidad,"Cantidad de tramos","Tramos=","Entero de 1 a 8",cantidad)==0 THEN RETURN 0; END;
    IF TYPE(cantidad)<>0 THEN SSInfoView("SignalLab","Aviso","Ingrese un entero real.",SSAccent(1)); RETURN 0; END;
    IF cantidad<>FLOOR(cantidad) OR cantidad<1 OR cantidad>8 THEN SSInfoView("SignalLab","Aviso","Use entre 1 y 8 tramos.",SSAccent(1)); RETURN 0; END;
    IF INPUT(exterior,"Fuera de los tramos","Valor=","Constante real; incluye los huecos",0)==0 THEN RETURN 0; END;
    IF TYPE(exterior)<>0 THEN SSInfoView("SignalLab","Aviso","El exterior debe ser real.",SSAccent(1)); RETURN 0; END;
    IF ABS(exterior)>1E100 THEN SSInfoView("SignalLab","Aviso","Use |valor| <= 1E100.",SSAccent(1)); RETURN 0; END;
    f:="TRAMOS: X=t; intervalos [a,b).";
    IF modo==3 THEN f:="TRAMOS: X=n entero; intervalos [a,b)."; END;
    FOR i FROM 1 TO cantidad DO
      a:=b; IF i==1 THEN a:=0; END;
      IF INPUT(a,"Tramo "+STRING(i),"Desde a=","Incluido. Orden ascendente, sin solapar",a)==0 THEN RETURN 0; END;
      IF TYPE(a)<>0 THEN SSInfoView("SignalLab","Aviso","El extremo debe ser real.",SSAccent(1)); RETURN 0; END;
      IF ABS(a)>1E12 THEN SSInfoView("SignalLab","Aviso","Use extremos de magnitud <= 1E12.",SSAccent(1)); RETURN 0; END;
      IF i>1 AND a<b THEN SSInfoView("SignalLab","Aviso","Los tramos no deben superponerse.",SSAccent(1)); RETURN 0; END;
      b:=a+1;
      IF INPUT(b,"Tramo "+STRING(i),"Hasta b=","Excluido: b > a",b)==0 THEN RETURN 0; END;
      IF TYPE(b)<>0 THEN SSInfoView("SignalLab","Aviso","El extremo debe ser real.",SSAccent(1)); RETURN 0; END;
      IF b<=a OR ABS(b)>1E12 THEN SSInfoView("SignalLab","Aviso","Use b > a y |b| <= 1E12.",SSAccent(1)); RETURN 0; END;
      IF modo==3 THEN IF a<>FLOOR(a) OR b<>FLOOR(b) THEN SSInfoView("SignalLab","Aviso","En discreto use extremos enteros.",SSAccent(1)); RETURN 0; END; END;
      IF INPUT(expr,"Expresion del tramo "+STRING(i),"Formula=","X es t o n. Ej: X, 2-X, EXP(-X)",expr)==0 THEN RETURN 0; END;
      IF DIM(expr)==0 OR DIM(expr)>256 THEN SSInfoView("SignalLab","Aviso","Use una expresion de 1 a 256 caracteres.",SSAccent(1)); RETURN 0; END;
      tramos:=CONCAT(tramos,{{a,b,expr}});
      f:=f+"\n["+STRING(a)+","+STRING(b)+"): "+expr;
    END;
    f:=f+"\nHuecos y exterior: "+STRING(exterior)+". No se supone periodicidad.";
    SSInfoView("Revisar definicion","Antes de generar muestras",f,SSAccent(1));
  END;
  IF modo==3 THEN Ts:=1; origenTxt:="n inicial="; END;
  IF INPUT(t0,"Ventana de la senal",origenTxt,"Primera coordenada a calcular",t0)==0 THEN RETURN 0; END;
  IF TYPE(t0)<>0 THEN SSInfoView("SignalLab","Aviso","El origen debe ser real.",SSAccent(1)); RETURN 0; END;
  IF ABS(t0)>1E12 THEN SSInfoView("SignalLab","Aviso","Use |origen| <= 1E12.",SSAccent(1)); RETURN 0; END;
  IF modo==3 THEN
    IF t0<>FLOOR(t0) THEN SSInfoView("SignalLab","Aviso","Use un indice inicial entero.",SSAccent(1)); RETURN 0; END;
  ELSE
    IF INPUT(Ts,"Paso temporal",pasoTxt,"Separacion real entre muestras",Ts)==0 THEN RETURN 0; END;
    IF TYPE(Ts)<>0 THEN SSInfoView("SignalLab","Aviso","Ts debe ser real.",SSAccent(1)); RETURN 0; END;
    IF Ts<=0 OR Ts>1E12 THEN SSInfoView("SignalLab","Aviso","Use 0 < Ts <= 1E12.",SSAccent(1)); RETURN 0; END;
  END;
  IF INPUT(N,"Ventana de la senal","Muestras N=","1...1024; no cambia Ts; mas N tarda mas",N)==0 THEN RETURN 0; END;
  IF TYPE(N)<>0 THEN SSInfoView("SignalLab","Aviso","N debe ser un entero real.",SSAccent(1)); RETURN 0; END;
  IF N<>FLOOR(N) OR N<1 OR N>1024 THEN SSInfoView("SignalLab","Aviso","Use un entero de 1 a 1024.",SSAccent(1)); RETURN 0; END;
  IF N>1 AND t0+Ts==t0 THEN SSInfoView("SignalLab","Aviso","Paso demasiado pequeno para este origen.",SSAccent(1)); RETURN 0; END;
  REPEAT
  eventos:={};
  IF modo>1 THEN
    f:="TRAMOS: X=t; intervalos [a,b).";
    IF modo==3 THEN f:="TRAMOS: X=n entero; intervalos [a,b)."; END;
    FOR i FROM 1 TO SIZE(tramos) DO fila:=tramos(i); f:=f+"\n["+STRING(fila(1))+","+STRING(fila(2))+"): "+fila(3); END;
    f:=f+"\nHuecos y exterior: "+STRING(exterior)+". No se supone periodicidad.";
  END;
  IF modo==1 THEN x:=SSEvalExpr(f,t0,Ts,N);
  ELSE
    x:=MAKELIST(exterior,i,1,N,1);
    FOR i FROM 1 TO N DO
      p:=t0+(i-1)*Ts;
      FOR j FROM 1 TO SIZE(tramos) DO
        fila:=tramos(j);
        IF p>=fila(1) AND p<fila(2) THEN
          IF modo==3 THEN val:=SSEvalExpr({fila(3),"DISCRETE"},p,Ts,1);
          ELSE val:=SSEvalExpr(fila(3),p,Ts,1); END;
          IF SIZE(val)==0 THEN RETURN 0; END;
          x(i):=val(1);
          FOR a FROM 1 TO SIZE(SSEVAL_EVENTS) DO
            e:=SSEVAL_EVENTS(a); e(1):=i; eventos:=CONCAT(eventos,{e});
          END;
        END;
      END;
    END;
    SSEVAL_EVENTS:=eventos;
  END;
  IF SIZE(x)==0 THEN RETURN 0; END;
  IF modo==3 THEN resultado:=SSSequenceExprResults(x,t0,f);
  ELSE resultado:=SSSampleResults(x,t0,Ts,f); END;
  IF resultado==2 THEN
    editar:=SSMenu("Editar senal sin recargar",{"Expresion o un tramo","Origen de la ventana","Paso Ts (continuo)","Cantidad de puntos N","Valor exterior (tramos)","Volver al resultado"},1);
    candidato:={f,t0,Ts,N,exterior}; nuevosTramos:=tramos; valido:=0;
    IF editar==1 THEN
      IF modo==1 THEN
        expr:=f; IF INPUT(expr,"Editar expresion","x(t)=","X representa t",expr) THEN candidato(1):=expr; valido:=1; END;
      ELSE
        elegido:=1;
        IF INPUT(elegido,"Elegir tramo","Tramo=","Numero de 1 a "+STRING(SIZE(tramos)),1) THEN
          IF TYPE(elegido)==0 THEN
            IF elegido==FLOOR(elegido) AND elegido>=1 AND elegido<=SIZE(tramos) THEN
              fila:=tramos(elegido); a:=fila(1); b:=fila(2); expr:=fila(3);
              IF INPUT(a,"Editar tramo","a incluido=","Conserva los otros tramos",a) THEN
                IF INPUT(b,"Editar tramo","b excluido=","Debe ser mayor que a",b) THEN
                  IF INPUT(expr,"Editar tramo","Formula=","X es t o n",expr) THEN nuevosTramos(elegido):={a,b,expr}; valido:=1; END;
                END;
              END;
            END;
          END;
        END;
      END;
    END;
    IF editar==2 THEN p:=t0; IF INPUT(p,"Editar origen",origenTxt,"Conserva la definicion de la senal",p) THEN candidato(2):=p; valido:=1; END; END;
    IF editar==3 THEN
      IF modo==3 THEN SSInfoView("SignalLab","Aviso","En discreto el paso sigue siendo 1.",SSAccent(1));
      ELSE p:=Ts; IF INPUT(p,"Editar muestreo","Ts=","N no cambia; cambia la ventana temporal",p) THEN candidato(3):=p; valido:=1; END; END;
    END;
    IF editar==4 THEN p:=N; IF INPUT(p,"Editar ventana","N=","Entero de 1 a 1024",p) THEN candidato(4):=p; valido:=1; END; END;
    IF editar==5 THEN
      IF modo==1 THEN SSInfoView("SignalLab","Aviso","El exterior solo se usa en tramos.",SSAccent(1));
      ELSE p:=exterior; IF INPUT(p,"Editar exterior","Valor=","Constante para huecos y exterior",p) THEN candidato(5):=p; valido:=1; END; END;
    END;
    IF valido==1 THEN
      FOR i FROM 2 TO 5 DO IF TYPE(candidato(i))<>0 THEN valido:=0; END; END;
      IF valido==1 THEN
        IF ABS(candidato(2))>1E12 OR candidato(3)<=0 OR candidato(3)>1E12 OR candidato(4)<1 OR candidato(4)>1024 OR candidato(4)<>FLOOR(candidato(4)) OR ABS(candidato(5))>1E100 THEN valido:=0; END;
        IF modo==3 AND candidato(2)<>FLOOR(candidato(2)) THEN valido:=0; END;
        IF candidato(4)>1 AND candidato(2)+candidato(3)==candidato(2) THEN valido:=0; END;
      END;
      IF modo==1 AND DIM(candidato(1))==0 THEN valido:=0; END;
      FOR i FROM 1 TO SIZE(nuevosTramos) DO
        fila:=nuevosTramos(i);
        IF TYPE(fila(1))<>0 OR TYPE(fila(2))<>0 THEN valido:=0;
        ELSE
          IF fila(2)<=fila(1) OR MAX(ABS(fila(1)),ABS(fila(2)))>1E12 THEN valido:=0; END;
          IF modo==3 THEN IF fila(1)<>FLOOR(fila(1)) OR fila(2)<>FLOOR(fila(2)) THEN valido:=0; END; END;
          IF i>1 THEN e:=nuevosTramos(i-1); IF TYPE(e(2))==0 THEN IF fila(1)<e(2) THEN valido:=0; END; END; END;
        END;
        IF DIM(fila(3))==0 OR DIM(fila(3))>256 THEN valido:=0; END;
      END;
      IF valido==1 THEN f:=candidato(1); t0:=candidato(2); Ts:=candidato(3); N:=candidato(4); exterior:=candidato(5); tramos:=nuevosTramos;
      ELSE SSInfoView("SignalLab","Aviso","Cambio invalido. Se conservan la definicion y parametros anteriores.",SSAccent(1)); END;
    END;
  END;
  UNTIL resultado<>2;
  RETURN 1;
END;

UITransformSignal()
BEGIN
  LOCAL x:={1,2,3};
  LOCAL nx:=0;
  LOCAL op:=1;
  LOCAL k:=1;
  LOCAL h:={1,1};
  LOCAL r;
  LOCAL n0;
  LOCAL idx;
  x:=SSReadList("Transformar","x=","Lista",x); IF SIZE(x)==0 THEN RETURN 0; END;
  nx:=SSReadOrigin(0);
  IF SSReadStep(1)<>1 THEN SSInfoView("Secuencia discreta","Operacion sobre indices n","El eje importado no tiene paso 1. Se trabajara sobre n local desde 0, sin cambiar las muestras ni el banco.",SSAccent(1)); nx:=0; END;
  IF INPUT(nx,"Transformar","n inicial=","Indice de x(1)",nx)==0 THEN RETURN 0; END; nx:=FLOOR(nx);
  op:=SSMenu("Operacion con secuencias",{"Desplazar x[n-k]","Invertir x[-n]","Escalar amplitud","Sumar otra senal","Partes par e impar"},op); IF op==0 THEN RETURN 0; END;
  IF op==1 THEN IF INPUT(k,"Desplazar","k=","Derecha si k>0",1)==0 THEN RETURN 0; END; r:=x; n0:=nx+FLOOR(k); END;
  IF op==2 THEN r:=SSReverse(x); n0:=-(nx+SIZE(x)-1); END;
  IF op==3 THEN
    IF INPUT(k,"Escalar","c=","Factor",2)==0 THEN RETURN 0; END;
    IF SSIsDrawable(k)==0 THEN RETURN 0; END;
    r:=x; n0:=nx;
    FOR idx FROM 1 TO SIZE(x) DO
      IF SSIsDrawable(x(idx)) THEN IFERR r(idx):=k*x(idx); IF SSIsDrawable(r(idx))==0 THEN r(idx):=SSUndef(); END; THEN r(idx):=SSUndef(); END;
      ELSE r(idx):=SSUndef(); END;
    END;
  END;
  IF op==4 THEN
    h:=SSReadList("Suma","h=","Segunda lista",h); IF SIZE(h)==0 THEN RETURN 0; END;
    IF INPUT(k,"Suma","n inicial h=","Indice de h(1)",0)==0 THEN RETURN 0; END;
    r:=SSAdd(x,nx,h,FLOOR(k)); IF SIZE(r)==0 THEN RETURN 0; END; n0:=r(2); r:=r(1);
  END;
  IF op==5 THEN
    r:=SSEvenOdd(x,nx); IF SIZE(r)==0 THEN RETURN 0; END;
    REPEAT
      op:=SSMenu({"Descomposicion par / impar",{3,"Descomposicion par / impar",{{"Entrada x",x,nx,1},{"Parte par",r(1),r(3),1},{"Parte impar",r(2),r(3),1}},"Descomposicion x[n]=xe[n]+xo[n]."},4},{"Parte par","Parte impar","Entrada original","Volver"},1);
      IF op==0 OR op==4 THEN RETURN 1; END;
      IF op==1 THEN SSShow(r(1),r(3),"Parte par"); END;
      IF op==2 THEN SSShow(r(2),r(3),"Parte impar"); END;
      IF op==3 THEN SSShow(x,nx,"Entrada original"); END;
    UNTIL 0;
  END;
  SSShow(r,n0,"Secuencia transformada"); RETURN 1;
END;

SSDensity(x)
BEGIN
  LOCAL k;
  LOCAL y:=MAKELIST(0,k,1,SIZE(x),1);
  FOR k FROM 1 TO SIZE(x) DO
    IF x(k)==SSUndef() THEN y(k):=SSUndef();
    ELSE
      IF SSIsSpecial(x(k)) THEN y(k):=SSPosInf();
      ELSE IF SSIsDrawable(x(k)) THEN IFERR y(k):=ABS(x(k))^2; THEN y(k):=SSUndef(); END; ELSE y(k):=SSUndef(); END; END;
    END;
  END;
  RETURN y;
END;

SSTrapEnergy(densidad,dt)
BEGIN
  LOCAL k;
  LOCAL e:=0;
  LOCAL N:=SIZE(densidad);
  IF N<2 THEN RETURN 0; END;
  FOR k FROM 1 TO N DO
    IF densidad(k)==SSUndef() THEN RETURN SSUndef(); END;
    IF SSIsSpecial(densidad(k))==0 AND SSIsDrawable(densidad(k))==0 THEN RETURN SSUndef(); END;
  END;
  FOR k FROM 1 TO N DO IF SSIsSpecial(densidad(k)) THEN RETURN SSPosInf(); END; END;
  e:=(densidad(1)+densidad(N))/2;
  FOR k FROM 2 TO N-1 DO e:=e+densidad(k); END;
  RETURN e*dt;
END;

SSMeasureResults(x,densidad,x0,dx,f,dominio,energia,potencia,rms,exacta,periodo)
BEGIN
  LOCAL op:=1;
  LOCAL discreta:=dominio==1;
  LOCAL variable:="t";
  LOCAL nombre:="x(t)";
  LOCAL intervalo;
  LOCAL fv;
  LOCAL ecmd;
  LOCAL pcmd;
  LOCAL wcmd;
  LOCAL etxt:="";
  LOCAL ptxt:="";
  LOCAL wtxt:=exacta;
  LOCAL ev:=SSUndef();
  LOCAL pv:=SSUndef();
  LOCAL wv:=SSUndef();
  LOCAL textos;
  LOCAL valores;
  LOCAL prueba;
  LOCAL ntxt;
  LOCAL cerrado;
  LOCAL j;
  LOCAL k;
  LOCAL estado;
  LOCAL metodo:="CAS sobre todo el eje.";
  LOCAL pasos:={};
  LOCAL raices:={};
  LOCAL pos:=1;
  LOCAL ini;
  LOCAL fin;
  LOCAL depth;
  LOCAL arg;
  LOCAL pendiente;
  LOCAL pendienteTxt;
  LOCAL raiz;
  LOCAL raizTxt;
  LOCAL datos;
  LOCAL valido:=1;
  LOCAL pieza;
  LOCAL punto;
  LOCAL izq;
  LOCAL der;
  LOCAL li;
  LOCAL ls;
  LOCAL liTxt;
  LOCAL lsTxt;
  LOCAL aTxt;
  LOCAL bTxt;
  LOCAL total;
  LOCAL ventana;
  LOCAL particion:=0;
  LOCAL integral;
  LOCAL calculado:=0;
  LOCAL etapa:="Preparar consulta";
  LOCAL x1:=x0+(SIZE(x)-1)*dx;
  IF discreta THEN variable:="n"; nombre:="x[n]"; END;
  intervalo:=variable+"="+STRING(x0)+"..."+STRING(x1);
  fv:=SSReplaceX(f,"(slenergyaxis)");
  IF discreta AND f<>"Lista finita ingresada" THEN
    fv:=SSDiracApprox(fv,-2);
    IF fv=="" THEN SSInfoView("Energia discreta","Expresion no valida","No se pudo construir la expresion discreta para el CAS.",SSAccent(1)); RETURN 0; END;
  END;
  metodo:="Consulta global no solicitada. Las medidas de ventana no son energia total ni potencia global.";
  estado:="Elija Energia y potencia global para consultar el CAS. Las tablas no requieren esa consulta.";
  ecmd:=""; pcmd:=""; wcmd:="";
  REPEAT
    IF SIZE(x)==0 THEN
      op:=SSMenu({"Energia teorica",{3,"Energia teorica",{{"Expresion",f},{"Energia global consultada",etxt},{"Potencia global consultada",ptxt},{"RMS global consultado",wtxt}},metodo+"\n"+estado+"\nDominio="+nombre},3},{"Calcular E y P global","Entrada y alcance","Volver"},1);
      IF op==0 OR op==3 THEN RETURN 1; END;
      IF op==2 THEN SSInfoView("Energia teorica","Expresion y dominio",f+"\n"+nombre+" sobre todo el eje. Se requiere convergencia. Una operacion pendiente no es cero.",SSAccent(1)); END;
    ELSE
      op:=SSMenu({"Resultados de energia",{3,"Resultados de energia",{{"Senal",x,x0,dx},{"Densidad temporal",densidad,x0,dx},{"Expresion",f},{"Energia global consultada",etxt},{"Potencia global consultada",ptxt},{"Energia de ventana",energia},{"Potencia de ventana",potencia},{"RMS de ventana",rms}},metodo+"\n"+estado+"\n"+intervalo},9},{"Energia y potencia global","Tabla de la senal","Tabla de |x|^2","Grafico de la senal","Grafico de |x|^2","Expresion y planteos","Medidas de ventana","Metodo y limites","Volver"},op);
      IF op==0 OR op==9 THEN RETURN 1; END;
    END;
    IF op==1 AND calculado==0 THEN
    etapa:="Preparar variables CAS";
    IFERR
  IF f<>"Lista finita ingresada" THEN
    prueba:=SSCASString("slenergyaxis"); ntxt:=SSCASString("slenergybound");
    IF (prueba<>"" AND prueba<>"slenergyaxis") OR (ntxt<>"" AND ntxt<>"slenergybound") THEN
      SSInfoView("Variables del calculo","Asignaciones CAS detectadas","slenergyaxis y slenergybound deben estar libres para este calculo. No se borraron sus definiciones. Se conservan el resultado y las medidas de ventana.",SSAccent(1)); CONTINUE;
    END;
  END;
  IF discreta THEN
    ecmd:="simplify(sum(abs(("+fv+"))^2,slenergyaxis,-infinity,infinity))";
    pcmd:="simplify(limit(sum(abs(("+fv+"))^2,slenergyaxis,-slenergybound,slenergybound)/(2*slenergybound+1),slenergybound,infinity))";
    wcmd:="simplify(sum(abs(("+fv+"))^2,slenergyaxis,"+STRING(x0,1,12,{3,".E-",0})+","+STRING(x1,1,12,{3,".E-",0})+"))";
  ELSE
    ecmd:="simplify(int(abs(("+fv+"))^2,slenergyaxis,-infinity,infinity))";
    pcmd:="simplify(limit(int(abs(("+fv+"))^2,slenergyaxis,-slenergybound,slenergybound)/(2*slenergybound),slenergybound,infinity))";
    wcmd:="simplify(int(abs(("+fv+"))^2,slenergyaxis,"+STRING(x0,1,12,{3,".E-",0})+","+STRING(x1,1,12,{3,".E-",0})+"))";
  END;
  SSHeader("Energia y potencia","Calculando medidas simbolicas...",SSAccent(1));
  etapa:="Energia total e integral de ventana";
  IF f=="Lista finita ingresada" THEN
    etxt:=STRING(energia,1,12,{3,".E-",0}); wtxt:=etxt;
    IF energia==SSUndef() THEN etxt:="undef"; wtxt:="undef"; END;
    IF energia==SSPosInf() THEN etxt:="infinity"; wtxt:="infinity"; END;
    ecmd:=etxt; wcmd:=etxt; pcmd:="undef";
    IF SSIsDrawable(energia) THEN pcmd:="0"; END;
    metodo:="Lista finita: se supone cero fuera de los indices ingresados. No se supone repeticion periodica.";
  ELSE
    // Separar todos los escalones afines, no reconocer ejemplos particulares.
    // En continuo el valor aislado en cada salto no cambia una integral ordinaria.
    IF discreta==0 AND INSTRING(UPPER(fv),"HEAVISIDE(")>0 AND INSTRING(UPPER(fv),"DIRAC(")==0 THEN
      WHILE pos<=DIM(fv) AND valido==1 DO
        ini:=INSTRING(UPPER(MID(fv,pos,DIM(fv)-pos+1)),"HEAVISIDE(");
        IF ini==0 THEN BREAK; END;
        ini:=ini+pos-1;
        IF ini>1 THEN
          IF INSTRING("ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_",UPPER(MID(fv,ini-1,1)))>0 THEN valido:=0; BREAK; END;
        END;
        fin:=ini+10; depth:=1;
        WHILE fin<=DIM(fv) AND depth>0 DO
          IF MID(fv,fin,1)=="(" THEN depth:=depth+1; END;
          IF MID(fv,fin,1)==")" THEN depth:=depth-1; END;
          fin:=fin+1;
        END;
        IF depth<>0 OR SIZE(pasos)>=16 THEN valido:=0; BREAK; END;
        arg:=MID(fv,ini+10,fin-ini-11);
        pendienteTxt:=SSCASString("simplify(diff(("+arg+"),slenergyaxis))");
        IF SSCASString("simplify(diff(("+arg+"),slenergyaxis,2))")<>"0" THEN valido:=0; BREAK; END;
        IFERR
          pendiente:=EXPR(SSCASString("evalf("+pendienteTxt+")"))+0.0;
          raizTxt:=SSCASString("simplify(-subst(("+arg+"),slenergyaxis=0)/("+pendienteTxt+"))");
          raiz:=EXPR(SSCASString("evalf("+raizTxt+")"))+0.0;
          IF TYPE(pendiente)<>0 OR TYPE(raiz)<>0 THEN valido:=0;
          ELSE IF pendiente==0 OR SSIsDrawable(pendiente)==0 OR ABS(raiz)>1E12 THEN valido:=0; END; END;
        THEN valido:=0; END;
        IF valido==1 THEN
          FOR j FROM 1 TO SIZE(pasos) DO
            datos:=pasos(j);
            IF datos(3)==raiz THEN
              IF SSCASString("simplify(("+datos(5)+")-("+raizTxt+"))")<>"0" THEN valido:=0; END;
            END;
          END;
        END;
        IF valido==1 THEN
          pasos:=CONCAT(pasos,{{ini,fin-ini,raiz,pendiente,raizTxt}});
          raices:=CONCAT(raices,{raiz}); pos:=fin;
        END;
      END;
      IF valido==1 AND SIZE(pasos)>0 THEN
        particion:=1;
        raices:=SORT(raices); total:="0"; ventana:="0";
        FOR k FROM 0 TO SIZE(raices) DO
          IF k==0 THEN izq:=-1E99; liTxt:="-infinity"; ELSE izq:=raices(k); END;
          IF k==SIZE(raices) THEN der:=1E99; lsTxt:="infinity"; ELSE der:=raices(k+1); END;
          IF izq<der THEN
            IF k==0 THEN punto:=der-MAX(1,ABS(der)/2);
            ELSE IF k==SIZE(raices) THEN punto:=izq+MAX(1,ABS(izq)/2);
            ELSE punto:=izq/2+der/2; END; END;
            pieza:=""; pos:=1;
            FOR j FROM 1 TO SIZE(pasos) DO
              datos:=pasos(j);
              IF datos(1)>pos THEN pieza:=pieza+MID(fv,pos,datos(1)-pos); END;
              IF datos(4)*(punto-datos(3))>0 THEN pieza:=pieza+"(1)"; ELSE pieza:=pieza+"(0)"; END;
              pos:=datos(1)+datos(2);
              IF k>0 AND datos(3)==izq THEN liTxt:=datos(5); END;
              IF k<SIZE(raices) AND datos(3)==der THEN lsTxt:=datos(5); END;
            END;
            IF pos<=DIM(fv) THEN pieza:=pieza+MID(fv,pos,DIM(fv)-pos+1); END;
            integral:="int(abs(simplify("+pieza+"))^2,slenergyaxis,"+liTxt+","+lsTxt+")";
            IFERR integral:=STRING(CAS.int("abs(simplify("+pieza+"))^2","slenergyaxis",liTxt,lsTxt)); THEN integral:=integral; END;
            total:=total+"+("+integral+")";
            IF SIZE(x)>1 THEN
              li:=MAX(izq,x0); ls:=MIN(der,x1);
              IF li<ls THEN
                aTxt:=liTxt; bTxt:=lsTxt;
                IF li==x0 THEN aTxt:=STRING(x0,1,12,{3,".E-",0}); END;
                IF ls==x1 THEN bTxt:=STRING(x1,1,12,{3,".E-",0}); END;
                integral:="int(abs(simplify("+pieza+"))^2,slenergyaxis,"+aTxt+","+bTxt+")";
                IFERR integral:=STRING(CAS.int("abs(simplify("+pieza+"))^2","slenergyaxis",aTxt,bTxt)); THEN integral:=integral; END;
                ventana:=ventana+"+("+integral+")";
              END;
            END;
          END;
        END;
        ecmd:="simplify("+total+")"; wcmd:="simplify("+ventana+")";
        metodo:="CAS por intervalos definidos por todos los escalones afines (hasta 16). Los extremos se conservan simbolicos; no se integra una malla.";
      END;
    END;
    IF discreta==0 AND INSTRING(UPPER(fv),"DIRAC(")>0 THEN
      metodo:="Una Dirac ideal no es una funcion ordinaria de energia cuadratica. No se asigna energia finita a una aproximacion gaussiana.";
    ELSE
      IF particion==0 THEN
        IFERR
          IF discreta THEN etxt:=STRING(CAS.sum("abs(("+fv+"))^2","slenergyaxis","-infinity","infinity"));
          ELSE etxt:=STRING(CAS.int("abs(("+fv+"))^2","slenergyaxis","-infinity","infinity")); END;
        THEN etxt:=""; END;
        IF SIZE(x)>0 THEN
          aTxt:=STRING(x0,1,12,{3,".E-",0}); bTxt:=STRING(x1,1,12,{3,".E-",0});
          IFERR
            IF discreta THEN wtxt:=STRING(CAS.sum("abs(("+fv+"))^2","slenergyaxis",aTxt,bTxt));
            ELSE wtxt:=STRING(CAS.int("abs(("+fv+"))^2","slenergyaxis",aTxt,bTxt)); END;
          THEN wtxt:=""; END;
        END;
      END;
      IF etxt=="" THEN etxt:=SSCASString(ecmd); END;
      IF SIZE(x)>0 AND wtxt=="" THEN wtxt:=SSCASString(wcmd); END;
    END;
  END;
  // Aceptar solo respuestas cerradas y escalares reales no negativos.
  // Una integral/suma pendiente o un parametro libre nunca habilita E finita => P=0.
  textos:={etxt,"",wtxt}; valores:={SSUndef(),SSUndef(),SSUndef()};
  etapa:="Interpretar resultado de energia";
  FOR j FROM 1 TO 3 DO
    prueba:=textos(j); cerrado:=DIM(prueba)>0;
    IF f=="Lista finita ingresada" THEN
      IF j<>2 AND SSIsDrawable(energia) THEN valores(j):=energia; END;
    ELSE
    IF INSTRING(UPPER(prueba),"INT(")>0 OR INSTRING(UPPER(prueba),"SUM(")>0 OR INSTRING(UPPER(prueba),"LIMIT(")>0 OR INSTRING(prueba,CHAR(8747))>0 OR INSTRING(prueba,CHAR(8721))>0 THEN cerrado:=0; END;
    IF cerrado==1 THEN
      IFERR
        ntxt:=SSCASString("evalf("+prueba+")");
        valores(j):=EXPR(ntxt)+0.0;
        IF TYPE(valores(j))<>0 THEN valores(j):=SSUndef();
        ELSE IF SSIsDrawable(valores(j))==0 OR valores(j)<0 THEN valores(j):=SSUndef(); END; END;
      THEN valores(j):=SSUndef(); END;
    END;
    END;
  END;
  ev:=valores(1); wv:=valores(3);
  IF SSIsDrawable(ev) THEN
    ptxt:="0"; pv:=0; estado:="Energia total finita: la potencia media sobre todo el eje es 0.";
  ELSE
    etapa:="Potencia media: limite global";
    IF discreta OR INSTRING(UPPER(fv),"DIRAC(")==0 THEN
      ptxt:=SSCASString(pcmd);
      IFERR
        prueba:=UPPER(ptxt);
        IF DIM(prueba)>0 AND INSTRING(prueba,"LIMIT(")==0 AND INSTRING(prueba,"INT(")==0 AND INSTRING(prueba,"SUM(")==0 AND INSTRING(prueba,CHAR(8747))==0 AND INSTRING(prueba,CHAR(8721))==0 THEN
          pv:=EXPR(SSCASString("evalf("+ptxt+")"))+0.0;
          IF TYPE(pv)<>0 THEN pv:=SSUndef(); ELSE IF SSIsDrawable(pv)==0 OR pv<0 THEN pv:=SSUndef(); END; END;
        END;
      THEN pv:=SSUndef(); END;
    END;
    estado:="No se certifico energia total finita. No se deduce P a partir de una ventana ni de una energia pendiente.";
  END;
  IF SSIsDrawable(ev)==0 THEN
    IF UPPER(etxt)=="INFINITY" OR UPPER(etxt)=="+INFINITY" OR etxt==CHAR(8734) THEN etxt:="infinity";
    ELSE etxt:="Pendiente o no definido. Consulte el planteo CAS."; END;
  END;
  IF SSIsDrawable(pv)==0 THEN
    IF UPPER(ptxt)=="INFINITY" OR UPPER(ptxt)=="+INFINITY" OR ptxt==CHAR(8734) THEN ptxt:="infinity";
    ELSE ptxt:="Pendiente o no definido. No se sustituye por P de ventana."; END;
  END;
  IF SSIsDrawable(pv) THEN
    IF pv>0 THEN etxt:="infinity"; estado:="Potencia media positiva: la energia total diverge."; END;
  END;
    calculado:=1;
    THEN
      etxt:="Pendiente: fallo durante "+etapa; ptxt:="Pendiente: no se deduce de la ventana";
      ev:=SSUndef(); pv:=SSUndef(); wv:=SSUndef();
      calculado:=-1; estado:="Fallo recuperable durante: "+etapa+". No se reemplazo por cero. Tablas y medidas numericas siguen disponibles. Para reintentar vuelva a cargar la entrada.";
      SSInfoView("Analisis energetico","Consulta no completada",estado,SSAccent(1));
    END;
    END;
    IF op==1 AND calculado<>0 THEN SSResultBrowse("Energia y potencia global","Dominio completo",{{"Energia total E",etxt},{"Potencia media P",ptxt}},f,metodo+"\n"+estado); END;
    IF SIZE(x)>0 THEN
    IF op==2 THEN SSDataView(x,x0,dx,nombre,variable,nombre,SSAccent(1)); END;
    IF op==3 THEN SSDataView(densidad,x0,dx,"Densidad de energia",variable,"|x|^2",SSAccent(1)); END;
    IF op==4 THEN IF discreta THEN SSPlot(x,x0,"Senal discreta"); ELSE SSPlotXY(x,x0,dx,"Senal continua","Muestras de ventana"); END; END;
    IF op==5 THEN IF discreta THEN SSPlot(densidad,x0,"Densidad |x|^2"); ELSE SSPlotXY(densidad,x0,dx,"Densidad |x|^2","Muestras de ventana"); END; END;
    IF op==6 THEN
      IF calculado==0 THEN SSInfoView("Planteos energeticos","Entrada y definiciones",f+"\nE=sum o integral de |x|^2 sobre todo el eje. P es su promedio temporal en el limite. La consulta CAS se inicia desde Energia y potencia global.",SSAccent(1));
      ELSE SSResultBrowse("Planteos energeticos","Definiciones y entrada",{{"Entrada",f},{"Energia global",ecmd},{"Potencia global",pcmd},{"Energia de ventana",wcmd}},intervalo,"Son operaciones planteadas, no certificados de convergencia. Consulte los resultados por separado."); END;
    END;
    IF op==7 THEN
      IF discreta==0 AND INSTRING(UPPER(fv),"DIRAC(")>0 THEN
        SSInfoView("Energia de Dirac","No es una energia ordinaria","El cuadrado de una Dirac ideal no define esta integral de energia. La energia de una gaussiana aproximante depende de su ancho y no se informa como energia de la Dirac.",SSAccent(1));
      ELSE IF SSIsDrawable(wv) THEN
        aTxt:=STRING(SIZE(x),1,12,{3,".E-",0});
        IF discreta==0 THEN aTxt:=STRING(x1-x0,1,12,{3,".E-",0}); END;
        SSResultBrowse("Ventana - resultado CAS","No es potencia global",{{"Energia de ventana",wtxt},{"Potencia de ventana","("+wtxt+")/("+aTxt+")"},{"RMS de ventana","sqrt(("+wtxt+")/("+aTxt+"))"}},intervalo,"Se prioriza el resultado simbolico cerrado. P ventana=E ventana/duracion (o cantidad de indices).");
      ELSE
        SSResultBrowse("Ventana - aproximacion","CAS no solicitado, pendiente o no disponible",{{"Energia numerica",energia},{"Potencia de ventana",potencia},{"RMS de ventana",rms}},intervalo,"Solo medidas del registro. En continuo usa trapecios y depende de N y de los saltos. No equivale a energia total ni demuestra convergencia. La consulta global se solicita por separado.");
      END; END;
    END;
    IF op==8 THEN SSInfoView("Metodo energetico","Dominio y precision",metodo+"\n\n"+estado+"\n\nLa ventana solo controla tablas, graficos y medidas locales. Use variables simbolicas libres en CAS; no se borran asignaciones ni se cambian ajustes. Un resultado numerico finito no certifica condiciones omitidas por el CAS.",SSAccent(1)); END;
    END;
  UNTIL 0;
END;

UISignalMeasuresList()
BEGIN
  LOCAL x:={1,-2,2};
  LOCAL n0:=0;
  LOCAL d;
  LOCAL e;
  LOCAL p;
  LOCAL per;
  LOCAL rms;
  x:=SSReadList("Energia discreta","x=","Lista finita",x); IF SIZE(x)==0 THEN RETURN 0; END;
  n0:=SSReadOrigin(0); IF SSReadStep(1)<>1 THEN n0:=0; END;
  IF INPUT(n0,"Indices de la secuencia","n inicial=","Indice entero de x(1), no tiempo",n0)==0 THEN RETURN 0; END;
  IF TYPE(n0)<>0 THEN SSInfoView("Energia discreta","Indice no real","Ingrese un indice entero real, no lista, texto ni complejo.",SSAccent(1)); RETURN 0; END;
  IF SSIsDrawable(n0)==0 THEN SSInfoView("Energia discreta","Indice fuera de rango","Use n inicial entero, de magnitud <=1E12.",SSAccent(1)); RETURN 0; END;
  IF n0<>FLOOR(n0) OR ABS(n0)>1E12 THEN SSInfoView("Energia discreta","Indice no valido","Use n inicial entero, de magnitud <=1E12. No se redondea.",SSAccent(1)); RETURN 0; END;
  d:=SSDensity(x); e:=SSEnergy(x); p:=e/SIZE(x); per:=SSPeriod(x);
  IF SSIsSpecial(e) THEN p:=e; rms:=e; ELSE rms:=SQRT(p); END;
  SSMeasureResults(x,d,n0,1,"Lista finita ingresada",1,e,p,rms,STRING(e),per); RETURN 1;
END;

UISignalMeasuresDiscreteExpr()
BEGIN
  LOCAL f:="(0.5)^ABS(X)";
  LOCAL n0:=-10;
  LOCAL n1:=10;
  LOCAL N;
  LOCAL x;
  LOCAL d;
  LOCAL e;
  LOCAL p;
  LOCAL rms;
  LOCAL exacta:="";
  LOCAL fn;
  IF INPUT(f,"Energia discreta por expresion","x[n]=","X es n. Ej: (0.8)^ABS(X)",f)==0 THEN RETURN 0; END;
  IF INPUT(n0,"Intervalo discreto","n inicial=","Primer indice",-10)==0 THEN RETURN 0; END;
  IF INPUT(n1,"Intervalo discreto","n final=","Ultimo indice",10)==0 THEN RETURN 0; END;
  IF TYPE(n0)<>0 OR TYPE(n1)<>0 THEN SSInfoView("Energia discreta","Indices no reales","Ingrese limites enteros reales, no listas, textos ni complejos.",SSAccent(1)); RETURN 0; END;
  IF SSIsDrawable(n0)==0 OR SSIsDrawable(n1)==0 THEN SSInfoView("Energia discreta","Indices fuera de rango","Use indices enteros de magnitud <=1E12.",SSAccent(1)); RETURN 0; END;
  IF n0<>FLOOR(n0) OR n1<>FLOOR(n1) OR ABS(n0)>1E12 OR ABS(n1)>1E12 THEN SSInfoView("Energia discreta","Indices no validos","Use indices enteros de magnitud <=1E12. No se redondean ni cambian los limites solicitados.",SSAccent(1)); RETURN 0; END;
  IF n1<n0 THEN SSInfoView("SignalLab","Aviso","El indice final debe ser mayor o igual al inicial.",SSAccent(1)); RETURN 0; END;
  N:=n1-n0+1; IF N>1024 THEN SSInfoView("SignalLab","Aviso","Use como maximo 1024 indices por calculo.",SSAccent(1)); RETURN 0; END;
  x:=SSEvalExpr({f,"DISCRETE"},n0,1,N); IF SIZE(x)==0 THEN RETURN 0; END;
  d:=SSDensity(x); e:=SSEnergy(x); p:=e/N; IF SSIsSpecial(e) THEN p:=e; rms:=e; ELSE rms:=SQRT(p); END; fn:=SSReplaceX(f,"(n)");
  exacta:="";
  SSMeasureResults(x,d,n0,1,f,1,e,p,rms,exacta,SSPeriod(x)); RETURN 1;
END;

UISignalMeasuresContinuousExpr()
BEGIN
  LOCAL f:="EXP(-ABS(X))";
  LOCAL t0:=-5;
  LOCAL t1:=5;
  LOCAL N:=201;
  LOCAL dt;
  LOCAL x;
  LOCAL d;
  LOCAL e;
  LOCAL p;
  LOCAL rms;
  LOCAL exacta:="";
  LOCAL ft;
  IF INPUT(f,"Energia continua por expresion","x(t)=","X es tiempo. Ej: EXP(-ABS(X))",f)==0 THEN RETURN 0; END;
  IF INPUT(t0,"Intervalo continuo","t inicial=","Limite inferior",-5)==0 THEN RETURN 0; END;
  IF INPUT(t1,"Intervalo continuo","t final=","Limite superior",5)==0 THEN RETURN 0; END;
  IF INPUT(N,"Resolucion numerica","muestras N=","Entre 11 y 1024",201)==0 THEN RETURN 0; END;
  IF TYPE(t0)<>0 OR TYPE(t1)<>0 OR TYPE(N)<>0 THEN SSInfoView("Energia continua","Parametros no reales","Los limites deben ser reales y N entero. No use listas, textos ni complejos.",SSAccent(1)); RETURN 0; END;
  IF SSIsDrawable(t0)==0 OR SSIsDrawable(t1)==0 OR SSIsDrawable(N)==0 THEN SSInfoView("Energia continua","Parametros fuera de rango","Use numeros finitos dentro del rango de la app y N entero de 11 a 1024.",SSAccent(1)); RETURN 0; END;
  IF N<>FLOOR(N) OR N<11 OR N>1024 THEN SSInfoView("Energia continua","Resolucion no valida","Use N entero de 11 a 1024; no se redondea ni recorta silenciosamente.",SSAccent(1)); RETURN 0; END;
  IF t1<=t0 THEN SSInfoView("SignalLab","Aviso","El limite superior debe ser mayor que el inferior.",SSAccent(1)); RETURN 0; END;
  dt:=(t1-t0)/(N-1);
  IF t0+dt==t0 OR t1-dt==t1 THEN SSInfoView("Energia continua","Malla no representable","El paso es demasiado pequeno frente a los limites. Reduzca el origen, amplie la ventana o reduzca N. No se evaluan tiempos repetidos.",SSAccent(1)); RETURN 0; END;
  x:=SSEvalExpr(f,t0,dt,N); IF SIZE(x)==0 THEN RETURN 0; END;
  d:=SSDensity(x); e:=SSTrapEnergy(d,dt); p:=e/(t1-t0); IF SSIsSpecial(e) THEN p:=e; rms:=e; ELSE rms:=SQRT(p); END; ft:=SSReplaceX(f,"(t)");
  exacta:="";
  SSMeasureResults(x,d,t0,dt,f,2,e,p,rms,exacta,0); RETURN 1;
END;

UISignalMeasuresTheory()
BEGIN
  LOCAL dominio:=1;
  LOCAL f:="(0.5)^ABS(X)";
  dominio:=SSMenu("Dominio de energia teorica",{"Discreta: x[n]","Continua: x(t)","Volver"},dominio);
  IF dominio==0 OR dominio==3 THEN RETURN 0; END;
  IF dominio==2 THEN f:="EXP(-ABS(X))"; END;
  IF INPUT(f,"Energia y potencia global","Expresion=","Use X; dominio completo, sin truncamiento",f)==0 THEN RETURN 0; END;
  RETURN SSMeasureResults({},{},0,1,f,dominio,0,0,0,"",0);
END;

UISignalMeasures()
BEGIN
  LOCAL op:=1;
  REPEAT
    op:=SSMenu("Energia y potencia",{"Lista discreta finita","Expresion discreta por indices","Expresion continua por intervalo","Analisis teorico en todo el eje","Formulas y clasificacion","Densidad espectral de energia","Volver"},op);
    IF op==0 OR op==7 THEN RETURN 1; END;
    IFERR
    IF op==1 THEN UISignalMeasuresList(); END;
    IF op==2 THEN UISignalMeasuresDiscreteExpr(); END;
    IF op==3 THEN UISignalMeasuresContinuousExpr(); END;
    IF op==4 THEN UISignalMeasuresTheory(); END;
    IF op==5 THEN SSTheoryView("Energia y potencia",{"DEFINICION. Discreta: E=sum |x[n]|^2. Continua: E=integral |x(t)|^2 dt. Potencia es el promedio temporal de |x|^2 y RMS=sqrt(P).","INTERPRETACION. Una senal de energia tiene 0<E<infinito y P=0. Una senal de potencia tiene E infinito y 0<P<infinito. La senal nula tiene ambos cero.","USO. Las opciones por intervalo calculan medidas de ventana. El analisis teorico usa sumas, integrales y limites del CAS sobre todo el eje."},SSAccent(1)); END;
    IF op==6 THEN UISpectrum(); END;
    THEN
      SSInfoView("Analisis energetico","Operacion no completada","Fallo recuperable al preparar o mostrar los datos, opcion "+STRING(op)+". Revise que la entrada sea numerica y finita, y los limites sean reales. Se vuelve a este menu, sin dar energia ni potencia falsas. Si persiste, informe opcion, expresion, limites y ultima pantalla visible.",SSAccent(1));
    END;
  UNTIL 0;
END;

VIEW "Senales - Analisis",UI_SIGNALS()
BEGIN
  LOCAL op:=1;
  REPEAT
    SSEVAL_EVENTS:={}; SSREAD_META:={};
    op:=SSMenu("Senales continuas y discretas",{"Crear secuencia x[n]","Crear expresion o senal por tramos","Transformar o sumar secuencias","Calcular energia y potencia","Conceptos y clasificacion","Volver al inicio"},op);
    IF op==0 THEN RETURN 0; END;
    IF op==1 THEN UIGenerator(); END;
    IF op==2 THEN UISampleExpr(); END;
    IF op==3 THEN UITransformSignal(); END;
    IF op==4 THEN UISignalMeasures(); END;
    IF op==5 THEN SSTheoryView("Conceptos de senales",{"CLASIFICACION. Las senales pueden ser continuas o discretas, deterministicas o aleatorias, periodicas o aperiodicas, de energia o de potencia.","OPERACIONES. Desplazamiento cambia el origen; inversion refleja el eje; escala modifica amplitud o tiempo. Las partes par e impar suman la senal original.","ENTRADA. Listas: {1,2,3}. Expresiones: use X como n o t. ENTER confirma y ESC vuelve. Los resultados pueden exportarse a banco, L0, L1 y M0."},SSAccent(1)); END;
  UNTIL op==6; RETURN 1;
END;

// ---------- Modulo LTI ----------

UIConvolution()
BEGIN
  LOCAL x:={1,2,1};
  LOCAL h:={1,1};
  LOCAL nx:=0;
  LOCAL nh:=0;
  LOCAL y;
  x:=SSReadList("Convolucion","x=","Entrada",x); IF SIZE(x)==0 THEN RETURN 0; END;
  IF INPUT(nx,"Convolucion","n inicial x=","Indice",0)==0 THEN RETURN 0; END;
  h:=SSReadList("Convolucion","h=","Respuesta impulso",h); IF SIZE(h)==0 THEN RETURN 0; END;
  IF INPUT(nh,"Convolucion","n inicial h=","Indice",0)==0 THEN RETURN 0; END;
  IF TYPE(nx)<>0 OR TYPE(nh)<>0 THEN SSInfoView("Convolucion discreta","Indices no reales","Los origenes son indices enteros, no tiempos. No use listas, textos ni complejos.",SSAccent(2)); RETURN 0; END;
  IF SSIsDrawable(nx)==0 OR SSIsDrawable(nh)==0 THEN SSInfoView("Convolucion discreta","Indices fuera de rango","Use indices enteros de magnitud <=1E12.",SSAccent(2)); RETURN 0; END;
  IF nx<>FLOOR(nx) OR nh<>FLOOR(nh) OR ABS(nx)>1E12 OR ABS(nh)>1E12 THEN SSInfoView("Convolucion discreta","Indices no validos","Use indices enteros de magnitud <=1E12. La salida empieza en nx+nh; no se redondean los origenes.",SSAccent(2)); RETURN 0; END;
  y:=SSConv(x,h); IF SIZE(y)==0 THEN RETURN 0; END; SSConvDiscreteResults(x,nx,h,nh,y); RETURN 1;
END;

UICorrelation()
BEGIN
  LOCAL x:={1,2,1};
  LOCAL h:={1,1};
  LOCAL nx:=0;
  LOCAL nh:=0;
  LOCAL y;
  LOCAL n0;
  LOCAL tipo;
  LOCAL continua;
  LOCAL propia;
  LOCAL entradas:={{},{}};
  LOCAL expresiones:={"",""};
  LOCAL origenes:={0,0};
  LOCAL cantidad:=2;
  LOCAL sidx;
  LOCAL j;
  LOCAL fuente;
  LOCAL datos;
  LOCAL f;
  LOCAL origen;
  LOCAL N:=100;
  LOCAL t0:=-5;
  LOCAL t1:=5;
  LOCAL dx:=1;
  LOCAL etiqueta;
  LOCAL titulo;
  LOCAL eje:="l";
  LOCAL nota;
  LOCAL definicion;
  LOCAL op:=1;
  LOCAL sub;
  LOCAL vista;
  LOCAL ex:=0;
  LOCAL eh:=0;
  LOCAL pico:=1;
  LOCAL cero;
  LOCAL r0:=0;
  LOCAL reales:=1;
  LOCAL circular:=0;
  LOCAL periodicaContinua:=0;
  LOCAL duracion:=1;
  LOCAL modelo:=1;
  LOCAL periodo:=0;
  LOCAL retardo;
  LOCAL indice;
  LOCAL bruta;
  LOCAL escala:=1;
  LOCAL divisor:=1;
  LOCAL normalizador:=0;
  LOCAL nombreResultado;
  LOCAL contexto;
  LOCAL formulaEscala:="r(l)";
  LOCAL formula;
  LOCAL resultado;
  LOCAL estado;
  LOCAL comando;
  LOCAL integrando;
  LOCAL axis:="slcorrtime";
  LOCAL lag:="slcorrlag";
  LOCAL texto;
  LOCAL salida;
  LOCAL pos;
  LOCAL fin;
  LOCAL token;
  LOCAL mirar;
  LOCAL simbolicas:={"",""};
  LOCAL chars:="ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_";
  LOCAL funciones:="|ABS|SIN|COS|TAN|ASIN|ACOS|ATAN|SINH|COSH|TANH|EXP|LN|SQRT|RE|IM|CONJ|SIGN|FLOOR|CEILING|";
  tipo:=SSMenu("Correlacion y autocorrelacion",{"Autocorrelacion discreta","Correlacion cruzada discreta","Autocorrelacion continua","Correlacion cruzada continua","Auto periodica discreta","Auto periodica continua","Volver"},1);
  IF tipo==0 OR tipo==7 THEN RETURN 0; END;
  continua:=tipo==3 OR tipo==4 OR tipo==6;
  propia:=tipo==1 OR tipo==3 OR tipo==5 OR tipo==6;
  periodicaContinua:=tipo==6;
  IF tipo==5 OR tipo==6 THEN circular:=1; escala:=3; END;
  IF propia THEN cantidad:=1; END;
  titulo:="Correlacion cruzada"; IF propia THEN titulo:="Autocorrelacion"; END;
  IF tipo==5 OR tipo==6 THEN titulo:="Autocorrelacion periodica"; END;
  IF continua==0 THEN
    IF tipo<>5 THEN
      modelo:=SSMenu("Modelo de correlacion discreta",{"Lineal: registro finito","Circular: un periodo","Volver"},1);
      IF modelo==0 OR modelo==3 THEN RETURN 0; END;
      circular:=modelo==2;
    END;
    IF circular THEN SSInfoView(titulo,"Un periodo de L muestras","Se repiten las muestras cargadas. Ambas entradas deben tener la misma longitud L, sin repetir el extremo final. Ejemplo COS((pi/2)*X): n=0,1,2,3, L=4. La salida muestra l=0..L-1 y tambien es periodica. Se conserva el signo: en l=2 el coseno esta invertido. Auto periodica inicia con el promedio r/L (potencia); la ruta Circular anterior inicia con la suma. Puede cambiar la escala o normalizar en resultados.",SSAccent(2)); END;
  END;
  IF continua THEN
    eje:="tau";
    IF periodicaContinua THEN
      SSInfoView(titulo,"Un periodo; correlacion de potencia","Use X como tiempo. Indique el inicio t0 y el periodo T>0. Se repite el tramo [t0,t0+T), no se supone cero fuera. La salida inicial es R(tau)=(1/T)*integral de un periodo. En cero coincide con la potencia media. Se aproxima x con N celdas; aumente N para comparar. No admite impulsos Dirac ideales.",SSAccent(2));
      t0:=0;
      IF INPUT(t0,"Inicio de un periodo","t0=","Origen del tramo que se repite",t0)==0 THEN RETURN 0; END;
      IF INPUT(duracion,"Periodo continuo","T=","Periodo positivo; ej COS(2*pi*X): T=1",duracion)==0 THEN RETURN 0; END;
      IF TYPE(t0)<>0 OR TYPE(duracion)<>0 THEN RETURN 0; END;
      IF SSIsDrawable(t0)==0 OR SSIsDrawable(duracion)==0 THEN RETURN 0; END;
      IF duracion<=0 THEN SSInfoView(titulo,"Periodo invalido","T debe ser positivo.",SSAccent(2)); RETURN 0; END;
      t1:=t0+duracion;
    ELSE
    SSInfoView(titulo,"Expresiones continuas; ventana finita","Use X como tiempo. Ejemplos: EXP(-X^2), Heaviside(X+1)-Heaviside(X-1). Se supone cero fuera de la ventana para el calculo numerico. N divide esa ventana en celdas iguales; se evalua en sus centros. No se divide por la duracion: se calcula correlacion de energia, no el promedio de una senal periodica. La consulta CAS usa las expresiones originales sobre todo el eje.",SSAccent(2));
    IF INPUT(t0,"Ventana comun","t minimo=","Ambas entradas se truncan aqui",t0)==0 THEN RETURN 0; END;
    IF INPUT(t1,"Ventana comun","t maximo=","Debe superar t minimo",t1)==0 THEN RETURN 0; END;
    END;
    IF TYPE(t0)<>0 OR TYPE(t1)<>0 THEN SSInfoView(titulo,"Ventana invalida","Use extremos reales finitos.",SSAccent(2)); RETURN 0; END;
    IF ABS(t0)>1E9 OR ABS(t1)>1E9 OR t1<=t0 THEN SSInfoView(titulo,"Ventana invalida","Use t max > t min y extremos de magnitud <= 1E9.",SSAccent(2)); RETURN 0; END;
    IF INPUT(N,"Resolucion continua","Celdas N=","Entero de 2 a 1024; aumente para comparar",N)==0 THEN RETURN 0; END;
    IF TYPE(N)<>0 THEN RETURN 0; END;
    IF N<>FLOOR(N) OR N<2 OR N>1024 THEN SSInfoView(titulo,"Resolucion invalida","Use un entero de 2 a 1024.",SSAccent(2)); RETURN 0; END;
    dx:=(t1-t0)/N;
    IF periodicaContinua THEN dx:=duracion/N; END;
    IF t0+dx==t0 OR t1-dx==t1 THEN SSInfoView(titulo,"Resolucion insuficiente","El paso no se distingue a este origen.",SSAccent(2)); RETURN 0; END;
  END;
  FOR sidx FROM 1 TO cantidad DO
    etiqueta:="x"; IF sidx==2 THEN etiqueta:="h"; END;
    IF continua THEN
      f:="EXP(-X^2)";
      texto:="X es tiempo. Ej: EXP(-X^2)";
      IF periodicaContinua THEN f:="COS(2*pi*X)"; texto:="Tramo de un periodo; X es tiempo"; END;
      IF INPUT(f,titulo,etiqueta+"(t)=",texto,f)==0 THEN RETURN 0; END;
      IF INSTRING(UPPER(f),"DIRAC(")>0 THEN SSInfoView(titulo,"Dirac ideal","Esta cuadratura requiere funciones ordinarias. No se reemplaza una Dirac por una gaussiana ni se define su energia cuadratica.",SSAccent(2)); RETURN 0; END;
      origen:=t0+dx/2; datos:=SSEvalExpr(f,origen,dx,N); expresiones(sidx):=f;
    ELSE
      fuente:=SSMenu("Entrada "+etiqueta+"[n]",{"Lista o datos exportados","Expresion matematica","Cancelar"},1);
      IF fuente==0 OR fuente==3 THEN RETURN 0; END;
      origen:=0;
      IF fuente==1 THEN
        datos:=SSReadList(titulo,etiqueta+"=","Lista finita; conserva indices enteros",{1,2,1});
        IF SIZE(datos)==0 THEN RETURN 0; END;
        IF SSReadStep(1)<>1 THEN SSInfoView(titulo,"El eje no es discreto unitario","Vuelva a elegir Solo valores; indice desde cero si desea reinterpretar esos datos como secuencia. No se cambia la tasa automaticamente.",SSAccent(2)); RETURN 0; END;
        origen:=SSReadOrigin(0);
      ELSE
        f:="(0.8)^ABS(X)";
        IF tipo==5 THEN f:="COS((pi/2)*X)"; END;
        IF INPUT(f,titulo,etiqueta+"[n]=","X es el indice entero n",f)==0 THEN RETURN 0; END;
        expresiones(sidx):=f;
      END;
      IF INPUT(origen,"Origen de "+etiqueta,"n inicial=","Indice entero de la primera muestra",origen)==0 THEN RETURN 0; END;
      IF TYPE(origen)<>0 THEN RETURN 0; END;
      IF origen<>FLOOR(origen) OR ABS(origen)>1E9 THEN SSInfoView(titulo,"Indice invalido","Use un entero de magnitud <= 1E9.",SSAccent(2)); RETURN 0; END;
      IF fuente==2 THEN
        N:=21;
        IF circular THEN
          N:=4; IF sidx==2 THEN N:=SIZE(entradas(1)); END;
          IF INPUT(N,"Periodo de "+etiqueta,"Longitud L=","Numero de muestras; no repetir el extremo",N)==0 THEN RETURN 0; END;
        ELSE
          IF INPUT(N,"Registro de "+etiqueta,"Muestras N=","Entero de 1 a 1024; cero fuera",N)==0 THEN RETURN 0; END;
        END;
        IF TYPE(N)<>0 THEN RETURN 0; END;
        IF N<>FLOOR(N) OR N<1 OR N>1024 THEN SSInfoView(titulo,"Longitud invalida","Use entre 1 y 1024 muestras.",SSAccent(2)); RETURN 0; END;
        datos:=SSEvalExpr({f,"DISCRETE"},origen,1,N);
      END;
    END;
    IF SIZE(datos)<1 OR SIZE(datos)>1024 THEN SSInfoView(titulo,"Entrada invalida","Use entre 1 y 1024 valores por entrada.",SSAccent(2)); RETURN 0; END;
    FOR j FROM 1 TO SIZE(datos) DO
      IF TYPE(datos(j))<>0 AND TYPE(datos(j))<>1 AND TYPE(datos(j))<>3 THEN SSInfoView(titulo,"Entrada no numerica","La muestra "+STRING(j)+" no es un numero real o complejo.",SSAccent(2)); RETURN 0; END;
      IF SSIsDrawable(datos(j))==0 THEN SSInfoView(titulo,"Entrada no finita","Hay un punto N/D o infinito. Revise la expresion y la ventana; no se omiten muestras para inventar un resultado.",SSAccent(2)); RETURN 0; END;
      IF IM(datos(j))<>0 THEN reales:=0; END;
    END;
    entradas(sidx):=datos; origenes(sidx):=origen;
  END;
  IF propia THEN entradas(2):=entradas(1); origenes(2):=origenes(1); expresiones(2):=expresiones(1); END;
  x:=entradas(1); h:=entradas(2); nx:=origenes(1); nh:=origenes(2);
  IF circular THEN
    IF SIZE(x)<>SIZE(h) THEN SSInfoView(titulo,"Periodos incompatibles","Las dos listas deben describir un periodo comun con igual longitud L. No se agregan ceros ni se repite una lista automaticamente. Cargue ambas sobre el periodo comun.",SSAccent(2)); RETURN 0; END;
    periodo:=SIZE(x); y:=MAKELIST(0,j,1,periodo,1); n0:=0;
    FOR retardo FROM 0 TO periodo-1 DO
      FOR j FROM 1 TO periodo DO
        // Indice de h correspondiente al tiempo n_x+j-1-l, modulo L.
        indice:=nx+j-1-retardo-nh;
        IF periodicaContinua THEN indice:=j-1-retardo; END;
        indice:=indice-periodo*FLOOR(indice/periodo)+1;
        y(retardo+1):=y(retardo+1)+x(j)*CONJ(h(indice));
      END;
    END;
  ELSE
    y:=SSCorr(x,h); n0:=nx-(nh+(SIZE(h)-1)*dx);
  END;
  IF continua THEN
    y:=y*dx;
    // Modelo constante en cada celda: correlacion lineal entre estos retardos.
    // En +/- duracion no hay solapamiento; agregar ambos ceros extremos.
    IF periodicaContinua==0 THEN y:=CONCAT({0},CONCAT(y,{0})); n0:=-(t1-t0); END;
  END;
  FOR j FROM 1 TO SIZE(y) DO
    IF SSIsDrawable(y(j))==0 THEN SSInfoView(titulo,"Resultado fuera de rango","Reduzca las amplitudes o la longitud. No se exportaron datos incompletos.",SSAccent(2)); RETURN 0; END;
    IF reales THEN y(j):=RE(y(j)); END;
    IF ABS(y(j))>ABS(y(pico)) THEN pico:=j; END;
  END;
  FOR j FROM 1 TO SIZE(x) DO ex:=ex+ABS(x(j))^2*dx; END;
  FOR j FROM 1 TO SIZE(h) DO eh:=eh+ABS(h(j))^2*dx; END;
  // Raices por separado: evitar desbordar innecesariamente con Ex*Eh.
  IF SSIsDrawable(ex) AND SSIsDrawable(eh) THEN
    IF ex>0 AND eh>0 THEN normalizador:=SQRT(ex)*SQRT(eh); END;
  END;
  cero:=ROUND(1-n0/dx,0);
  IF cero>=1 AND cero<=SIZE(y) THEN IF ABS(n0+(cero-1)*dx)<1E-6*dx THEN r0:=y(cero); END; END;
  definicion:="sum(x(n)*conj(h(n-l)),n,-infinity,infinity)";
  IF propia THEN definicion:="sum(x(n)*conj(x(n-l)),n,-infinity,infinity)"; END;
  nota:="BASE LINEAL: r_xh(l)=sum x(n)*conj(h(n-l)). Se invierte y conjuga la segunda entrada. Registros finitos, cero fuera. El primer retardo es n0_x-(n0_h+Nh-1). La suma base no divide por N. En auto, r_xx(0)=energia del registro.\nNo se resta la media. No es covarianza, coeficiente de Pearson ni estimacion insesgada por solapamiento. Se conserva el signo y la conjugacion: r_xx(-l)=conj(r_xx(l)). Modulo es una vista separada, no la correlacion de salida.";
  IF circular THEN
    definicion:="sum(x(n)*conj(h(n-l)),n,0,"+STRING(periodo-1)+")";
    IF propia THEN definicion:="sum(x(n)*conj(x(n-l)),n,0,"+STRING(periodo-1)+")"; END;
    nota:="BASE CIRCULAR: suma de un periodo de L="+STRING(periodo)+" muestras, con x y h extendidas periodicamente. Se muestran l=0..L-1; los origenes de ambas entradas se respetan modulo L. No se agregan ceros ni se presupone que el periodo sea fundamental.\nEx y Eh son energias de un periodo, no energias totales de la senal periodica. La suma circular en cero de una auto es Ex; el promedio por periodo es Ex/L (potencia). La correlacion normalizada en cero es 1 si Ex>0. No se resta la media y no se toma modulo. Para {1,0,-1,0}: suma {2,0,-2,0}, promedio {0.5,0,-0.5,0}, coeficiente {1,0,-1,0}.";
  END;
  IF continua THEN
    definicion:="int(x(t)*conj(h(t-tau)),t,-infinity,infinity)";
    IF propia THEN definicion:="int(x(t)*conj(x(t-tau)),t,-infinity,infinity)"; END;
    nota:="BASE CONTINUA: R_xh(tau)=int x(t)*conj(h(t-tau)) dt. Ventana ["+STRING(t0)+","+STRING(t1)+"], cero fuera; N centros de celda, modelo constante por celda de ancho dt="+STRING(dx)+". Base=dt*sum, interpolacion lineal EXACTA para ese modelo, no para las expresiones originales. Compare N y ventana; detalles estrechos pueden quedar mal resueltos.\nEx y Eh son energias del modelo truncado. No se resta la media ni se calcula correlacion de potencia periodica continua. La normalizacion usa esas energias de ventana. La consulta CAS permanece SIN normalizar y sobre las expresiones originales de todo el eje: es una consulta distinta y puede divergir. Se conservan complejos y conjugacion de la segunda entrada.";
  END;
  IF periodicaContinua THEN
    definicion:="int(xp(t)*conj(xp(t-tau)),t,t0,t0+T)";
    nota:="BASE PERIODICA CONTINUA: integral sobre UN periodo, no sobre todo el eje. xp es la extension periodica del tramo ingresado. Se evalua en N centros y se repiten las celdas de ancho dt=T/N. La base es dt*sum circular; el resultado inicial divide por T (potencia). En cero R(0)=Ex/T. La escala normalizada divide la base por Ex y vale 1 en cero si Ex>0.\nAproximacion numerica: la interpolacion lineal del grafico es exacta para el modelo constante por celdas, NO para la expresion original. Compare resoluciones; no se verifica automaticamente que T sea el periodo fundamental. Tabla y exportacion: N retardos de 0 a T-dt. Solo el grafico repite el primer punto en T para cerrar el periodo. No se resta la media. No se ofrece la integral de todo el eje ni una formula CAS cerrada para este modelo.";
  END;
  formula:=""; bruta:=y; SSEVAL_EVENTS:={};
  REPEAT
    divisor:=1; formulaEscala:="r(l)";
    nombreResultado:="Cruzada"; IF propia THEN nombreResultado:="Auto"; END;
    IF continua THEN
      IF periodicaContinua THEN nombreResultado:=nombreResultado+" periodica continua"; ELSE nombreResultado:=nombreResultado+" continua"; END;
    ELSE IF circular THEN nombreResultado:=nombreResultado+" circular"; ELSE nombreResultado:=nombreResultado+" lineal"; END; END;
    contexto:="Salida: suma/integral base sin normalizar.";
    IF escala==2 THEN
      divisor:=normalizador; formulaEscala:="r(l)/sqrt(E_x*E_h)"; nombreResultado:=nombreResultado+" | rho";
      contexto:="Salida NORMALIZADA rho=r/sqrt(Ex*Eh). En auto equivale a r/r(0) y rho(0)=1. Conserva signo o fase; |rho|<=1 salvo redondeo. No se normaliza por el solapamiento de cada retardo.";
    END;
    IF escala==3 THEN
      divisor:=periodo; formulaEscala:="r(l)/L"; nombreResultado:=nombreResultado+" | media";
      contexto:="Salida PROMEDIO PERIODICO r/L. Es correlacion de potencia de las secuencias periodicas, no coeficiente normalizado a 1.";
      IF periodicaContinua THEN
        divisor:=duracion; formulaEscala:="r(tau)/T";
        contexto:="Salida PROMEDIO PERIODICO R(tau)=base/T. Es autocorrelacion de potencia; R(0)=potencia media, no 1 salvo potencia unitaria.";
      END;
    END;
    IF escala==1 THEN nombreResultado:=nombreResultado+" | base"; END;
    contexto:=contexto+"\nDivisor="+STRING(divisor,1,12,{3,".E-",0})+"\n"+nota;
    y:=bruta/divisor; r0:=0;
    IF cero>=1 AND cero<=SIZE(y) THEN IF ABS(n0+(cero-1)*dx)<1E-6*dx THEN r0:=y(cero); END; END;
    op:=SSMenu({nombreResultado,{3,nombreResultado,{{"Correlacion",y,n0,dx},{"Entrada x",x,nx,dx},{"Entrada h",h,nh,dx},{"Expresion x",expresiones(1)},{"Expresion h",expresiones(2)},{"Divisor de normalizacion",divisor},{"Energia x y h",{ex,eh}}},contexto},11},{"Tabla de correlacion","Grafico de parte real","Grafico de parte imaginaria","Grafico de modulo |r|","Resumen y valor en cero","Definicion y formula","Consultar entradas","Exportar correlacion","Metodo y convenciones","Normalizacion / escala","Volver"},op);
    IF op==0 OR op==11 THEN RETURN 1; END;
    IF op==1 THEN SSDataView(y,n0,dx,nombreResultado,eje,"r",SSAccent(2)); END;
    IF op>=2 AND op<=4 THEN
      vista:=y; etiqueta:="Parte real de r";
      IF op==3 THEN vista:=MAKELIST(IM(y(j)),j,1,SIZE(y),1); etiqueta:="Parte imaginaria de r"; END;
      IF op==4 THEN vista:=SSMag(y); etiqueta:="Modulo |r|"; END;
      IF continua THEN
        IF periodicaContinua THEN SSPlotXY(CONCAT(vista,{vista(1)}),n0,dx,etiqueta,nombreResultado);
        ELSE SSPlotXY(vista,n0,dx,etiqueta,nombreResultado); END;
      ELSE SSPlotDiscrete(vista,n0,1,etiqueta,nombreResultado+"; l entero"); END;
    END;
    IF op==5 THEN
      IF circular AND propia THEN
        texto:="L (muestras)"; resultado:=periodo;
        IF periodicaContinua THEN texto:="T (tiempo)"; resultado:=duracion; END;
        SSResultBrowse(nombreResultado,"Medidas de un periodo",{{"Salida en retardo cero",r0},{texto,resultado},{"Energia de x en un periodo",ex},{"Potencia media de x",ex/resultado},{"Maximo |salida|",ABS(y(pico))},{"Paso de retardo",dx},{"Divisor aplicado",divisor}},"N="+STRING(SIZE(x))+"; no se duplica el extremo",contexto);
      ELSE SSResultBrowse(nombreResultado,"Medidas del registro o periodo",{{"Salida en retardo cero",r0},{"Energia de x",ex},{"Energia de h",eh},{"Maximo |salida|",ABS(y(pico))},{"Retardo de ese maximo",n0+(pico-1)*dx},{"Paso de retardo",dx},{"Divisor aplicado",divisor}},"Longitudes: "+STRING(SIZE(x))+" y "+STRING(SIZE(h)),contexto); END;
    END;
    IF op==6 THEN
      sub:=1;
      IF continua AND periodicaContinua==0 THEN sub:=SSMenu("Formula de correlacion",{"Definicion y escala","CAS sin normalizar: todo el eje","Volver"},1); END;
      IF sub==1 THEN
        IF continua THEN
          formulaEscala:="r(tau)";
          IF escala==2 THEN formulaEscala:="r(tau)/sqrt(E_x*E_h)"; END;
          IF escala==3 THEN formulaEscala:="r(tau)/T"; END;
        END;
        SSResultBrowse(nombreResultado,"Definicion, escala y datos",{{"Definicion de la base",definicion},{"Operacion de escala",formulaEscala},{"Divisor numerico",divisor},{"Valores de salida",y},{"Primer retardo",n0}},"La definicion es un planteo, no una integral resuelta.",contexto);
      END;
      IF continua AND periodicaContinua==0 AND sub==2 THEN
        IF formula=="" THEN
          IF SSCASString("eval("+axis+")")<>axis OR SSCASString("eval("+lag+")")<>lag THEN SSInfoView(titulo,"Simbolos no disponibles","No se pudo verificar que slcorrtime y slcorrlag esten libres. No se borran variables del usuario.",SSAccent(2));
          ELSE
            FOR sidx FROM 1 TO 2 DO
              texto:=expresiones(sidx);
              IF INSTRING(UPPER(texto),UPPER(axis))>0 OR INSTRING(UPPER(texto),UPPER(lag))>0 THEN SSInfoView(titulo,"Nombre reservado","No use slcorrtime ni slcorrlag en la entrada.",SSAccent(2)); RETURN 0; END;
              salida:="("+axis+")"; IF sidx==2 THEN salida:="("+axis+"-"+lag+")"; END;
              texto:=SSReplaceX(texto,salida); salida:=""; pos:=1;
              WHILE pos<=DIM(texto) DO
                token:=MID(texto,pos,1);
                IF INSTRING(chars,UPPER(token))>0 THEN
                  fin:=pos+1; WHILE fin<=DIM(texto) AND INSTRING(chars,UPPER(MID(texto,fin,1)))>0 DO fin:=fin+1; END;
                  token:=MID(texto,pos,fin-pos); mirar:=fin;
                  WHILE mirar<=DIM(texto) AND MID(texto,mirar,1)==" " DO mirar:=mirar+1; END;
                  IF mirar<=DIM(texto) THEN IF MID(texto,mirar,1)=="(" AND INSTRING(funciones,"|"+UPPER(token)+"|")>0 THEN token:=LOWER(token); END; END;
                  IF UPPER(token)=="PI" THEN token:="pi"; END;
                  pos:=fin;
                ELSE pos:=pos+1; END;
                salida:=salida+token;
              END;
              simbolicas(sidx):=salida;
            END;
            integrando:="("+simbolicas(1)+")*conj("+simbolicas(2)+")";
            comando:="int("+integrando+","+axis+",-infinity,infinity)"; formula:="";
            IFERR resultado:=CAS.int(integrando,axis,"-infinity","infinity"); formula:=STRING(resultado); THEN formula:=""; END;
            IF formula=="" THEN formula:=SSCASString(comando); END;
            estado:="CAS: expresiones originales, todo el eje. tau se interpreta real. Revise convergencia y condiciones; no es el modelo numerico truncado.";
            IF formula=="" OR UPPER(formula)=="UNDEF" OR UPPER(formula)=="NAN" OR INSTRING(UPPER(formula),"ERROR")>0 OR INSTRING(UPPER(formula),"INFINITY")>0 THEN formula:=comando; estado:="PENDIENTE o divergente: CAS no devolvio un resultado finito. Se conserva la integral planteada, no un cero."; END;
            IF INSTRING(UPPER(formula),"INT(")>0 OR INSTRING(formula,CHAR(8747))>0 OR INSTRING(UPPER(formula),"LIMIT(")>0 THEN estado:="PENDIENTE: integral o limite sin resolver. No es una formula cerrada."; END;
            texto:=formula; formula:=""; pos:=1;
            WHILE pos<=DIM(texto) DO
              token:=MID(texto,pos,1);
              IF INSTRING(chars,UPPER(token))>0 THEN
                fin:=pos+1; WHILE fin<=DIM(texto) AND INSTRING(chars,UPPER(MID(texto,fin,1)))>0 DO fin:=fin+1; END;
                token:=MID(texto,pos,fin-pos); pos:=fin;
                IF token==axis THEN token:="t"; END; IF token==lag THEN token:="tau"; END;
              ELSE pos:=pos+1; END;
              formula:=formula+token;
            END;
          END;
        END;
        IF formula<>"" THEN SSSymbolicResults(titulo,"CAS sin normalizar; todo el eje",formula,"x="+expresiones(1)+"; h="+expresiones(2),estado+"\nNo se aplica la normalizacion de la tabla: esta usa energias del modelo truncado."); END;
      END;
    END;
    IF op==7 THEN
      sub:=SSMenu("Entradas utilizadas",{"Primera entrada x","Segunda entrada h","Volver"},1);
      IF sub==1 OR sub==2 THEN SSDataView(entradas(sub),origenes(sub),dx,"Entrada de correlacion","t o n","valor",SSAccent(2)); END;
    END;
    IF op==8 THEN SSExportData(y,n0,dx,nombreResultado); END;
    IF op==9 THEN SSInfoView(nombreResultado,"Metodo y convenciones",contexto,SSAccent(2)); END;
    IF op==10 THEN
      IF periodicaContinua THEN sub:=SSMenu("Escala de correlacion",{"Integral de un periodo","Normalizada: R(tau)/R(0)","Promedio de periodo: r/T","Volver"},escala);
      ELSE
      IF circular THEN sub:=SSMenu("Escala de correlacion",{"Sin normalizar: suma","Coeficiente r/sqrt(Ex*Eh)","Promedio de periodo: r/L","Volver"},escala);
      ELSE sub:=SSMenu("Escala de correlacion",{"Sin normalizar: suma/integral","Coeficiente r/sqrt(Ex*Eh)","Volver"},escala); END;
      END;
      IF sub==1 THEN escala:=1; END;
      IF circular AND sub==3 THEN escala:=3; END;
      IF sub==2 THEN
        IF normalizador<=0 OR SSIsDrawable(normalizador)==0 THEN SSInfoView(titulo,"Normalizacion no definida","Se requieren dos energias positivas y representables. Una senal nula no tiene correlacion normalizada: no se sustituye la division por cero por una lista de ceros. Se conserva la escala anterior.",SSAccent(2));
        ELSE escala:=2; END;
      END;
    END;
  UNTIL 0;
END;

UIDiffEquation()
BEGIN
  LOCAL b:={1};
  LOCAL a:={1,-0.5};
  LOCAL x:={1,0,0,0,0,0,0,0};
  LOCAL y;
  LOCAL r;
  r:=SSReadTransfer("Ecuacion en diferencias",b,a); IF SIZE(r)==0 THEN RETURN 0; END; b:=r(1); a:=r(2);
  IF a(1)==0 THEN SSInfoView("SignalLab","Aviso","a0 no puede ser cero",SSAccent(1)); RETURN 0; END;
  x:=SSReadList("Ecuacion diferencias","x=","Entrada",x); IF SIZE(x)==0 THEN RETURN 0; END;
  y:=SSDiffEq(b,a,x); SSShow(y,SSReadOrigin(0),{"Respuesta del sistema",SSReadStep(1),SSTransferText(b,a,2)}); RETURN 1;
END;

UIResponses()
BEGIN
  LOCAL b:={1};
  LOCAL a:={1,-0.5};
  LOCAL N:=20;
  LOCAL tipo:=1;
  LOCAL x;
  LOCAL y;
  LOCAL r;
  r:=SSReadTransfer("Respuesta LTI",b,a); IF SIZE(r)==0 THEN RETURN 0; END; b:=r(1); a:=r(2);
  IF INPUT(N,"Respuesta LTI","N=","Entero 1..1024",20)==0 THEN RETURN 0; END;
  IF N<1 OR N>1024 OR N<>FLOOR(N) THEN SSInfoView("Respuesta LTI","Cantidad no valida","Use entre 1 y 1024 muestras.",SSAccent(2)); RETURN 0; END;
  tipo:=SSMenu("Entrada del sistema",{"Impulso","Escalon"},tipo); IF tipo==0 THEN RETURN 0; END;
  IF tipo==1 THEN x:=SSImpulse(N); ELSE x:=SSStep(N); END;
  y:=SSDiffEq(b,a,x); SSShow(y,0,{"Respuesta LTI",1,SSTransferText(b,a,2)}); RETURN 1;
END;

UIPolesZeros()
BEGIN
  LOCAL b:={1};
  LOCAL a:={1,-0.5};
  LOCAL dom:=2;
  LOCAL z:={};
  LOCAL p:={};
  LOCAL est;
  LOCAL r;
  LOCAL entrada;
  LOCAL op:=1;
  LOCAL sub;
  LOCAL k;
  LOCAL j;
  LOCAL len;
  LOCAL recalcular:=1;
  LOCAL completo:=1;
  LOCAL causal:=1;
  LOCAL nulo:=0;
  LOCAL ganancia:=1;
  LOCAL nuevaGanancia;
  LOCAL bn;
  LOCAL an;
  LOCAL bd;
  LOCAL ad;
  LOCAL bueno;
  LOCAL expr;
  LOCAL variable:="z";
  LOCAL contexto;
  LOCAL x;
  LOCAL y;
  LOCAL espectro;
  LOCAL w;
  LOCAL punto;
  LOCAL den;
  LOCAL pirad:=3.141592653589793;
  entrada:=SSMenu("Polos, ceros y filtros",{"Analizar / editar coeficientes","Disenar ubicando polos y ceros","Volver"},1);
  IF entrada==0 OR entrada==3 THEN RETURN 0; END;
  IF entrada==1 THEN
    dom:=SSMenu("Dominio de estabilidad",{"Continuo: plano s","Discreto: plano z"},dom); IF dom==0 THEN RETURN 0; END;
    SSInfoView("Coeficientes de H","Convencion de entrada","Continuo: potencias descendentes de s. Discreto: b={b0,b1,...}, a={a0,a1,...}, H(z)=(b0+b1/z+...)/(a0+a1/z+...). Para localizar raices en z se igualan los grados agregando ceros AL FINAL de la lista mas corta. Ejemplo b={1}, a={1,-0.5}: cero en 0, polo en 0.5. Hasta 32 grados en este analisis interactivo.",SSAccent(7));
    IF dom==2 THEN r:=SSReadTransfer("Polos/ceros digital",b,a);
    ELSE r:=SSReadTransfer("Polos y ceros",b,a); END;
    IF SIZE(r)==0 THEN RETURN 0; END;
    IF MAX(SIZE(r(1)),SIZE(r(2)))>33 THEN SSInfoView("Orden demasiado alto","Analisis interactivo hasta 32","Use una seccion de menor orden para evitar raices mal condicionadas y exceso de memoria.",SSAccent(7)); RETURN 0; END;
    b:=r(1); a:=r(2); r:={};
    IF dom==2 THEN len:=MAX(SIZE(b),SIZE(a)); b:=SSPad(b,len); a:=SSPad(a,len); END;
  ELSE
    b:={1}; a:={1};
    SSInfoView("Diseno en plano z","H(z)=K*producto(z-cero)/producto(z-polo)","Agregar (tecla 1) pide polo/cero y sus coordenadas, sin mover el cursor. H(z) (tecla 2) muestra el diseno actual sin guardarlo. Mas/ENTER ofrece pares conjugados, mover, eliminar, autoescala y Guardar y volver. Flechas mueven el cursor; +/- zoom; 0 autoescala. ESC/Salir pregunta si hay cambios: guardar en Recientes, descartar o seguir. K se edita en el menu de resultados. Se permiten modelos inestables y no causales para teoria.",SSAccent(6));
    op:=5;
  END;
  REPEAT
    IF recalcular THEN
      // Reducir solo ceros iniciales exactos, nunca coeficientes pequenos reales.
      WHILE SIZE(b)>1 AND b(1)==0 DO b:=MAKELIST(b(k),k,2,SIZE(b),1); END;
      ganancia:=b(1)/a(1); b:=b/a(1); a:=a/a(1);
      nulo:=SIZE(b)==1 AND b(1)==0;
      z:=SSPolyRoots(b); p:=SSPolyRoots(a); completo:=1;
      IF SIZE(z)<>SIZE(b)-1 OR SIZE(p)<>SIZE(a)-1 THEN completo:=0; END;
      FOR k FROM 1 TO SIZE(z) DO IF SSIsDrawable(z(k))==0 THEN completo:=0; END; END;
      FOR k FROM 1 TO SIZE(p) DO IF SSIsDrawable(p(k))==0 THEN completo:=0; END; END;
      recalcular:=0;
    END;
    variable:="z"; IF dom==1 THEN variable:="s"; END;
    expr:="("+SSPolyText(b,variable)+")/("+SSPolyText(a,variable)+")";
    causal:=SIZE(b)<=SIZE(a);
    est:="Polos estrictamente en la region estable (hipotesis causal).";
    IF completo==0 THEN est:="Raices incompletas o no evaluables: estabilidad NO determinada.";
    ELSE
      FOR k FROM 1 TO SIZE(p) DO
        IF (dom==2 AND ABS(p(k))>=1-1E-9) OR (dom==1 AND RE(p(k))>=-1E-9) THEN est:="Hay polos fuera o a menos de 1E-9 de la frontera: no certificar estabilidad."; END;
      END;
    END;
    contexto:=est+"\nSin cancelar polos/ceros comunes. Las raices repetidas o cercanas son sensibles al redondeo; la tabla conserva sus multiplicidades. La estabilidad bilateral depende tambien de la ROC. K es el factor del cociente factorizado, no necesariamente la ganancia DC.\n";
    IF causal THEN contexto:=contexto+"Grado numerador <= denominador: se puede obtener una forma causal en z^-1.";
    ELSE contexto:=contexto+"Grado numerador > denominador: requiere anticipos. Se permite estudiarlo, pero no aplicarlo como filtro causal."; END;
    IF dom==1 THEN contexto:=est+"\nAnalisis continuo en s, sin cancelar factores. Para disenar y aplicar un filtro digital use el plano z."; END;
    IF nulo THEN contexto:=contexto+"\nH es identicamente cero: sus ceros no son una lista finita. Los polos mostrados pertenecen al denominador no reducido."; END;
    IF op<>5 OR entrada<>2 THEN op:=SSMenu({"Analisis interactivo de H("+variable+")",{3,"Analisis interactivo de H("+variable+")",{{"Numerador descendente en "+variable,b,0,1},{"Denominador descendente en "+variable,a,0,1},{"H("+variable+")",expr},{"Ceros",z},{"Polos",p},{"Ganancia K",ganancia}},contexto},10},{"Diagrama polos y ceros","Valores y estabilidad","Formula H("+variable+")","Editar coeficientes de H","Posicionar polos y ceros","Editar ganancia K","Magnitud y fase","Aplicar a una senal","Coeficientes y exportacion","Volver"},op); END;
    entrada:=0;
    IF op==0 OR op==10 THEN RETURN 1; END;
    IF op==1 THEN
      IF completo AND nulo==0 THEN SSPlotPZ(z,p,dom,{"Polos y ceros de H("+variable+")",0});
      ELSE SSInfoView("Diagrama no disponible","No presentar raices parciales",contexto,SSAccent(7)); END;
    END;
    IF op==2 THEN SSResultBrowse("Polos y ceros","Valores actuales",{{"Ceros (con multiplicidad)",z},{"Polos (con multiplicidad)",p},{"Ganancia K",ganancia},{"Estado",est}},"H("+variable+")="+expr,contexto); END;
    IF op==3 THEN SSSymbolicResults("Funcion de transferencia","H("+variable+") actual",expr,"K="+STRING(ganancia),contexto); END;
    IF op==4 THEN
      bd:=b; ad:=a;
      IF dom==2 THEN
        len:=MAX(SIZE(b),SIZE(a));
        IF SIZE(b)<len THEN bd:=CONCAT(MAKELIST(0,k,1,len-SIZE(b),1),b); END;
        IF SIZE(a)<len THEN ad:=CONCAT(MAKELIST(0,k,1,len-SIZE(a),1),a); END;
        SSInfoView("Editar H(z)","Coeficientes de z^0,z^-1,...","b={b0,b1,...}, a={a0,a1,...}. Se mantienen los retardos: ceros al INICIO de b son retardos puros. Al cancelar se conserva H anterior. a0 debe ser no nulo para esta carga causal.",SSAccent(7));
      END;
      IF dom==2 THEN r:=SSReadTransfer("Polos/ceros digital",bd,ad);
      ELSE r:=SSReadTransfer("Editar polos y ceros",bd,ad); END;
      IF SIZE(r)==2 THEN
        IF MAX(SIZE(r(1)),SIZE(r(2)))<=33 THEN
          b:=r(1); a:=r(2); IF dom==2 THEN len:=MAX(SIZE(b),SIZE(a)); b:=SSPad(b,len); a:=SSPad(a,len); END;
          recalcular:=1;
        ELSE SSInfoView("Cambio no aplicado","Hasta grado 32","Se conserva la funcion anterior.",SSAccent(7)); END;
      END;
      r:={}; bd:={}; ad:={};
    END;
    IF op==5 THEN
      IF dom<>2 OR completo==0 OR nulo THEN SSInfoView("Editor no disponible","Diseno digital en plano z","Se necesitan raices completas y H no nula. Para continuo puede editar los coeficientes. Para disenar un filtro nuevo vuelva y elija Disenar ubicando polos y ceros.",SSAccent(7));
      ELSE
        r:=SSPlotPZ(z,p,2,{"Editor: plano z",1,ganancia});
        IF SIZE(r)==2 THEN
          bn:={ganancia}; an:={1}; bueno:=1;
          IFERR
            bd:=r(1); ad:=r(2);
            FOR k FROM 1 TO SIZE(bd) DO bn:=SSConv(bn,{1,-bd(k)}); END;
            FOR k FROM 1 TO SIZE(ad) DO an:=SSConv(an,{1,-ad(k)}); END;
            FOR k FROM 1 TO SIZE(bn) DO IF SSIsDrawable(bn(k))==0 THEN bueno:=0; END; END;
            FOR k FROM 1 TO SIZE(an) DO IF SSIsDrawable(an(k))==0 THEN bueno:=0; END; END;
          THEN bueno:=0; END;
          IF bueno THEN b:=bn; a:=an; z:=r(1); p:=r(2); completo:=1; recalcular:=0;
          ELSE SSInfoView("Diseno no aplicado","Error o desbordamiento","Se conserva la funcion anterior. Use raices de menor modulo u orden.",SSAccent(7)); END;
        END;
        r:={}; bn:={}; an:={}; bd:={}; ad:={};
      END;
    END;
    IF op==6 THEN
      nuevaGanancia:=ganancia;
      IF INPUT(nuevaGanancia,"Factor de ganancia","K=","Numero finito no nulo; NO ganancia DC",ganancia) THEN
        IF SSIsDrawable(nuevaGanancia) AND ganancia<>0 THEN
          IF ABS(nuevaGanancia)>0 THEN
            bueno:=1;
            IFERR bn:=b*(nuevaGanancia/ganancia); FOR k FROM 1 TO SIZE(bn) DO IF SSIsDrawable(bn(k))==0 THEN bueno:=0; END; END; THEN bueno:=0; END;
            IF bueno THEN b:=bn; ganancia:=nuevaGanancia; END; bn:={};
          END;
        END;
      END;
    END;
    IF op==7 THEN
      IF dom==2 THEN
        sub:=SSMenu("Respuesta del diseno",{"Magnitud |H(e^jw)|","Fase en radianes","Magnitud en dB","Volver"},1);
        IF sub>=1 AND sub<=3 THEN
          // Igualar grados antes de invertir a potencias de z^-1; admite anticipos.
          len:=MAX(SIZE(b),SIZE(a)); bd:=b; ad:=a;
          IF SIZE(bd)<len THEN bd:=CONCAT(MAKELIST(0,k,1,len-SIZE(bd),1),bd); END;
          IF SIZE(ad)<len THEN ad:=CONCAT(MAKELIST(0,k,1,len-SIZE(ad),1),ad); END;
          espectro:=SSFResponse(bd,ad,201); bd:={}; ad:={};
          IF sub==2 THEN y:=SSPhase(espectro); SSPlotXY(y,-pirad,2*pirad/200,"Fase del diseno","w rad/muestra | fase rad; 201 puntos");
          ELSE
            y:=espectro;
            FOR k FROM 1 TO SIZE(y) DO
              IF SSIsDrawable(y(k)) THEN
                IF sub==1 THEN y(k):=ABS(y(k));
                ELSE IF ABS(y(k))>0 THEN y(k):=20*LOG(ABS(y(k))); ELSE y(k):=SSNegInf(); END; END;
              END;
            END;
            SSPlotXY(y,-pirad,2*pirad/200,"Magnitud del diseno","w rad/muestra | opcion "+STRING(sub)+"; 201 puntos");
          END;
          y:={}; espectro:={};
        END;
      ELSE SSInfoView("Respuesta continua","Plano s","Use Respuesta lineal H(jw) o Bode con estos coeficientes. Este centro grafica la respuesta digital en el plano z.",SSAccent(7)); END;
    END;
    IF op==8 OR op==9 THEN
      IF dom==2 AND causal THEN
        bd:=b; ad:=a;
        IF SIZE(b)<SIZE(a) THEN bd:=CONCAT(MAKELIST(0,k,1,SIZE(a)-SIZE(b),1),b); END;
        IF op==9 THEN
          sub:=SSMenu("Coeficientes del filtro",{"Tabla numerador b[k]","Tabla denominador a[k]","Exportar b[k]","Exportar a[k]","Volver"},1);
          IF sub==1 THEN SSDataView(bd,0,1,"b[k]: potencias z^-k","k","b[k]",SSAccent(6)); END;
          IF sub==2 THEN SSDataView(ad,0,1,"a[k]: potencias z^-k","k","a[k]",SSAccent(6)); END;
          IF sub==3 THEN SSExportData(bd,0,1,"Numerador b[k] del filtro"); END;
          IF sub==4 THEN SSExportData(ad,0,1,"Denominador a[k] del filtro"); END;
        ELSE
          SSInfoView("Aplicar filtro causal","Estado inicial cero",contexto+"\nNo se cambian polos por estabilidad. Una salida finita no demuestra estabilidad. Se conserva la longitud de la entrada; cola posterior no incluida.",SSAccent(6));
          sub:=SSMenu("Aplicar el diseno actual",{"Continuar con esta H(z)","Cancelar"},2);
          IF sub==1 THEN
            x:=SSReadList("Entrada del filtro","x[n]=","Secuencia finita",{1,0,0,0,0,0,0,0});
            IF SIZE(x)>0 THEN
              bueno:=1; FOR k FROM 1 TO SIZE(x) DO IF SSIsDrawable(x(k))==0 THEN bueno:=0; END; END;
              IF bueno THEN IFERR y:=SSDiffEq(bd,ad,x); THEN bueno:=0; END; END;
              IF bueno THEN FOR k FROM 1 TO SIZE(y) DO IF SSIsDrawable(y(k))==0 THEN bueno:=0; END; END; END;
              IF bueno THEN
                SSEVAL_EVENTS:={};
                sub:=1;
                REPEAT
                  sub:=SSMenu({"Salida del filtro disenado",{3,"Salida del filtro disenado",{{"Salida y[n]",y,0,1},{"Numerador aplicado",bd,0,1},{"Denominador aplicado",ad,0,1}},"Salida del filtro del editor. Estado inicial nulo."},4},{"Tabla y[n]","Grafico y[n]","Exportar y[n]","Volver al diseno"},sub);
                  IF sub==0 OR sub==4 THEN BREAK; END;
                  IF sub==1 THEN SSDataView(y,0,1,"Salida y[n] del diseno","n","y[n]",SSAccent(6)); END;
                  IF sub==2 THEN SSPlotDiscrete(y,0,1,"Salida y[n] del diseno","n local desde 0"); END;
                  IF sub==3 THEN SSExportData(y,0,1,"Salida del filtro por polos/ceros"); END;
                UNTIL 0;
              ELSE SSInfoView("Salida no disponible","Datos invalidos o desbordamiento","No se sustituyen errores por ceros. El diseno se conserva; revise polos, ganancia y entrada.",SSAccent(7)); END;
            END;
            x:={}; y:={};
          END;
        END;
        bd:={}; ad:={};
      ELSE
        IF op==9 THEN SSDataView(b,0,1,"Numerador: orden descendente","#","coef",SSAccent(7)); SSDataView(a,0,1,"Denominador: orden descendente","#","coef",SSAccent(7));
        ELSE SSInfoView("No aplicable como filtro causal","La funcion se conserva",contexto,SSAccent(7)); END;
      END;
    END;
  UNTIL 0;
END;

UIContinuousConv()
BEGIN
  LOCAL f:="Heaviside(X)";
  LOCAL g:="Dirac(X+5)+Dirac(X-5)";
  LOCAL t0:=0;
  LOCAL t1:=4;
  LOCAL N:=81;
  LOCAL dt;
  LOCAL x;
  LOCAL h;
  LOCAL y;
  LOCAL hasDirac:=0;
  LOCAL nota:="";
  IF INPUT(f,"Convolucion continua numerica","x(t)=","Use X. Se admite Heaviside y Dirac",f)==0 THEN RETURN 0; END;
  IF INPUT(g,"Convolucion continua numerica","h(t)=","Use X. Ej.: Dirac(X-1)",g)==0 THEN RETURN 0; END;
  hasDirac:=INSTRING(UPPER(f+g),"DIRAC(")>0;
  IF hasDirac THEN
    t0:=-10; t1:=10; N:=201;
    SSInfoView("SignalLab","Aviso","Se detecto Dirac(...).\nSe representara por un pulso gaussiano de area unitaria.\nAjuste el intervalo para incluir cada impulso.",SSAccent(1));
  END;
  IF INPUT(t0,"Ventana numerica comun","t minimo=","x(t) y h(t) se truncan aqui",t0)==0 THEN RETURN 0; END;
  IF INPUT(t1,"Ventana numerica comun","t maximo=","Debe incluir todos los impulsos",t1)==0 THEN RETURN 0; END;
  IF INPUT(N,"Resolucion de la convolucion","muestras N=","Entre 11 y 1024",N)==0 THEN RETURN 0; END;
  N:=MAX(11,MIN(1024,FLOOR(N)));
  IF t1<=t0 THEN SSInfoView("SignalLab","Aviso","El limite superior debe ser mayor que el inferior.",SSAccent(1)); RETURN 0; END;
  dt:=(t1-t0)/(N-1);
  x:=SSEvalExpr(f,t0,dt,N); h:=SSEvalExpr(g,t0,dt,N);
  IF SIZE(x)==0 OR SIZE(h)==0 THEN RETURN 0; END;
  y:=SSConv(x,h); IF SIZE(y)==0 THEN RETURN 0; END;
  FOR N FROM 1 TO SIZE(y) DO IF SSIsDrawable(y(N)) THEN y(N):=y(N)*dt; END; END;
  IF hasDirac THEN nota:="\nDirac: aprox. gaussiana, sigma=Delta t"; END;
  SSConvContinuousResults(x,h,y,t0,t1,dt,f,g,nota); RETURN 1;
END;

VIEW "Sistemas LTI - Convolucion",UI_LTI()
BEGIN
  LOCAL op:=1;
  REPEAT
    SSEVAL_EVENTS:={}; SSREAD_META:={};
    op:=SSMenu("Sistemas LTI",{"Convolucion discreta x[n]*h[n]","Convolucion continua numerica","Correlacion y autocorrelacion","Resolver ecuacion en diferencias","Respuesta a impulso o escalon","Polos, ceros y estabilidad","Conceptos y propiedades LTI","Volver al inicio"},op);
    IF op==0 THEN RETURN 0; END;
    IF op==1 THEN UIConvolution(); END;
    IF op==2 THEN UIContinuousConv(); END;
    IF op==3 THEN UICorrelation(); END;
    IF op==4 THEN UIDiffEquation(); END;
    IF op==5 THEN UIResponses(); END;
    IF op==6 THEN UIPolesZeros(); END;
    IF op==7 THEN SSTheoryView("Sistemas LTI",{"DEFINICION. LTI significa lineal e invariante en el tiempo. La salida se obtiene por convolucion y=x*h.","PROPIEDADES. La convolucion es conmutativa, asociativa y distributiva. Un sistema es causal si h[n]=0 para n<0 o h(t)=0 para t<0.","ESTABILIDAD. BIBO exige suma o integral absoluta finita de h. Polos dentro del circulo unidad indican estabilidad discreta; polos en semiplano izquierdo, estabilidad continua.","USO. Numerador y denominador se cargan consecutivamente. Las secuencias conservan su indice inicial y los graficos abren la tabla con ENTER."},SSAccent(2)); END;
  UNTIL op==8; RETURN 1;
END;

// ---------- Modulo Transformadas ----------

UICASTransform(tipo)
BEGIN
  LOCAL f;
  LOCAL cmd;
  LOCAL titulo;
  LOCAL datos:=SSTransformGuide(tipo);
  IF tipo==1 THEN f:="exp(-2*t)*Heaviside(t)"; titulo:="Laplace"; END;
  IF tipo==2 THEN f:="1/(s+2)"; titulo:="Laplace inversa"; END;
  IF tipo==3 THEN f:="(0.5)^n*Heaviside(n)"; titulo:="Transformada Z"; END;
  IF tipo==4 THEN f:="z/(z-0.5)"; titulo:="Z inversa"; END;
  f:=SSRecentExpression(titulo,f);
  SSInfoView(titulo,"Guia de entrada",datos(3),SSAccent(3));
  IF INPUT(f,titulo,datos(1),datos(2),f)==0 THEN RETURN 0; END;
  IF tipo==1 THEN cmd:="laplace("+f+",t,s)"; END;
  IF tipo==2 THEN cmd:="ilaplace("+f+",s,t)"; END;
  IF tipo==3 THEN cmd:="ztrans("+f+",n,z)"; END;
  IF tipo==4 THEN cmd:="invztrans("+f+",z,n)"; END;
  RETURN SSCASRunTransform(tipo,f,cmd,titulo);
END;

SSZSequenceExpr(x,n0)
BEGIN
  LOCAL k;
  LOCAL n;
  LOCAL term;
  LOCAL out:="";
  FOR k FROM 1 TO SIZE(x) DO
    IF x(k)<>0 THEN
      n:=FLOOR(n0)+k-1; term:="("+STRING(RE(x(k)),1,12,{3,".E-",0})+"+("+STRING(IM(x(k)),1,12,{3,".E-",0})+")*i)";
      IF n>0 THEN term:=term+"*z^(-"+STRING(n)+")"; END;
      IF n<0 THEN term:=term+"*z^("+STRING(-n)+")"; END;
      IF out<>"" THEN out:=out+" + "; END;
      out:=out+term;
    END;
  END;
  IF out=="" THEN out:="0"; END;
  RETURN out;
END;

UIZTransform()
BEGIN
  LOCAL modo:=1;
  LOCAL x:={1,2,1};
  LOCAL n0:=0;
  LOCAL f:="(0.5)^n*Heaviside(n)";
  LOCAL expr;
  LOCAL res;
  LOCAL datos:=SSTransformGuide(3);
  LOCAL opcion:=1;
  LOCAL radio:=1;
  LOCAL nuevo;
  LOCAL Nw:=101;
  LOCAL pirad:=3.141592653589793;
  LOCAL dw;
  LOCAL k;
  LOCAL j;
  LOCAL w;
  LOCAL punto;
  LOCAL valor;
  LOCAL texto;
  LOCAL spec:={};
  LOCAL mag;
  LOCAL fase;
  LOCAL validos;
  LOCAL parteReal;
  LOCAL parteImag;
  LOCAL textoReal;
  LOCAL textoImag;
  LOCAL diagnostico:="";
  LOCAL nota;
  LOCAL entrada;
  modo:=SSMenu("Transformada Z",{"Secuencia finita con indices","Expresion CAS y graficos","Simbolica: tablas y CAS","Volver"},modo);
  IF modo==0 OR modo==4 THEN RETURN 0; END;
  IF modo==3 THEN
    SSInfoView("Z simbolica","Unilateral, n>=0","Use n o X como indice. Ej: COS(n/4), exp(-2*n), Dirac(n-3). Se muestran formula y condiciones; esta consulta no cambia la ruta CAS con graficos existente. La ROC completa no siempre se determina.",SSAccent(3));
    IF INPUT(f,"Z simbolica","x[n]=","Use n o X; sin ztrans(...) alrededor",f)==0 THEN RETURN 0; END;
    RETURN SSCASRunTransform(3,f,"","Z simbolica");
  END;
  IF modo==2 THEN
    f:=SSRecentExpression("Transformada Z",f);
    SSInfoView("Transformada Z simbolica","Guia de entrada",datos(3),SSAccent(3));
    IF INPUT(f,"Transformada Z simbolica",datos(1),datos(2),f)==0 THEN RETURN 0; END;
    expr:="ztrans("+f+",n,z)";
    res:=SSCASTransformString(3,f,expr);
    IF res=="" THEN res:=SSCASString(expr); END;
    IF res=="" OR INSTRING(UPPER(res),"ZTRANS(")>0 THEN
      SSInfoView("Transformada Z","Sin resultado evaluado","El CAS no resolvio la transformada. Revise n minuscula, la sintaxis y las variables libres. No se puede graficar una instruccion pendiente.",SSAccent(7)); RETURN 0;
    END;
    entrada:="x[n]="+f;
    nota:=datos(3)+"\nGrafico: evaluacion de la expresion X(z) sobre z=r*exp(i*w), NO sobre todo el plano complejo. El radio r debe pertenecer a la ROC para representar la transformada de la secuencia. La app no deduce ni verifica esa ROC. r=1 corresponde a DTFT solo si el circulo unidad esta en la ROC; fuera de ella es solo la continuacion algebraica de X(z). Mantenga z libre en CAS. No se cambian ajustes ni asignaciones.";
  ELSE
  x:=SSReadList("Transformada Z","x[n]=","Lista finita",x); IF SIZE(x)==0 THEN RETURN 0; END;
  n0:=SSReadOrigin(0);
  IF SSReadStep(1)<>1 THEN
    SSInfoView("Transformada Z","Indice discreto, no tiempo","La transformada Z utiliza indices enteros separados por 1. El paso temporal del banco no se usa como indice n. Indique a continuacion el indice de la primera muestra.",SSAccent(3)); n0:=0;
  END;
  IF INPUT(n0,"Indices de x[n]","n inicial=","Indice entero asociado a x(1)",n0)==0 THEN RETURN 0; END;
  IF TYPE(n0)<>0 THEN SSInfoView("SignalLab","Aviso","Use un indice entero real.",SSAccent(1)); RETURN 0; END;
  IF n0<>FLOOR(n0) OR ABS(n0)>1E6 THEN SSInfoView("SignalLab","Aviso","Use n inicial entero, |n|<=1E6.",SSAccent(1)); RETURN 0; END;
  IF SIZE(x)>1024 THEN SSInfoView("SignalLab","Aviso","Use como maximo 1024 muestras.",SSAccent(1)); RETURN 0; END;
  FOR j FROM 1 TO SIZE(x) DO IF SSIsDrawable(x(j))==0 THEN SSInfoView("SignalLab","Aviso","La entrada debe contener valores finitos.",SSAccent(1)); RETURN 0; END; END;
  expr:=SSZSequenceExpr(x,n0);
  res:=expr;
  IF DIM(expr)<=6000 THEN res:=SSCASString("simplify("+expr+")"); IF res=="" THEN res:=expr; END; END;
  entrada:=SSListMath(x,n0,"x");
  nota:="X(z)=sum x[n]*z^(-n). Soporte n="+STRING(n0)+"..."+STRING(n0+SIZE(x)-1)+". El indice inicial se aplica a la primera muestra. Para secuencia finita, todo radio finito r>0 esta en la ROC. Cero o infinito pueden excluirse segun las potencias. El grafico evalua la suma con los datos almacenados sobre z=r*exp(i*w); la formula usa la precision textual de STRING. r=1 da la DTFT de esta secuencia finita.";
  END;
  SSEVAL_EVENTS:={};
  REPEAT
    opcion:=SSMenu({"Resultados de transformada Z",{3,"Resultados de transformada Z",{{"X(z)",res},{"Entrada",entrada},{"Radio r",radio},{"Contorno calculado",spec,-pirad,2*pirad/(Nw-1)}},nota},8},{"Formula X(z) Textbook","Magnitud sobre z=r*exp(i*w)","Fase sobre z=r*exp(i*w)","Tabla compleja de X(z)","Exportar valores del contorno","Cambiar radio r","Entrada y region de convergencia","Volver"},opcion);
    IF opcion==0 OR opcion==8 THEN RETURN 1; END;
    IF opcion==1 THEN SSSymbolicResults("Transformada Z","X(z) - resultado en z",res,entrada,nota); END;
    IF opcion>=2 AND opcion<=5 THEN
      IF SIZE(spec)==0 THEN
        dw:=2*pirad/(Nw-1); spec:=MAKELIST(SSUndef(),k,1,Nw,1); mag:=spec; fase:=spec; validos:=0; diagnostico:="";
        SSHeader("Evaluando X(z)","101 puntos; r="+STRING(radio),SSAccent(3));
        FOR k FROM 0 TO Nw-1 DO
          w:=-pirad+k*dw; punto:=radio*EXP((0,1)*w); valor:=SSUndef();
          // Puntos reales exactos: no ocultar polos por residuos de exp(i*pi).
          IF k==0 OR k==Nw-1 THEN punto:=-radio; END;
          IF k==(Nw-1)/2 THEN punto:=radio; END;
          IF modo==1 THEN
            IFERR
              valor:=0;
              FOR j FROM 1 TO SIZE(x) DO
                IF x(j)<>0 THEN valor:=valor+x(j)*punto^(-(n0+j-1)); END;
              END;
            THEN valor:=SSUndef(); END;
          ELSE
            // STRING sin opciones hereda coma decimal y agrupacion de Home.
            // Una coma decimal dentro de subst se confunde con un argumento.
            // Formato interno: estandar, precision 12, sin grupos, punto,
            // exponente E y signo ASCII. No se modifican ajustes de usuario.
            textoReal:=STRING(RE(punto),1,12,{3,".E-",0});
            textoImag:=STRING(IM(punto),1,12,{3,".E-",0});
            texto:="subst(("+res+"),z=("+textoReal+"+("+textoImag+")*i))";
            // Ejecutar comandos completos; no pasar una variable de texto
            // a CAS.evalf ni interpretar en Home la notacion compleja del CAS.
            // Solo cruzan la frontera dos escalares reales, luego se recompone.
            textoReal:=SSCASString("evalf(RE("+texto+"))");
            textoImag:=SSCASString("evalf(IM("+texto+"))");
            IFERR
              IF textoReal<>"" AND textoImag<>"" THEN
                parteReal:=EXPR(textoReal)+0.0; parteImag:=EXPR(textoImag)+0.0;
                IF TYPE(parteReal)==0 AND TYPE(parteImag)==0 THEN
                  IF SSIsDrawable(parteReal) AND SSIsDrawable(parteImag) THEN valor:=parteReal+(0,1)*parteImag; END;
                END;
              END;
            THEN valor:=SSUndef(); END;
            IF SSIsDrawable(valor)==0 AND diagnostico=="" THEN
              diagnostico:=" | Primer N/D: w="+STRING(w)+" | z interno=("+STRING(RE(punto),1,12,{3,".E-",0})+")+("+STRING(IM(punto),1,12,{3,".E-",0})+")*i | Re CAS: "+MID(textoReal,1,120)+" | Im CAS: "+MID(textoImag,1,120);
            END;
          END;
          IF SSIsDrawable(valor) THEN
            spec(k+1):=valor; mag(k+1):=ABS(valor); fase(k+1):=SSUndef(); validos:=validos+1;
            IF ABS(valor)>0 THEN fase(k+1):=IM(LN((RE(valor)/ABS(valor),IM(valor)/ABS(valor)))); END;
          END;
        END;
        IF validos==0 THEN
          SSInfoView("Grafico Z","Sin puntos evaluables","No se obtuvieron valores numericos finitos. Revise el resultado CAS, variables libres o radio. No se reemplazan errores por ceros. La formula permanece disponible."+diagnostico,SSAccent(7)); spec:={};
        ELSE
          IF validos<Nw THEN SSInfoView("Grafico Z",STRING(validos)+"/"+STRING(Nw)+" puntos evaluables",STRING(Nw-validos)+" puntos quedan N/D y cortan la curva. Pueden ser polos, desbordamientos o evaluaciones pendientes. Si solo quedan puntos aislados, no representan una curva completa. La malla no detecta todos los polos."+diagnostico,SSAccent(3)); END;
        END;
      END;
      IF SIZE(spec)>0 THEN
        IF opcion==2 THEN
          IF modo==1 THEN SSPlotXY(mag,-pirad,dw,"Magnitud |X(r*exp(i*w))|",{"w rad/muestra; r="+STRING(radio),"RESPONSE",x,{n0,radio},5,1});
          ELSE SSPlotXY(mag,-pirad,dw,"Magnitud |X(r*exp(i*w))|",{"w rad/muestra; r="+STRING(radio),"RESPONSE",res,radio,4,1}); END;
        END;
        IF opcion==3 THEN
          IF modo==1 THEN SSPlotXY(fase,-pirad,dw,"Fase X(r*exp(i*w))",{"Fase rad; r="+STRING(radio),"RESPONSE",x,{n0,radio},5,2});
          ELSE SSPlotXY(fase,-pirad,dw,"Fase X(r*exp(i*w))",{"Fase rad; r="+STRING(radio),"RESPONSE",res,radio,4,2}); END;
        END;
        IF opcion==4 THEN SSDataView(spec,-pirad,dw,"X(z), r="+STRING(radio),"w","X(z)",SSAccent(3)); END;
        IF opcion==5 THEN SSExportData(spec,-pirad,dw,"X(z) sobre r="+STRING(radio)+"; eje w rad"); END;
      END;
    END;
    IF opcion==6 THEN
      nuevo:=radio;
      IF INPUT(nuevo,"Contorno de transformada Z","r=","Real positivo 1E-6...1E6; revise ROC",radio) THEN
        IF TYPE(nuevo)<>0 THEN SSInfoView("SignalLab","Aviso","El radio debe ser real.",SSAccent(1));
        ELSE IF nuevo<1E-6 OR nuevo>1E6 THEN SSInfoView("SignalLab","Aviso","Use 1E-6 <= r <= 1E6.",SSAccent(1));
        ELSE radio:=nuevo; spec:={}; END; END;
      END;
    END;
    IF opcion==7 THEN SSInfoView("Transformada Z","Entrada, contorno y ROC",entrada+"\n"+nota+"\nr="+STRING(radio)+"; w=-pi...pi, 101 puntos. La fase esta en radianes; en ceros queda N/D. La exportacion guarda valores complejos y eje w, no coordenadas del plano z. Las curvas no son un diagrama de polos y ceros.",SSAccent(3)); END;
  UNTIL 0;
END;

UIODESolve()
BEGIN
  LOCAL eq:="diff(y(t),t$2)+2*diff(y(t),t)+5*y(t)=0";
  LOCAL cmd;
  IF INPUT(eq,"Ecuacion diferencial","Ecuacion=","Ej: diff(y(t),t)+y(t)=0",eq)==0 THEN RETURN 0; END;
  cmd:="desolve("+eq+",y(t))"; SSCASResult(cmd,"Solucion de la EDO",eq,"La incognita es y(t), con t como tiempo. Las constantes libres se determinan con condiciones iniciales. diff(y(t),t) representa la primera derivada y diff(y(t),t$2) la segunda."); RETURN 1;
END;

UIBilinear()
BEGIN
  LOCAL H:="1/(s+1)";
  LOCAL T:=1;
  LOCAL cmd;
  LOCAL periodo;
  LOCAL resultado:="";
  LOCAL nuevoH;
  LOCAL nuevoT;
  LOCAL nuevoResultado;
  LOCAL op:=1;
  LOCAL valido;
  LOCAL recalcular:=1;
  LOCAL nota:="Sustitucion bilineal s=(2/T)*(z-1)/(z+1). T en segundos; fs=1/T. No es una transformada Z de muestras ni agrega prewarping. La frecuencia analogica y la digital se relacionan por Omega=(2/T)*tan(w/2). No se modifican ajustes ni variables del usuario.";
  IF INPUT(H,"Transformacion bilineal","H(s)=","Expresion en s minuscula. Ej: 1/(s+1); decimales con punto",H)==0 THEN RETURN 0; END;
  IF INPUT(T,"Transformacion bilineal","T (s)=","Real positivo; ejemplos: 1, 0.1 o 1/10",T)==0 THEN RETURN 0; END;
  nuevoH:=H; nuevoT:=T;
  REPEAT
    IF recalcular THEN
      recalcular:=0; valido:=1;
      IF TYPE(nuevoH)<>2 OR TYPE(nuevoT)<>0 THEN valido:=0;
      ELSE
        IF DIM(nuevoH)<1 OR DIM(nuevoH)>4096 OR SSIsDrawable(nuevoT)==0 OR nuevoT<=0 THEN valido:=0; END;
        IF INSTRING(nuevoH,";")>0 OR INSTRING(nuevoH,":=")>0 THEN valido:=0; END;
      END;
      IF valido==0 THEN
        SSInfoView("Bilineal","Parametros no validos","H(s) debe ser una expresion de hasta 4096 caracteres, no una asignacion. T debe ser real, positivo y menor que 1E50 (limite numerico de la app). Se conserva el ultimo resultado si existe.",SSAccent(3));
      ELSE
        // No usar STRING(T) de pantalla dentro del CAS: la coma separa argumentos.
        periodo:=STRING(nuevoT,1,12,{3,".E-",0});
        IF SSCASString("eval(s)")<>"s" OR SSCASString("eval(z)")<>"z" THEN
          valido:=0;
          SSInfoView("Bilineal","Variables simbolicas ocupadas","s o z tienen valores asignados, o el CAS no pudo comprobar que estan libres. No se borraron ni cambiaron variables. Revise esas asignaciones antes de repetir; el resultado previo se conserva.",SSAccent(3));
        ELSE
          cmd:="simplify(subst(("+nuevoH+"),s,(2/("+periodo+"))*(z-1)/(z+1)))";
          nuevoResultado:=SSCASString(cmd);
          IF nuevoResultado=="" OR UPPER(nuevoResultado)=="NAN" OR INSTRING(UPPER(nuevoResultado),"UNDEF")>0 OR INSTRING(UPPER(nuevoResultado),"INFINITY")>0 OR INSTRING(UPPER(nuevoResultado),"SUBST(")>0 OR INSTRING(UPPER(nuevoResultado),"SIMPLIFY(")>0 THEN
            valido:=0;
            SSInfoView("Bilineal pendiente","No se obtuvo una expresion cerrada","No significa que la bilineal no exista. Revise H(s) y sus parametros. Orden enviada con decimal explicito:\n"+cmd+"\nNo se reemplazo el resultado anterior.",SSAccent(3));
          END;
        END;
        IF valido THEN H:=nuevoH; T:=nuevoT; resultado:=nuevoResultado; END;
        nuevoResultado:="";
      END;
    END;
    IF resultado=="" THEN
      op:=SSMenu("Bilineal sin resultado",{"Editar H(s)","Editar T","Volver"},1);
      IF op==0 OR op==3 THEN RETURN 0; END;
      IF op==1 THEN op:=3; ELSE op:=4; END;
    ELSE
      op:=SSMenu({"Resultado bilineal",{3,"Resultado bilineal",{{"H(s)",H},{"T en segundos",T},{"H(z)",resultado}},nota},5},{"H(z) Textbook","Sustitucion y unidades","Editar H(s)","Editar T","Volver"},op);
      IF op==0 OR op==5 THEN RETURN 1; END;
      IF op==1 THEN SSFormulaView("H(z) bilineal","T="+STRING(T)+" s",resultado,SSAccent(3)); END;
      IF op==2 THEN SSResultBrowse("Bilineal","Modelo y unidades",{{"Entrada H(s)",H},{"T (s)",T},{"fs (Hz), expresion","1/("+STRING(T,1,12,{3,".E-",0})+")"},{"Sustitucion", "s=(2/("+STRING(T,1,12,{3,".E-",0})+"))*(z-1)/(z+1)"}},"H(s)="+H,nota); END;
      nuevoH:=H; nuevoT:=T;
    END;
    IF op==3 THEN IF INPUT(nuevoH,"Editar bilineal","H(s)=","Use s minuscula y punto decimal; cancelar conserva el resultado",nuevoH) THEN recalcular:=1; END; END;
    IF op==4 THEN IF INPUT(nuevoT,"Editar bilineal","T (s)=","Real positivo; cancelar conserva el resultado",nuevoT) THEN recalcular:=1; END; END;
  UNTIL 0;
END;

UIFourierContinuous(tipo)
BEGIN
  LOCAL f:="EXP(-ABS(X))";
  LOCAL t0:=-8;
  LOCAL t1:=8;
  LOCAL Nt:=161;
  LOCAL wmax:=8;
  LOCAL Nw:=161;
  LOCAL dt;
  LOCAL dw;
  LOCAL x;
  LOCAL spec;
  LOCAL out;
  LOCAL idx;
  LOCAL T:=2*3.141592653589793;
  LOCAL k:=1;
  LOCAL ck:=0;
  LOCAL tren:=1;
  LOCAL amp:=1;
  LOCAL ancho:=1;
  LOCAL centro:=0;
  LOCAL offset:=0;
  LOCAL vista:=1;
  LOCAL orden:=10;
  LOCAL fase;
  LOCAL formula;
  LOCAL nota;
  LOCAL opcion:=1;
  LOCAL q;
  LOCAL pirad:=3.141592653589793;
  LOCAL editar;
  LOCAL candidato;
  LOCAL valor;
  LOCAL valido;
  LOCAL mathChoice:=1;
  LOCAL mathCache:={"","",""};
  LOCAL mathStatus:={"","",""};
  LOCAL integrando;
  LOCAL variable;
  LOCAL limiteA;
  LOCAL limiteB;
  LOCAL comando;
  LOCAL resultado;
  LOCAL resultText;
  LOCAL estadoMath;
  LOCAL tituloMath;
  LOCAL etiquetaMath;
  LOCAL muestrasMath;
  LOCAL serieAxis:="slfouriertime";
  LOCAL serieIndex:="slfourierharmonic";
  LOCAL serieFree;
  LOCAL seriePeriod;
  LOCAL serieRead;
  LOCAL serieTexts;
  LOCAL serieText;
  LOCAL seriePos;
  LOCAL serieEnd;
  LOCAL serieToken;
  LOCAL serieChars:="ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_";
  LOCAL serieSlot;
  LOCAL serieNonzero;
  LOCAL serieInput;
  LOCAL serieFunctions:="|ABS|COS|SIN|TAN|ACOS|ASIN|ATAN|COSH|SINH|TANH|EXP|LN|SQRT|RE|IM|SIGN|FLOOR|CEILING|";
  LOCAL origenMath;
  LOCAL pasoMath;
  LOCAL signoMath;
  LOCAL escalaMath;
  LOCAL terminoMath;
  LOCAL eventosSerie;
  LOCAL ctWeights;
  LOCAL ctLeft;
  LOCAL ctRight;
  LOCAL ctEps;
  LOCAL ctSideOK;
  LOCAL ctFallback;
  LOCAL ctPoint;
  LOCAL ctEvents;
  IF tipo<1 OR tipo>3 THEN RETURN 0; END;
  IF tipo==1 OR tipo==2 THEN
    opcion:=SSMenu("Modo de Fourier continua",{"Numerico: graficos y tablas","Simbolico: tablas y CAS","Volver"},1);
    IF opcion==0 OR opcion==3 THEN RETURN 0; END;
    IF opcion==2 THEN
      tituloMath:="Fourier simbolica"; etiquetaMath:="x(t)="; f:="Heaviside(X+1)-Heaviside(X-1)";
      IF tipo==2 THEN tituloMath:="Fourier inversa simbolica"; etiquetaMath:="X(w)="; f:="2/(1+X^2)"; END;
      SSInfoView(tituloMath,"Expresion completa, sin ventana","Use X como tiempo en directa o frecuencia angular en inversa. Se reconocen pares de tabla y linealidad; el resto se consulta al CAS. Ej: COS(2*X), Dirac(X-3), Heaviside(X+1)-Heaviside(X-1). sinc(v) significa sin(v)/v. Resultado bajo las condiciones indicadas; no se altera el grafico numerico. Parametros libres se conservan si no tienen valores CAS guardados.",SSAccent(4));
      IF INPUT(f,tituloMath,etiquetaMath,"Use X; multiplicaciones explicitas con *",f)==0 THEN RETURN 0; END;
      RETURN SSCASRunTransform(tipo+4,f,"",tituloMath);
    END;
  END;
  IF tipo==3 THEN
    tren:=SSMenu("Entrada serie continua",{"Expresion x(t)","Tren de pulsos rectangulares","Tren de impulsos Dirac","Volver"},1);
    IF tren==0 OR tren==4 THEN RETURN 0; END;
  END;
  IF tipo==3 AND tren>1 THEN
    T:=2;
    IF tren==2 THEN
      SSInfoView("Tren de pulsos","Parametros de la onda","B es el offset vertical: fuera del pulso vale B y dentro B+A. A es la altura relativa, con signo. Ancho es su duracion, entre 0 y T; centro es el centro temporal.\nEjemplo: T=2, A=2, B=-1, ancho=1, centro=0: onda entre -1 y 1, ciclo 50%.",SSAccent(4));
    ELSE
      SSInfoView("Tren de impulsos","Dirac ideal: AREA y nivel B","A es el area (peso) de cada Dirac, NO una altura. B es un nivel constante sumado al tren, independiente de A. Los impulsos ocurren en centro+m*T.\nEjemplo: T=2, A=1, B=3, centro=0: c[0]=3.5; c[k]=0.5 para k<>0.",SSAccent(4));
    END;
    IF INPUT(T,"Periodo del tren","T=","Periodo positivo. Ejemplo: 2",T)==0 THEN RETURN 0; END;
    IF TYPE(T)<>0 THEN SSInfoView("SignalLab","Aviso","T debe ser un numero real.",SSAccent(1)); RETURN 0; END;
    IF T<1E-100 OR T>1E100 THEN SSInfoView("SignalLab","Aviso","Use 1E-100 <= T <= 1E100.",SSAccent(1)); RETURN 0; END;
    f:="Amplitud del pulso"; nota:="Altura real con signo. Ejemplo: 1";
    IF tren==3 THEN f:="Area de cada impulso"; nota:="Peso real, NO altura. Ejemplo: 1"; END;
    IF INPUT(amp,f,"A=",nota,amp)==0 THEN RETURN 0; END;
    IF TYPE(amp)<>0 THEN SSInfoView("SignalLab","Aviso","A debe ser un numero real.",SSAccent(1)); RETURN 0; END;
    IF ABS(amp)>1E100 THEN SSInfoView("SignalLab","Aviso","Use |A| <= 1E100.",SSAccent(1)); RETURN 0; END;
    IF INPUT(offset,"Offset vertical del tren","B=","Nivel constante con signo. 0: sin offset",offset)==0 THEN RETURN 0; END;
    IF TYPE(offset)<>0 THEN SSInfoView("SignalLab","Aviso","B debe ser un numero real.",SSAccent(1)); RETURN 0; END;
    IF ABS(offset)>1E100 THEN SSInfoView("SignalLab","Aviso","Use |B| <= 1E100.",SSAccent(1)); RETURN 0; END;
    ancho:=T/2;
    IF tren==2 THEN
      IF INPUT(ancho,"Duracion de cada pulso","ancho=","Mismas unidades que T; 0 < ancho <= T",ancho)==0 THEN RETURN 0; END;
      IF TYPE(ancho)<>0 THEN SSInfoView("SignalLab","Aviso","El ancho debe ser real.",SSAccent(1)); RETURN 0; END;
      IF ancho<=0 OR ancho>T THEN SSInfoView("SignalLab","Aviso","Use 0 < ancho <= T.",SSAccent(1)); RETURN 0; END;
    END;
    IF INPUT(centro,"Desplazamiento temporal","centro=","Centro del pulso o posicion de Dirac. Ej: 0",centro)==0 THEN RETURN 0; END;
    IF TYPE(centro)<>0 THEN SSInfoView("SignalLab","Aviso","El centro debe ser real.",SSAccent(1)); RETURN 0; END;
    IF ABS(centro/T)>1E12 THEN SSInfoView("SignalLab","Aviso","Reduzca centro modulo T: |centro/T| <= 1E12.",SSAccent(1)); RETURN 0; END;
    centro:=centro-T*FLOOR(centro/T);
    IF INPUT(orden,"Armonicos de la serie","K=","Se calculan k=-K...K. Entero de 0 a 50",orden)==0 THEN RETURN 0; END;
    IF TYPE(orden)<>0 THEN SSInfoView("SignalLab","Aviso","K debe ser un entero real.",SSAccent(1)); RETURN 0; END;
    IF orden<>FLOOR(orden) OR orden<0 OR orden>50 THEN SSInfoView("SignalLab","Aviso","Use un entero 0 <= K <= 50.",SSAccent(1)); RETURN 0; END;
    REPEAT
    spec:=MAKELIST(0,idx,1,2*orden+1,1);
    fase:=spec;
    // Coeficientes analiticos: sin cuadratura ni aproximacion gaussiana de Dirac.
    FOR k FROM -orden TO orden DO
      IF tren==3 THEN
        ck:=amp/T;
      ELSE
        q:=k*ancho/T;
        ck:=amp*(ancho/T);
        IF k<>0 THEN
          IF q==FLOOR(q) AND q<>0 THEN
            ck:=0;
          ELSE
            // IM(exp(i*v)) calcula sen(v) en radianes sin cambiar modos.
            IF q<>0 THEN ck:=ck*IM(EXP((0,1)*pirad*q))/(pirad*q); END;
          END;
        END;
      END;
      ck:=ck*EXP((0,-1)*2*pirad*k*centro/T);
      // Sumar una constante cambia unicamente el coeficiente de continua.
      IF k==0 THEN ck:=ck+offset; END;
      spec(k+orden+1):=ck;
      IF ABS(ck)>0 THEN fase(k+orden+1):=IM(LN((RE(ck)/ABS(ck),IM(ck)/ABS(ck)))); ELSE fase(k+orden+1):=SSUndef(); END;
    END;
    // La representacion temporal es independiente de los coeficientes.
    Nt:=201; dt:=T/(Nt-1); t0:=centro-T/2;
    x:=MAKELIST(offset,idx,1,Nt,1); out:=x;
    FOR idx FROM 0 TO Nt-1 DO
      q:=idx/(Nt-1)-0.5;
      IF tren==2 THEN
        IF ABS(q)<ancho/(2*T) OR ancho==T THEN x(idx+1):=offset+amp; END;
        IF ancho<T AND ABS(ABS(q)-ancho/(2*T))<1E-14 THEN x(idx+1):=offset+amp/2; END;
      END;
      ck:=0;
      FOR k FROM -orden TO orden DO
        ck:=ck+spec(k+orden+1)*EXP((0,1)*2*pirad*k*(centro/T+q));
      END;
      out(idx+1):=RE(ck);
    END;
    formula:="("+STRING(amp,1,12,{3,".E-",0})+")/("+STRING(T,1,12,{3,".E-",0})+")*exp(-i*2*pi*k*("+STRING(centro,1,12,{3,".E-",0})+")/("+STRING(T,1,12,{3,".E-",0})+"))";
    nota:="Tren de Dirac: x(t)=B+A*sum delta(t-centro-m*T), m entero. A es AREA, no altura. B es el nivel continuo y no cambia el area de los impulsos. Entrada permite ver por separado B y las posiciones/areas de Dirac, sin mezclar sus unidades. La suma parcial incluye B, tiene picos finitos y no equivale a impulsos ideales.";
    IF tren==2 THEN
      formula:="("+STRING(amp,1,12,{3,".E-",0})+")*("+STRING(ancho/T,1,12,{3,".E-",0})+")*sin(pi*k*("+STRING(ancho/T,1,12,{3,".E-",0})+"))/(pi*k*("+STRING(ancho/T,1,12,{3,".E-",0})+"))*exp(-i*2*pi*k*("+STRING(centro,1,12,{3,".E-",0})+")/("+STRING(T,1,12,{3,".E-",0})+"))";
      nota:="Pulsos rectangulares con base B y nivel B+A dentro del pulso, centrados en centro+m*T, de duracion ancho. Ciclo de trabajo="+STRING(100*ancho/T)+"%. La formula para k<>0 usa sinc normalizada: sin(pi*u)/(pi*u). B solo se suma a c[0]. Si ancho=T, la senal es constante B+A. La vista temporal usa 201 puntos; los pulsos angostos pueden verse mal resueltos, sin afectar sus coeficientes. En saltos se muestra B+A/2; la suma parcial presenta Gibbs.";
    END;
    nota:=nota+"\nT="+STRING(T)+"; A="+STRING(amp)+"; centro equivalente="+STRING(centro)+"; K="+STRING(orden)+".\nc[0]="+STRING(spec(orden+1))+".\nx(t)=sum c[k]*exp(i*2*pi*k*t/T). Las lineas estan en k/T Hz si T esta en segundos. La fase se muestra en radianes; en c[k]=0 no esta definida y queda N/D. La exportacion guarda COEFICIENTES, no muestras de la entrada.";
    nota:=nota+"\nOffset B="+STRING(offset)+". Solo cambia c[0]; los armonicos k<>0 mantienen amplitud y fase.";
    IF tren==2 THEN nota:=nota+"\nAncho="+STRING(ancho)+"."; END;
    SSEVAL_EVENTS:={};
    REPEAT
      opcion:=SSMenu({"Fourier de tren periodico",{3,"Fourier de tren periodico",{{"Coeficientes c[k]",spec,-orden,1},{"Formula",formula},{"Periodo T",T},{"Amplitud/area A",amp},{"Offset B",offset},{"Ancho",ancho},{"Centro",centro},{"Tipo de tren",tren}},nota},10},{"Tabla de coeficientes c[k]","Magnitud por armonico","Fase en radianes","Formula Textbook y c[0]","Ver tren de entrada","Suma parcial de Fourier","Exportar coeficientes","Parametros e interpretacion","Editar parametros","Volver"},opcion);
      IF opcion==0 OR opcion==10 THEN RETURN 1; END;
      IF opcion==1 THEN SSDataView(spec,-orden,1,"Serie continua: c[k]","k","c[k]",SSAccent(4)); END;
      IF opcion==2 THEN SSPlotDiscrete(SSMag(spec),-orden,1,"Magnitud |c[k]|","k"); END;
      IF opcion==3 THEN SSPlotDiscrete(fase,-orden,1,"Fase c[k] en radianes","k"); END;
      IF opcion==4 THEN
        SSFormulaView("Serie continua","c[k] para k<>0; c[0] a continuacion",formula,SSAccent(4));
        SSInfoView("Componente continua","Incluye el offset B","c[0]="+STRING(spec(orden+1))+"\nValor medio en un periodo. Pulsos: B+A*ancho/T. Dirac: B+A/T, con A como area.\nB="+STRING(offset)+". Los demas coeficientes no cambian al sumar B.",SSAccent(4));
      END;
      IF opcion==5 THEN
        IF tren==2 THEN
          SSPlotXY(x,t0,dt,"Tren de pulsos: un periodo","B="+SSFmt(offset,4)+" | saltos: B+A/2");
        ELSE
          REPEAT
            vista:=SSMenu("Entrada B + tren Dirac",{"Nivel continuo B","Impulsos: posiciones y areas","Volver"},1);
            IF vista==1 THEN SSPlotXY(x,t0,dt,"Nivel continuo del tren","B="+SSFmt(offset,4)+"; Dirac se consulta aparte"); END;
            IF vista==2 THEN
              SSInfoView("Representacion de Dirac","Los tallos indican AREAS","Tres impulsos en centro-T, centro y centro+T. A es el area, no una altura finita. B="+STRING(offset)+" se muestra en Nivel continuo B. La tabla de tallos contiene posiciones y areas: no se suma B a sus pesos. Para ver ambos aportes juntos consulte Suma parcial de Fourier.",SSAccent(4));
              SSPlotDiscrete({amp,amp,amp},centro-T,T,"Tren Dirac: tallos=areas","t");
            END;
          UNTIL vista==0 OR vista==3;
        END;
      END;
      IF opcion==6 THEN SSPlotXY(out,t0,dt,"Suma parcial: -K a K","Aproximacion finita; no Dirac ideal"); END;
      IF opcion==7 THEN SSExportData(spec,-orden,1,"Serie continua c[k], tren periodico"); END;
      IF opcion==8 THEN SSInfoView("Tren periodico","Parametros y convenciones",nota,SSAccent(4)); END;
      IF opcion==9 THEN
        candidato:={T,amp,offset,ancho,centro,orden}; valido:=0;
        editar:=SSMenu("Editar tren periodico",{"Periodo T","Altura o area A","Offset vertical B","Ancho (solo pulsos)","Centro temporal","Armonicos K","Volver al resultado"},1);
        IF editar>=1 AND editar<=6 THEN
          IF editar==4 AND tren==3 THEN SSInfoView("SignalLab","Aviso","Un Dirac ideal no tiene ancho finito.",SSAccent(1));
          ELSE
            valor:=candidato(editar);
            IF INPUT(valor,"Editar parametro","Valor=","Los demas parametros se conservan",valor) THEN candidato(editar):=valor; valido:=1; END;
          END;
        END;
        IF valido==1 THEN
          FOR idx FROM 1 TO 6 DO IF TYPE(candidato(idx))<>0 THEN valido:=0; END; END;
          IF valido==1 THEN
            IF candidato(1)<1E-100 OR candidato(1)>1E100 OR ABS(candidato(2))>1E100 OR ABS(candidato(3))>1E100 OR candidato(6)<0 OR candidato(6)>50 OR candidato(6)<>FLOOR(candidato(6)) THEN valido:=0; END;
            IF valido==1 THEN
              IF ABS(candidato(5)/candidato(1))>1E12 THEN valido:=0; END;
              IF tren==2 THEN IF candidato(4)<=0 OR candidato(4)>candidato(1) THEN valido:=0; END; END;
            END;
          END;
          IF valido==1 THEN
            T:=candidato(1); amp:=candidato(2); offset:=candidato(3); ancho:=candidato(4); centro:=candidato(5); orden:=candidato(6);
            centro:=centro-T*FLOOR(centro/T);
          ELSE SSInfoView("SignalLab","Aviso","Cambio invalido. Se conserva el tren anterior; ancho debe ser <= T.",SSAccent(1)); opcion:=1; END;
        ELSE opcion:=1; END;
      END;
    UNTIL opcion==9;
    opcion:=1;
    UNTIL 0;
  END;
  IF tipo==1 THEN
    IF INPUT(f,"Transformada de Fourier directa","x(t)=","X es tiempo. Ej: EXP(-ABS(X))",f)==0 THEN RETURN 0; END;
    IF INPUT(t0,"Ventana temporal","t minimo=","Inicio de la integral",-8)==0 THEN RETURN 0; END;
    IF INPUT(t1,"Ventana temporal","t maximo=","Fin de la integral",8)==0 THEN RETURN 0; END;
    IF INPUT(Nt,"Muestras temporales","Nt=","Entre 21 y 1024",161)==0 THEN RETURN 0; END;
    IF INPUT(wmax,"Eje de frecuencia","w max=","Se calcula de -w max a +w max",8)==0 THEN RETURN 0; END;
    IF INPUT(Nw,"Puntos de frecuencia","Nw=","Entre 21 y 1024",161)==0 THEN RETURN 0; END;
    Nt:=MAX(21,MIN(1024,FLOOR(Nt))); Nw:=MAX(21,MIN(1024,FLOOR(Nw)));
    IF t1<=t0 OR wmax<=0 THEN SSInfoView("SignalLab","Aviso","Use t max > t min y w max > 0.",SSAccent(1)); RETURN 0; END;
    dt:=(t1-t0)/(Nt-1); dw:=2*wmax/(Nw-1);
    x:=SSEvalExpr(f,t0,dt,Nt); IF SIZE(x)==0 THEN RETURN 0; END;
    // La integral continua no depende del valor aislado de un salto.
    // Promediar aproximaciones laterales, no fases ni muestras discretas.
    // En los extremos de la ventana se usa solo el lado interior y medio peso.
    ctWeights:=x; ctEvents:=SSEVAL_EVENTS; ctFallback:=0;
    ctEps:=ABS(dt)*1E-5; ctSideOK:=1;
    FOR idx FROM 1 TO 2 DO
      ctPoint:=t0; IF idx==2 THEN ctPoint:=t1; END;
      IF STRING(ctPoint-ctEps,1,12,{3,".E-",0})==STRING(ctPoint,1,12,{3,".E-",0}) OR STRING(ctPoint+ctEps,1,12,{3,".E-",0})==STRING(ctPoint,1,12,{3,".E-",0}) THEN ctSideOK:=0; END;
    END;
    IF ctSideOK==1 THEN
      // Solo puntos interiores: no evaluar fuera de la ventana del usuario.
      ctLeft:=SSEvalExpr(f,t0+dt-ctEps,dt,Nt-1);
      ctRight:=SSEvalExpr(f,t0+ctEps,dt,Nt-1);
      IF SIZE(ctLeft)<>Nt-1 OR SIZE(ctRight)<>Nt-1 THEN ctSideOK:=0; END;
    END;
    FOR idx FROM 1 TO Nt DO
      IF ctSideOK==1 AND SSIsDrawable(x(idx)) THEN
        IF idx==1 THEN
          IF SSIsDrawable(ctRight(1)) THEN ctWeights(idx):=ctRight(1); ELSE ctFallback:=ctFallback+1; END;
        ELSE
          IF idx==Nt THEN
            IF SSIsDrawable(ctLeft(Nt-1)) THEN ctWeights(idx):=ctLeft(Nt-1); ELSE ctFallback:=ctFallback+1; END;
          ELSE
            IF SSIsDrawable(ctLeft(idx-1)) AND SSIsDrawable(ctRight(idx)) THEN ctWeights(idx):=(ctLeft(idx-1)+ctRight(idx))/2;
            ELSE ctFallback:=ctFallback+1; END;
          END;
        END;
      ELSE ctFallback:=ctFallback+1; END;
      // Conservar N/D e infinitos; nunca promediar un polo para inventar cero.
      IF idx==1 OR idx==Nt THEN IF SSIsDrawable(ctWeights(idx)) THEN ctWeights(idx):=ctWeights(idx)/2; END; END;
    END;
    SSEVAL_EVENTS:=ctEvents;
    REPEAT
      spec:=SSCTFT({ctWeights,"PROGRESS"},t0,dt,-wmax,dw,Nw);
      IF SIZE(spec)>0 THEN BREAK; END;
      IF SSMenu("Fourier cancelada",{"Reintentar: misma entrada","Volver sin calcular"},1)<>1 THEN RETURN 0; END;
    UNTIL 0;
    ctLeft:={}; ctRight:={};
  END;
  IF tipo==2 THEN
    f:="2/(1+X^2)";
    IF INPUT(f,"Transformada de Fourier inversa","X(w)=","X es w (rad/s). Ej: 2/(1+X^2)",f)==0 THEN RETURN 0; END;
    IF INPUT(wmax,"Ventana de frecuencia","w max=","Se integra de -w max a +w max",8)==0 THEN RETURN 0; END;
    IF INPUT(Nw,"Muestras de frecuencia","Nw=","Entre 21 y 1024",161)==0 THEN RETURN 0; END;
    IF INPUT(t0,"Ventana temporal de salida","t minimo=","Inicio del grafico",-8)==0 THEN RETURN 0; END;
    IF INPUT(t1,"Ventana temporal de salida","t maximo=","Fin del grafico",8)==0 THEN RETURN 0; END;
    IF INPUT(Nt,"Puntos temporales","Nt=","Entre 21 y 1024",161)==0 THEN RETURN 0; END;
    Nt:=MAX(21,MIN(1024,FLOOR(Nt))); Nw:=MAX(21,MIN(1024,FLOOR(Nw)));
    IF t1<=t0 OR wmax<=0 THEN SSInfoView("SignalLab","Aviso","Use t max > t min y w max > 0.",SSAccent(1)); RETURN 0; END;
    dw:=2*wmax/(Nw-1); dt:=(t1-t0)/(Nt-1);
    spec:=SSEvalExpr(f,-wmax,dw,Nw); IF SIZE(spec)==0 THEN RETURN 0; END;
    REPEAT
      out:=SSICTFT({spec,"PROGRESS"},-wmax,dw,t0,dt,Nt);
      IF SIZE(out)>0 THEN BREAK; END;
      IF SSMenu("Inversa cancelada",{"Reintentar: mismo espectro","Volver sin calcular"},1)<>1 THEN RETURN 0; END;
    UNTIL 0;
  END;
  IF tipo==1 OR tipo==2 THEN
    tituloMath:="Fourier continua directa"; etiquetaMath:="X(w), w en rad/s";
    variable:="t"; integrando:="("+SSReplaceX(f,"(t)")+")*exp(-i*w*t)";
    muestrasMath:=ctWeights; ctWeights:={}; origenMath:=t0; pasoMath:=dt; signoMath:="-i*w"; escalaMath:=STRING(dt,1,12,{3,".E-",0});
    IF tipo==2 THEN
      tituloMath:="Fourier continua inversa"; etiquetaMath:="x(t), t en segundos";
      variable:="w"; integrando:="("+SSReplaceX(f,"(w)")+")*exp(i*w*t)/(2*pi)";
      muestrasMath:=spec; origenMath:=-wmax; pasoMath:=dw; signoMath:="i*t"; escalaMath:="("+STRING(dw,1,12,{3,".E-",0})+")/(2*pi)";
      // Misma cuadratura que SSICTFT; conservar spec original en tablas/exportacion.
      FOR idx FROM 1 TO SIZE(muestrasMath) DO
        IF idx==1 OR idx==SIZE(muestrasMath) THEN
          IF SSIsDrawable(muestrasMath(idx)) THEN muestrasMath(idx):=muestrasMath(idx)/2; END;
        END;
      END;
    END;
    nota:="Convencion: X(w)=int(x(t)*exp(-i*w*t),t,-infinity,+infinity); inversa con exp(i*w*t)/(2*pi). w es frecuencia angular. Use radianes en Home y CAS para interpretar las expresiones trigonometricas. No se cambian modos ni variables del usuario.\nLos graficos usan una suma numerica sobre una ventana FINITA, no la formula simbolica sobre todo el eje. Pueden diferir por truncamiento, discretizacion, residuos o tratamiento numerico de singularidades/Dirac.\nVentana temporal="+STRING(t0)+"..."+STRING(t1)+"; Nt="+STRING(Nt)+"; dt="+STRING(dt)+"\nVentana frecuencial="+STRING(-wmax)+"..."+STRING(wmax)+"; Nw="+STRING(Nw)+"; dw="+STRING(dw)+"\nEntrada="+f;
    IF tipo==1 THEN nota:=nota+"\nDirecta: cuadratura trapezoidal. En cada punto interior se promedian valores a t-eps y t+eps, eps=dt*1E-5; extremos con lado interior y medio peso. Aproxima los limites laterales para no convertir la convencion Heaviside(0) en un desplazamiento. No es integracion exacta: puede perder detalles mas estrechos que la malla o eps. La entrada conserva x(t) original; Formula numerica usa los pesos realmente integrados. Puntos sin promedio lateral valido="+STRING(ctFallback)+"; se conserva su valor original (si algun punto sigue siendo no finito, toda la suma numerica es N/D).\nLa fase no se fuerza: un pulso real centrado tiene 0 o pi; uno desplazado conserva su pendiente. En ceros espectrales la fase es N/D.";
    ELSE nota:=nota+"\nInversa: cuadratura trapezoidal de la ventana; medio peso en ambos extremos. La tabla de entrada conserva X(w) sin ponderar. La formula numerica usa los mismos pesos que la salida."; END;
    opcion:=1;
    REPEAT
      opcion:=SSMenu({tituloMath,{3,tituloMath,{{"Muestras temporales",IFTE(tipo==1,x,out),t0,dt},{"Muestras frecuenciales",spec,-wmax,dw},{"Expresion de entrada",f},{"Tipo: 1 directa, 2 inversa",tipo}},nota},8},{"Resultado matematico","Grafico de magnitud de salida","Grafico de fase de salida","Entrada utilizada","Tabla compleja de salida","Exportar salida","Metodo, ventana y condiciones","Volver"},opcion);
      IF opcion==0 OR opcion==8 THEN RETURN 1; END;
      IF opcion==1 THEN
        mathChoice:=SSMenu("Formula de Fourier",{"Completa: tablas y CAS","Integral de la ventana (CAS)","Formula numerica de los graficos","Volver"},1);
        IF mathChoice==1 THEN SSCASRunTransform(tipo+4,f,"",tituloMath); END;
        IF mathChoice==1 THEN mathChoice:=0; END;
        IF mathChoice==3 THEN
          valido:=1;
          FOR idx FROM 1 TO SIZE(muestrasMath) DO
            IF SSIsDrawable(muestrasMath(idx))==0 THEN valido:=0; BREAK; END;
          END;
          IF valido==0 THEN
            SSInfoView(tituloMath,"Suma numerica no definida","Hay muestras N/D o no finitas en la entrada de la integral. No se omiten ni se sustituyen por cero. Revise la ventana y la expresion; la consulta simbolica sigue disponible.",SSAccent(4));
            mathChoice:=0;
          END;
        END;
        IF mathChoice>=1 AND mathChoice<=3 THEN
          IF mathCache(mathChoice)=="" THEN
            resultText:=""; estadoMath:="";
            IF mathChoice<=2 THEN
              limiteA:="-infinity"; limiteB:="+infinity";
              IF mathChoice==2 THEN
                limiteA:=STRING(t0); limiteB:=STRING(t1);
                IF tipo==2 THEN limiteA:=STRING(-wmax); limiteB:=STRING(wmax); END;
              END;
              comando:="int("+integrando+","+variable+","+limiteA+","+limiteB+")";
              SSInfoView("Calculo simbolico","Integral de Fourier","Se consultara el CAS al continuar. Las integrales dificiles pueden tardar o quedar pendientes. La transformada completa requiere convergencia; los impulsos espectrales pueden necesitar tratamiento distribucional.\nMantenga libres t y w en CAS para obtener una formula en esas variables. No se borran sus asignaciones.",SSAccent(4));
              IFERR resultado:=CAS.int(integrando,variable,limiteA,limiteB); resultText:=STRING(resultado); THEN resultText:=""; END;
              IF resultText=="" OR INSTRING(UPPER(resultText),"ERROR")>0 OR UPPER(resultText)=="UNDEF" THEN resultText:=SSCASString(comando); END;
              IF resultText<>"" THEN
                IFERR resultado:=CAS.simplify(resultText); resultText:=STRING(resultado); THEN resultText:=resultText; END;
              END;
              estadoMath:="Resultado devuelto por CAS; revise sus condiciones. No es la aproximacion numerica del grafico.";
              IF mathChoice==2 THEN estadoMath:="Resultado CAS de la ventana elegida. No es la transformada de la senal sobre todo el eje; el grafico aproxima esta integral por una suma."; END;
              IF resultText=="" OR INSTRING(UPPER(resultText),"ERROR")>0 OR UPPER(resultText)=="UNDEF" OR INSTRING(UPPER(resultText),"INFINITY")>0 OR UPPER(resultText)=="NAN" THEN
                resultText:=comando; estadoMath:="Integral planteada, SIN resultado finito obtenido. Esto no demuestra por si solo divergencia: puede faltar convergencia, supuestos o capacidad del CAS. Consulte la formula numerica para la ventana finita.";
              ELSE
                IF INSTRING(UPPER(resultText),"INT(")>0 OR INSTRING(UPPER(resultText),"INTEGRATE(")>0 OR INSTRING(resultText,CHAR(8747))>0 OR INSTRING(UPPER(resultText),"LIMIT(")>0 OR UPPER(resultText)==UPPER(comando) THEN estadoMath:="Expresion CAS con integral o limite PENDIENTE. No es una solucion cerrada. Consulte la formula numerica de la ventana."; END;
              END;
            ELSE
              // La suma se expande con los mismos datos, pasos y extremos del grafico.
              resultText:="";
              FOR idx FROM 1 TO SIZE(muestrasMath) DO
                IF SSIsDrawable(muestrasMath(idx)) THEN
                  IF muestrasMath(idx)<>0 THEN
                    terminoMath:="("+STRING(RE(muestrasMath(idx)),1,12,{3,".E-",0})+"+("+STRING(IM(muestrasMath(idx)),1,12,{3,".E-",0})+")*i)*exp("+signoMath+"*("+STRING(origenMath+(idx-1)*pasoMath,1,12,{3,".E-",0})+"))";
                    IF resultText<>"" THEN resultText:=resultText+"+"; END;
                    resultText:=resultText+terminoMath;
                  END;
                END;
              END;
              IF resultText=="" THEN resultText:="0"; ELSE resultText:="("+escalaMath+")*("+resultText+")"; END;
              estadoMath:="Formula explicita de la suma NUMERICA finita, no una transformada simbolica exacta. Mismas muestras y pesos que el calculo; coeficientes escritos con 12 cifras y punto decimal CAS. Puede diferir en el ultimo redondeo respecto de la tabla. No se omiten muestras invalidas. Si es extensa, consulte la vista lineal.";
            END;
            mathCache(mathChoice):=resultText; mathStatus(mathChoice):=estadoMath;
          END;
          estadoMath:="CAS | "+etiquetaMath;
          IF mathChoice==3 THEN estadoMath:="Aprox. numerica | "+etiquetaMath; END;
          IF INSTRING(mathStatus(mathChoice),"PENDIENTE")>0 OR INSTRING(mathStatus(mathChoice),"SIN resultado")>0 THEN
            estadoMath:="Integral pendiente, no resuelta";
            SSInfoView(tituloMath,estadoMath,mathStatus(mathChoice)+"\nPuede volver y elegir Formula numerica de los graficos para consultar la suma explicita de la ventana.",SSAccent(4));
          END;
          SSSymbolicResults(tituloMath,estadoMath,mathCache(mathChoice),f,mathStatus(mathChoice)+"\n"+nota);
          IF mathChoice==3 THEN mathCache(3):=""; resultText:=""; terminoMath:=""; END;
        END;
      END;
      IF opcion==2 THEN
        IF tipo==1 THEN SSPlotXY(SSMag(spec),-wmax,dw,"Magnitud de X(w)","w rad/s; ventana finita");
        ELSE SSPlotXY(SSMag(out),t0,dt,"Magnitud de x(t)","t; inversa numerica"); END;
      END;
      IF opcion==3 THEN
        IF tipo==1 THEN SSPlotXY(SSPhase(spec),-wmax,dw,"Fase de X(w)","w rad/s; fase en radianes");
        ELSE SSPlotXY(SSPhase(out),t0,dt,"Fase de x(t)","t; fase en radianes"); END;
      END;
      IF opcion==4 THEN
        IF tipo==1 THEN SSPlotXY(x,t0,dt,"Entrada temporal x(t)","Parte real; ENTER datos");
        ELSE SSPlotXY(SSMag(spec),-wmax,dw,"Espectro de entrada |X(w)|","w rad/s; ENTER datos de magnitud"); SSDataView(spec,-wmax,dw,"Espectro de entrada complejo","w","X(w)",SSAccent(4)); END;
      END;
      IF opcion==5 THEN
        IF tipo==1 THEN SSDataView(spec,-wmax,dw,"Salida Fourier compleja","w","X(w)",SSAccent(4));
        ELSE SSDataView(out,t0,dt,"Salida inversa compleja","t","x(t)",SSAccent(4)); SSPlotXY(out,t0,dt,"Parte real de x(t)","Inversa numerica"); END;
      END;
      IF opcion==6 THEN
        IF tipo==1 THEN SSExportData(spec,-wmax,dw,"Fourier continua: ventana numerica");
        ELSE SSExportData(out,t0,dt,"Fourier inversa: ventana numerica"); END;
      END;
      IF opcion==7 THEN SSInfoView(tituloMath,"Metodo y alcance",nota,SSAccent(4)); END;
    UNTIL 0;
  END;
  IF tipo==3 THEN
    f:="X";
    T:=2*pirad;
    SSInfoView("Serie por expresion","Un periodo; varios armonicos","Use X como tiempo en 0 <= t < T; la extension es periodica. Ejemplo: 1+COS(X), T=2*pi, K=5, N=161. Use radianes para las funciones trigonometricas. K fija los armonicos -K...K; N fija la precision numerica, no el numero de coeficientes. Para Dirac use el tren ideal.",SSAccent(4));
    IF INPUT(f,"Serie de Fourier compleja","x(t)=","Use X: 1+COS(X); periodo [0,T)",f)==0 THEN RETURN 0; END;
    IF INPUT(T,"Periodo fundamental","T=","Positivo. Ej: 2*pi para COS(X)",T)==0 THEN RETURN 0; END;
    IF INPUT(orden,"Armonicos de la serie","K=","Entero 0...50; se calculan -K...K",orden)==0 THEN RETURN 0; END;
    IF INPUT(Nt,"Precision de integracion","N=","Entero 21...1024, mayor que 2*K",Nt)==0 THEN RETURN 0; END;
    IF TYPE(T)<>0 OR TYPE(orden)<>0 OR TYPE(Nt)<>0 THEN SSInfoView("SignalLab","Aviso","T, K y N deben ser reales.",SSAccent(1)); RETURN 0; END;
    IF T<1E-100 OR T>1E100 OR orden<>FLOOR(orden) OR orden<0 OR orden>50 OR Nt<>FLOOR(Nt) OR Nt<21 OR Nt>1024 OR Nt<=2*orden THEN SSInfoView("SignalLab","Aviso","Use T positivo, K entero 0...50 y N entero 21...1024 con N>2*K.",SSAccent(1)); RETURN 0; END;
    dt:=T/Nt; x:=SSEvalExpr(f,0,dt,Nt);
    eventosSerie:=SSEVAL_EVENTS;
    IF SIZE(x)<>Nt THEN RETURN 0; END;
    FOR idx FROM 1 TO Nt DO
      IF SSIsDrawable(x(idx))==0 THEN SSInfoView("SignalLab","Aviso","La expresion tiene muestras no finitas. Revise el dominio; para Dirac use el tren ideal.",SSAccent(1)); RETURN 0; END;
    END;
    REPEAT
      // Cuadratura periodica: no duplicar la muestra del extremo T.
      SSEVAL_EVENTS:={};
      spec:=MAKELIST(0,idx,1,2*orden+1,1); fase:=spec;
      q:=0;
      FOR idx FROM 1 TO Nt DO q:=q+ABS(x(idx))/Nt; END;
      FOR k FROM -orden TO orden DO
        ck:=0;
        FOR idx FROM 0 TO Nt-1 DO ck:=ck+(x(idx+1)/Nt)*EXP((0,-1)*2*pirad*k*idx/Nt); END;
        spec(k+orden+1):=ck;
        // Solo fase: evitar angulos artificiales de residuos. Coeficientes intactos.
        IF ABS(RE(ck))<=1E-12*q THEN ck:=(0,IM(ck)); END;
        IF ABS(IM(ck))<=1E-12*q THEN ck:=RE(ck); END;
        IF ABS(ck)>0 THEN fase(k+orden+1):=IM(LN((RE(ck)/ABS(ck),IM(ck)/ABS(ck)))); ELSE fase(k+orden+1):=SSUndef(); END;
      END;
      out:=MAKELIST(0,idx,1,201,1);
      FOR idx FROM 0 TO 200 DO
        ck:=0;
        FOR k FROM -orden TO orden DO ck:=ck+spec(k+orden+1)*EXP((0,1)*2*pirad*k*idx/200); END;
        out(idx+1):=ck;
      END;
      // Formula explicita de la misma suma parcial, con coeficientes complejos.
      formula:="";
      FOR k FROM -orden TO orden DO
        ck:=spec(k+orden+1);
        IF ck<>0 THEN
          terminoMath:="("+STRING(RE(ck),1,12,{3,".E-",0})+"+("+STRING(IM(ck),1,12,{3,".E-",0})+")*i)";
          IF k<>0 THEN terminoMath:=terminoMath+"*exp(i*2*pi*("+STRING(k)+")*t/("+STRING(T,1,12,{3,".E-",0})+"))"; END;
          IF formula<>"" THEN formula:=formula+"+"; END;
          formula:=formula+terminoMath;
        END;
      END;
      IF formula=="" THEN formula:="0"; END;
      nota:="x(t)="+f+"; periodo [0,T), T="+STRING(T)+"; K="+STRING(orden)+"; N="+STRING(Nt)+".\nSe calculan "+STRING(2*orden+1)+" coeficientes, incluido c[0]="+STRING(spec(orden+1))+".\nc[k]=(1/T)*int(x(t)*exp(-i*2*pi*k*t/T),t,0,T). La tabla aproxima esta integral con N muestras t=j*T/N, j=0...N-1. La suma parcial usa k=-K...K. K=0 es el valor medio numerico.\nN>2*K evita repetir indices espectrales, pero no garantiza precision: compare aumentando N. Saltos, pulsos angostos o armonicos altos requieren mas resolucion; puede haber Gibbs y alias numerico. Para Dirac ideal use su entrada por parametros.\nLa formula de la suma parcial usa estos mismos c[k], no es una solucion simbolica exacta. STRING puede redondear los numeros. Los coeficientes originales se conservan. Solo para fase se omiten residuos <=1E-12 del promedio |x|.\nEje de espectros: k, frecuencia k/T Hz si T esta en segundos. Fase en radianes; en cero no esta definida (N/D). Graficos temporales: parte real; tablas y exportacion conservan complejos. Exportar coeficientes guarda c[k], no muestras temporales. Use radianes; no se cambian ajustes.";
      mathCache:={"","",""}; mathStatus:={"","",""}; opcion:=1;
      REPEAT
        opcion:=SSMenu({"Fourier por expresion",{3,"Fourier por expresion",{{"Coeficientes c[k]",spec,-orden,1},{"Entrada temporal",x,0,dt,eventosSerie},{"Expresion",f},{"Suma parcial",formula},{"Periodo",T}},nota},10},{"Tabla de coeficientes c[k]","Magnitud por armonico","Fase en radianes","Formulas Textbook y c[0]","Ver expresion de entrada","Suma parcial de Fourier","Exportar coeficientes","Parametros e interpretacion","Editar parametros","Volver"},opcion);
        IF opcion==0 OR opcion==10 THEN RETURN 1; END;
        IF opcion==1 THEN SSDataView(spec,-orden,1,"Serie continua: c[k]","k","c[k]",SSAccent(4)); END;
        IF opcion==2 THEN SSPlotDiscrete(SSMag(spec),-orden,1,"Magnitud |c[k]|","k"); END;
        IF opcion==3 THEN SSPlotDiscrete(fase,-orden,1,"Fase c[k] en radianes","k"); END;
        IF opcion==4 THEN
          mathChoice:=SSMenu("Formulas de la serie",{"Suma parcial explicita xK(t)","Coeficiente general c[k] (CAS)","Valor medio c[0] numerico","Volver"},1);
          IF mathChoice==1 THEN SSSymbolicResults("Serie por expresion","xK(t) | aproximacion numerica",formula,f,nota); END;
          IF mathChoice==3 THEN SSSymbolicResults("Componente continua","c[0] | valor medio numerico",STRING(spec(orden+1)),f,nota); END;
          IF mathChoice==2 THEN
            IF mathCache(2)=="" THEN
              // k es tambien el contador LOCAL numerico: nunca enviarlo al CAS.
              // Integrar con simbolos distintos y renombrar SOLO texto al presentar.
              seriePeriod:=STRING(T,1,12,{3,".E-",0});
              // Recuperar el racional del valor numerico, sin adivinar multiplos de pi.
              serieRead:=SSCASString("exact("+seriePeriod+")");
              IF serieRead<>"" THEN
                IFERR
                  valor:=EXPR(serieRead)+0.0;
                  IF TYPE(valor)==0 THEN IF valor==T THEN seriePeriod:=serieRead; END; END;
                THEN serieRead:=""; END;
              END;
              // Las funciones simbolicas se envian con nombres CAS, no Home.
              // Se conservan parametros y nombres de funciones no reconocidas.
              serieRead:=SSReplaceX(f,"("+serieAxis+")"); serieInput:=""; seriePos:=1;
              WHILE seriePos<=DIM(serieRead) DO
                serieToken:=MID(serieRead,seriePos,1);
                IF INSTRING(serieChars,UPPER(serieToken))>0 THEN
                  serieEnd:=seriePos+1;
                  WHILE serieEnd<=DIM(serieRead) AND INSTRING(serieChars,UPPER(MID(serieRead,serieEnd,1)))>0 DO serieEnd:=serieEnd+1; END;
                  serieToken:=MID(serieRead,seriePos,serieEnd-seriePos);
                  serieSlot:=serieEnd; WHILE serieSlot<=DIM(serieRead) AND MID(serieRead,serieSlot,1)==" " DO serieSlot:=serieSlot+1; END;
                  IF serieSlot<=DIM(serieRead) THEN
                    IF MID(serieRead,serieSlot,1)=="(" AND INSTRING(serieFunctions,"|"+UPPER(serieToken)+"|")>0 THEN serieToken:=LOWER(serieToken); END;
                  END;
                  IF UPPER(serieToken)=="PI" THEN serieToken:="pi"; END;
                  seriePos:=serieEnd;
                ELSE seriePos:=seriePos+1; END;
                serieInput:=serieInput+serieToken;
              END;
              integrando:="("+serieInput+")*exp(-i*2*pi*"+serieIndex+"*"+serieAxis+"/("+seriePeriod+"))/("+seriePeriod+")";
              comando:="int("+integrando+","+serieAxis+",0,"+seriePeriod+")";
              serieFree:=1;
              serieRead:=SSCASString("eval("+serieAxis+")");
              IF serieRead<>serieAxis THEN serieFree:=0; END;
              serieRead:=SSCASString("eval("+serieIndex+")");
              IF serieRead<>serieIndex THEN serieFree:=0; END;
              IF INSTRING(UPPER(f),UPPER(serieAxis))>0 OR INSTRING(UPPER(f),UPPER(serieIndex))>0 THEN serieFree:=0; END;
              SSInfoView("Coeficiente general CAS","Indice simbolico, no el K elegido","Se usan simbolos internos separados del contador de armonicos y de las variables t/k guardadas. No se borran variables ni se imponen supuestos globales. La formula puede requerir limites en k=0 u otros armonicos excepcionales. El periodo usa el valor numerico ingresado: puede diferir de un periodo exacto escrito en CAS.",SSAccent(4));
              resultText:="";
              IF serieFree==1 THEN
                IFERR resultado:=CAS.int(integrando,serieAxis,"0",seriePeriod); resultText:=STRING(resultado); THEN resultText:=""; END;
                IF resultText=="" OR INSTRING(UPPER(resultText),"ERROR")>0 OR UPPER(resultText)=="UNDEF" THEN resultText:=SSCASString(comando); END;
              END;
              // Conservar la salida integral: una simplificacion adicional puede
              // perder los casos excepcionales de una formula parametrica.
              estadoMath:="Resultado CAS para c[k], coeficiente complejo de la serie (tambien llamado A_k). No es el coeficiente coseno de la serie trigonometrica. k sigue simbolico, independiente del K numerico. Revise k entero y limites en los armonicos excepcionales; c[0] tiene consulta numerica separada. No sustituye los coeficientes de la tabla.";
              IF resultText=="" OR INSTRING(UPPER(resultText),"ERROR")>0 OR UPPER(resultText)=="UNDEF" OR INSTRING(UPPER(resultText),"INFINITY")>0 OR UPPER(resultText)=="NAN" THEN
                resultText:=comando; estadoMath:="Integral PENDIENTE: no se obtuvo una formula cerrada. Consulte Suma parcial explicita para la expresion numerica calculada.";
              ELSE
                IF INSTRING(UPPER(resultText),"INT(")>0 OR INSTRING(UPPER(resultText),"INTEGRATE(")>0 OR INSTRING(resultText,CHAR(8747))>0 OR INSTRING(UPPER(resultText),"LIMIT(")>0 THEN estadoMath:="Resultado con integral o limite PENDIENTE. No es una solucion cerrada; consulte la suma parcial numerica."; END;
              END;
              IF serieFree==0 THEN estadoMath:="Integral PENDIENTE: no se pudo verificar que slfouriertime y slfourierharmonic esten libres, o la entrada usa esos nombres reservados. No se ejecuto la integral ni se borraron sus variables."; END;
              IF resultText=="0" OR resultText=="0.0" THEN
                serieNonzero:=0;
                FOR idx FROM 1 TO SIZE(spec) DO
                  IF idx<>orden+1 AND ABS(spec(idx))>1E-8*q THEN serieNonzero:=1; END;
                END;
                IF serieNonzero==1 THEN
                  resultText:=comando;
                  estadoMath:="Formula general PENDIENTE de confirmar: CAS devolvio 0, pero la tabla numerica contiene armonicos no nulos distintos de continua. Puede haber casos excepcionales omitidos o error de cuadratura; no se presenta ese 0 como formula completa ni se inventa una expresion a partir de la tabla. Se conserva la integral para revisarla.";
                END;
              END;
              // No usar subst/eval para volver a k: reintroduciria la colision.
              serieTexts:={resultText,comando};
              FOR serieSlot FROM 1 TO 2 DO
                serieRead:=serieTexts(serieSlot); serieText:=""; seriePos:=1;
                WHILE seriePos<=DIM(serieRead) DO
                  serieToken:=MID(serieRead,seriePos,1);
                  IF INSTRING(serieChars,UPPER(serieToken))>0 THEN
                    serieEnd:=seriePos+1;
                    WHILE serieEnd<=DIM(serieRead) AND INSTRING(serieChars,UPPER(MID(serieRead,serieEnd,1)))>0 DO serieEnd:=serieEnd+1; END;
                    serieToken:=MID(serieRead,seriePos,serieEnd-seriePos);
                    IF serieToken==serieAxis THEN serieToken:="t"; END;
                    IF serieToken==serieIndex THEN serieToken:="k"; END;
                    seriePos:=serieEnd;
                  ELSE seriePos:=seriePos+1; END;
                  serieText:=serieText+serieToken;
                END;
                serieTexts(serieSlot):=serieText;
              END;
              resultText:=serieTexts(1); comando:=serieTexts(2);
              estadoMath:=estadoMath+"\nPlanteo con notacion t/k: "+comando;
              mathCache(2):=resultText; mathStatus(2):=estadoMath;
            END;
            etiquetaMath:="c[k] | CAS, revisar condiciones";
            IF INSTRING(mathStatus(2),"PENDIENTE")>0 THEN etiquetaMath:="Integral pendiente, no resuelta"; SSInfoView("Serie por expresion",etiquetaMath,mathStatus(2),SSAccent(4)); END;
            SSSymbolicResults("Serie por expresion",etiquetaMath,mathCache(2),f,mathStatus(2));
          END;
        END;
        IF opcion==5 THEN SSEVAL_EVENTS:=eventosSerie; SSPlotXY(x,0,dt,"Entrada: un periodo [0,T)","Parte real; ENTER datos complejos"); SSEVAL_EVENTS:={}; END;
        IF opcion==6 THEN SSPlotXY(out,0,T/200,"Suma parcial: -K a K","Parte real; aproximacion numerica"); END;
        IF opcion==7 THEN SSExportData(spec,-orden,1,"Serie continua c[k], expresion"); END;
        IF opcion==8 THEN SSInfoView("Serie por expresion","Parametros y convenciones",nota,SSAccent(4)); END;
        IF opcion==9 THEN
          candidato:={f,T,orden,Nt}; valido:=0;
          editar:=SSMenu("Editar serie por expresion",{"Expresion x(t) con X","Periodo T","Armonicos K","Precision N","Volver al resultado"},1);
          IF editar>=1 AND editar<=4 THEN
            valor:=candidato(editar);
            IF INPUT(valor,"Editar serie por expresion","Valor=","T>0; K=0...50; N=21...1024, N>2*K",valor) THEN candidato(editar):=valor; valido:=1; END;
          END;
          IF valido==1 THEN
            IF TYPE(candidato(1))<>2 OR TYPE(candidato(2))<>0 OR TYPE(candidato(3))<>0 OR TYPE(candidato(4))<>0 THEN valido:=0; END;
            IF valido==1 THEN
              IF candidato(2)<1E-100 OR candidato(2)>1E100 OR candidato(3)<>FLOOR(candidato(3)) OR candidato(3)<0 OR candidato(3)>50 OR candidato(4)<>FLOOR(candidato(4)) OR candidato(4)<21 OR candidato(4)>1024 OR candidato(4)<=2*candidato(3) THEN valido:=0; END;
            END;
            IF valido==1 THEN
              muestrasMath:=SSEvalExpr(candidato(1),0,candidato(2)/candidato(4),candidato(4));
              IF SIZE(muestrasMath)<>candidato(4) THEN valido:=0;
              ELSE FOR idx FROM 1 TO SIZE(muestrasMath) DO IF SSIsDrawable(muestrasMath(idx))==0 THEN valido:=0; END; END; END;
            END;
            IF valido==1 THEN f:=candidato(1); T:=candidato(2); orden:=candidato(3); Nt:=candidato(4); dt:=T/Nt; x:=muestrasMath; eventosSerie:=SSEVAL_EVENTS;
            ELSE SSInfoView("SignalLab","Aviso","Cambio invalido o expresion no finita. Se conserva el resultado anterior.",SSAccent(1)); opcion:=1; END;
          ELSE opcion:=1; END;
        END;
        SSEVAL_EVENTS:={};
      UNTIL opcion==9;
    UNTIL 0;
  END;
  RETURN 1;
END;

VIEW "Transformadas Laplace/Z",UI_TRANSFORMS()
BEGIN
  LOCAL op:=1;
  REPEAT
    SSEVAL_EVENTS:={}; SSREAD_META:={};
    op:=SSMenu("Transformadas Laplace y Z",{"Laplace directa: x(t) a X(s)","Laplace inversa: X(s) a x(t)","Transformada Z de secuencia","Z inversa: X(z) a x[n]","Resolver una EDO simbolica","Bilineal: H(s) a H(z)","Teoria, convergencia y ROC","Volver al inicio"},op);
    IF op==0 THEN RETURN 0; END;
    IF op==1 OR op==2 OR op==4 THEN UICASTransform(op); END;
    IF op==3 THEN UIZTransform(); END;
    IF op==5 THEN UIODESolve(); END;
    IF op==6 THEN UIBilinear(); END;
    IF op==7 THEN SSTheoryView("Laplace y Z",{"DEFINICION. Laplace: X(s)=integral x(t)e^(-st)dt. Z: X(z)=sum x[n]z^(-n). La region de convergencia forma parte del resultado.","INTERPRETACION. Polos, ceros y ROC permiten estudiar causalidad y estabilidad. Una secuencia finita se transforma sumando cada muestra con su indice real.","USO. Ingrese expresiones con t,s,n,z o una lista {x0,x1,...} y el indice inicial. ENTER confirma; ESC vuelve sin calcular."},SSAccent(3)); END;
  UNTIL op==8; RETURN 1;
END;

// ---------- Modulo Fourier y espectro ----------

UIDFT()
BEGIN
  LOCAL compacta:=0;
  LOCAL unidadEje:="w rad/muestra";
  LOCAL factorEje:=1;
  LOCAL TsEje:=1;
  LOCAL eleccionEje;
  LOCAL x:={1,1,1,1};
  LOCAL op:=1;
  LOCAL spec;
  LOCAL y;
  LOCAL base;
  LOCAL natural;
  LOCAL N;
  LOCAL fuente;
  LOCAL f:="(0.8)^X";
  LOCAL n0:=0;
  LOCAL n1:=20;
  LOCAL idx;
  LOCAL dw;
  LOCAL escala;
  LOCAL fase;
  LOCAL formula;
  LOCAL termino;
  LOCAL nota;
  LOCAL opcion:=1;
  LOCAL dftComparada:={};
  LOCAL superpuesta:=0;
  LOCAL nombreGrafico;
  LOCAL opciones;
  LOCAL dftInicio;
  LOCAL dftPaso;
  LOCAL pirad:=3.141592653589793;
  op:=SSMenu("Fourier discreta",{"DFT directa","DFT inversa","DTFT de expresion o lista finita","DTFT simbolica: senal completa","Volver"},op); IF op==0 OR op==5 THEN RETURN 0; END;
  IF op==4 THEN
    f:="COS(pi*X/2)";
    SSInfoView("DTFT simbolica bilateral","No se trunca la secuencia","Use X o n entero. Ej: COS(pi*X/2), Dirac(X-3). Senos y cosenos infinitos dan replicas de Dirac cada 2*pi, no picos finitos. El resto se consulta al CAS y puede quedar pendiente. Para datos finitos conserve la opcion DTFT de lista/intervalo.",SSAccent(4));
    IF INPUT(f,"DTFT simbolica","x[n]=","Use X o n; secuencia completa",f)==0 THEN RETURN 0; END;
    RETURN SSCASRunTransform(7,f,"","DTFT simbolica");
  END;
  IF op==3 THEN SSInfoView("DTFT de intervalo finito","Entrada por expresion o lista","Se calculara X(w)=sum x[n]*exp(-i*w*n) en un intervalo ENTERO, suponiendo cero fuera. Si su expresion representa una senal infinita, el resultado es el de su truncamiento. Una senal periodica infinita se analiza en Serie discreta. Use X como n y radianes para trigonometria; Aqui Dirac(X) se interpreta como delta discreta: 1 en X=0 y 0 en los demas indices.",SSAccent(4)); END;
  fuente:=1;
  IF op<>2 THEN fuente:=SSMenu("Entrada Fourier discreta",{"Lista o banco de datos","Expresion matematica x[n]","Volver"},1); IF fuente==0 OR fuente==3 THEN RETURN 0; END; END;
  IF fuente==2 THEN
    IF INPUT(f,"Fourier discreta por expresion","x[n]=","X es n entero. Ej: (0.8)^X",f)==0 THEN RETURN 0; END;
    IF op==3 THEN
      IF INPUT(n0,"Intervalo discreto","n inicial=","Entero; se conserva en la fase",n0)==0 THEN RETURN 0; END;
      IF INPUT(n1,"Intervalo discreto","n final=","Entero; hasta 1024 muestras",n1)==0 THEN RETURN 0; END;
      IF TYPE(n0)<>0 OR TYPE(n1)<>0 THEN SSInfoView("SignalLab","Aviso","Use indices enteros reales.",SSAccent(1)); RETURN 0; END;
      IF n0<>FLOOR(n0) OR n1<>FLOOR(n1) OR ABS(n0)>1E6 OR ABS(n1)>1E6 OR n1<n0 OR n1-n0+1>1024 THEN SSInfoView("SignalLab","Aviso","Intervalo entero de 1...1024 muestras, |n|<=1E6.",SSAccent(1)); RETURN 0; END;
      N:=n1-n0+1;
    ELSE
      N:=21;
      IF INPUT(N,"Muestras de la expresion","Cantidad=","Indices n=0...cantidad-1; 1...1024",N)==0 THEN RETURN 0; END;
      IF TYPE(N)<>0 THEN SSInfoView("SignalLab","Aviso","Use una cantidad entera real.",SSAccent(1)); RETURN 0; END;
      IF N<>FLOOR(N) OR N<1 OR N>1024 THEN SSInfoView("SignalLab","Aviso","Use de 1 a 1024 muestras.",SSAccent(1)); RETURN 0; END;
    END;
    x:=SSEvalExpr({f,"DISCRETE"},n0,1,N); IF SIZE(x)<>N THEN RETURN 0; END;
    SSREAD_META:={0,0,1,"Expresion Fourier"};
  ELSE
  x:=SSReadList("DFT","Lista=","Datos complejos admitidos",x); IF SIZE(x)==0 THEN RETURN 0; END;
  END;
  IF SIZE(x)>1024 THEN SSInfoView("SignalLab","Aviso","Use como maximo 1024 muestras.",SSAccent(1)); RETURN 0; END;
  FOR idx FROM 1 TO SIZE(x) DO IF SSIsDrawable(x(idx))==0 THEN SSInfoView("SignalLab","Aviso","Las muestras deben ser finitas. Revise el dominio de la expresion.",SSAccent(1)); RETURN 0; END; END;
  IF op==3 THEN
    IF fuente==1 THEN
      n0:=SSReadOrigin(0);
      IF SSReadStep(1)<>1 THEN SSInfoView("DTFT","Indices discretos","El eje debe tener paso 1. Indique el indice de la primera muestra; el paso temporal importado no se usara como indice n.",SSAccent(4)); n0:=0; END;
      IF INPUT(n0,"Indices de la DTFT","n inicial=","Entero asociado a la primera muestra",n0)==0 THEN RETURN 0; END;
      IF TYPE(n0)<>0 THEN SSInfoView("SignalLab","Aviso","Use un indice real entero.",SSAccent(1)); RETURN 0; END;
      IF n0<>FLOOR(n0) OR ABS(n0)>1E6 THEN SSInfoView("SignalLab","Aviso","Use n entero, |n|<=1E6.",SSAccent(1)); RETURN 0; END;
    END;
    // DTFT finita, sin factor temporal ni division por N. Eje continuo w.
    dw:=2*pirad/200;
    REPEAT
      spec:=SSCTFT({x,"PROGRESS"},n0,1,-pirad,dw,201);
      IF SIZE(spec)>0 THEN BREAK; END;
      IF SSMenu("DTFT cancelada",{"Reintentar: mismos datos","Volver sin calcular"},1)<>1 THEN RETURN 0; END;
    UNTIL 0;
    fase:=spec;
    escala:=0; FOR idx FROM 1 TO SIZE(x) DO escala:=escala+ABS(x(idx)); END;
    FOR idx FROM 1 TO SIZE(spec) DO
      IF ABS(RE(fase(idx)))<=1E-12*escala THEN fase(idx):=(0,IM(fase(idx))); END;
      IF ABS(IM(fase(idx)))<=1E-12*escala THEN fase(idx):=RE(fase(idx)); END;
    END;
    fase:=SSPhase(fase);
    formula:="";
    nota:="DTFT: X(w)=sum x[n]*exp(-i*w*n), sin dividir por N. Se usa n="+STRING(n0)+"..."+STRING(n0+SIZE(x)-1)+" y cero fuera. La DTFT es continua y periodica en w con periodo 2*pi; el grafico toma 201 puntos entre -pi y pi. w esta en rad/muestra. El indice inicial se conserva y cambia la fase.\nSi la expresion representa una secuencia infinita, esta es SOLO su version truncada al intervalo, no su transformada exacta infinita. Para una secuencia periodica infinita use Serie discreta; su DTFT distribucional no se representa por esta curva.\nLa formula explicita usa los mismos datos finitos que el grafico; STRING puede redondear cifras. Magnitud y fase se consultan separadas; fase en radianes, en cero no definida (N/D). Una malla finita puede omitir detalles rapidos. Use radianes para funciones trigonometricas de la entrada; no se cambian ajustes.";
    REPEAT
      nombreGrafico:="DFT superpuesta: NO"; IF superpuesta==1 THEN nombreGrafico:="DFT superpuesta: SI"; END;
      opciones:={"Formula X(w) Textbook","Magnitud |X(w)|","Fase de X(w)","Tabla compleja X(w)","Entrada x[n]","Exportar X(w)","Intervalo y convenciones",nombreGrafico,"Eje: w o Hz","Fase extendida / retardo","Volver"};
      opcion:=SSMenu({"Resultados DTFT finita",{3,"Resultados DTFT finita",{{"Entrada x[n]",x,n0,1},{"DTFT; "+unidadEje,spec,-pirad*factorEje,dw*factorEje},{"Expresion de entrada",f}},nota+"\nEje visible: "+unidadEje},11},opciones,opcion);
      IF opcion==0 OR opcion==11 THEN RETURN 1; END;
      IF opcion==9 THEN
        eleccionEje:=SSMenu("Unidades del espectro",{"w rad/muestra","Hz: indicar Ts en segundos","Volver"},1);
        IF eleccionEje==1 THEN factorEje:=1; unidadEje:="w rad/muestra"; END;
        IF eleccionEje==2 THEN
          TsEje:=SSReadStep(1);
          IF INPUT(TsEje,"Paso temporal","Ts (s)=","Confirmar segundos; no cambia magnitud ni fase",TsEje) THEN
            IF TYPE(TsEje)==0 THEN IF TsEje>=1E-12 AND TsEje<=1E12 THEN factorEje:=1/(2*pirad*TsEje); unidadEje:="f Hz"; END; END;
          END;
        END;
      END;
      IF opcion==10 THEN
        eleccionEje:=SSMenu("Analisis de fase",{"Fase desenrollada","Retardo de grupo (muestras)","Volver"},1);
        IF eleccionEje==1 OR eleccionEje==2 THEN
          SSInfoView("Analisis de fase","Malla finita; no unir N/D","Retardo en muestras, derivado respecto de w rad/muestra. No es fiable cerca de ceros. La malla debe resolver las vueltas de fase.",SSAccent(4));
          y:=SSPhase({spec,"UNWRAP",dw}); nombreGrafico:="Fase desenrollada (rad)";
          IF eleccionEje==2 THEN y:=SSPhase({spec,"DELAY",dw}); nombreGrafico:="Retardo de grupo (muestras)"; END;
          SSPlotXY(y,-pirad*factorEje,dw*factorEje,nombreGrafico,unidadEje); y:={};
        END;
      END;
      IF opcion==8 THEN superpuesta:=1-superpuesta; IF superpuesta==0 THEN dftComparada:={}; END; END;
      IF opcion==1 THEN
        // Construir solo al abrir; no retener la expresion al recorrer graficos.
        formula:=""; compacta:=0;
        FOR idx FROM 1 TO SIZE(x) DO
          IF x(idx)<>0 THEN
            termino:="("+STRING(RE(x(idx)),1,12,{3,".E-",0})+"+("+STRING(IM(x(idx)),1,12,{3,".E-",0})+")*i)";
            IF n0+idx-1<>0 THEN termino:=termino+"*exp(-i*w*("+STRING(n0+idx-1,1,12,{3,".E-",0})+"))"; END;
            // Limitar ANTES de concatenar, no despues de agotar memoria.
            IF DIM(formula)+DIM(termino)+1>5000 THEN compacta:=1; BREAK; END;
            IF formula<>"" THEN formula:=formula+"+"; END;
            formula:=formula+termino;
          END;
        END;
        IF formula=="" THEN formula:="0"; END;
        IF compacta THEN
          formula:=""; termino:="";
          SSInfoView("DTFT finita","Definicion compacta completa","X(w)=sum a[k]*exp(-i*w*(n0+k)), k=0...N-1.\nN="+STRING(SIZE(x))+"; n0="+STRING(n0,1,12,{3,".E-",0})+".\na[k] es la muestra k+1 de la tabla de entrada, no una variable CAS. No se omiten terminos: se evita desplegar mas de 5000 caracteres. La tabla conserva todos los coeficientes.",SSAccent(4));
        ELSE SSSymbolicResults("DTFT finita","X(w) | suma del intervalo",formula,"N="+STRING(SIZE(x))+"; n inicial="+STRING(n0),nota); END;
        formula:=""; termino:="";
      END;
      IF (opcion==2 OR opcion==3) AND superpuesta==1 THEN
        IF SIZE(dftComparada)==0 THEN
          SSHeader("Comparacion DTFT / DFT","Calculando bins del mismo registro...",SSAccent(4));
          N:=SIZE(x); dftInicio:=SSDFTAxis0(N); dftPaso:=2*pirad/N;
          dftComparada:=SSDFT({x,"PROGRESS"});
          IF SIZE(dftComparada)==0 THEN CONTINUE; END;
          dftComparada:=SSShiftSpectrum(dftComparada);
          // DFT por posiciones -> mismo origen n0 de la DTFT, sin perder fase.
          FOR idx FROM 1 TO N DO
            dftComparada(idx):=dftComparada(idx)*EXP((0,-1)*(dftInicio+(idx-1)*dftPaso)*n0);
          END;
          // Conservar bins originales: el visor limpia solo su copia visual.
        END;
        nombreGrafico:="Magnitud DTFT / DFT"; IF opcion==3 THEN nombreGrafico:="Fase DTFT / DFT (rad)"; END;
        superpuesta:=SSPlotDual(spec,dftComparada,{nombreGrafico,-pirad*factorEje,dw*factorEje,"FOURIER",dftInicio*factorEje,dftPaso*factorEje,1,opcion,superpuesta,unidadEje});
      ELSE
        IF opcion==2 THEN SSPlotXY(SSMag(spec),-pirad*factorEje,dw*factorEje,"DTFT: magnitud |X(w)|",unidadEje); END;
        IF opcion==3 THEN SSPlotXY(fase,-pirad*factorEje,dw*factorEje,"DTFT: fase en radianes",unidadEje); END;
      END;
      IF opcion==4 THEN SSDataView(spec,-pirad*factorEje,dw*factorEje,"DTFT compleja; "+unidadEje,unidadEje,"X(w)",SSAccent(4)); END;
      IF opcion==5 THEN SSDataView(x,n0,1,"Entrada DTFT","n","x[n]",SSAccent(4)); SSPlotDiscrete(x,n0,1,"Entrada DTFT: parte real","n entero"); END;
      IF opcion==6 THEN SSExportData(spec,-pirad*factorEje,dw*factorEje,"DTFT finita; "+unidadEje); END;
      IF opcion==7 THEN SSInfoView("DTFT finita","Metodo y alcance",nota+"\nSolo para fase se omiten residuos real/imag <=1E-12*sum |x[n]|. Tabla y exportacion conservan el espectro original; la limpieza visual es independiente. DFT superpuesta usa N=longitud del registro y el mismo n inicial, sin normalizar. Tecla 1 alterna la DFT en el grafico; ENTER permite consultar ambas tablas con sus rejillas reales. Los bins no se ajustan a la muestra DTFT mas cercana. Fase nula no definida: sin punto en la comparacion.",SSAccent(4)); END;
    UNTIL 0;
  END;
  IF SSReadOrigin(0)<>0 OR SSReadStep(1)<>1 THEN
    SSInfoView("DFT","Referencia de la transformada","Origen importado="+STRING(SSReadOrigin(0))+"; paso="+STRING(SSReadStep(1))+".\nEsta DFT usa la posicion de las muestras: n=0...N-1. Su frecuencia w esta en radianes por muestra. Para convertir a radianes por unidad del eje original, divida w por el paso. No se aplica un desplazamiento de fase por el origen importado.",SSAccent(4));
  END;
  natural:=SIZE(x);
  N:=natural;
  IF INPUT(N,"Longitud de la DFT","N=","Cambiar N para se"+CHAR(241)+"ales no peri"+CHAR(243)+"dicas.",N)==0 THEN RETURN 0; END;
  IF TYPE(N)<>0 THEN SSInfoView("DFT / IDFT","N no real","Ingrese N entero, no lista, texto ni complejo.",SSAccent(4)); RETURN 0; END;
  IF SSIsDrawable(N)==0 THEN SSInfoView("DFT / IDFT","N fuera de rango","Use un entero de 1 a 1024.",SSAccent(4)); RETURN 0; END;
  IF N<>FLOOR(N) OR N<1 OR N>1024 THEN SSInfoView("DFT / IDFT","N no valido","Use un entero de 1 a 1024. N natural es la longitud de la entrada; no se redondea el N ingresado.",SSAccent(4)); RETURN 0; END;
  base:=SSPad(x,N);
  REPEAT
    IF op==1 THEN spec:=SSDFT({base,"PROGRESS"}); ELSE spec:=SSIDFT({base,"PROGRESS"}); END;
    IF SIZE(spec)>0 THEN BREAK; END;
    IF SSMenu("Calculo cancelado",{"Reintentar: mismos datos","Volver sin calcular"},1)<>1 THEN RETURN 0; END;
  UNTIL 0;
  IF op==1 THEN
    SSDFTResults(spec,{"DFT directa X(w)",base,"",x},1,natural,N);
  ELSE
    SSDFTResults(spec,{"IDFT x[n]",base,"",x},3,natural,N);
  END;
  RETURN 1;
END;

UIDiscreteFourierSeries()
BEGIN
  LOCAL x:={1,0,-1,0};
  LOCAL natural;
  LOCAL N;
  LOCAL k;
  LOCAL c;
  LOCAL fuente;
  LOCAL f:="COS(2*3.141592653589793*X/8)";
  fuente:=SSMenu("Entrada serie discreta",{"Lista o banco: un periodo","Expresion x[n]: un periodo","Volver"},1);
  IF fuente==0 OR fuente==3 THEN RETURN 0; END;
  IF fuente==2 THEN
    IF INPUT(f,"Serie discreta por expresion","x[n]=","Use X como n: COS(2*pi*X/8)",f)==0 THEN RETURN 0; END;
    N:=8;
    IF INPUT(N,"Periodo discreto","N=","Entero 1...1024; n=0...N-1",N)==0 THEN RETURN 0; END;
    IF TYPE(N)<>0 THEN SSInfoView("SignalLab","Aviso","Use un periodo entero real.",SSAccent(1)); RETURN 0; END;
    IF N<>FLOOR(N) OR N<1 OR N>1024 THEN SSInfoView("SignalLab","Aviso","Use N entero de 1 a 1024.",SSAccent(1)); RETURN 0; END;
    x:=SSEvalExpr({f,"DISCRETE"},0,1,N); IF SIZE(x)<>N THEN RETURN 0; END;
    natural:=N;
  ELSE
  x:=SSReadList("Serie de Fourier discreta","Un periodo x[n]=","Ejemplo: {1,0,-1,0}",x); IF SIZE(x)==0 THEN RETURN 0; END;
  natural:=SIZE(x);
  N:=natural;
  IF INPUT(N,"Periodo discreto","N=","Un periodo completo; editable",N)==0 THEN RETURN 0; END;
  IF TYPE(N)<>0 THEN SSInfoView("Serie discreta","Periodo no real","Ingrese N entero, no lista, texto ni complejo.",SSAccent(4)); RETURN 0; END;
  IF SSIsDrawable(N)==0 THEN SSInfoView("Serie discreta","Periodo fuera de rango","Use N entero de 1 a 1024.",SSAccent(4)); RETURN 0; END;
  IF N<>FLOOR(N) OR N<1 OR N>1024 THEN SSInfoView("Serie discreta","Periodo no valido","Use N entero de 1 a 1024. No se redondea el periodo ingresado.",SSAccent(4)); RETURN 0; END;
  END;
  FOR k FROM 1 TO SIZE(x) DO IF SSIsDrawable(x(k))==0 THEN SSInfoView("SignalLab","Aviso","El periodo debe contener muestras finitas.",SSAccent(1)); RETURN 0; END; END;
  SSEVAL_EVENTS:={};
  c:=SSDFT({SSPad(x,N),"PROGRESS"}); IF SIZE(c)==0 THEN RETURN 0; END;
  FOR k FROM 1 TO N DO c(k):=c(k)/N; END;
  c:=SSCleanComplex(c);
  SSDFTResults(c,{"Coeficientes c[k]",SSPad(x,N),"",x},2,natural,N); RETURN 1;
END;

UISpectrum()
BEGIN
  LOCAL compacta:=0;
  LOCAL estimador;
  LOCAL fs:=1;
  LOCAL segmento;
  LOCAL solape:=0;
  LOCAL salto;
  LOCAL bloques;
  LOCAL bloque;
  LOCAL inicio;
  LOCAL quitarMedia;
  LOCAL media;
  LOCAL temporal;
  LOCAL ventanaEnergia;
  LOCAL potencia;
  LOCAL escalaPSD;
  LOCAL x:={1,0,-1,0,1,0,-1,0};
  LOCAL tipo:=3;
  LOCAL beta:=5;
  LOCAL w;
  LOCAL spec;
  LOCAL psd;
  LOCAL shifted;
  LOCAL w0;
  LOCAL dw;
  LOCAL n;
  LOCAL modo;
  LOCAL fuente;
  LOCAL continua;
  LOCAL f:="EXP(-X^2)";
  LOCAL origen:=0;
  LOCAL t0:=-5;
  LOCAL t1:=5;
  LOCAL dt:=1;
  LOCAL Nt:=100;
  LOCAL Nw:=401;
  LOCAL pirad:=3.14159265358979;
  LOCAL wmax:=10;
  LOCAL argumento;
  LOCAL factor;
  LOCAL energia;
  LOCAL banda;
  LOCAL formula;
  LOCAL suma;
  LOCAL termino;
  LOCAL titulo;
  LOCAL eje;
  LOCAL nota;
  LOCAL op:=1;
  modo:=SSMenu("Densidades espectrales",{"Energia: secuencia discreta","Energia: expresion continua","Periodograma con ventana (PSD)","Volver"},1);
  IF modo==0 OR modo==4 THEN RETURN 0; END;
  IF modo<3 THEN
    continua:=modo==2;
    titulo:="Densidad espectral de energia"; eje:="w rad/muestra";
    IF continua THEN
      eje:="w rad/s";
      SSInfoView(titulo,"Continua: modelo de ventana","Use X como tiempo. Se evalua en centros de celdas, con valor constante en cada celda y cero fuera de la ventana. Se calcula la transformada exacta de ese modelo, no la transformada exacta de la expresion original. Ampliar ventana y aumentar N permite comparar la aproximacion. No admite Dirac ideal ni supone repeticion periodica.",SSAccent(4));
      IF INPUT(f,titulo,"x(t)=","Ej: EXP(-X^2); X es tiempo",f)==0 THEN RETURN 0; END;
      IF INSTRING(UPPER(f),"DIRAC(")>0 THEN SSInfoView(titulo,"Dirac no admitida","Esta densidad requiere un modelo de energia finita; no se calcula el cuadrado de una distribucion ideal.",SSAccent(4)); RETURN 0; END;
      IF INPUT(t0,"Ventana temporal","t minimo=","Cero fuera de esta ventana",t0)==0 THEN RETURN 0; END;
      IF INPUT(t1,"Ventana temporal","t maximo=","Mayor que t minimo",t1)==0 THEN RETURN 0; END;
      IF TYPE(t0)<>0 OR TYPE(t1)<>0 THEN RETURN 0; END;
      IF t1<=t0 OR ABS(t0)>1E9 OR ABS(t1)>1E9 THEN SSInfoView(titulo,"Ventana invalida","Extremos reales de magnitud <=1E9 y t max > t min.",SSAccent(4)); RETURN 0; END;
      IF INPUT(Nt,"Modelo continuo","Celdas N=","Entero de 2 a 1024",Nt)==0 THEN RETURN 0; END;
      IF TYPE(Nt)<>0 THEN RETURN 0; END;
      IF Nt<>FLOOR(Nt) OR Nt<2 OR Nt>1024 THEN RETURN 0; END;
      dt:=(t1-t0)/Nt; origen:=t0+dt/2;
      IF origen+dt==origen THEN SSInfoView(titulo,"Paso no representable","Reduzca el origen o amplie la ventana.",SSAccent(4)); RETURN 0; END;
      x:=SSEvalExpr(f,origen,dt,Nt);
      IF INPUT(wmax,"Banda espectral","w max=","Positiva, en rad/s. Se grafica +/-w max",wmax)==0 THEN RETURN 0; END;
      IF TYPE(wmax)<>0 THEN RETURN 0; END;
      IF wmax<=0 OR wmax>1E12 THEN RETURN 0; END;
    ELSE
      fuente:=SSMenu("Entrada de energia espectral",{"Lista o datos exportados","Expresion discreta","Volver"},1);
      IF fuente==0 OR fuente==3 THEN RETURN 0; END;
      IF fuente==1 THEN
        x:=SSReadList(titulo,"x[n]=","Registro finito, cero fuera",{1,-2,1});
        IF SIZE(x)==0 THEN RETURN 0; END;
        IF SSReadStep(1)<>1 THEN SSInfoView(titulo,"Indice no unitario","Para interpretar estos datos como secuencia elija Solo valores; indice desde cero. No se modifica la tasa de muestreo automaticamente.",SSAccent(4)); RETURN 0; END;
        origen:=SSReadOrigin(0); f:="Lista finita ingresada";
      ELSE
        f:="(0.5)^ABS(X)";
        IF INPUT(f,titulo,"x[n]=","X es indice entero; cero fuera del registro",f)==0 THEN RETURN 0; END;
      END;
      IF INPUT(origen,"Indice inicial","n inicial=","Entero; el origen se conserva",origen)==0 THEN RETURN 0; END;
      IF TYPE(origen)<>0 THEN RETURN 0; END;
      IF origen<>FLOOR(origen) OR ABS(origen)>1E9 THEN RETURN 0; END;
      IF fuente==2 THEN
        Nt:=21; IF INPUT(Nt,"Registro discreto","Muestras N=","Entero de 1 a 1024",Nt)==0 THEN RETURN 0; END;
        IF TYPE(Nt)<>0 THEN RETURN 0; END;
        IF Nt<>FLOOR(Nt) OR Nt<1 OR Nt>1024 THEN RETURN 0; END;
        x:=SSEvalExpr({f,"DISCRETE"},origen,1,Nt);
      END;
      wmax:=pirad;
    END;
    IF SIZE(x)<1 OR SIZE(x)>1024 THEN SSInfoView(titulo,"Longitud invalida","Use entre 1 y 1024 muestras.",SSAccent(4)); RETURN 0; END;
    FOR n FROM 1 TO SIZE(x) DO
      IF TYPE(x(n))<>0 AND TYPE(x(n))<>1 AND TYPE(x(n))<>3 THEN SSInfoView(titulo,"Entrada no numerica","Todos los valores deben ser numeros reales o complejos.",SSAccent(4)); RETURN 0; END;
      IF SSIsDrawable(x(n))==0 THEN SSInfoView(titulo,"Entrada no finita","Hay muestras N/D o infinitas. No se omiten ni se sustituyen por cero.",SSAccent(4)); RETURN 0; END;
    END;
    IF INPUT(Nw,"Malla de frecuencias","Puntos Nw=","11...2049; para Parseval use al menos N+1",Nw)==0 THEN RETURN 0; END;
    IF TYPE(Nw)<>0 THEN RETURN 0; END;
    IF Nw<>FLOOR(Nw) OR Nw<11 OR Nw>2049 THEN RETURN 0; END;
    w0:=-wmax; dw:=2*wmax/(Nw-1);
    SSHeader(titulo,"Calculando |X(w)|^2...",SSAccent(4));
    spec:=SSCTFT(x,origen,dt,w0,dw,Nw);
    // Transformada del pulso rectangular de cada celda: dt*sinc(w*dt/2).
    // SSCTFT ya incluye dt; aqui solo falta el factor sinc no normalizado.
    IF continua THEN
      FOR n FROM 1 TO Nw DO
        argumento:=(w0+(n-1)*dw)*dt/2; factor:=1;
        IF ABS(argumento)<1E-4 THEN factor:=1-argumento^2/6+argumento^4/120;
        ELSE factor:=SSSinR(argumento)/argumento; END;
        spec(n):=spec(n)*factor;
      END;
    END;
    psd:=MAKELIST(0,n,1,Nw,1);
    FOR n FROM 1 TO Nw DO
      IF SSIsDrawable(spec(n))==0 THEN SSInfoView(titulo,"Espectro fuera de rango","No se generaron datos parciales. Reduzca amplitud, origen o banda.",SSAccent(4)); RETURN 0; END;
      psd(n):=ABS(spec(n))^2;
      IF SSIsDrawable(psd(n))==0 THEN SSInfoView(titulo,"Densidad fuera de rango","Reduzca la amplitud de entrada.",SSAccent(4)); RETURN 0; END;
    END;
    energia:=SSEnergy(x)*dt; banda:=SSTrapEnergy(psd,dw)/(2*pirad);
    nota:="Densidad de ENERGIA Psi(w)=|X(w)|^2, sin dividir por N ni por duracion. No es |x|^2 temporal ni PSD de una senal periodica. Convencion de Fourier exp(-i*w*t) o exp(-i*w*n). Parseval: E=(1/(2*pi))*integral Psi(w) dw. Se conservan entradas complejas: su densidad no tiene por que ser par. Tabla y exportacion contienen Psi, no su raiz.";
    IF continua THEN
      nota:=nota+"\nContinua: modelo constante por celdas, cero fuera. La integral espectral mostrada cubre SOLO la banda +/-w max y usa trapecios; no reemplaza E total del modelo. Faltan colas y puede haber error de malla. Compare N, Nw, banda y ventana. Un limite finito no demuestra energia finita de la expresion original.";
    ELSE
      nota:=nota+"\nDiscreta: DTFT de la secuencia finita, periodica en w con periodo 2*pi. Se integra un periodo [-pi,pi]. La integral numerica puede subestimar con pocos puntos; Nw-1 >= longitud del registro evita alias de esta cuadratura para el polinomio espectral finito. No se interpreta el registro como una senal temporal repetida.";
    END;
    formula:=""; suma:=""; SSEVAL_EVENTS:={};
    REPEAT
      op:=SSMenu({titulo,{3,titulo,{{"Densidad Psi(w)",psd,w0,dw},{"X(w)",spec,w0,dw},{"Entrada",x,origen,dt},{"Expresion",f}},nota},9},{"Grafico de Psi(w)","Tabla de Psi(w)","Formula del registro o modelo","Energia y comparacion Parseval","Consultar entrada","Tabla compleja X(w)","Exportar Psi(w)","Metodo, unidades y limites","Volver"},op);
      IF op==0 OR op==9 THEN RETURN 1; END;
      IF op==1 THEN SSPlotXY(psd,w0,dw,"Densidad de energia |X(w)|^2",eje); END;
      IF op==2 THEN SSDataView(psd,w0,dw,titulo,eje,"Psi",SSAccent(4)); END;
      IF op==3 THEN
        suma:=""; compacta:=0;
        FOR n FROM 1 TO SIZE(x) DO
          IF x(n)<>0 THEN
            termino:="("+STRING(RE(x(n)),1,12,{3,".E-",0})+"+("+STRING(IM(x(n)),1,12,{3,".E-",0})+")*i)*exp(-i*w*("+STRING(origen+(n-1)*dt,1,12,{3,".E-",0})+"))";
            IF DIM(suma)+DIM(termino)+1>5000 THEN compacta:=1; BREAK; END;
            IF suma<>"" THEN suma:=suma+"+"; END; suma:=suma+termino;
          END;
        END;
        IF compacta THEN
          suma:=""; termino:="";
          formula:="S(w)=sum a[k]*exp(-i*w*(origen+k*dt)), k=0...N-1.\nPsi(w)=abs(S(w))^2.";
          IF continua THEN formula:="S(w)=sum a[k]*exp(-i*w*(origen+k*dt)), k=0...N-1.\nX(w)=dt*sinc(w*dt/2)*S(w); Psi(w)=abs(X(w))^2.\nsinc(v)=sin(v)/v; sinc(0)=1."; END;
          SSInfoView(titulo,"Definicion compacta completa",formula+"\nN="+STRING(SIZE(x))+"; origen="+STRING(origen,1,12,{3,".E-",0})+"; dt="+STRING(dt,1,12,{3,".E-",0})+".\na[k] es la muestra k+1 en Consultar entrada, no una variable CAS. Se incluyen todos los terminos. En continua son centros de celdas del modelo, no la expresion original exacta.",SSAccent(4));
        ELSE
        IF suma=="" THEN suma:="0"; END;
        IF continua THEN
          termino:=STRING(dt,1,12,{3,".E-",0});
          suma:="("+termino+")*piecewise(w==0,1,sin(w*("+termino+")/2)/(w*("+termino+")/2))*("+suma+")";
        END;
        formula:="abs("+suma+")^2"; suma:="";
        SSResultBrowse(titulo,"Formula del registro/modelo",formula,f,"Coeficientes numericos a 12 digitos; no es la transformada simbolica de la expresion original.\n"+nota);
        END;
        formula:=""; termino:="";
      END;
      IF op==4 THEN SSResultBrowse(titulo,"Parseval; escalas y alcance",{{"Energia temporal del registro/modelo",energia},{"Integral espectral numerica / (2*pi)",banda},{"Diferencia temporal menos espectral",energia-banda},{"Paso temporal o de indice",dt},{"Paso de frecuencia",dw}},f,nota); END;
      IF op==5 THEN SSDataView(x,origen,dt,"Entrada usada en densidad","t o n","x",SSAccent(4)); END;
      IF op==6 THEN SSDataView(spec,w0,dw,"Transformada del registro/modelo",eje,"X",SSAccent(4)); END;
      IF op==7 THEN SSExportData(psd,w0,dw,titulo+"; "+eje); END;
      IF op==8 THEN SSInfoView(titulo,"Metodo y unidades",nota,SSAccent(4)); END;
    UNTIL 0;
  END;
  x:=SSReadList("Espectro","x=","Muestras",x); IF SIZE(x)==0 THEN RETURN 0; END;
  IF SIZE(x)>1024 THEN SSInfoView("SignalLab","Aviso","Use como maximo 1024 muestras para proteger la memoria.",SSAccent(1)); RETURN 0; END;
  FOR n FROM 1 TO SIZE(x) DO
    IF SSIsDrawable(x(n))==0 THEN SSInfoView("Espectro","Muestra no valida","El registro contiene N/D o valores no finitos. Corrija la entrada; no se reemplazan por cero ni se aplica una ventana para ocultarlos.",SSAccent(4)); RETURN 0; END;
  END;
  estimador:=SSMenu("Metodo espectral",{"Periodograma anterior: |DFT|^2/N","PSD calibrada: un segmento","PSD Welch: promedio de segmentos","Volver"},1);
  IF estimador==0 OR estimador==4 THEN RETURN 0; END;
  segmento:=SIZE(x);
  IF estimador>1 THEN
    fs:=1/SSReadStep(1);
    IF INPUT(fs,"Frecuencia de muestreo","fs (Hz)=","Confirme unidades: fs=1/Ts, Ts en segundos",fs)==0 THEN RETURN 0; END;
    IF TYPE(fs)<>0 THEN RETURN 0; END;
    IF fs<1E-9 OR fs>1E12 THEN SSInfoView("PSD","fs no valida","Use 1E-9 <= fs <= 1E12 Hz.",SSAccent(4)); RETURN 0; END;
    IF estimador==3 THEN
      segmento:=MIN(256,SIZE(x));
      IF INPUT(segmento,"Welch","Muestras/segmento=","Entero 2...N; sin zero-padding",segmento)==0 THEN RETURN 0; END;
      IF TYPE(segmento)<>0 THEN RETURN 0; END;
      IF segmento<2 OR segmento>SIZE(x) OR segmento<>FLOOR(segmento) THEN RETURN 0; END;
      solape:=FLOOR(segmento/2);
      IF INPUT(solape,"Welch","Solape (muestras)=","Entero 0...segmento-1",solape)==0 THEN RETURN 0; END;
      IF TYPE(solape)<>0 THEN RETURN 0; END;
      IF solape<0 OR solape>=segmento OR solape<>FLOOR(solape) THEN RETURN 0; END;
    END;
    quitarMedia:=SSMenu("Continua en la PSD",{"Conservar media (incluye DC)","Restar media de cada segmento","Cancelar"},1);
    IF quitarMedia==0 OR quitarMedia==3 THEN RETURN 0; END;
  END;
  tipo:=SSMenu("Ventana espectral",{"Rectangular","Hann","Hamming","Blackman","Kaiser"},tipo); IF tipo==0 THEN RETURN 0; END;
  IF tipo==5 THEN
    IF INPUT(beta,"Kaiser","beta=","Real entre 0 y 20",5)==0 THEN RETURN 0; END;
    IF SSIsDrawable(beta)==0 THEN RETURN 0; END;
    IF IM(beta)<>0 OR RE(beta)<0 OR RE(beta)>20 THEN SSInfoView("Kaiser","Beta no valido","Use un real entre 0 y 20.",SSAccent(4)); RETURN 0; END;
    beta:=RE(beta);
  END;
  IF estimador>1 THEN
    salto:=segmento-solape; bloques:=1+FLOOR((SIZE(x)-segmento)/salto);
    IF bloques>128 THEN SSInfoView("Welch","Demasiados segmentos","Maximo 128 por calculo; reduzca solape o aumente el segmento. La entrada no se modifica.",SSAccent(4)); RETURN 0; END;
    w:=SSWindow(segmento,tipo,beta); ventanaEnergia:=0;
    FOR n FROM 1 TO segmento DO ventanaEnergia:=ventanaEnergia+ABS(w(n))^2; END;
    IF ventanaEnergia<=0 THEN SSInfoView("PSD","Ventana de energia nula","Aumente el segmento o elija otra ventana.",SSAccent(4)); RETURN 0; END;
    escalaPSD:=fs*ventanaEnergia*bloques;
    psd:=MAKELIST(0,n,1,segmento,1);
    FOR bloque FROM 0 TO bloques-1 DO
      inicio:=1+bloque*salto;
      temporal:=MAKELIST(x(inicio+n-1),n,1,segmento,1); media:=0;
      IF quitarMedia==2 THEN FOR n FROM 1 TO segmento DO media:=media+temporal(n); END; media:=media/segmento; END;
      FOR n FROM 1 TO segmento DO temporal(n):=(temporal(n)-media)*w(n); END;
      spec:=SSDFT({temporal,"PROGRESS"}); temporal:={};
      IF SIZE(spec)==0 THEN RETURN 0; END;
      FOR n FROM 1 TO segmento DO
        IF SSIsDrawable(spec(n))==0 THEN SSInfoView("PSD","Desbordamiento","No se entrega un promedio incompleto.",SSAccent(4)); RETURN 0; END;
        psd(n):=psd(n)+ABS(spec(n))^2/escalaPSD;
        IF SSIsDrawable(psd(n))==0 THEN RETURN 0; END;
      END;
    END;
    spec:={}; w:={}; psd:=SSShiftSpectrum(psd);
    w0:=-FLOOR(segmento/2)*fs/segmento; dw:=fs/segmento; potencia:=0;
    FOR n FROM 1 TO segmento DO potencia:=potencia+psd(n)*dw; END;
    titulo:="PSD calibrada"; IF estimador==3 THEN titulo:="PSD Welch"; END;
    nota:="Densidad bilateral, unidades de x^2/Hz; no se duplican bins. Promedio de |DFT|^2/(fs*sum ventana^2). No es espectro de amplitud ni densidad de energia. fs="+STRING(fs)+" Hz; segmentos="+STRING(bloques)+" de "+STRING(segmento)+"; solape="+STRING(solape)+". Muestras finales sin segmento completo="+STRING(SIZE(x)-((bloques-1)*salto+segmento))+". ";
    IF quitarMedia==2 THEN nota:=nota+"Se resta la media por segmento."; ELSE nota:=nota+"Se conserva DC."; END;
    REPEAT
      op:=SSMenu({titulo,{3,titulo,{{"PSD bilateral",psd,w0,dw},{"Entrada original",x,SSReadOrigin(0),SSReadStep(1)},{"fs, segmento, solape, media, ventana, beta",{fs,segmento,solape,quitarMedia,tipo,beta}},{"Potencia integrada",potencia}},nota},5},{"Grafico PSD","Tabla PSD","Exportar PSD","Metodo y potencia","Volver"},op);
      IF op==0 OR op==5 THEN RETURN 1; END;
      IF op==1 THEN SSPlotDiscrete(psd,w0,dw,titulo+" [x^2/Hz]","f Hz"); END;
      IF op==2 THEN SSDataView(psd,w0,dw,titulo,"f Hz","PSD",SSAccent(4)); END;
      IF op==3 THEN SSExportData(psd,w0,dw,titulo+"; f Hz; x^2/Hz"); END;
      IF op==4 THEN SSInfoView(titulo,"Potencia integrada="+SSFmt(potencia,8),nota+"\nIntegral estimada=sum PSD*df. Estima potencia ponderada por la ventana y el promedio de segmentos; no tiene por que coincidir exactamente con la potencia de todo el registro.",SSAccent(4)); END;
    UNTIL 0;
  END;
  w:=SSWindow(SIZE(x),tipo,beta); FOR n FROM 1 TO SIZE(x) DO x(n):=x(n)*w(n); END;
  spec:=SSDFT({x,"PROGRESS"}); IF SIZE(spec)==0 THEN RETURN 0; END;
  shifted:=SSShiftSpectrum(spec); psd:=MAKELIST(0,n,1,SIZE(x),1);
  FOR n FROM 1 TO SIZE(x) DO
    psd(n):=SSUndef();
    IF SSIsDrawable(shifted(n)) THEN
      IFERR psd(n):=ABS(shifted(n))^2/SIZE(x); IF SSIsDrawable(psd(n))==0 THEN psd(n):=SSUndef(); END; THEN psd(n):=SSUndef(); END;
    END;
  END;
  w0:=SSDFTAxis0(SIZE(x)); dw:=2*3.141592653589793/SIZE(x);
  REPEAT
    op:=SSMenu({"Espectro con ventana",{3,"Espectro con ventana",{{"DFT con ventana",shifted,w0,dw},{"Periodograma",psd,w0,dw},{"Registro con ventana",x,0,1},{"Ventana: tipo y beta",{tipo,beta}}},"Periodograma = |DFT|^2/N; no calibrado por Hz. w en rad/muestra."},7},{"Magnitud DFT","Periodograma","Tabla compleja DFT","Tabla periodograma","Exportar periodograma","Escala e interpretacion","Volver"},op);
    IF op==0 OR op==7 THEN RETURN 1; END;
    IF op==1 THEN SSPlotDiscrete(SSMag(shifted),w0,dw,"Magnitud DFT con ventana","w"); END;
    IF op==2 THEN SSPlotDiscrete(psd,w0,dw,"Periodograma |DFT|^2/N","w"); END;
    IF op==3 THEN SSDataView(shifted,w0,dw,"DFT con ventana","w","X",SSAccent(4)); END;
    IF op==4 THEN SSDataView(psd,w0,dw,"Periodograma","w","P",SSAccent(4)); END;
    IF op==5 THEN SSExportData(psd,w0,dw,"Periodograma |DFT|^2/N"); END;
    IF op==6 THEN SSInfoView("Periodograma","Escala del registro con ventana","Se muestra |DFT{x*ventana}|^2/N. Eje w en rad/muestra. No se divide por fs ni se compensa la energia de la ventana: no es una PSD calibrada por Hz. La ventana modifica la energia del registro.",SSAccent(4)); END;
  UNTIL 0;
END;

UIConvDFT()
BEGIN
  LOCAL x:={1,2,1};
  LOCAL h:={1,1};
  LOCAL tipo:=1;
  LOCAL specx;
  LOCAL spech;
  LOCAL k;
  LOCAL out;
  LOCAL reales:=1;
  x:=SSReadList("Convolucion DFT","x=","Primera secuencia",x); IF SIZE(x)==0 THEN RETURN 0; END;
  h:=SSReadList("Convolucion DFT","h=","Segunda secuencia",h); IF SIZE(h)==0 THEN RETURN 0; END;
  FOR k FROM 1 TO SIZE(x) DO
    IF SSIsDrawable(x(k))==0 THEN SSInfoView("SignalLab","Aviso","Use muestras finitas en x.",SSAccent(1)); RETURN 0; END;
    IF IM(x(k))<>0 THEN reales:=0; END;
  END;
  FOR k FROM 1 TO SIZE(h) DO
    IF SSIsDrawable(h(k))==0 THEN SSInfoView("SignalLab","Aviso","Use muestras finitas en h.",SSAccent(1)); RETURN 0; END;
    IF IM(h(k))<>0 THEN reales:=0; END;
  END;
  tipo:=SSMenu("Tipo de convolucion DFT",{"Lineal por DFT","Circular"},tipo); IF tipo==0 THEN RETURN 0; END;
  IF tipo==1 AND SIZE(x)+SIZE(h)-1>1024 THEN SSInfoView("SignalLab","Aviso","La longitud DFT resultante debe ser <=1024. Use convolucion directa para una salida mayor.",SSAccent(1)); RETURN 0; END;
  IF tipo==2 AND MAX(SIZE(x),SIZE(h))>1024 THEN SSInfoView("SignalLab","Aviso","Use hasta 1024 muestras por entrada circular.",SSAccent(1)); RETURN 0; END;
  IF tipo==1 THEN
    specx:=SSDFT({SSPad(x,SIZE(x)+SIZE(h)-1),"PROGRESS"}); IF SIZE(specx)==0 THEN RETURN 0; END;
    spech:=SSDFT({SSPad(h,SIZE(specx)),"PROGRESS"}); IF SIZE(spech)==0 THEN RETURN 0; END;
    out:=MAKELIST(0,k,1,SIZE(specx),1);
    FOR k FROM 1 TO SIZE(specx) DO out(k):=specx(k)*spech(k); END; specx:={}; spech:={};
    out:=SSIDFT({out,"PROGRESS"});
  ELSE out:=SSCircular({x,"PROGRESS"},h); END;
  IF SIZE(out)==0 THEN RETURN 0; END;
  // Invariante algebraica: reales * reales es real, aunque la ruta DFT/IDFT
  // introduzca residuos imaginarios. No usar tolerancia para clasificar entradas:
  // una componente imaginaria genuina, por pequena que sea, no es entrada real.
  IF reales==1 THEN FOR k FROM 1 TO SIZE(out) DO out(k):=RE(out(k)); END; END;
  SSConvDFTResults(x,h,out,tipo); RETURN 1;
END;

UIFreqResponse()
BEGIN
  LOCAL b:={1};
  LOCAL a:={1,-0.5};
  LOCAL r;
  LOCAL op:=1;
  r:=SSReadTransfer("Respuesta H(e^jw)",b,a); IF SIZE(r)==0 THEN RETURN 0; END; b:=r(1); a:=r(2);
  REPEAT
    op:=SSMenu({"Respuesta digital H(e^jw)",{3,"Respuesta digital H(e^jw)",{{"Numerador b",b,0,1},{"Denominador a",a,0,1},{"H(z)",SSTransferText(b,a,2)}},"Coeficientes en z^-1. Respuesta digital en -pi...pi rad/muestra."},9},{"Magnitud lineal","Fase en radianes","Magnitud en dB","Funcion H(z) Textbook","Tabla compleja H(e^jw)","Editar H(z)","Fase desenrollada","Retardo de grupo","Volver"},op);
    IF op==0 OR op==9 THEN RETURN 1; END;
    IF op==7 THEN SSDigitalResponseView(b,a,4); END;
    IF op==8 THEN SSDigitalResponseView(b,a,5); END;
    IF op==1 THEN SSDigitalResponseView(b,a,1); END;
    IF op==2 THEN SSDigitalResponseView(b,a,2); END;
    IF op==3 THEN SSDigitalResponseView(b,a,3); END;
    IF op==4 THEN SSFormulaView("Funcion de transferencia","Respuesta discreta",SSTransferText(b,a,2),SSAccent(7)); END;
    IF op==5 THEN r:=SSFResponse(b,a,193); SSDataView(r,-3.141592653589793,2*3.141592653589793/192,"Respuesta compleja","w","H",SSAccent(7)); r:={}; END;
    IF op==6 THEN r:=SSReadTransfer("Respuesta H(e^jw)",b,a); IF SIZE(r)==2 THEN b:=r(1); a:=r(2); END; END;
  UNTIL 0;
END;

VIEW "Fourier discreto",UI_FOURIER()
BEGIN
  LOCAL op:=1;
  LOCAL sub:=1;
  REPEAT
    SSEVAL_EVENTS:={}; SSREAD_META:={};
    op:=SSMenu("Fourier: series y transformadas",{"Serie de Fourier continua","Serie de Fourier discreta","Transformada continua directa","Transformada continua inversa","Fourier discreta: DFT y DTFT","Densidad de energia y PSD","Convolucion y correlacion","Teoria y propiedades de Fourier","Volver al inicio"},op);
    IF op==0 THEN RETURN 0; END;
    IF op==1 THEN UIFourierContinuous(3); END;
    IF op==2 THEN UIDiscreteFourierSeries(); END;
    IF op==3 THEN UIFourierContinuous(1); END;
    IF op==4 THEN UIFourierContinuous(2); END;
    IF op==5 THEN UIDFT(); END;
    IF op==6 THEN UISpectrum(); END;
    IF op==7 THEN sub:=SSMenu("Operaciones de Fourier",{"Convolucion lineal o circular","Correlacion y autocorrelacion","Volver"},sub); IF sub==1 THEN UIConvDFT(); END; IF sub==2 THEN UICorrelation(); END; END;
    IF op==8 THEN SSTheoryView("Teoria de Fourier",{"SERIES. Una senal periodica continua usa coeficientes c[k]=(1/T) integral_T x(t)e^(-jk w0 t)dt. Una secuencia periodica usa c[k]=(1/N) sum_N x[n]e^(-j2pi kn/N).","TRANSFORMADAS. La CTFT integra sobre el tiempo. La DFT analiza N muestras y entrega N bins. SignalLab ordena la DFT sobre -pi <= w < pi.","N EN DFT. El N natural es siempre la longitud de la lista cargada, porque la lista representa el periodo o registro completo. N mayor agrega ceros; N menor trunca. Cambiar N no crea periodicidad en una senal aperiodica.","MODULO Y FASE. El modulo expresa amplitud espectral. La fase se muestra en radianes y queda N/D cuando el modulo es cero. Parseval relaciona energia temporal y espectral."},SSAccent(4)); END;
  UNTIL op==9; RETURN 1;
END;

// ---------- Modulo muestreo y conversion ----------

UINyquist()
BEGIN
  LOCAL fmax:=1000;
  LOCAL fs:=2500;
  LOCAL f:=1700;
  LOCAL fa;
  LOCAL k;
  LOCAL modo:=1;
  LOCAL op:=1;
  LOCAL Ts:=0.1;
  LOCAL N:=21;
  LOCAL A:=1;
  LOCAL phi:=0;
  LOCAL L;
  LOCAL Nt;
  LOCAL dt;
  LOCAL t;
  LOCAL q;
  LOCAL s;
  LOCAL n;
  LOCAL x;
  LOCAL original;
  LOCAL alias;
  LOCAL reconstruida;
  LOCAL error;
  LOCAL nota;
  LOCAL estado;
  LOCAL pirad:=3.141592653589793;
  LOCAL filtro:=0;
  LOCAL fc:=4;
  LOCAL etapas:=4;
  LOCAL H:=1;
  LOCAL ampFiltrada;
  LOCAL faseFiltrada;
  LOCAL continuaFiltrada;
  LOCAL muestrasSinFiltro;
  LOCAL editar;
  LOCAL candidato;
  LOCAL valor;
  LOCAL valido;
  LOCAL principal:=1;
  LOCAL diagnostico:=1;
  LOCAL grafico;
  modo:=SSMenu("Nyquist y aliasing",{"Criterio de banda y alias","Laboratorio visual de un tono","Volver"},1);
  IF modo==0 OR modo==3 THEN RETURN 0; END;
  IF modo==1 THEN
    IF INPUT(fmax,"Nyquist","f max=","Banda maxima conocida, en Hz",fmax)==0 THEN RETURN 0; END;
    IF INPUT(fs,"Nyquist","fs=","Frecuencia de muestreo, en Hz",fs)==0 THEN RETURN 0; END;
    IF INPUT(f,"Aliasing","f tono=","Frecuencia a observar, en Hz",f)==0 THEN RETURN 0; END;
    IF TYPE(fmax)<>0 OR TYPE(fs)<>0 OR TYPE(f)<>0 THEN SSInfoView("SignalLab","Aviso","Ingrese numeros reales.",SSAccent(1)); RETURN 0; END;
    IF fmax<0 OR fs<=0 OR f<0 OR MAX(MAX(fmax,fs),f)>1E12 THEN SSInfoView("SignalLab","Aviso","Use frecuencias no negativas <= 1E12 y fs > 0.",SSAccent(1)); RETURN 0; END;
    IF f/fs>1E12 THEN SSInfoView("SignalLab","Aviso","Relacion f/fs demasiado grande.",SSAccent(1)); RETURN 0; END;
    fa:=f-fs*FLOOR(f/fs+0.5);
    estado:="fs > 2*fmax: satisface el criterio de banda indicada.";
    IF fs<2*fmax THEN estado:="fs < 2*fmax: no satisface el criterio de banda indicada."; END;
    IF fs==2*fmax THEN estado:="fs = 2*fmax: caso limite, no garantiza reconstruccion; depende del contenido y fase en el borde."; END;
    REPEAT
      op:=SSMenu({"Resultado de Nyquist",{3,"Resultado de Nyquist",{{"Banda fmax Hz",fmax},{"Muestreo fs Hz",fs},{"Tono f Hz",f},{"Alias firmado Hz",fa}},estado},5},{"Criterio de banda","Alias del tono","Valores y formulas","Supuestos","Volver"},op);
      IF op==0 OR op==5 THEN RETURN 1; END;
      IF op==1 THEN SSInfoView("Criterio de banda","Comparar fs con 2*fmax","Banda fmax: "+SSFmt(fmax,6)+" Hz\nMuestreo fs: "+SSFmt(fs,6)+" Hz\nUmbral 2*fmax: "+SSFmt(2*fmax,6)+" Hz\n\n"+estado,SSAccent(5)); END;
      IF op==2 THEN
        nota:="Tono original: "+SSFmt(f,6)+" Hz\nAlias firmado: "+SSFmt(fa,6)+" Hz\nFrecuencia aparente: "+SSFmt(ABS(fa),6)+" Hz\n\nEl signo conserva la informacion de fase.";
        IF f>fmax THEN nota:=nota+"\n\nAtencion: este tono supera fmax. El criterio de banda no lo cubre."; END;
        SSInfoView("Alias del tono","Frecuencias en Hz",nota,SSAccent(5));
      END;
      IF op==3 THEN SSResultBrowse("Nyquist y alias","Datos y definiciones",{{"Banda fmax en Hz",fmax},{"Muestreo fs en Hz",fs},{"Periodo Ts en s",1/fs},{"Umbral 2*fmax en Hz",2*fmax},{"Alias firmado en Hz",fa},{"Frecuencia aparente en Hz",ABS(fa)},{"Formula del alias","f-fs*floor(f/fs+1/2)"}},"La banda se ingresa; no se estima automaticamente.","Alias firmado en [-fs/2,fs/2). Frecuencia aparente=abs(fa). El umbral de Nyquist es estricto: fs=2*fmax es un caso limite."); END;
      IF op==4 THEN SSTheoryView("Supuestos de Nyquist",{"BANDA CONOCIDA\n\nfmax es la banda declarada por el usuario. No se infiere de la senal. Un tono mayor que fmax no queda cubierto por ese criterio.","MUESTREO IDEAL\n\nSe supone muestreo uniforme, sin filtro previo. fs>2*fmax satisface el criterio de banda. La igualdad es un caso limite dependiente del contenido y la fase.","ALIAS DEL TONO\n\nLa frecuencia aparente es el valor absoluto del alias firmado. No identifica una unica senal analogica original."},SSAccent(5)); END;
    UNTIL 0;
  END;
  f:=7;
  SSInfoView("Laboratorio de aliasing","Tono cosenoidal","x(t)=A*cos(2*pi*f*t+phi)\n\nt: segundos; f: Hz; phi: radianes.\nInicio del registro: t=0.\n\nEjemplo: f=7 Hz, Ts=0.1 s.\nFrecuencia aparente: 3 Hz.\nEdite Ts desde el resultado.",SSAccent(5));
  IF INPUT(f,"Tono original","f (Hz)=","Frecuencia de 0 a 1E6 Hz",f)==0 THEN RETURN 0; END;
  IF INPUT(A,"Tono original","A=","Amplitud real con signo",A)==0 THEN RETURN 0; END;
  IF INPUT(phi,"Tono original","phi (rad)=","Fase en radianes, no grados",phi)==0 THEN RETURN 0; END;
  IF INPUT(N,"Muestras del laboratorio","N=","Entero de 2 a 64; ventana (N-1)*Ts",N)==0 THEN RETURN 0; END;
  IF TYPE(f)<>0 OR TYPE(A)<>0 OR TYPE(phi)<>0 OR TYPE(N)<>0 THEN SSInfoView("SignalLab","Aviso","Ingrese valores reales.",SSAccent(1)); RETURN 0; END;
  IF f<0 OR f>1E6 OR ABS(A)>1E6 OR ABS(phi)>1E6 OR N<>FLOOR(N) OR N<2 OR N>64 THEN SSInfoView("SignalLab","Aviso","Revise f, |A| y |phi| <= 1E6; N entero de 2 a 64.",SSAccent(1)); RETURN 0; END;
  phi:=phi-2*pirad*FLOOR(phi/(2*pirad));
    IF INPUT(Ts,"Muestreo del tono","Ts (s)=","Ej: 0.1; reduzca para subir fs",Ts)==0 THEN RETURN 0; END;
    IF TYPE(Ts)<>0 THEN SSInfoView("SignalLab","Aviso","Ts debe ser real.",SSAccent(1)); RETURN 0; END;
    IF Ts<1E-9 OR Ts>1E6 THEN SSInfoView("SignalLab","Aviso","Use 1E-9 <= Ts <= 1E6 segundos.",SSAccent(1)); RETURN 0; END;
  fc:=0.4/Ts;
  REPEAT
    fs:=1/Ts; fa:=f-fs*FLOOR(f/fs+0.5);
    L:=MAX(8,FLOOR(24*f*Ts)+1); Nt:=(N-1)*L+1;
    IF Nt>1024 THEN
      SSInfoView("Resolucion del laboratorio","Reduzca Ts o vuelva para bajar N","La curva original requiere mas de 1024 puntos para representar este tono sin submuestrear tambien el dibujo. No se dibujara una curva enganosa. ENTER permite elegir otro Ts.",SSAccent(5));
      IF INPUT(Ts,"Reducir ventana","Ts (s)=","Reduzca Ts para usar <=1024 puntos",Ts)==0 THEN RETURN 0; END;
      IF TYPE(Ts)<>0 THEN RETURN 0; END;
      IF Ts<1E-9 OR Ts>1E6 THEN RETURN 0; END;
      fc:=0.4/Ts;
    ELSE
      dt:=Ts/L;
      H:=1;
      IF filtro==1 THEN H:=1/((1,(f/fc))^etapas); END;
      ampFiltrada:=A*ABS(H); faseFiltrada:=phi+IM(LN(H));
      muestrasSinFiltro:=MAKELIST(A*SSCosR(2*pirad*f*(k-1)*Ts+phi),k,1,N,1);
      x:=MAKELIST(ampFiltrada*SSCosR(2*pirad*f*(k-1)*Ts+faseFiltrada),k,1,N,1);
      original:=MAKELIST(0,k,1,Nt,1); alias:=original; reconstruida:=original; continuaFiltrada:=original;
      FOR k FROM 1 TO Nt DO
        t:=(k-1)*dt;
        original(k):=A*SSCosR(2*pirad*f*t+phi);
        continuaFiltrada(k):=ampFiltrada*SSCosR(2*pirad*f*t+faseFiltrada);
        alias(k):=ampFiltrada*SSCosR(2*pirad*fa*t+faseFiltrada);
        s:=0;
        // SINC en radianes; ceros enteros exactos y solo N muestras.
        FOR n FROM 1 TO N DO
          q:=(k-1)/L-(n-1);
          IF q==0 THEN s:=s+x(n);
          ELSE IF q<>FLOOR(q) THEN s:=s+x(n)*SSSinR(pirad*q)/(pirad*q); END; END;
        END;
        reconstruida(k):=s;
      END;
      error:=reconstruida-original;
      SSEVAL_EVENTS:={};
      estado:="Tono dentro de la banda de Nyquist (f < fs/2).";
      IF f>fs/2 THEN estado:="Tono por encima de Nyquist: aparece plegamiento."; END;
      IF f==fs/2 THEN estado:="Tono justo en Nyquist: caso limite dependiente de fase."; END;
      IF A==0 THEN estado:="A=0: senal nula; no hay un tono observable."; END;
      // El diagnostico se presenta por temas, sin construir un bloque monolitico.
      op:=1;
      REPEAT
        principal:=SSMenu({"Laboratorio de aliasing",{3,"Laboratorio de aliasing",{{"Muestras",x,0,Ts},{"Original continuo",original,0,dt},{"Alias continuo",alias,0,dt},{"Reconstruccion SINC",reconstruida,0,dt},{"Tono f, A, fase",{f,A,phi}},{"Filtro, corte Hz, etapas",{filtro,fc,etapas}}},estado+"\nTs="+STRING(Ts)+"; N="+STRING(N)},7},{"Resumen y diagnostico","Graficos individuales","Muestras y exportacion","Comparar senales","Editar tono y muestreo","Filtro antialias RC","Volver"},principal);
        IF principal==0 OR principal==7 THEN RETURN 1; END;
        op:=-1;
        IF principal==1 THEN op:=1; END;
        IF principal==2 THEN
          grafico:=SSMenu("Graficos de aliasing",{"Tono original","Tono alias","Entrada al muestreador","Reconstruccion SINC","Error SINC - original","Espectros de lineas","Volver"},1);
          IF grafico==1 THEN op:=2; END;
          IF grafico==2 THEN op:=3; END;
          IF grafico==3 THEN op:=11; END;
          IF grafico==4 THEN op:=5; END;
          IF grafico==5 THEN op:=6; END;
          IF grafico==6 THEN op:=7; END;
        END;
        IF principal==3 THEN op:=4; END;
        IF principal==4 THEN op:=8; END;
        IF principal==5 THEN op:=9; END;
        IF principal==6 THEN op:=10; END;
        IF op==1 THEN
          diagnostico:=1;
          REPEAT
            diagnostico:=SSMenu("Diagnostico de aliasing",{"Resumen del muestreo","Datos del tono","Filtro y senal muestreada","Interpretar el alias","SINC y error","Interpretar los espectros","Volver"},diagnostico);
            IF diagnostico==0 OR diagnostico==7 THEN BREAK; END;
            IF diagnostico==1 THEN SSInfoView("Resumen del muestreo","Frecuencias en Hz","fs: "+SSFmt(fs,6)+" Hz\nLimite fs/2: "+SSFmt(fs/2,6)+" Hz\nTono: "+SSFmt(f,6)+" Hz\nAlias firmado: "+SSFmt(fa,6)+" Hz\nAparente: "+SSFmt(ABS(fa),6)+" Hz\n\n"+estado,SSAccent(5)); END;
            IF diagnostico==2 THEN SSResultBrowse("Datos del tono","Entrada y ventana",{{"Frecuencia f en Hz",f},{"Amplitud A",A},{"Fase phi en rad",phi},{"Periodo Ts en s",Ts},{"Muestras N",N},{"Duracion en s",(N-1)*Ts},{"Formula del tono","A*cos(2*pi*f*t+phi)"}},"t=0..."+SSFmt((N-1)*Ts,6)+" s","La formula usa los parametros de este menu. Amplitud con las unidades de entrada; fase en radianes. No cambia el modo angular."); END;
            IF diagnostico==3 THEN
              IF filtro==0 THEN SSInfoView("Filtro antialias","Desactivado","Las muestras se toman del tono original.\n\nPuede activar una cascada RC desde Filtro antialias RC.\n\nUn filtro previo atenua el alias; no recupera informacion ya perdida.",SSAccent(5));
              ELSE SSResultBrowse("Filtro RC activo","Antes del muestreador",{{"Corte por etapa en Hz",fc},{"Etapas RC",etapas},{"Ganancia en el tono",ABS(H)},{"Atenuacion en dB",-20*LOG(ABS(H))},{"Fase agregada en rad",IM(LN(H))},{"Amplitud muestreada",ampFiltrada},{"Fase muestreada en rad",faseFiltrada},{"Modelo H(s)","(1+s/(2*pi*fc))^(-r)"}},"r="+STRING(etapas)+"; fc="+SSFmt(fc,6)+" Hz","Etapas RC desacopladas en regimen permanente, sin transitorio. fc es el corte de CADA etapa; no es un Butterworth ni un filtro ideal. Se filtra antes de muestrear. El alias conserva su frecuencia, con amplitud y fase modificadas."); END;
            END;
            IF diagnostico==4 THEN SSTheoryView("Interpretar el alias",{"FRECUENCIA Y SIGNO\n\nfa=f-fs*floor(f/fs+1/2).\nfa pertenece a [-fs/2,fs/2).\nLa frecuencia aparente es |fa|.\nEl signo conserva la fase.","COINCIDENCIA EN LAS MUESTRAS\n\nEl alias coincide con el tono muestreado en los instantes n*Ts, no necesariamente entre ellos. No identifica una unica senal analogica original.","SI HAY FILTRO RC\n\nLas muestras y el alias usan la amplitud y fase del tono filtrado. El filtro atenua el alias, no cambia fa ni garantiza eliminar todo plegamiento."},SSAccent(5)); END;
            IF diagnostico==5 THEN SSTheoryView("SINC y error",{"RECONSTRUCCION FINITA\n\nSe suman N terminos x[n]*sinc(t/Ts-n).\nsinc(u)=sin(pi*u)/(pi*u), con valor 1 en u=0.\nSolo se usa el registro disponible.","QUE MIDE EL ERROR\n\nError = SINC - original sin filtro.\nIncluye efectos de borde y truncamiento, incluso sin alias. Con filtro tambien incluye su efecto.","COMPARACION UTIL\n\nUse Comparar senales > Filtrada analogica y SINC para separar visualmente el filtrado de la reconstruccion finita. No es una reconstruccion de una senal infinita."},SSAccent(5)); END;
            IF diagnostico==6 THEN SSTheoryView("Espectros de lineas",{"PESOS ANALITICOS\n\nLos tallos son magnitudes de pesos espectrales en Hz; no son DFT ni PSD. Para f>0, el tono tiene pesos |A|/2 en +/-f. No se grafica fase.","DC Y NYQUIST\n\nEn DC el peso es |A*cos(phi)|. En Nyquist puede perderse la componente en cuadratura: la igualdad no garantiza reconstruccion.","CON FILTRO ACTIVO\n\nEl espectro original es el tono sin filtrar. El espectro alias usa la amplitud y fase despues del filtro RC. Sus pesos no describen una DFT de la ventana finita."},SSAccent(5)); END;
          UNTIL 0;
        END;
        IF op==2 THEN SSPlotXY(original,0,dt,"Tono original","t (s); f="+SSFmt(f,4)+" Hz"); END;
        IF op==3 THEN SSPlotXY(alias,0,dt,"Tono alias equivalente","t (s); fa="+SSFmt(fa,4)+" Hz"); END;
        IF op==4 THEN SSDataView(x,0,Ts,"Aliasing: muestras del tono","t (s)","x[n]",SSAccent(5)); SSPlotDiscrete(x,0,Ts,"Aliasing: muestras del tono","t (s)"); END;
        IF op==5 THEN SSPlotXY(reconstruida,0,dt,"SINC finita del tono","t (s); aproximacion con N muestras"); END;
        IF op==6 THEN SSPlotXY(error,0,dt,"Error SINC - original","t (s); incluye filtro, borde y alias"); END;
        IF op==7 THEN
          SSInfoView("Espectros del laboratorio","Pesos de lineas, no alturas","Primero se muestra el tono original y luego el alias equivalente. Eje en Hz. Los tallos representan magnitudes de pesos espectrales; no son una DFT de la ventana. La fase no se muestra en este grafico. En Nyquist las muestras pueden perder la componente en cuadratura.",SSAccent(4));
          IF f==0 THEN SSPlotDiscrete({ABS(A*SSCosR(phi))},0,1,"Espectro original: DC","f (Hz)");
          ELSE SSPlotDiscrete({ABS(A)/2,0,ABS(A)/2},-f,f,"Espectro original: pesos","f (Hz)"); END;
          IF fa==0 THEN SSPlotDiscrete({ABS(ampFiltrada*SSCosR(faseFiltrada))},0,1,"Espectro alias: DC","f (Hz)");
          ELSE SSPlotDiscrete({ABS(ampFiltrada)/2,0,ABS(ampFiltrada)/2},-ABS(fa),ABS(fa),"Espectro alias: pesos","f (Hz)"); END;
        END;
        IF op==8 THEN
          k:=SSMenu("Comparaciones del laboratorio",{"Original y alias","Original y SINC","Original y filtrada analogica","Muestras sin y con filtro","Filtrada analogica y SINC","Volver"},1);
          IF k==1 THEN SSPlotDual(original,alias,{"Original y alias | t (s)",0,dt}); END;
          IF k==2 THEN SSPlotDual(original,reconstruida,{"Original y SINC | t (s)",0,dt}); END;
          IF k==3 THEN SSPlotDual(original,continuaFiltrada,{"Original y filtrada | t (s)",0,dt}); END;
          IF k==4 THEN SSPlotDual(muestrasSinFiltro,x,{"Muestras sin/con filtro",0,Ts}); END;
          IF k==5 THEN SSPlotDual(continuaFiltrada,reconstruida,{"Filtrada y SINC | t (s)",0,dt}); END;
        END;
        IF op==11 THEN SSPlotXY(continuaFiltrada,0,dt,"Entrada analogica al muestreo","t (s); filtro activo="+STRING(filtro)); END;
        IF op==9 OR op==10 THEN
          candidato:={f,A,phi,N,Ts,fc,etapas,filtro}; valido:=0;
          IF op==9 THEN
            editar:=SSMenu("Editar un parametro",{"Frecuencia f (Hz)","Amplitud A","Fase phi (rad)","Cantidad de muestras N","Periodo Ts (s)","Volver al resultado"},1);
            IF editar>=1 AND editar<=5 THEN
              valor:=candidato(editar);
              IF INPUT(valor,"Editar parametro","Valor=","Conserva los demas parametros",valor) THEN candidato(editar):=valor; valido:=1; END;
            END;
          ELSE
            editar:=SSMenu("Filtro antes de muestrear",{"Sin filtro","Cascada analogica RC","Volver"},1+filtro);
            IF editar==1 THEN candidato(8):=0; valido:=1; END;
            IF editar==2 THEN
              valor:=fc;
              IF INPUT(valor,"Corte por etapa RC","fc (Hz)=","1E-12 <= fc < fs/2; sugerido 0.4/Ts",fc) THEN
                candidato(6):=valor; valor:=etapas;
                IF INPUT(valor,"Etapas RC desacopladas","r=","Entero de 1 a 8; modelo estacionario",etapas) THEN candidato(7):=valor; candidato(8):=1; valido:=1; END;
              END;
            END;
          END;
          IF valido==1 THEN
            FOR k FROM 1 TO 8 DO IF TYPE(candidato(k))<>0 THEN valido:=0; END; END;
            IF valido==1 THEN
              IF candidato(1)<0 OR candidato(1)>1E6 OR ABS(candidato(2))>1E6 OR ABS(candidato(3))>1E6 OR candidato(4)<2 OR candidato(4)>64 OR candidato(4)<>FLOOR(candidato(4)) OR candidato(5)<1E-9 OR candidato(5)>1E6 THEN valido:=0; END;
              IF valido==1 THEN
                IF (candidato(4)-1)*MAX(8,FLOOR(24*candidato(1)*candidato(5))+1)+1>1024 THEN valido:=0; END;
                IF candidato(8)==1 THEN
                  // Al bajar fs, ajustar el corte propuesto al nuevo Nyquist.
                  IF op==9 AND editar==5 AND candidato(6)>=0.5/candidato(5) THEN candidato(6):=0.4/candidato(5); END;
                  IF candidato(6)<1E-12 OR candidato(6)>=0.5/candidato(5) OR candidato(7)<1 OR candidato(7)>8 OR candidato(7)<>FLOOR(candidato(7)) THEN valido:=0; END;
                END;
              END;
            END;
            IF valido==1 THEN
              IF op==9 AND editar==5 AND candidato(8)==1 AND candidato(6)<>fc THEN SSInfoView("Corte ajustado","Cambio de Ts","El corte anterior excedia el nuevo Nyquist. Se ajusto fc a "+STRING(candidato(6))+" Hz; puede editarlo en Filtro antialias analogico.",SSAccent(5)); END;
              f:=candidato(1); A:=candidato(2); phi:=candidato(3); N:=candidato(4); Ts:=candidato(5); fc:=candidato(6); etapas:=candidato(7); filtro:=candidato(8); op:=9;
            ELSE SSInfoView("SignalLab","Aviso","Cambio invalido o rejilla >1024. Se conserva el resultado anterior.",SSAccent(1)); op:=1; END;
          ELSE op:=1; END;
        END;
      UNTIL op==9;
    END;
  UNTIL 0;
END;

UIRateChange()
BEGIN
  LOCAL x:={1,2,3,4,5,6};
  LOCAL pasoEntrada:=1;
  LOCAL op:=1;
  LOCAL fuente:=1;
  LOCAL M:=2;
  LOCAL fase:=0;
  LOCAL f:="COS(pi*X/4)";
  LOCAL n0:=-8;
  LOCAL n1:=8;
  LOCAL N;
  LOCAL y;
  op:=SSMenu("Cambio de tasa",{"Diezmar","Expandir con ceros","Interpolacion lineal","Interpolacion SINC","Retenedor orden cero"},op); IF op==0 THEN RETURN 0; END;
  IF op<=4 THEN
    fuente:=SSMenu("Entrada x[n]",{"Secuencia finita","Expresion matematica x[n]"},fuente); IF fuente==0 THEN RETURN 0; END;
  ELSE
    fuente:=1;
  END;
  IF fuente==1 THEN
    n0:=0;
    x:=SSReadList("Cambio de tasa","x[n]=","Ejemplo: {1,2,3,4,5,6}",x); IF SIZE(x)==0 THEN RETURN 0; END;
    n0:=SSReadOrigin(0); pasoEntrada:=SSReadStep(1);
    IF pasoEntrada<>1 OR n0<>FLOOR(n0) THEN
      SSInfoView("Entrada discreta","Reindexar muestras desde n=0","El banco trae origen="+STRING(n0)+" y paso="+STRING(pasoEntrada)+". Se conservan los valores en orden y se asignan indices n=0..."+STRING(SIZE(x)-1)+". El eje importado no se interpreta como n. El banco original no cambia hasta exportar.",SSAccent(5));
      n0:=0;
    END;
    pasoEntrada:=1;
  ELSE
    IF INPUT(f,"Entrada por expresion","x[n]=","X es n. Ej: COS(X) o X^2",f)==0 THEN RETURN 0; END;
    IF INPUT(n0,"Intervalo de entrada","n inicial=","Primer indice",-8)==0 THEN RETURN 0; END;
    IF INPUT(n1,"Intervalo de entrada","n final=","Ultimo indice",8)==0 THEN RETURN 0; END;
    IF TYPE(n0)<>0 OR TYPE(n1)<>0 THEN SSInfoView("Cambio de tasa","Indices no reales","Use n inicial y final enteros; no listas, textos ni complejos.",SSAccent(5)); RETURN 0; END;
    IF SSIsDrawable(n0)==0 OR SSIsDrawable(n1)==0 THEN SSInfoView("Cambio de tasa","Indices fuera de rango","Use indices enteros de magnitud <=1E12.",SSAccent(5)); RETURN 0; END;
    IF n0<>FLOOR(n0) OR n1<>FLOOR(n1) OR ABS(n0)>1E12 OR ABS(n1)>1E12 THEN SSInfoView("Cambio de tasa","Indices invalidos","Use indices enteros de magnitud <=1E12. No se redondea ni se cambia la ventana solicitada.",SSAccent(5)); RETURN 0; END;
    IF n1<n0 THEN SSInfoView("SignalLab","Aviso","Intervalo invalido.",SSAccent(1)); RETURN 0; END;
    N:=n1-n0+1; IF N>1024 THEN SSInfoView("SignalLab","Aviso","Use como maximo 1024 indices por expresion.",SSAccent(1)); RETURN 0; END;
    x:=SSEvalExpr({f,"DISCRETE"},n0,1,N); IF SIZE(x)==0 THEN RETURN 0; END;
  END;
  IF ABS(n0)>1E12 THEN SSInfoView("SignalLab","Aviso","Use un indice inicial de valor absoluto <= 1E12.",SSAccent(1)); RETURN 0; END;
  IF INPUT(M,"Factor","M o L=","Entero de 1 a 2048",2)==0 THEN RETURN 0; END;
  IF TYPE(M)<>0 THEN SSInfoView("SignalLab","Aviso","El factor debe ser real.",SSAccent(1)); RETURN 0; END;
  IF M<1 OR M>2048 OR M<>FLOOR(M) THEN SSInfoView("SignalLab","Aviso","El factor debe ser un entero de 1 a 2048.",SSAccent(1)); RETURN 0; END;
  IF op>1 AND (SIZE(x)-1)*M+1>2048 THEN SSInfoView("SignalLab","Aviso","La salida supera 2048 valores. Reduzca el factor o la lista.",SSAccent(1)); RETURN 0; END;
  IF op==1 THEN
    IF INPUT(fase,"Diezmado","fase p=","0..M-1; y[n]=x[M*n+p]",0)==0 THEN RETURN 0; END;
    IF TYPE(fase)<>0 THEN SSInfoView("SignalLab","Aviso","La fase debe ser real.",SSAccent(1)); RETURN 0; END;
    IF fase<>FLOOR(fase) OR fase<0 OR fase>=M THEN SSInfoView("SignalLab","Aviso","Fase invalida: use un entero de 0 a M-1.",SSAccent(1)); RETURN 0; END;
    N:=fase-n0-M*FLOOR((fase-n0)/M);
    y:=SSDecimate(x,M,N);
  END;
  IF op==2 THEN y:=SSExpand(x,M); END;
  IF op==3 THEN y:=SSLinearInterp(x,M); END;
  IF op==4 THEN
    IF (SIZE(x)-1)*M+1>1024 THEN SSInfoView("SignalLab","Aviso","SINC admite hasta 1024 puntos de salida. Reduzca la lista o el factor L.",SSAccent(1)); RETURN 0; END;
    REPEAT
      y:=SSSincInterp({x,"PROGRESS"},M);
      IF SIZE(y)>0 THEN BREAK; END;
      IF SSMenu("SINC cancelada",{"Reintentar: misma entrada","Volver sin calcular"},1)<>1 THEN RETURN 0; END;
    UNTIL 0;
  END;
  IF op==5 THEN y:=SSZeroOrderHold(x,M); END;
  IF SIZE(y)==0 THEN SSInfoView("SignalLab","Aviso","La fase elegida no deja muestras dentro de la lista.",SSAccent(1)); RETURN 0; END;
  SSEVAL_EVENTS:={};
  SSRateResults(x,y,n0,op,M,fase,fuente,f,pasoEntrada); RETURN 1;
END;

UIReconstruction()
BEGIN
  LOCAL x:={0,1,0,-1,0};
  LOCAL t0:=0;
  LOCAL Ts:=0.25;
  LOCAL L:=8;
  LOCAL metodo:=2;
  LOCAL y;
  LOCAL op:=1;
  x:=SSReadList("Reconstruccion D/A","x[n]=","Ejemplo: {0,1,0,-1,0}",x); IF SIZE(x)==0 THEN RETURN 0; END;
  t0:=SSReadOrigin(0); Ts:=SSReadStep(0.25);
  IF INPUT(Ts,"Eje temporal","Ts=","Paso importado o periodo entre muestras",Ts)==0 THEN RETURN 0; END;
  IF INPUT(L,"Resolucion","puntos por Ts=","Entero entre 2 y 32",8)==0 THEN RETURN 0; END;
  IF SSIsDrawable(Ts)==0 OR SSIsDrawable(L)==0 THEN RETURN 0; END;
  IF IM(Ts)<>0 OR IM(L)<>0 THEN SSInfoView("Reconstruccion D/A","Parametros no reales","Ts y la resolucion deben ser reales.",SSAccent(5)); RETURN 0; END;
  Ts:=RE(Ts); L:=RE(L);
  IF Ts<=0 THEN SSInfoView("SignalLab","Aviso","Ts debe ser positivo.",SSAccent(1)); RETURN 0; END;
  IF L<2 OR L>32 OR L<>FLOOR(L) THEN SSInfoView("Reconstruccion D/A","Resolucion no valida","Use un entero entre 2 y 32. No se modifica silenciosamente el valor ingresado.",SSAccent(5)); RETURN 0; END;
  metodo:=SSMenu("Metodo D/A",{"Retenedor de orden cero","Interpolacion lineal","Interpolacion SINC"},metodo); IF metodo==0 THEN RETURN 0; END;
  IF metodo==3 AND (SIZE(x)-1)*L+1>1024 THEN SSInfoView("SignalLab","Aviso","SINC admite hasta 1024 puntos de salida. Reduzca la lista o los puntos por Ts.",SSAccent(1)); RETURN 0; END;
  IF (SIZE(x)-1)*L+1>4096 THEN SSInfoView("Reconstruccion D/A","Salida demasiado extensa","Se requieren "+STRING((SIZE(x)-1)*L+1)+" puntos; el limite es 4096. Reduzca la lista o los puntos por Ts.",SSAccent(5)); RETURN 0; END;
  IF metodo==1 THEN y:=SSZeroOrderHold(x,L); END;
  IF metodo==2 THEN y:=SSLinearInterp(x,L); END;
  IF metodo==3 THEN
    REPEAT
      y:=SSSincInterp({x,"PROGRESS"},L);
      IF SIZE(y)>0 THEN BREAK; END;
      IF SSMenu("SINC cancelada",{"Reintentar: misma entrada","Volver sin calcular"},1)<>1 THEN RETURN 0; END;
    UNTIL 0;
  END;
  IF SIZE(y)==0 THEN SSInfoView("Reconstruccion D/A","Sin salida","No se pudo construir la reconstruccion. Revise los datos y la resolucion.",SSAccent(5)); RETURN 0; END;
  SSEVAL_EVENTS:={};
  REPEAT
  op:=SSMenu({"Reconstruccion D/A",{3,"Reconstruccion D/A",{{"Entrada x[n]",x,t0,Ts},{"Salida reconstruida",y,t0,Ts/L},{"Metodo: 1 ZOH, 2 lineal, 3 SINC",metodo},{"Puntos por Ts",L}},"Eje temporal. Reconstruccion numerica del registro finito."},6},{"Grafico de entrada","Grafico reconstruido","Tabla de salida","Exportar salida","Metodo y resolucion","Volver"},op);
  IF op==0 OR op==6 THEN RETURN 1; END;
  IF op==1 THEN SSPlotDiscrete(x,t0,Ts,"Entrada discreta x[n]","t"); END;
  IF op==2 THEN
  IF metodo==1 THEN
    SSPlotXY(y,t0,Ts/L,"Salida continua aproximada",{"Reconstruccion por retenedor ZOH","ZOH"});
  ELSE IF metodo==2 THEN
    SSPlotXY(y,t0,Ts/L,"Salida continua aproximada","Reconstruccion por interpolacion lineal");
  ELSE
    SSPlotXY(y,t0,Ts/L,"Salida continua aproximada","Reconstruccion SINC ideal truncada");
  END; END;
  END;
  IF op==3 THEN SSDataView(y,t0,Ts/L,"Reconstruccion D/A","t","y(t)",SSAccent(5)); END;
  IF op==4 THEN SSExportData(y,t0,Ts/L,"Reconstruccion D/A"); END;
  IF op==5 THEN SSInfoView("Reconstruccion D/A","Registro finito","Metodo: 1 ZOH; 2 lineal; 3 SINC. Elegido="+STRING(metodo)+"\nTs="+STRING(Ts)+"; puntos por Ts="+STRING(L)+". No es una reconstruccion de una senal infinita conocida.",SSAccent(5)); END;
  UNTIL 0;
END;

UIQuantization()
BEGIN
  LOCAL x:={-1,-0.4,0,0.3,0.9,1};
  LOCAL bits:=3;
  LOCAL qlo:=-1;
  LOCAL qhi:=1;
  LOCAL modo:=1;
  LOCAL offsetMode:=1;
  LOCAL k;
  LOCAL r;
  LOCAL snr;
  x:=SSReadList("Cuantizacion","x=","Muestras",x); IF SIZE(x)==0 THEN RETURN 0; END;
  FOR k FROM 1 TO SIZE(x) DO
    IF SSIsDrawable(x(k))==0 THEN SSInfoView("Cuantizacion","Entrada no valida","Use muestras numericas reales y finitas.",SSAccent(5)); RETURN 0; END;
    IF IM(x(k))<>0 THEN SSInfoView("Cuantizacion","Entrada no real","El cuantizador requiere muestras reales.",SSAccent(5)); RETURN 0; END;
    x(k):=RE(x(k));
  END;
  IF INPUT(bits,"Cuantizacion","bits=","Entero entre 1 y 24",3)==0 THEN RETURN 0; END;
  IF SSIsDrawable(bits)==0 THEN RETURN 0; END;
  IF IM(bits)<>0 THEN RETURN 0; END;
  bits:=RE(bits);
  IF bits<1 OR bits>24 OR bits<>FLOOR(bits) THEN SSInfoView("Cuantizacion","Bits no validos","Ingrese un entero entre 1 y 24.",SSAccent(5)); RETURN 0; END;
  IF INPUT(qlo,"Rango","min=","Valor minimo",-1)==0 THEN RETURN 0; END;
  IF INPUT(qhi,"Rango","max=","Valor maximo",1)==0 THEN RETURN 0; END;
  IF SSIsDrawable(qlo)==0 OR SSIsDrawable(qhi)==0 THEN RETURN 0; END;
  IF IM(qlo)<>0 OR IM(qhi)<>0 THEN RETURN 0; END;
  qlo:=RE(qlo); qhi:=RE(qhi);
  IF qhi<=qlo THEN SSInfoView("Cuantizacion","Rango no valido","El maximo debe ser mayor que el minimo.",SSAccent(5)); RETURN 0; END;
  offsetMode:=SSMenu("Niveles de cuantizacion",{"Sin offset: rango original","Con offset: nivel en 0"},offsetMode); IF offsetMode==0 THEN RETURN 0; END;
  IF offsetMode==2 AND (qlo>0 OR qhi<0) THEN SSInfoView("Cuantizacion","El rango debe incluir 0","Para alinear un nivel con cero, indique un minimo <=0 y un maximo >=0.",SSAccent(5)); RETURN 0; END;
  modo:=SSMenu("Metodo de cuantizacion",{"Redondeo","Truncamiento"},modo); IF modo==0 THEN RETURN 0; END;
  IF offsetMode==2 THEN modo:=modo+2; END;
  r:=SSQuantize(x,bits,qlo,qhi,modo);
  // SSQuantResults calcula la SNR una vez y al cambiar el intervalo.
  // No construir aqui otra lista de error ni duplicar la misma suma.
  snr:=0;
  SSQuantResults(x,r(1),bits,qlo,qhi,r(2),r(3),snr,modo); RETURN 1;
END;

UIFixedPoint()
BEGIN
  LOCAL x:=0.7;
  LOCAL ni:=2;
  LOCAL nf:=6;
  LOCAL modo:=1;
  LOCAL esc;
  LOCAL minv;
  LOCAL maxv;
  LOCAL limitado;
  LOCAL representado;
  IF INPUT(x,"Punto fijo","x=","Numero",0.7)==0 THEN RETURN 0; END;
  IF INPUT(ni,"Punto fijo","Bits enteros=","Incluye signo",2)==0 THEN RETURN 0; END;
  IF INPUT(nf,"Punto fijo","Bits fracc=","Fraccionarios",6)==0 THEN RETURN 0; END;
  IF TYPE(x)<>0 OR TYPE(ni)<>0 OR TYPE(nf)<>0 THEN SSInfoView("Punto fijo","Campos no reales","Ingrese numeros reales, no listas, textos ni complejos. Los bits deben ser enteros.",SSAccent(5)); RETURN 0; END;
  IF SSIsDrawable(ni)==0 OR SSIsDrawable(nf)==0 THEN SSInfoView("Punto fijo","Bits fuera de rango","Use cantidades enteras finitas; hasta 32 bits en total.",SSAccent(5)); RETURN 0; END;
  IF SSIsDrawable(x)==0 OR IM(x)<>0 OR ni<>FLOOR(ni) OR nf<>FLOOR(nf) OR ni<1 OR nf<0 OR ni+nf>32 THEN SSInfoView("Punto fijo","Datos no validos","Entrada real finita; bits enteros >=1 (incluye signo), fraccionarios >=0, total <=32. Cantidades enteras.",SSAccent(5)); RETURN 0; END;
  modo:=SSMenu("Metodo de punto fijo",{"Redondeo","Truncamiento"},modo); IF modo==0 THEN RETURN 0; END;
  esc:=2^FLOOR(nf); minv:=-2^(FLOOR(ni)-1); maxv:=2^(FLOOR(ni)-1)-1/esc;
  limitado:=MAX(minv,MIN(maxv,x));
  IF modo==1 THEN representado:=ROUND(limitado*esc,0)/esc; ELSE representado:=SIGN(limitado)*FLOOR(ABS(limitado)*esc)/esc; END;
  SSResultBrowse({"Punto fijo",1},"Q con "+STRING(ni)+" bits enteros / "+STRING(nf)+" fraccionarios",{{"Entrada original",x},{"Valor representado",representado},{"Error total: entrada - salida",x-representado},{"Error de saturacion",x-limitado},{"Error de redondeo/truncamiento",limitado-representado},{"Rango",{minv,maxv}},{"LSB",1/esc}},"Entrada="+STRING(x),"El error total incluye saturacion y conversion. La entrada original se conserva; los bits enteros incluyen el signo."); RETURN 1;
END;

VIEW "Muestreo y conversion",UI_SAMPLING()
BEGIN
  LOCAL op:=1;
  REPEAT
    SSEVAL_EVENTS:={}; SSREAD_META:={};
    op:=SSMenu("Muestreo, conversion A/D y D/A",{"Muestrear: x(t) a x[n]","Analizar Nyquist y aliasing","Diezmar, expandir o interpolar","Reconstruir: x[n] a x(t)","Cuantizar y calcular SNR","Representar en punto fijo","Conceptos de conversion A/D y D/A","Volver al inicio"},op);
    IF op==0 THEN RETURN 0; END;
    IF op==1 THEN UISampleExpr(); END;
    IF op==2 THEN UINyquist(); END;
    IF op==3 THEN UIRateChange(); END;
    IF op==4 THEN UIReconstruction(); END;
    IF op==5 THEN UIQuantization(); END;
    IF op==6 THEN UIFixedPoint(); END;
    IF op==7 THEN SSTheoryView("Muestreo y conversion",{"MUESTREO. x[n]=x(t0+n*Ts). Ts fija la separacion real; N solo indica cuantas muestras se calculan y muestran. Nyquist requiere fs>2*fmax.","DISCONTINUIDADES. Si un punto falla se consultan limites laterales. La tabla puede mostrar +INF, -INF, +/-INF o N/D; el grafico corta la curva y no une ambos lados.","CAMBIO DE TASA. Diezmar conserva una de cada M muestras. Expandir inserta L-1 ceros. Interpolar estima puntos intermedios. Las salidas se exportan a otras herramientas.","CONVERSION. A/D combina muestreo, cuantizacion y codificacion. D/A usa retenedor/interpolador y filtro de reconstruccion. Un filtro antialias precede al muestreo."},SSAccent(5)); END;
  UNTIL op==8; RETURN 1;
END;

// ---------- Modulo filtros ----------

SSDigitalResponseView(b,a,modo)
BEGIN
  LOCAL N:=193;
  LOCAL pirad:=3.141592653589793;
  LOCAL H:=SSFResponse(b,a,N);
  LOCAL k;
  LOCAL y:=MAKELIST(0,k,1,N,1);
  FOR k FROM 1 TO N DO
    IF SSIsDrawable(H(k))==0 THEN y(k):=SSUndef();
    ELSE
    IF modo==1 THEN y(k):=ABS(H(k)); END;
    IF modo==2 THEN
      IF ABS(H(k))==0 THEN y(k):=SSUndef();
      ELSE y(k):=IM(LN(H(k)/ABS(H(k)))); END;
    END;
    IF modo==3 THEN IF ABS(H(k))==0 THEN y(k):=SSNegInf(); ELSE y(k):=20*LOG(ABS(H(k))); END; END;
    END;
  END;
  IF modo==1 THEN SSPlotXY(y,-pirad,2*pirad/(N-1),"Modulo lineal H(e^jw)",{"w: -pi a pi rad/muestra","RESPONSE",b,a,2,1}); END;
  IF modo==2 THEN SSPlotXY(y,-pirad,2*pirad/(N-1),"Fase H(e^jw)",{"w: -pi a pi; fase en rad","RESPONSE",b,a,2,2}); END;
  IF modo==3 THEN SSPlotXY(y,-pirad,2*pirad/(N-1),"Magnitud H(e^jw) dB",{"w: -pi a pi rad/muestra","RESPONSE",b,a,2,3}); END;
  IF modo==4 OR modo==5 THEN
    SSInfoView("Analisis de fase","Malla adaptada a la ventana visible","Fase desenrollada por segmentos, sin unir N/D. Retardo=-d(fase)/dw, en muestras para sistemas digitales. Cerca de ceros no es fiable; acerque X para resolver variaciones rapidas. No determina retardos mayores a lo que permite la malla.",SSAccent(6));
    IF modo==4 THEN SSPlotXY(y,-pirad,2*pirad/(N-1),"Fase desenrollada H(e^jw)",{"w rad/muestra; fase rad","RESPONSE",b,a,2,4}); END;
    IF modo==5 THEN SSPlotXY(y,-pirad,2*pirad/(N-1),"Retardo de grupo (muestras)",{"w rad/muestra","RESPONSE",b,a,2,5}); END;
  END;
  RETURN 1;
END;

SSDigitalFilterResults(b,a,tipo,orden,f1,f2,Q)
BEGIN
  LOCAL op:=1;
  LOCAL chars:=SSFilterType(tipo)+". Orden="+STRING(orden)+". ";
  LOCAL x;
  LOCAL pz:="";
  LOCAL referencia;
  LOCAL estabilidad;
  LOCAL estado;
  LOCAL sub:=1;
  LOCAL candidato;
  IF Q>0 THEN
    chars:=chars+"Frecuencia central/corte="+SSFmt(f1,6)+"; ancho aproximado="+SSFmt(f1/Q,6)+"; Q="+SSFmt(Q,6)+".";
  ELSE
    IF tipo<=2 THEN chars:=chars+"Frecuencia de corte normalizada="+SSFmt(f1,6)+" ciclos/muestra.";
    ELSE chars:=chars+"Cortes="+SSFmt(f1,6)+" y "+SSFmt(f2,6)+"; centro="+SSFmt((f1+f2)/2,6)+"; ancho="+SSFmt(f2-f1,6)+"."; END;
  END;
  REPEAT
    IF f1<0 THEN chars:="Modelo editado por coeficientes. Orden="+STRING(orden)+". Corte, Q y tipo no se infieren automaticamente."; END;
    op:=SSMenu({"Resultados del filtro",{3,"Resultados del filtro",{{"Numerador b",b,0,1},{"Denominador a",a,0,1},{"H(z)",SSTransferText(b,a,2)},{"Tipo, orden, f1, f2, Q",{tipo,orden,f1,f2,Q}}},chars},13},{"Funcion matematica H(z)","Caracteristicas","Implementacion digital","Coeficientes b y a","Respuesta al impulso","Modulo lineal","Fase","Magnitud en dB","Polos y ceros","Editar H(z)","Fase desenrollada","Retardo de grupo","Volver"},op);
    IF op==0 OR op==13 THEN RETURN 1; END;
    IF op==10 THEN
      candidato:=SSReadTransfer("Editar filtro H(z)",b,a);
      IF SIZE(candidato)==2 THEN b:=candidato(1); a:=candidato(2); orden:=MAX(SIZE(a),SIZE(b))-1; f1:=-1; f2:=-1; Q:=0; END;
      candidato:={};
    END;
    IF op==11 THEN SSDigitalResponseView(b,a,4); END;
    IF op==12 THEN SSDigitalResponseView(b,a,5); END;
    IF op==1 THEN SSFormulaView("Funcion del filtro","Cociente de polinomios en z^-1",SSTransferText(b,a,2),SSAccent(6)); END;
    IF op==2 THEN
      IF orden<=32 THEN pz:=" Polos="+STRING(SSPolyRoots(a))+". Ceros="+STRING(SSPolyRoots(b))+"."; ELSE pz:=" Polos/ceros omitidos aqui para proteger memoria; reduzca el orden a 32 para graficarlos."; END;
      referencia:=SSFResponse(b,a,{1,0,1,2}); referencia:=referencia(1);
      IF SSIsDrawable(referencia) THEN referencia:=ABS(referencia); END;
      estabilidad:=SSStable(a,2); estado:="Indeterminada: raices no verificadas o cerca de la frontera.";
      IF estabilidad==1 THEN estado:="Estable (hipotesis causal)."; END;
      IF estabilidad==0 THEN estado:="Inestable (hipotesis causal)."; END;
      SSInfoView("Caracteristicas del filtro","Parametros calculados",chars+"\n\nGanancia en continua (w=0)="+SSFmt(referencia,6)+".\n\n"+pz+"\n\n"+estado,SSAccent(6));
    END;
    IF op==3 THEN SSInfoView("Implementacion digital","Estructura realizable","Implementacion por retardos z^-1, multiplicadores y sumadores. b fija la rama directa; a fija la realimentacion. No se asignan componentes R, L o C a un filtro digital.",SSAccent(6)); END;
    IF op==4 THEN
      REPEAT
        sub:=SSMenu("Coeficientes del filtro",{"Numerador b[k]","Denominador a[k]","Exportar b[k]","Exportar a[k]","Volver"},sub);
        IF sub==0 OR sub==5 THEN BREAK; END;
        IF sub==1 THEN SSDataView(b,0,1,"Numerador b","k","b[k]",SSAccent(6)); END;
        IF sub==2 THEN SSDataView(a,0,1,"Denominador a","k","a[k]",SSAccent(6)); END;
        IF sub==3 THEN SSExportData(b,0,1,"Coeficientes b[k]"); END;
        IF sub==4 THEN SSExportData(a,0,1,"Coeficientes a[k]"); END;
      UNTIL 0;
    END;
    IF op==5 THEN x:=SSDiffEq(b,a,SSImpulse(64)); SSPlot(x,0,"Respuesta al impulso"); END;
    IF op==6 THEN SSDigitalResponseView(b,a,1); END;
    IF op==7 THEN SSDigitalResponseView(b,a,2); END;
    IF op==8 THEN SSDigitalResponseView(b,a,3); END;
    IF op==9 THEN IF orden<=32 THEN SSPlotPZ(b,a,2,"Polos y ceros del filtro"); ELSE SSInfoView("SignalLab","Aviso","Grafico P/Z limitado a orden 32 para proteger la memoria.",SSAccent(1)); END; END;
  UNTIL 0;
END;

UIFIRDesign()
BEGIN
  LOCAL tipo:=1;
  LOCAL N:=21;
  LOCAL f1:=0.15;
  LOCAL f2:=0.3;
  LOCAL vent:=3;
  LOCAL beta:=5;
  LOCAL h;
  LOCAL idx;
  LOCAL valido;
  tipo:=SSMenu("FIR ideal",{"Pasa bajos","Pasa altos","Pasa banda","Rechaza banda"},tipo); IF tipo==0 THEN RETURN 0; END;
  REPEAT
    IF INPUT(N,"Longitud FIR","Muestras N=","Entero 3..101; PA/RB requieren impar",N)==0 THEN RETURN 0; END;
    IF TYPE(N)<>0 THEN SSInfoView("Longitud FIR","Campo no real","Ingrese un numero entero, no una lista, texto ni complejo.",SSAccent(6)); CONTINUE; END;
    IF SSIsDrawable(N)==0 THEN SSInfoView("Longitud FIR","Fuera de rango","Ingrese un entero de 3 a 101.",SSAccent(6)); CONTINUE; END;
    IF N<>FLOOR(N) OR N<3 OR N>101 THEN SSInfoView("Longitud FIR","Valor no valido","Use un entero entre 3 y 101. No se cambia N silenciosamente.",SSAccent(6));
    ELSE
      IF (tipo==2 OR tipo==4) AND N MOD 2==0 THEN SSInfoView("Longitud FIR","Se necesita longitud impar","La inversion espectral para pasaaltos o rechazabanda necesita una muestra central. Elija, por ejemplo, N=21.",SSAccent(6));
      ELSE BREAK; END;
    END;
  UNTIL 0;
  IF INPUT(f1,"Frecuencia","f1=","0..0.5 ciclos/muestra",0.15)==0 THEN RETURN 0; END;
  IF tipo>=3 THEN IF INPUT(f2,"Frecuencia","f2=","f2>f1",0.3)==0 THEN RETURN 0; END; END;
  IF TYPE(f1)<>0 OR TYPE(f2)<>0 THEN SSInfoView("FIR","Frecuencia no real","Use numeros reales en ciclos/muestra, no listas, textos ni complejos.",SSAccent(6)); RETURN 0; END;
  IF SSIsDrawable(f1)==0 OR SSIsDrawable(f2)==0 THEN SSInfoView("FIR","Frecuencia fuera de rango","Use cortes finitos entre 0 y 0.5 ciclos/muestra.",SSAccent(6)); RETURN 0; END;
  IF f1<=0 OR f1>=0.5 THEN SSInfoView("SignalLab","Aviso","f1 debe estar entre 0 y 0.5.",SSAccent(1)); RETURN 0; END;
  IF tipo>=3 AND (f2<=f1 OR f2>=0.5) THEN SSInfoView("SignalLab","Aviso","Use f1 < f2 < 0.5.",SSAccent(1)); RETURN 0; END;
  vent:=SSMenu("Ventana FIR",{"Rectangular","Hann","Hamming","Blackman","Kaiser"},vent); IF vent==0 THEN RETURN 0; END;
  IF vent==5 THEN
    IF INPUT(beta,"Kaiser","beta=","0..20",5)==0 THEN RETURN 0; END;
    IF TYPE(beta)<>0 THEN SSInfoView("Kaiser","Beta no real","Ingrese un numero real entre 0 y 20.",SSAccent(6)); RETURN 0; END;
    IF SSIsDrawable(beta)==0 OR beta<0 OR beta>20 THEN SSInfoView("Kaiser","Beta fuera de rango","Use 0 <= beta <= 20.",SSAccent(6)); RETURN 0; END;
  END;
  valido:=1; h:={};
  IFERR h:=SSFIR(tipo,N,f1,f2,vent,beta); THEN valido:=0; END;
  IF SIZE(h)<>N THEN valido:=0; END;
  FOR idx FROM 1 TO SIZE(h) DO IF SSIsDrawable(h(idx))==0 THEN valido:=0; END; END;
  IF valido==0 THEN SSInfoView("FIR","Diseno no calculado","No se obtuvo una lista completa de coeficientes finitos. No se abre un filtro vacio ni parcial. Revise los parametros.",SSAccent(6)); RETURN 0; END;
  SSDigitalFilterResults(h,{1},tipo,N-1,f1,f2,0); RETURN 1;
END;

UIBiquadDesign()
BEGIN
  LOCAL tipo:=1;
  LOCAL f0:=0.15;
  LOCAL Q:=0.707;
  LOCAL r;
  LOCAL b;
  LOCAL a;
  LOCAL idx;
  LOCAL valido:=1;
  tipo:=SSMenu("IIR biquad",{"Pasa bajos","Pasa altos","Pasa banda","Notch / rechaza"},tipo); IF tipo==0 THEN RETURN 0; END;
  IF INPUT(f0,"Biquad","f0=","0..0.5 ciclos/muestra",0.15)==0 THEN RETURN 0; END;
  IF INPUT(Q,"Biquad","Q=","Factor de calidad",0.707)==0 THEN RETURN 0; END;
  IF TYPE(f0)<>0 OR TYPE(Q)<>0 THEN SSInfoView("Biquad","Campos no reales","f0 y Q deben ser numeros reales, no listas, textos ni complejos.",SSAccent(6)); RETURN 0; END;
  IF SSIsDrawable(f0)==0 OR SSIsDrawable(Q)==0 THEN SSInfoView("Biquad","Campos fuera de rango","Use parametros finitos dentro del rango numerico de la app (modulo menor que 1E50).",SSAccent(6)); RETURN 0; END;
  IF f0<=0 OR f0>=0.5 OR Q<=0 THEN SSInfoView("SignalLab","Aviso","Use 0 < f0 < 0.5 y Q > 0.",SSAccent(1)); RETURN 0; END;
  IFERR
    r:=SSBiquad(tipo,f0,Q); b:=r(1); a:=r(2);
    IF SIZE(b)<>3 OR SIZE(a)<>3 THEN valido:=0;
    ELSE FOR idx FROM 1 TO 3 DO IF SSIsDrawable(b(idx))==0 OR SSIsDrawable(a(idx))==0 THEN valido:=0; END; END; END;
  THEN valido:=0; END;
  IF valido==0 THEN SSInfoView("Biquad","Diseno no representable","No se obtuvieron coeficientes finitos. Valores extremos de Q o f0 pueden exceder la precision o el rango numerico. No se abre un filtro parcial.",SSAccent(6)); RETURN 0; END;
  SSDigitalFilterResults(b,a,tipo,2,f0,f0,Q); RETURN 1;
END;

UIApplyFilter()
BEGIN
  LOCAL b:={0.5,0.5};
  LOCAL a:={1};
  LOCAL x:={1,2,3,4,5};
  LOCAL y;
  LOCAL r;
  r:=SSReadTransfer("Aplicar filtro",b,a); IF SIZE(r)==0 THEN RETURN 0; END; b:=r(1); a:=r(2);
  x:=SSReadList("Aplicar filtro","x=","Entrada",x); IF SIZE(x)==0 THEN RETURN 0; END;
  y:=SSDiffEq(b,a,x);
  SSShow(y,SSReadOrigin(0),{"Salida del filtro",SSReadStep(1),SSTransferText(b,a,2)}); RETURN 1;
END;

UIIIRAnalogMap()
BEGIN
  // Una sola implementacion para Transformadas y Filtros: mismas validaciones.
  RETURN UIBilinear();
END;

SSAnalogFilterResults(b,a,tipo,fc,R,C)
BEGIN
  LOCAL op:=1;
  LOCAL wc:=2*3.141592653589793*fc;
  LOCAL N:=96;
  LOCAL H;
  LOCAL k;
  LOCAL dw;
  LOCAL w0;
  LOCAL w1;
  REPEAT
    op:=SSMenu({"Filtro analogico RC",{3,"Filtro analogico RC",{{"Numerador b",b,0,1},{"Denominador a",a,0,1},{"H(s)",SSTransferText(b,a,1)},{"R ohm",R},{"C farad",C},{"Corte Hz",fc},{"Tipo",tipo}},"Filtro analogico RC. Coeficientes descendentes en s."},8},{"Funcion matematica H(s)","Caracteristicas","Componentes y topologia","Modulo lineal","Fase lineal","Bode magnitud","Polos y ceros","Volver"},op);
    IF op==0 OR op==8 THEN RETURN 1; END;
    IF op==1 THEN SSFormulaView("Funcion del filtro","Modelo continuo",SSTransferText(b,a,1),SSAccent(6)); END;
    IF op==2 THEN SSInfoView("Caracteristicas RC",SSFilterType(tipo),"Orden=1. Frecuencia de corte fc="+SSFmt(fc,8)+" Hz; wc="+SSFmt(wc,8)+" rad/s; ganancia de banda pasante unitaria; polo="+STRING(SSPolyRoots(a))+"; ancho de banda definido por fc.",SSAccent(6)); END;
    IF op==3 THEN
      IF tipo==1 THEN SSInfoView("Construccion RC","Pasa bajos pasivo","Topologia: R en serie y C a masa; salida sobre C. R="+SSFmt(R,8)+" ohm; C="+SSFmt(C*1E9,8)+" nF. Ecuacion: fc=1/(2*pi*R*C).",SSAccent(6));
      ELSE SSInfoView("Construccion RC","Pasa altos pasivo","Topologia: C en serie y R a masa; salida sobre R. R="+SSFmt(R,8)+" ohm; C="+SSFmt(C*1E9,8)+" nF. Ecuacion: fc=1/(2*pi*R*C).",SSAccent(6)); END;
    END;
    IF op==4 OR op==5 THEN
      dw:=3*wc/(N-1); H:=SSAnalogResponse(b,a,0,dw,N);
      IF op==4 THEN H:=SSMag(H); ELSE H:=SSPhase(H); END;
      IF op==4 THEN SSPlotXY(H,0,dw,"Modulo lineal RC",{"w en rad/s","RESPONSE",b,a,1,1}); ELSE SSPlotXY(H,0,dw,"Fase lineal RC",{"w en rad/s","RESPONSE",b,a,1,2}); END;
    END;
    IF op==6 THEN
      w0:=wc/100; w1:=wc*100; H:=MAKELIST(0,k,1,N,1);
      H:=SSFResponse(b,a,{N,LOG(w0),(LOG(w1)-LOG(w0))/(N-1),3});
      FOR k FROM 1 TO N DO IF SSIsDrawable(H(k)) THEN IF ABS(H(k))==0 THEN H(k):=SSNegInf(); ELSE H(k):=20*LOG(ABS(H(k))); END; END; END;
      SSPlotXY(H,LOG(w0),(LOG(w1)-LOG(w0))/(N-1),"Bode RC dB",{"Eje log10(w rad/s)","RESPONSE",b,a,3,3});
    END;
    IF op==7 THEN SSPlotPZ(b,a,1,"Polos y ceros RC"); END;
  UNTIL 0;
END;

UIAnalogRCDesign()
BEGIN
  LOCAL tipo:=1;
  LOCAL fijo:=1;
  LOCAL fc:=1000;
  LOCAL R:=1000;
  LOCAL Cn:=100;
  LOCAL C;
  LOCAL tau;
  LOCAL b;
  LOCAL a;
  LOCAL valido:=1;
  tipo:=SSMenu("Diseno analogico RC",{"Pasa bajos RC","Pasa altos RC","Volver"},tipo); IF tipo==0 OR tipo==3 THEN RETURN 0; END;
  fijo:=SSMenu("Componente conocido",{"Fijar resistencia R","Fijar capacitor C","Volver"},fijo); IF fijo==0 OR fijo==3 THEN RETURN 0; END;
  IF INPUT(fc,"Frecuencia de corte","fc=","Hz",1000)==0 THEN RETURN 0; END;
  IF TYPE(fc)<>0 THEN SSInfoView("Filtro RC","Frecuencia no real","Ingrese fc como un numero real positivo en Hz.",SSAccent(6)); RETURN 0; END;
  IF SSIsDrawable(fc)==0 THEN SSInfoView("Filtro RC","Frecuencia fuera de rango","Use fc finita y positiva, dentro del rango numerico de la app.",SSAccent(6)); RETURN 0; END;
  IF fc<=0 THEN SSInfoView("SignalLab","Aviso","fc debe ser positiva.",SSAccent(1)); RETURN 0; END;
  IF fijo==1 THEN
    IF INPUT(R,"Componente","R=","ohm",1000)==0 THEN RETURN 0; END;
    IF TYPE(R)<>0 THEN SSInfoView("Filtro RC","Resistencia no real","Ingrese R real y positiva en ohm.",SSAccent(6)); RETURN 0; END;
    IF SSIsDrawable(R)==0 OR R<=0 THEN SSInfoView("Filtro RC","Resistencia fuera de rango","Use R finita y positiva, dentro del rango numerico de la app.",SSAccent(6)); RETURN 0; END;
    IFERR C:=1/(2*3.141592653589793*fc*R); THEN valido:=0; END;
  ELSE
    IF INPUT(Cn,"Componente","C=","nanofaradios",100)==0 THEN RETURN 0; END;
    IF TYPE(Cn)<>0 THEN SSInfoView("Filtro RC","Capacidad no real","Ingrese C real y positiva en nanofaradios.",SSAccent(6)); RETURN 0; END;
    IF SSIsDrawable(Cn)==0 OR Cn<=0 THEN SSInfoView("Filtro RC","Capacidad fuera de rango","Use C finita y positiva, dentro del rango numerico de la app.",SSAccent(6)); RETURN 0; END;
    IFERR C:=Cn*1E-9; R:=1/(2*3.141592653589793*fc*C); THEN valido:=0; END;
  END;
  IF valido THEN
    IFERR
      tau:=R*C;
      IF SSIsDrawable(R)==0 OR SSIsDrawable(C)==0 OR SSIsDrawable(tau)==0 OR R<=0 OR C<=0 OR tau<=0 THEN valido:=0; END;
      // Las vistas RC usan hasta 100*wc y log10(wc/100).
      IF SSIsDrawable(200*3.141592653589793*fc)==0 OR 2*3.141592653589793*fc/100<=0 THEN valido:=0; END;
    THEN valido:=0; END;
  END;
  IF valido==0 THEN SSInfoView("Filtro RC","Diseno no representable","La conversion de componentes o su rango de frecuencias excede el rango numerico de la app. Revise fc y el componente; no se abre un modelo invalido.",SSAccent(6)); RETURN 0; END;
  a:={tau,1};
  IF tipo==1 THEN b:={1}; ELSE b:={tau,0}; END;
  SSAnalogFilterResults(b,a,tipo,fc,R,C); RETURN 1;
END;

VIEW "Diseno de filtros",UI_FILTERS()
BEGIN
  LOCAL op:=1;
  REPEAT
    SSEVAL_EVENTS:={}; SSREAD_META:={};
    op:=SSMenu("Filtros analogicos y digitales",{"Disenar FIR por ventanas","Disenar IIR biquad","Disenar filtro analogico RC","Filtrar una senal con b/a","Respuesta digital H(e^jw)","Polos/ceros: analizar o disenar","Transformacion bilineal H(s)-H(z)","Teoria y estructuras de filtros","Volver"},op);
    IF op==0 THEN RETURN 0; END;
    IF op==1 THEN UIFIRDesign(); END;
    IF op==2 THEN UIBiquadDesign(); END;
    IF op==3 THEN UIAnalogRCDesign(); END;
    IF op==4 THEN UIApplyFilter(); END;
    IF op==5 THEN UIFreqResponse(); END;
    IF op==6 THEN UIPolesZeros(); END;
    IF op==7 THEN UIIIRAnalogMap(); END;
    IF op==8 THEN SSTheoryView("Teoria de filtros",{"FUNCION. Un filtro digital se expresa como H(z)=B(z)/A(z); un filtro analogico como H(s)=N(s)/D(s). Coeficientes, polos, ceros, tabla y grafico deben describir el mismo sistema.","FIR E IIR. FIR no realimenta y siempre es BIBO estable. IIR usa denominador no trivial y requiere polos dentro del circulo unidad. Q relaciona frecuencia central y ancho de banda.","RC FISICO. Pasa bajos: R serie, C a masa, salida en C. Pasa altos: C serie, R a masa, salida en R. En ambos fc=1/(2*pi*R*C).","USO. En resultados abra Funcion, Caracteristicas, Implementacion, Tabla o Grafico. Los filtros digitales no reciben componentes fisicos inventados; el diseno RC si calcula R o C."},SSAccent(6)); END;
  UNTIL op==9; RETURN 1;
END;

// ---------- Modulo control y Bode ----------

SSPolyEval(c,z)
BEGIN
  LOCAL k;
  LOCAL v:=0; FOR k FROM 1 TO SIZE(c) DO v:=v*z+c(k); END; RETURN v;
END;

UISecondOrder()
BEGIN
  LOCAL wn:=5;
  LOCAL zeta:=0.5;
  LOCAL wd;
  LOCAL Mp;
  LOCAL ts;
  LOCAL tp;
  LOCAL p1;
  LOCAL p2;
  LOCAL op:=1;
  LOCAL r;
  IF INPUT(wn,"Segundo orden","wn=","Frecuencia natural rad/s",5)==0 THEN RETURN 0; END;
  IF INPUT(zeta,"Segundo orden","zeta=","Amortiguamiento",0.5)==0 THEN RETURN 0; END;
  IF wn<=0 OR zeta<0 THEN SSInfoView("SignalLab","Aviso","Se requiere wn>0 y zeta>=0.",SSAccent(1)); RETURN 0; END;
  wd:=0;
  IF zeta<1 THEN
    wd:=wn*SQRT(1-zeta^2);
    p1:=-zeta*wn+(0,1)*wd; p2:=CONJ(p1);
  ELSE
    p1:=-wn/(zeta+SQRT(MAX(0,zeta^2-1)));
    p2:=-wn*(zeta+SQRT(MAX(0,zeta^2-1)));
  END;
  IF zeta>0 AND zeta<1 THEN Mp:=100*EXP(-3.141592653589793*zeta/SQRT(1-zeta^2)); tp:=3.141592653589793/wd; ELSE Mp:=0; tp:=0; END;
  IF zeta==0 THEN ts:=SSPosInf(); tp:=3.141592653589793/wn; Mp:=100;
  ELSE
    IF zeta<1 THEN ts:=-LN(0.02*SQRT(1-zeta^2))/(zeta*wn);
    ELSE
      tp:=SSUndef();
      IF zeta==1 THEN ts:=5.83392170191739/wn;
      ELSE ts:=LN((p2/(p2-p1))/0.02)/(-p1); END;
    END;
  END;
  REPEAT
    op:=SSMenu({"Sistema de segundo orden",{3,"Sistema de segundo orden",{{"wn rad/s",wn},{"zeta",zeta},{"Polos",{p1,p2}},{"wd rad/s",wd},{"Sobreimpulso %",Mp},{"Tiempo 2%",ts},{"Tiempo de pico",tp}},"Segundo orden; H(s)=wn^2/(s^2+2*zeta*wn*s+wn^2). Tiempo 2% es cota, no primer ingreso."},4},{"Parametros y polos","Respuesta al escalon","Funcion H(s)","Volver"},op);
    IF op==0 OR op==4 THEN RETURN 1; END;
    IF op==1 THEN SSResultBrowse("Segundo orden","Parametros de respuesta",{{"Polos",{p1,p2}},{"wd en rad/s",wd},{"Sobreimpulso en porcentaje",Mp},{"Tiempo suficiente para banda 2%",ts},{"Tiempo de pico Tp",tp}},"wn="+STRING(wn)+"; zeta="+STRING(zeta),"Tiempo 2%: cota de envolvente si zeta<1; cota del polo lento si zeta>1; solucion numerica critica si zeta=1. No es siempre el primer ingreso a la banda. Sin amortiguamiento no se establece. N/D en Tp indica respuesta sin pico."); END;
    IF op==2 THEN SSSecondOrderPlot(wn,zeta); END;
    IF op==3 THEN SSFormulaView("Segundo orden","H(s)",SSTransferText({wn^2},{1,2*zeta*wn,wn^2},1),SSAccent(7)); END;
  UNTIL 0;
END;

UIBodeContinuous()
BEGIN
  LOCAL b:={1};
  LOCAL a:={1,1};
  LOCAL wmin:=0.01;
  LOCAL wmax:=100;
  LOCAL k;
  LOCAL mag;
  LOCAL ph:=MAKELIST(0,k,1,100,1);
  LOCAL r;
  LOCAL op:=1;
  mag:=MAKELIST(0,k,1,100,1);
  r:=SSReadTransfer("Bode de H(s)",b,a); IF SIZE(r)==0 THEN RETURN 0; END; b:=r(1); a:=r(2);
  IF INPUT(wmin,"Bode","w min=","rad/s",0.01)==0 THEN RETURN 0; END;
  IF INPUT(wmax,"Bode","w max=","rad/s",100)==0 THEN RETURN 0; END;
  IF TYPE(wmin)<>0 OR TYPE(wmax)<>0 THEN RETURN 0; END;
  IF SSIsDrawable(wmin)==0 OR SSIsDrawable(wmax)==0 THEN RETURN 0; END;
  IF wmin<=0 OR wmax<=wmin THEN SSInfoView("SignalLab","Aviso","Use 0 < w min < w max.",SSAccent(1)); RETURN 0; END;
  REPEAT
    op:=SSMenu({"Bode de H(s)",{3,"Bode de H(s)",{{"Numerador b",b,0,1},{"Denominador a",a,0,1},{"H(s)",SSTransferText(b,a,1)},{"Intervalo w rad/s",{wmin,wmax}}},"Diagrama de Bode. Coeficientes en potencias descendentes de s."},9},{"Magnitud en dB","Fase en radianes","Funcion H(s) Textbook","Tabla compleja H(jw)","Editar H(s)","Cambiar intervalo","Fase desenrollada","Retardo de grupo (s)","Volver"},op);
    IF op==0 OR op==9 THEN RETURN 1; END;
    IF op==7 OR op==8 THEN
      SSInfoView("Fase extendida","Diferencias sobre la malla visible","El retardo deriva respecto de w rad/s, no de log10(w), y se expresa en segundos. No se unen ceros/N/D. Una malla insuficiente puede ocultar vueltas; acerque la ventana.",SSAccent(7));
      mag:={0,0};
      IF op==7 THEN SSPlotXY(mag,LOG(wmin),LOG(wmax)-LOG(wmin),"Bode: fase desenrollada",{"log10(w rad/s); fase rad","RESPONSE",b,a,3,4}); END;
      IF op==8 THEN SSPlotXY(mag,LOG(wmin),LOG(wmax)-LOG(wmin),"Bode: retardo de grupo (s)",{"log10(w rad/s)","RESPONSE",b,a,3,5}); END;
      mag:={};
    END;
    IF op==1 OR op==2 OR op==4 THEN
      mag:=SSFResponse(b,a,{100,LOG(wmin),(LOG(wmax)-LOG(wmin))/99,3});
      IF op==4 THEN SSDataView(mag,LOG(wmin),(LOG(wmax)-LOG(wmin))/99,"Respuesta compleja","log10(w)","H",SSAccent(7)); END;
      IF op==1 THEN
        FOR k FROM 1 TO SIZE(mag) DO IF SSIsDrawable(mag(k)) THEN IF ABS(mag(k))==0 THEN mag(k):=SSNegInf(); ELSE mag(k):=20*LOG(ABS(mag(k))); END; END; END;
        SSPlotXY(mag,LOG(wmin),(LOG(wmax)-LOG(wmin))/99,"Bode magnitud dB",{"Eje log10(w rad/s)","RESPONSE",b,a,3,3});
      END;
      IF op==2 THEN ph:=SSPhase(mag); SSPlotXY(ph,LOG(wmin),(LOG(wmax)-LOG(wmin))/99,"Bode fase",{"Eje log10(w rad/s)","RESPONSE",b,a,3,2}); END;
      mag:={}; ph:={};
    END;
    IF op==3 THEN SSFormulaView("Funcion de transferencia","Diagrama de Bode",SSTransferText(b,a,1),SSAccent(7)); END;
    IF op==5 THEN r:=SSReadTransfer("Bode de H(s)",b,a); IF SIZE(r)==2 THEN b:=r(1); a:=r(2); END; END;
    IF op==6 THEN
      r:=SSReadListDirect("Rango Bode","{wmin,wmax}=","rad/s; 0 < wmin < wmax",{wmin,wmax});
      IF SIZE(r)==2 THEN IF SSIsDrawable(r(1)) AND SSIsDrawable(r(2)) AND IM(r(1))==0 AND IM(r(2))==0 THEN IF r(1)>0 AND r(2)>r(1) THEN wmin:=r(1); wmax:=r(2); ELSE SSInfoView("Bode","Intervalo conservado","Se requiere 0 < wmin < wmax.",SSAccent(7)); END; END; END;
    END;
  UNTIL 0;
END;

UIFreqResponseContinuousLinear()
BEGIN
  LOCAL b:={1};
  LOCAL a:={1,1};
  LOCAL r;
  LOCAL wmin:=0;
  LOCAL wmax:=10;
  LOCAL N:=96;
  LOCAL dw;
  LOCAL H;
  LOCAL k;
  LOCAL op:=1;
  r:=SSReadTransfer("Respuesta lineal H(jw)",b,a); IF SIZE(r)==0 THEN RETURN 0; END; b:=r(1); a:=r(2);
  IF INPUT(wmin,"Rango lineal","w min=","rad/s; puede ser cero",0)==0 THEN RETURN 0; END;
  IF INPUT(wmax,"Rango lineal","w max=","rad/s",10)==0 THEN RETURN 0; END;
  IF INPUT(N,"Resolucion","Puntos N=","Entre 16 y 160",96)==0 THEN RETURN 0; END;
  IF TYPE(wmin)<>0 OR TYPE(wmax)<>0 OR TYPE(N)<>0 THEN RETURN 0; END;
  IF SSIsDrawable(wmin)==0 OR SSIsDrawable(wmax)==0 OR SSIsDrawable(N)==0 THEN RETURN 0; END;
  IF N<>FLOOR(N) OR N<16 OR N>160 THEN SSInfoView("Respuesta lineal H(jw)","Resolucion no valida","Ingrese un entero entre 16 y 160. No se recorta ni redondea N silenciosamente.",SSAccent(7)); RETURN 0; END;
  IF wmax<=wmin THEN SSInfoView("SignalLab","Aviso","Use w min < w max, en rad/s.",SSAccent(1)); RETURN 0; END;
  dw:=(wmax-wmin)/(N-1);
  REPEAT
    op:=SSMenu({"Respuesta lineal H(jw)",{3,"Respuesta lineal H(jw)",{{"Numerador b",b,0,1},{"Denominador a",a,0,1},{"H(s)",SSTransferText(b,a,1)},{"Rango w min, max, N",{wmin,wmax,N}}},"Respuesta lineal; w en rad/s. Coeficientes descendentes en s."},9},{"Magnitud lineal","Fase en radianes","Funcion y coeficientes","Tabla compleja H(jw)","Editar H(s)","Cambiar rango y resolucion","Fase desenrollada","Retardo de grupo (s)","Volver"},op);
    IF op==0 OR op==9 THEN RETURN 1; END;
    IF op==7 OR op==8 THEN
      SSInfoView("Fase extendida","Malla visible; retardo en segundos","No se unen ceros/N/D. El retardo es una derivada numerica de la fase respecto de w rad/s. Acerque la ventana si la fase varia demasiado entre muestras.",SSAccent(7));
      H:={0,0};
      IF op==7 THEN SSPlotXY(H,wmin,wmax-wmin,"Fase desenrollada H(jw)",{"w rad/s; fase rad","RESPONSE",b,a,1,4}); END;
      IF op==8 THEN SSPlotXY(H,wmin,wmax-wmin,"Retardo de grupo H(jw) (s)",{"w rad/s","RESPONSE",b,a,1,5}); END;
      H:={};
    END;
    IF op==1 OR op==2 OR op==4 THEN
      H:=SSAnalogResponse(b,a,wmin,dw,N);
      IF op==1 THEN H:=SSMag(H); SSPlotXY(H,wmin,dw,"Modulo lineal |H(jw)|",{"Eje w en rad/s","RESPONSE",b,a,1,1}); END;
      IF op==2 THEN H:=SSPhase(H); SSPlotXY(H,wmin,dw,"Fase de H(jw)",{"Fase en radianes","RESPONSE",b,a,1,2}); END;
      IF op==4 THEN SSDataView(H,wmin,dw,"Respuesta compleja","w rad/s","H",SSAccent(7)); END;
      H:={};
    END;
    IF op==3 THEN SSResultBrowse("Revisar H(s)","Modelo actual",{{"Funcion H(s) Textbook",SSTransferText(b,a,1)},{"Numerador b",b},{"Denominador a",a}},"Coeficientes en potencias descendentes de s.","w usa rad/s: 1000 Hz equivale a 2*pi*1000 rad/s. Fase en radianes. Volver regresa al centro de resultados."); END;
    IF op==5 THEN r:=SSReadTransfer("Respuesta lineal H(jw)",b,a); IF SIZE(r)==2 THEN b:=r(1); a:=r(2); END; END;
    IF op==6 THEN
      r:=SSReadListDirect("Rango lineal","{wmin,wmax,N}=","rad/s; wmin<wmax; entero 16<=N<=160",{wmin,wmax,N});
      IF SIZE(r)==3 THEN
        IF TYPE(r(1))==0 AND TYPE(r(2))==0 AND TYPE(r(3))==0 THEN
          IF SSIsDrawable(r(1)) AND SSIsDrawable(r(2)) AND r(2)>r(1) AND r(3)==FLOOR(r(3)) AND r(3)>=16 AND r(3)<=160 THEN wmin:=r(1); wmax:=r(2); N:=r(3); dw:=(wmax-wmin)/(N-1);
          ELSE SSInfoView("Rango lineal","Se conserva el rango anterior","Use wmin<wmax y N entero de 16 a 160.",SSAccent(7)); END;
        END;
      END;
    END;
  UNTIL 0;
END;

UIFeedback()
BEGIN
  LOCAL b:={1};
  LOCAL a:={1,1};
  LOCAL K:=1;
  LOCAL acl;
  LOCAL p;
  LOCAL r;
  LOCAL op:=1;
  r:=SSReadTransfer("Realimentacion",b,a); IF SIZE(r)==0 THEN RETURN 0; END; b:=r(1); a:=r(2);
  IF INPUT(K,"Realimentacion","K=","Ganancia de lazo",1)==0 THEN RETURN 0; END;
  acl:=SSPolyAdd(a,b,1,K); p:=SSPolyRoots(acl);
  REPEAT
    op:=SSMenu({"Realimentacion unitaria",{3,"Realimentacion unitaria",{{"Numerador planta",b,0,1},{"Denominador planta",a,0,1},{"Ganancia K",K},{"Denominador cerrado",acl,0,1},{"Polos cerrados",p},{"Transferencia cerrada",SSTransferText(K*b,acl,1)}},"Realimentacion negativa: KG/(1+KG)."},5},{"Valores y estabilidad","Diagrama polos / ceros","Funcion de lazo cerrado","Cambiar K","Volver"},op);
    IF op==0 OR op==5 THEN RETURN 1; END;
    IF op==1 THEN SSResultBrowse("Realimentacion","Lazo cerrado",{{"Denominador en s",SSPolyText(acl,"s")},{"Coeficientes del denominador",acl},{"Polos",p},{"Estabilidad: 1 si, 0 no, -1 N/D",SSStable(acl,1)}},"K="+STRING(K),"Realimentacion negativa: denominador A(s)+K*B(s). Analisis causal sin cancelaciones. -1: raices no verificadas o demasiado proximas a la frontera; no certifica estabilidad."); END;
    IF op==2 THEN SSPlotPZ(K*b,acl,1,"Lazo cerrado"); END;
    IF op==3 THEN SSFormulaView("Realimentacion","T=KG/(1+KG)",SSTransferText(K*b,acl,1),SSAccent(7)); END;
    IF op==4 THEN r:=K; IF INPUT(r,"Realimentacion","K=","Ganancia real finita",K) THEN IF SSIsDrawable(r) AND IM(r)==0 THEN K:=r; acl:=SSPolyAdd(a,b,1,K); p:=SSPolyRoots(acl); END; END; END;
  UNTIL 0;
END;

UIRootLocus()
BEGIN
  LOCAL b:={1};
  LOCAL a:={1,3,2};
  LOCAL k0:=0;
  LOCAL k1:=20;
  LOCAL N:=11;
  LOCAL k;
  LOCAL g;
  LOCAL r;
  LOCAL op:=1;
  r:=SSReadTransfer("Lugar de raices",b,a); IF SIZE(r)==0 THEN RETURN 0; END; b:=r(1); a:=r(2);
  IF INPUT(k0,"Ganancia","K inicial=","Inicio",0)==0 THEN RETURN 0; END;
  IF INPUT(k1,"Ganancia","K final=","Fin",20)==0 THEN RETURN 0; END;
  IF INPUT(N,"Ganancia","Puntos=","Cantidad; maximo 41",11)==0 THEN RETURN 0; END; N:=MAX(2,MIN(41,FLOOR(N)));
  REPEAT
    op:=SSMenu({"Lugar de raices",{3,"Lugar de raices",{{"Numerador planta",b,0,1},{"Denominador planta",a,0,1},{"K inicial, final, N",{k0,k1,N}}},"Realimentacion negativa; raices de A(s)+K*B(s), para los K elegidos."},4},{"Ver lugar de raices","Transferencia de la planta","Rango de K y resolucion","Volver"},op);
    IF op==0 OR op==4 THEN RETURN 1; END;
    IF op==1 THEN SSRootLocusPlot(a,b,k0,k1,N); END;
    IF op==2 THEN SSFormulaView("Planta","G(s)",SSTransferText(b,a,1),SSAccent(7)); END;
    IF op==3 THEN SSInfoView("Lugar de raices","Parametros guardables","K inicial="+STRING(k0)+"; K final="+STRING(k1)+"; N="+STRING(N)+"\nMalla finita de ganancias; no garantiza encontrar toda la curva.",SSAccent(7)); END;
  UNTIL 0;
END;

VIEW "Analisis de control",UI_CONTROL()
BEGIN
  LOCAL op:=1;
  REPEAT
    SSEVAL_EVENTS:={}; SSREAD_META:={};
    op:=SSMenu("Sistemas y control",{"Respuesta de segundo orden","Respuesta lineal H(jw)","Diagramas de Bode H(jw)","Respuesta discreta H(e^jw)","Realimentacion unitaria","Lugar de raices","Polos, ceros y estabilidad","Teoria de sistemas y control","Volver"},op);
    IF op==0 THEN RETURN 0; END;
    IFERR
    IF op==1 THEN UISecondOrder(); END;
    IF op==2 THEN UIFreqResponseContinuousLinear(); END;
    IF op==3 THEN UIBodeContinuous(); END;
    IF op==4 THEN UIFreqResponse(); END;
    IF op==5 THEN UIFeedback(); END;
    IF op==6 THEN UIRootLocus(); END;
    IF op==7 THEN UIPolesZeros(); END;
    IF op==8 THEN SSTheoryView("Sistemas y control",{"FUNCION DE TRANSFERENCIA. H(s)=N(s)/D(s), con condiciones iniciales nulas. En discreto H(z)=B(z)/A(z). Sus polos determinan modos y estabilidad.","FRECUENCIA. H(jw) lineal muestra modulo y fase sobre un eje cartesiano. Bode usa frecuencia logaritmica y magnitud en dB; son herramientas separadas.","REALIMENTACION. Para realimentacion negativa unitaria, T=KG/(1+KG). El lugar de raices sigue los polos cerrados al variar K.","ENTRADA. Escriba coeficientes en potencias descendentes: {1,3,2}=s^2+3s+2. Numerador y denominador se solicitan consecutivamente."},SSAccent(7)); END;
    THEN SSInfoView("Control","Operacion no completada","Se detecto un error recuperable en la opcion "+STRING(op)+". Se vuelve al menu sin inventar un grafico. Revise los coeficientes, la expresion y el intervalo.",SSAccent(7)); END;
  UNTIL op==9; RETURN 1;
END;

// ---------- Resumen del plan y menu principal ----------

UITheory()
BEGIN
  LOCAL op:=1;
  REPEAT
    op:=SSMenu("Teoria por programa",{"Sistemas I: ejes 1-4","Sistemas I: Fourier","Sistemas I: muestreo/control","Sistemas II: procesamiento","Sistemas II: espectro","Sistemas II: filtros","Formulas clave","Instrucciones de uso","Volver"},op);
    IF op==0 THEN RETURN 0; END;
    IF op==1 THEN SSTheoryView("Sistemas I: fundamentos",{"SENALES. Clasificacion, transformaciones de ejes, energia, potencia, periodicidad y representacion por impulsos/escalones.","SISTEMAS. Linealidad, invariancia, causalidad y estabilidad. En LTI, y=x*h; las ecuaciones diferenciales o en diferencias modelan la dinamica.","TRANSFORMADAS. Laplace y Z convierten ecuaciones en relaciones algebraicas. Polos, ceros y region de convergencia completan la interpretacion."},SSAccent(8)); END;
    IF op==2 THEN SSTheoryView("Sistemas I: Fourier",{"SERIES CONTINUAS Y DISCRETAS. Descomponen una senal periodica en armonicos complejos. Los coeficientes describen amplitud y fase.","TRANSFORMADAS. CTFT integra en tiempo; DFT usa N muestras. SignalLab presenta la DFT ordenada de -pi a pi y ofrece modulo y fase.","PROPIEDADES. Linealidad, desplazamiento, dualidad, Parseval y teorema de convolucion. Las ventanas reducen fuga a costa de resolucion."},SSAccent(8)); END;
    IF op==3 THEN SSTheoryView("Sistemas I: muestreo y control",{"MUESTREO. fs debe superar 2*fmax para evitar alias ideal. La reconstruccion combina retenedor/interpolador y filtro.","CONTROL. H(jw) puede verse en escala lineal o como Bode. Margenes y lugar de raices describen robustez y variacion con ganancia.","NAVEGACION. ENTER confirma o abre datos; ESC vuelve; en graficos +/- cambia X, multiplicar/dividir cambia Y, flechas mueven y 0 restaura."},SSAccent(8)); END;
    IF op==4 THEN SSTheoryView("Sistemas II: procesamiento",{"A/D Y D/A. Cuantizacion, codificacion, SNR, punto fijo y reconstruccion. El numero de bits fija niveles y paso.","MULTITASA. Diezmado reduce tasa; expansion inserta ceros; interpolacion completa valores. Los resultados pueden exportarse a Fourier o filtrado.","REALIZACION. Una ecuacion en diferencias usa b en la rama directa y a en la realimentacion. Formas directas, cascada y paralelo cambian la implementacion, no H(z)."},SSAccent(8)); END;
    IF op==5 THEN SSTheoryView("Sistemas II: espectro",{"DENSIDADES. Para senales de energia, densidad espectral es |X|^2. Para potencia se emplean promedios y autocorrelacion.","ESTIMACION. Periodograma y ventanas estiman espectro desde registros finitos. Mayor duracion mejora separacion de frecuencias.","FASE. La fase lineal produce retardo constante. Fase minima concentra energia temprana y ubica ceros dentro del circulo unidad."},SSAccent(8)); END;
    IF op==6 THEN SSTheoryView("Sistemas II: filtros",{"FIR. Respuesta finita, siempre estable, posible fase lineal. Diseno por ventana aproxima una respuesta ideal.","IIR. Respuesta infinita y menor orden para transiciones similares. Polos deben permanecer dentro del circulo unidad.","ANALOGICOS. Butterworth es plano; Chebyshev y eliptico admiten rizado. Bilineal convierte H(s) en H(z). Un RC de primer orden cumple fc=1/(2*pi*R*C)."},SSAccent(8)); END;
    IF op==7 THEN SSTheoryView("Formulario rapido",{"LTI: y=x*h y H=Y/X. DFT: X[k]=sum x[n] exp(-j2*pi*k*n/N). DFS: c[k]=X[k]/N.","MUESTREO: fs>2*fmax. ENERGIA: suma o integral de |x|^2. BIBO: suma/integral |h| finita.","CONTROL: T=KG/(1+KG) con realimentacion unitaria negativa. SEGUNDO ORDEN: wd=wn*sqrt(1-zeta^2).","CUANTIZACION: Delta=(max-min)/(2^B-1). SNR ideal senoidal aproximada=6.02B+1.76 dB."},SSAccent(8)); END;
    IF op==8 THEN SSTheoryView("Instrucciones de uso",{"ENTRADAS. Secuencias y coeficientes se escriben como listas: {1,2,3}. En expresiones use X como indice n o variable t. Numerador y denominador se solicitan consecutivamente.","NAVEGACION. Flechas recorren menus y tablas. ENTER confirma, abre detalles o muestra datos de un grafico. ESC cancela o vuelve sin perder el menu superior.","GRAFICOS. + y - acercan o alejan el eje horizontal. Multiplicar y dividir controlan el vertical. Flechas mueven la vista y 0 restaura el autoescalado.","EXPORTACION. En una tabla pulse + o elija Exportar. L0 guarda valores, L1 el eje y M0 la tabla. Luego seleccione banco SignalLab o L0 en otra herramienta.","RESULTADOS. Modulo es amplitud no negativa; fase es angulo en radianes. +INF/-INF indican limites laterales; un circulo abierto marca un limite finito en un punto no definido."},SSAccent(8)); END;
  UNTIL op==9; RETURN 1;
END;

UIAbout()
BEGIN
  LOCAL op:=1;
  LOCAL k;
  LOCAL registro;
  LOCAL encontrado;
  REPEAT
    op:=SSMenu("SignalLab 5.0",{"Novedades y limites","Ultima operacion registrada","Limpiar contexto temporal","Volver"},op);
    IF op==0 OR op==4 THEN RETURN 1; END;
    IF op==1 THEN SSInfoView("SignalLab 5.0","Mejoras del 16/10/2026","Entrada original editable; zoom independiente; PSD calibrada y Welch; fase extendida y retardo; guardado sin pregunta repetida si no hubo cambios. Cancelacion cooperativa en rutas numericas, no interrumpe consultas CAS. La revision local no ejecuta firmware ni mide RAM. No se modifica la configuracion de la calculadora.",SSAccent(1)); END;
    IF op==2 THEN
      encontrado:=0;
      IF TYPE(SSHISTORY)==6 THEN FOR k FROM 1 TO SIZE(SSHISTORY) DO
        registro:=SSHISTORY(k);
        IF registro(1)==5 THEN encontrado:=1; SSInfoView(registro(2),registro(3),registro(5)+"\nProgreso: "+STRING(registro(4))+"\nRegistro orientativo, no diagnostico de RAM ni prueba de crasheo. Si Recientes esta lleno no se desplazan resultados para crearlo.",SSAccent(1)); END;
      END; END;
      IF encontrado==0 THEN SSInfoView("Diagnostico","Sin registro disponible","Se registra al iniciar operaciones compatibles si queda lugar en Recientes. No se guardan listas ni expresiones completas.",SSAccent(1)); END;
    END;
    IF op==3 THEN
      SSEVAL_EVENTS:={}; SSREAD_META:={};
      SSInfoView("Contexto liberado","Banco y Recientes conservados","Se limpiaron marcas transitorias y metadatos de la ultima lectura. Las listas L0/L1, M0, banco e historial no se borraron. Las listas locales se liberan al volver de cada herramienta. No equivale a reiniciar ni garantiza una cantidad de RAM disponible.",SSAccent(1));
    END;
  UNTIL 0;
END;

VIEW "SignalLab - Inicio",START()
BEGIN
  LOCAL op:=1;
  IF TYPE(SSDATA)<>6 THEN SSDATA:={}; SSDATA_N0:=0; SSDATA_DX:=1; SSDATA_NAME:=""; END;
  SSEVAL_EVENTS:={};
  REPEAT
    SSEVAL_EVENTS:={}; SSREAD_META:={};
    op:=SSDashboard(op);
    IF op==0 THEN RETURN 0; END;
    IFERR
    IF op==1 THEN UI_SIGNALS(); END;
    IF op==2 THEN UI_LTI(); END;
    IF op==3 THEN UI_TRANSFORMS(); END;
    IF op==4 THEN UI_FOURIER(); END;
    IF op==5 THEN UI_SAMPLING(); END;
    IF op==6 THEN UI_FILTERS(); END;
    IF op==7 THEN UI_CONTROL(); END;
    IF op==8 THEN UITheory(); END;
    THEN SSHistoryAdd({"DIAG","Modulo "+STRING(op),{},"Error recuperable; retorno al tablero."}); SSInfoView("SignalLab","Operacion interrumpida","Error recuperable en el modulo "+STRING(op)+". Se conserva el banco y se vuelve al tablero. No se entrego un resultado sustituto. Anote entrada, parametros y ultima pantalla si vuelve a ocurrir.",SSAccent(op)); END;
  UNTIL op==0;
  RETURN 1;
END;

RESET()
BEGIN
  START();
END;
