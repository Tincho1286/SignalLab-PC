  END;
  IF titulo=="Laboratorio de aliasing" THEN
    d:="Tono y muestreo uniforme."; e:="Tiempo en s; frecuencia en Hz";
    IF idx==1 THEN d:="Resumen, datos e interpretacion."; e:="Una pantalla por tema"; END;
    IF idx==2 THEN d:="Original, alias, SINC y error."; e:="Elija la curva que desea ver"; END;
    IF idx==3 THEN d:="Valores muestreados y exportacion."; e:="El paso temporal es Ts"; END;
    IF idx==4 THEN d:="Dos curvas sobre los mismos ejes."; e:="Original, filtrada o SINC"; END;
    IF idx==5 THEN d:="Cambiar tono, Ts o cantidad N."; e:="Recalcula al confirmar"; END;
    IF idx==6 THEN d:="Filtro RC previo al muestreo."; e:="Sin filtro o cascada RC"; END;
    IF idx==7 THEN d:="Regresar a Muestreo."; e:="ESC tambien vuelve"; END;
    IF idx==8 THEN d:="Original y resultado en el mismo eje."; e:="Azul original; naranja alias o SINC"; END;
    IF idx==9 THEN d:="Edita f, A, fase, N o Ts."; e:="Conserva los parametros restantes"; END;
    IF idx==10 THEN d:="Simula filtro analogico antes de A/D."; e:="Cascada RC: corte por etapa en Hz"; END;
    IF idx==11 THEN d:="Muestra la entrada analogica filtrada."; e:="Regimen permanente, sin transitorio"; END;
    IF idx==12 THEN d:="Vuelve a Muestreo."; e:="Exporte los datos que quiera conservar"; END;
  END;
  IF titulo=="Energia y potencia" THEN
    IF idx==1 THEN d:="Calcula medidas de una lista finita."; e:="Ej: x={1,-2,2}, n0=0"; END;
    IF idx==2 THEN d:="Formula discreta evaluada por indices."; e:="Ej: (0.5)^ABS(X), n=-10..10"; END;
    IF idx==3 THEN d:="Formula continua integrada en ventana."; e:="Ej: EXP(-ABS(X)), t=-5..5"; END;
    IF idx==4 THEN d:="Usa sumas, integrales y limites del CAS."; e:="E total y P media en todo el eje"; END;
    IF idx==5 THEN d:="Definiciones y criterio de clasificacion."; e:="Energia: 0<E<infinito; potencia: 0<P<infinito"; END;
    IF idx==6 THEN d:="Calcula Psi(w)=|X(w)|^2."; e:="Discreta o continua; no es PSD"; END;
    IF idx==7 THEN d:="Regresa al menu de senales."; e:="Presione ENTER para volver"; END;
  END;
  IF titulo=="Densidades espectrales" THEN
    IF idx==1 THEN d:="DTFT de registro finito al cuadrado."; e:="Lista o expresion; w en rad/muestra"; END;
    IF idx==2 THEN d:="Energia espectral del modelo por celdas."; e:="Expresion; ventana y w en rad/s"; END;
    IF idx==3 THEN d:="Estimador con ventana y escala 1/N."; e:="Se conserva el periodograma anterior"; END;
    IF idx==4 THEN d:="Regresa al menu anterior."; e:="ESC tambien vuelve"; END;
  END;
  IF titulo=="Densidad espectral de energia" THEN
    IF idx==1 THEN d:="Curva de Psi(w)=|X(w)|^2."; e:="ENTER abre valores; zoom de vista"; END;
    IF idx==2 THEN d:="Frecuencia y densidad numerica."; e:="+ exporta; no divide por N"; END;
    IF idx==3 THEN d:="Formula finita del registro o modelo."; e:="Textbook; formula larga en texto"; END;
    IF idx==4 THEN d:="Energia temporal e integral espectral."; e:="Continua: integral solo de la banda"; END;
    IF idx==5 THEN d:="Valores y origen efectivamente usados."; e:="Continua: centros de celda"; END;
    IF idx==6 THEN d:="Transformada antes de tomar |X|^2."; e:="Conserva partes real e imaginaria"; END;
    IF idx==7 THEN d:="Guarda Psi(w) y frecuencias."; e:="Elija banco, listas o tabla; no se escriben todos los destinos automaticamente"; END;
    IF idx==8 THEN d:="Convencion, escala y limitaciones."; e:="Registro finito no es senal periodica"; END;
    IF idx==9 THEN d:="Regresa al menu anterior."; e:="ESC tambien vuelve"; END;
  END;
  IF INSTRING(titulo,"Resultados de energia")>0 THEN
    IF idx==1 THEN d:="Energia total y potencia media global."; e:="CAS; una ventana no las sustituye"; END;
    IF idx==2 THEN d:="Consulta cada valor de la senal."; e:="Flechas y ENTER para mas precision"; END;
    IF idx==3 THEN d:="Consulta la densidad |x|^2."; e:="La suma o integral produce E"; END;
    IF idx==4 THEN d:="Grafica la senal evaluada."; e:="ENTER abre todos los valores"; END;
    IF idx==5 THEN d:="Grafica el aporte energetico."; e:="Ordenada: |x|^2"; END;
    IF idx==6 THEN d:="Expresion y planteos del calculo."; e:="Una operacion puede estar pendiente"; END;
    IF idx==7 THEN d:="Medidas locales del registro."; e:="Energia de la ventana y promedio sobre ella. No equivalen por si solos a energia total ni potencia media global."; END;
    IF idx==8 THEN d:="Metodo y alcance de las medidas."; e:="Global no equivale a ventana"; END;
    IF idx==9 THEN d:="Regresa al analisis energetico."; e:="Presione ENTER para volver"; END;
  END;
  IF INSTRING(titulo,"Sistemas LTI")>0 THEN
    IF idx==1 THEN d:="Convolucion de dos listas finitas."; e:="Ej: x={1,2,1}, h={1,1}"; END;
    IF idx==2 THEN d:="Integra x(tau)h(t-tau) numericamente."; e:="Ej: Heaviside(X) y Dirac(X-5)"; END;
    IF idx==3 THEN d:="Mide similitud segun el retardo."; e:="Ej: x={1,2,1}, h={1,1}"; END;
    IF idx==4 THEN d:="Simula un sistema definido por b y a."; e:="Ej: b={1}, a={1,-0.5}"; END;
    IF idx==5 THEN d:="Calcula respuesta impulso o escalon."; e:="Ej: b={1}, a={1,-0.5}, N=20"; END;
    IF idx==6 THEN d:="Grafica raices y comprueba estabilidad."; e:="Ej: b={1}, a={1,-0.5}"; END;
    IF idx==7 THEN d:="Propiedades de sistemas LTI."; e:="Ej: BIBO: suma |h[n]| finita"; END;
    IF idx==8 THEN d:="Regresa al tablero de modulos."; e:="Presione ENTER para volver"; END;
  END;
  IF INSTRING(titulo,"Transformadas Laplace")>0 THEN
    IF idx==1 THEN d:="Entrada: t minuscula. Salida: s."; e:="Ej: exp(-2*t)*Heaviside(t)"; END;
    IF idx==2 THEN d:="Entrada: s minuscula. Salida: t."; e:="Ej: 1/(s+2)"; END;
    IF idx==3 THEN d:="Lista o formula en n minuscula."; e:="Ej: {1,2,1} o (1/2)^n"; END;
    IF idx==4 THEN d:="Entrada: z minuscula. Salida: n."; e:="Ej: z/(z-0.5)"; END;
    IF idx==5 THEN d:="Incognita y(t); derivar con diff."; e:="Ej: diff(y(t),t)+y(t)=0"; END;
    IF idx==6 THEN d:="Formula en s; T en segundos."; e:="Ej: 1/(s+1), T=0.1"; END;
    IF idx==7 THEN d:="Definiciones, convergencia y ROC."; e:="Ayuda navegable por paginas"; END;
    IF idx==8 THEN d:="Regresa al tablero de modulos."; e:="Presione ENTER para volver"; END;
  END;
  IF INSTRING(titulo,"Fourier: series")>0 THEN
    IF idx==1 THEN d:="Expresion, tren de pulsos o Dirac."; e:="Entradas periodicas por parametros"; END;
    IF idx==2 THEN d:="Coeficientes de serie discreta."; e:="Una secuencia periodica completa"; END;
    IF idx==3 THEN d:="Integra x(t) para obtener X(w)."; e:="Modulo y fase sobre eje continuo"; END;
    IF idx==4 THEN d:="Reconstruye x(t) desde X(w)."; e:="Integral inversa numerica"; END;
    IF idx==5 THEN d:="DFT/IDFT y DTFT de un intervalo finito."; e:="Lista o expresion x[n] con X"; END;
    IF idx==6 THEN d:="Energia espectral discreta o continua."; e:="Tambien conserva periodograma y PSD"; END;
    IF idx==7 THEN d:="Convolucion o correlacion."; e:="Operaciones ligadas a Fourier"; END;
    IF idx==8 THEN d:="Definiciones, N, modulo y fase."; e:="Ayuda navegable por paginas"; END;
    IF idx==9 THEN d:="Regresa al tablero de modulos."; e:="Presione ENTER para volver"; END;
  END;
  IF INSTRING(titulo,"Muestreo, conversion")>0 THEN
    IF idx==1 THEN d:="Verifica Nyquist y calcula alias."; e:="Ej: fmax=1000, fs=2500, f=1700"; END;
    IF idx==2 THEN d:="Diezma, expande o interpola x[n]."; e:="Admite lista o expresion matematica"; END;
    IF idx==3 THEN d:="Cuantiza y estima la SNR."; e:="Ej: bits=3, rango=-1..1"; END;
    IF idx==4 THEN d:="Representa un numero en punto fijo."; e:="Ej: x=0.7, enteros=2, fracc=6"; END;
    IF idx==5 THEN d:="Convierte x(t) en muestras x[n]."; e:="Ej: SIN(X), Ts=0.1, N=21"; END;
    IF idx==6 THEN d:="Reconstruye con ZOH o interpolacion."; e:="Ej: x={0,1,0,-1,0}, Ts=0.25"; END;
    IF idx==7 THEN d:="Conceptos A/D, D/A y antialias."; e:="Ej: filtro PB antes de muestrear"; END;
    IF idx==8 THEN d:="Regresa al tablero de modulos."; e:="Presione ENTER para volver"; END;
  END;
  IF INSTRING(titulo,"Filtros analogicos")>0 THEN
