    IF idx==4 THEN d:="Guarda secuencia e indices."; e:="Banco, L0, L1 y M0 en la HP Prime"; END;
    IF idx==5 THEN d:="Metodo de evaluacion y alcance."; e:="Indices enteros; no supone periodo"; END;
