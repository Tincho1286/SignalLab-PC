    IF idx==7 THEN d:="Regresa al generador."; e:="Presione ENTER para volver"; END;
  END;
  IF INSTRING(titulo,"Senales continuas")>0 THEN
    IF idx==1 THEN d:="Crea secuencias basicas o por formula."; e:="Ej: COS(pi*X/4)"; END;
    IF idx==2 THEN d:="Desplaza, invierte, escala o suma."; e:="Ej: x={1,2,3}, k=2"; END;
    IF idx==3 THEN d:="Energia y potencia discreta o continua."; e:="Listas o expresiones con X"; END;
    IF idx==4 THEN d:="Clasificacion y formulas esenciales."; e:="Ej: E=suma o integral de |x|^2"; END;
