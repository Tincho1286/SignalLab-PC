    IF idx==5 THEN d:="Mantiene cada muestra durante L pasos."; e:="Retenedor de orden cero: tramos constantes, no interpolacion SINC."; END;
  END;
  IF INSTRING(titulo,"Entrada x[n]")>0 THEN
    IF idx==1 THEN d:="Carga directamente los valores de x[n]."; e:="Ej: {1,2,3,4,5,6}"; END;
    IF idx==2 THEN d:="Evalua una formula sobre un intervalo."; e:="Ej: COS(pi*X/4), n=-8..8"; END;
  END;
  IF INSTRING(titulo,"Fuente de datos")>0 THEN
    IF idx==1 THEN d:="Escribe una lista nueva manualmente."; e:="Ej: {1,2,3,4}"; END;
    IF idx==2 THEN d:="Reutiliza el ultimo banco de SignalLab."; e:="Conserva inicio y paso asociados"; END;
    IF idx==3 THEN d:="Carga la lista estandar L0 de Home."; e:="Puede editarse fuera de SignalLab"; END;
  END;
  IF INSTRING(titulo,"Resultados del muestreo")>0 THEN
    IF idx==1 THEN d:="Consulta n, tiempo real y muestra."; e:="Separacion temporal exactamente Ts"; END;
    IF idx==2 THEN d:="Grafica tallos sobre el eje temporal."; e:="H: +/- | V: x/div | flechas"; END;
    IF idx==3 THEN d:="Muestra expresion y regla usada."; e:="x[n]=x(t0+n*Ts)"; END;
    IF idx==4 THEN d:="Guarda las muestras para otro menu."; e:="Luego use banco SignalLab o L0"; END;
    IF idx==5 THEN d:="Metodo numerico, unidades y ventana."; e:="N no cambia Ts ni certifica Nyquist"; END;
    IF idx==6 THEN d:="Edita una entrada sin recargar todo."; e:="Tramo, formula, origen, Ts o N"; END;
    IF idx==7 THEN d:="Regresa al menu de muestreo."; e:="Presione ENTER para volver"; END;
  END;
  IF INSTRING(titulo,"Resultados de cambio de tasa")>0 THEN
    IF idx==1 THEN d:="Revisa la entrada ya evaluada."; e:="Tabla completa de x[n]"; END;
    IF idx==2 THEN d:="Revisa todos los valores obtenidos."; e:="La tecla + tambien los exporta"; END;
    IF idx==3 THEN d:="Muestras de salida, con su signo."; e:="Tallos en n entero; misma tabla"; END;
    IF idx==4 THEN d:="Guarda la salida para otra operacion."; e:="Ej: usarla luego en la DFT"; END;
    IF idx==5 THEN d:="Muestra factor, fase y tamanos."; e:="Incluye la expresion de entrada"; END;
    IF idx==6 THEN d:="Edita el factor y la fase de diezmado."; e:="La entrada original se conserva"; END;
    IF idx==7 THEN d:="Filtra al diezmar o tras expandir."; e:="Ideal A/fc, FIR Hamming o IIR b/a"; END;
    IF idx==8 THEN d:="Compara ambas salidas con igual eje."; e:="Azul sin filtro; naranja con filtro"; END;
    IF idx==9 THEN d:="Consulta la senal en la etapa filtrada."; e:="No reemplaza la entrada original"; END;
    IF idx==10 THEN d:="Consulta el filtro seleccionado."; e:="Formula, datos y convenciones"; END;
    IF idx==11 THEN d:="Vista adicional del filtro ideal."; e:="Curva SINC entre muestras enteras"; END;
    IF idx==12 THEN d:="DTFT de cada registro disponible."; e:="Original, sin filtro, filtrada y final"; END;
    IF idx==13 THEN d:="Regresa a Muestreo."; e:="Exporte para guardar los cambios"; END;
  END;
  IF INSTRING(titulo,"Resultados DFT")>0 THEN
    IF idx==1 THEN d:="Consulta cada coeficiente complejo."; e:="Flechas y ENTER para detalle"; END;
    IF idx==2 THEN d:="Grafica la magnitud del resultado."; e:="H: +/- | V: x/div | flechas"; END;
    IF idx==3 THEN d:="Grafica la fase en radianes."; e:="Alineada con el mismo N y eje"; END;
    IF idx==4 THEN d:="Compara N natural con N utilizado."; e:="N natural = longitud de la lista"; END;
    IF idx==5 THEN d:="Guarda valores y eje espectral."; e:="Seleccione el destino de exportacion"; END;
